(module
  (type $A (array (mut v128)))
  (global $array (mut (ref null $A)) (ref.null $A))
  (func (export "init")
    (global.set $array (array.new $A (v128.const i64x2 7 11) (i32.const 64))))
  (func (export "clear") (global.set $array (ref.null $A)))
  (func (export "get") (param $index i32) (result v128)
    (array.get $A (global.get $array) (local.get $index)))
  (func (export "set") (param $index i32) (param $value v128)
    (array.set $A (global.get $array) (local.get $index) (local.get $value)))
  (func (export "read") (param $n i32) (result i64)
    (local $i i32) (local $sum i64)
    (block $done (loop $again
      (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $sum (i64.add (local.get $sum)
        (i64x2.extract_lane 0 (array.get $A (global.get $array)
          (i32.and (local.get $i) (i32.const 63))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $again)))
    (local.get $sum))
  (func (export "write") (param $n i32) (result i64)
    (local $i i32)
    (block $done (loop $again
      (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
      (array.set $A (global.get $array)
        (i32.and (local.get $i) (i32.const 63))
        (i64x2.splat (i64.extend_i32_u (local.get $i))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $again)))
    (i64x2.extract_lane 1 (array.get $A (global.get $array)
      (i32.and (i32.sub (local.get $n) (i32.const 1)) (i32.const 63)))))
)
