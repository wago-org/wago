(module
  (type $Record (struct (field i32) (field i64) (field f32) (field f64)
    (field i8) (field i16) (field v128)))
  (type $Other (struct (field i64)))
  (global $object (mut eqref) (ref.null eq))
  (func (export "init")
    (global.set $object
      (struct.new $Record (i32.const 7) (i64.const 0x0102030405060708)
        (f32.const 1.25) (f64.const -6.5) (i32.const -7) (i32.const -1234)
        (v128.const i64x2 11 22))))
  (func (export "clear") (global.set $object (ref.null eq)))
  (func (export "other") (global.set $object (struct.new $Other (i64.const 99))))
  (func (export "i32") (result i32)
    (struct.get $Record 0 (ref.cast (ref $Record) (global.get $object))))
  (func (export "nullable-i32") (result i32)
    (struct.get $Record 0 (ref.cast (ref null $Record) (global.get $object))))
  (func (export "i64") (result i64)
    (struct.get $Record 1 (ref.cast (ref $Record) (global.get $object))))
  (func (export "f32") (result i32)
    (i32.reinterpret_f32 (struct.get $Record 2 (ref.cast (ref $Record) (global.get $object)))))
  (func (export "f64") (result i64)
    (i64.reinterpret_f64 (struct.get $Record 3 (ref.cast (ref $Record) (global.get $object)))))
  (func (export "i8-s") (result i32)
    (struct.get_s $Record 4 (ref.cast (ref $Record) (global.get $object))))
  (func (export "i8-u") (result i32)
    (struct.get_u $Record 4 (ref.cast (ref $Record) (global.get $object))))
  (func (export "i16-s") (result i32)
    (struct.get_s $Record 5 (ref.cast (ref $Record) (global.get $object))))
  (func (export "i16-u") (result i32)
    (struct.get_u $Record 5 (ref.cast (ref $Record) (global.get $object))))
  (func (export "v128") (result v128)
    (struct.get $Record 6 (ref.cast (ref $Record) (global.get $object))))
  (func (export "loop-i32") (param $n i32) (result i32)
    (local $i i32) (local $sum i32)
    (block $done (loop $again
      (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $sum (i32.add (local.get $sum)
        (struct.get $Record 0 (ref.cast (ref $Record) (global.get $object)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $again)))
    (local.get $sum))
  (func (export "loop-v128") (param $n i32) (result i64)
    (local $i i32) (local $sum i64)
    (block $done (loop $again
      (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $sum (i64.add (local.get $sum)
        (i64x2.extract_lane 1
          (struct.get $Record 6 (ref.cast (ref $Record) (global.get $object))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $again)))
    (local.get $sum))
)
