+//go:build linux && amd64
+
+package amd64
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestZeroarityBranchLeavesMixedStateUntouched(t *testing.T) {
+	for _, loop := range []bool{false, true} {
+		f := fn{s: newStack()}
+		for i, typ := range []machineType{mtI32, mtI64, mtF64, mtV128} {
+			e := f.pushValue(storage{kind: stSlot, typ: typ, slot: uint32(i)})
+			if i == 1 {
+				f.setStackGCRoot(e, true)
+			}
+		}
+		f.tmpRoots = []*elem{nil}
+		f.tmpTypes = []machineType{mtF32}
+		before := append([]machineType(nil), f.tmpTypes...)
+		root := f.s.back()
+		depth := f.s.logicalDepth
+		fr := ctrlFrame{kind: cfBlock}
+		if loop {
+			fr.kind = cfLoop
+		}
+		// No assembler: any attempted emission is a test failure, not a silent no-op.
+		f.moveBranchValues(&fr, 4, 0)
+		if f.s.back() != root || f.s.logicalDepth != depth || len(f.tmpRoots) != 1 || f.tmpRoots[0] != nil || !reflect.DeepEqual(f.tmpTypes, before) || fr.has(ctrlHasResultGCRoots) {
+			t.Fatal("zero payload mutated stack, scratch or target")
+		}
+	}
+}
+func TestZeroarityBranchNoSourceRead(t *testing.T) {
+	f := fn{}
+	f.moveBranchValues(&ctrlFrame{}, 0, 0)
+	if f.tmpRoots != nil || f.tmpTypes != nil {
+		t.Fatal("zero source walked")
+	}
+}
