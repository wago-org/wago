+//go:build linux && amd64
+
+package amd64
+
+import (
+	"fmt"
+	"math/bits"
+	"reflect"
+	"testing"
+)
+
+func commonpathUnaryExpected(op wOp, v int64, typ machineType) (int64, machineType) {
+	switch op {
+	case opEqz:
+		if (typ == mtI32 && uint32(v) == 0) || (typ == mtI64 && v == 0) {
+			return 1, mtI32
+		}
+		return 0, mtI32
+	case opClz:
+		if typ == mtI32 {
+			return int64(bits.LeadingZeros32(uint32(v))), typ
+		}
+		return int64(bits.LeadingZeros64(uint64(v))), typ
+	case opCtz:
+		if typ == mtI32 {
+			return int64(bits.TrailingZeros32(uint32(v))), typ
+		}
+		return int64(bits.TrailingZeros64(uint64(v))), typ
+	case opPopcnt:
+		if typ == mtI32 {
+			return int64(bits.OnesCount32(uint32(v))), typ
+		}
+		return int64(bits.OnesCount64(uint64(v))), typ
+	case opWrap:
+		return int64(int32(v)), mtI32
+	case opSExt32:
+		return int64(int32(v)), mtI64
+	case opZExt32:
+		return int64(uint32(v)), mtI64
+	case opSExt8:
+		return int64(int8(v)), typ
+	case opSExt16:
+		return int64(int16(v)), typ
+	}
+	panic("unsupported test op")
+}
+
+func TestCommonpathUnaryRootReuse(t *testing.T) {
+	for _, op := range []wOp{opEqz, opClz, opCtz, opPopcnt, opWrap, opSExt32, opZExt32, opSExt8, opSExt16} {
+		for _, typ := range []machineType{mtI32, mtI64} {
+			for _, v := range []int64{0, 1, -1, -1 << 63, 1<<63 - 1, 0x100000000, 0x80000000, 0x80, 0x8000} {
+				t.Run(fmt.Sprintf("op%d/type%d/value%d", op, typ, v), func(t *testing.T) {
+					f := fn{s: newStack()}
+					outer := f.pushValue(storage{kind: stConst, typ: mtI32, cval: 11})
+					root := f.pushValue(storage{kind: stConst, typ: typ, cval: v})
+					f.s.setElemCold(root, nil, []Reg{1, 2})
+					f.s.pendingPrefix = root
+					f.s.pendingPrefixLoads = true
+					depth, used := f.s.logicalDepth, len(*f.s.activeChunk)
+					prev, next := root.prev, root.next
+					want, wt := commonpathUnaryExpected(op, v, typ)
+					f.pushUnOp(op, typ)
+					if f.s.back() != root || root.st.kind != stConst || root.st.cval != want || root.st.typ != wt {
+						t.Fatalf("got %+v want value%d type%d same root", root.st, want, wt)
+					}
+					if f.s.logicalDepth != depth || len(*f.s.activeChunk) != used || root.prev != prev || root.next != next || outer.next != root || !root.st.hasLogicalRoot() {
+						t.Fatal("root/link/arena invariant")
+					}
+					if f.s.pendingPrefix != root || !f.s.pendingPrefixLoads {
+						t.Fatal("pending prefix changed")
+					}
+					for _, c := range f.s.cold {
+						if c.custom != nil || c.vregs != nil {
+							t.Fatal("cold payload retained")
+						}
+					}
+					load := f.pushValue(storage{kind: stLocalRef, typ: mtI32, idx: 0})
+					if load.prev != root || f.s.pendingEffects&pendingLocalRef == 0 {
+						t.Fatal("subsequent pending effect lost")
+					}
+				})
+			}
+		}
+	}
+}
+
+func TestCommonpathBranchPayloadOwnsSnapshot(t *testing.T) {
+	f := fn{s: newStack()}
+	types := []machineType{mtV128, mtI32, mtF64, mtI64}
+	for i, typ := range types {
+		e := f.pushValue(storage{kind: stSlot, typ: typ, slot: uint32(i)})
+		if i == 3 {
+			f.setStackGCRoot(e, true)
+		}
+	}
+	p := f.captureBranchPayload(4, 3)
+	if p.fromSlot != 2 || p.nSlots != 3 || !reflect.DeepEqual(p.gcRoots, []bool{false, false, true}) {
+		t.Fatalf("payload %+v", p)
+	}
+	// Mutate both scratch views and source flags; captured bits/slot scalars must own their values.
+	for i := range f.tmpTypes {
+		f.tmpTypes[i] = mtV128
+	}
+	for i := range f.tmpRoots {
+		f.tmpRoots[i] = nil
+	}
+	for e := f.s.head.next; e != f.s.head; e = e.next {
+		e.st.setGCRoot(false)
+	}
+	a, b := ctrlFrame{resultN: 3}, ctrlFrame{resultN: 3}
+	f.recordBranchPayloadRoots(&a, p)
+	f.recordBranchPayloadRoots(&b, p)
+	want := []bool{false, false, true}
+	if !reflect.DeepEqual(f.frameResultGCRoots(&a), want) || !reflect.DeepEqual(f.frameResultGCRoots(&b), want) {
+		t.Fatal("per-target root snapshot lost")
+	}
+	f.setFrameResultGCRoot(&a, 0)
+	if !reflect.DeepEqual(f.frameResultGCRoots(&b), want) || !reflect.DeepEqual(p.gcRoots, want) {
+		t.Fatal("target root aliases payload or other target")
+	}
+}
+
+func TestCommonpathZeroBranchPayloadNoStackAccess(t *testing.T) {
+	f := fn{} // nil stack/assembler deliberately proves the zero path reads neither.
+	p := f.captureBranchPayload(0, 0)
+	if p.fromSlot != 0 || p.nSlots != 0 || p.gcRoots != nil {
+		t.Fatal(p)
+	}
+	f.emitBranchPayload(&ctrlFrame{}, p)
+	if f.tmpRoots != nil || f.tmpTypes != nil {
+		t.Fatal("zero payload borrowed scratch")
+	}
+}
+
+func TestCommonpathBranchPayloadEmissionParity(t *testing.T) {
+	for _, typ := range []machineType{mtI32, mtI64, mtF32, mtF64, mtV128} {
+		for _, loop := range []bool{false, true} {
+			for _, merge := range []bool{false, true} {
+				if merge && (loop || typ == mtV128) {
+					continue
+				}
+				t.Run(fmt.Sprintf("type%d/loop%t/merge%t", typ, loop, merge), func(t *testing.T) {
+					makeFn := func() (*fn, *ctrlFrame) {
+						sc := newScratchWithStackCap(defaultStackArenaCap)
+						f := &sc.fnState
+						f.sc, f.s, f.a = sc, sc.stack, sc.asm
+						f.pushValue(storage{kind: stSlot, typ: mtV128})
+						e := f.pushValue(storage{kind: stSlot, typ: typ, slot: 2})
+						if typ == mtI64 {
+							f.setStackGCRoot(e, true)
+						}
+						fr := &ctrlFrame{kind: cfBlock, resultN: 1, res0: typ}
+						if loop {
+							fr.kind = cfLoop
+						}
+						fr.set(ctrlRegMerge1, merge)
+						return f, fr
+					}
+					old, a := makeFn()
+					now, b := makeFn()
+					p := now.captureBranchPayload(2, 1)
+					for i := range now.tmpTypes {
+						now.tmpTypes[i] = mtI32
+					}
+					for i := range now.tmpRoots {
+						now.tmpRoots[i] = nil
+					}
+					if merge {
+						old.branchEdgeToMerge1(a, 2)
+					} else {
+						old.moveBranchValues(a, 2, 1)
+					}
+					now.emitBranchPayload(b, p)
+					if !reflect.DeepEqual(old.a.B, now.a.B) {
+						t.Fatalf("native mismatch old%x new%x", old.a.B, now.a.B)
+					}
+					if !reflect.DeepEqual(old.frameResultGCRoots(a), now.frameResultGCRoots(b)) {
+						t.Fatal("target GC mismatch")
+					}
+				})
+			}
+		}
+	}
+}
