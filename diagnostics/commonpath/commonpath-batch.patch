+// branchPayload is a call-local snapshot of an already canonical source image.
+// It owns no operand pointers or register identities. Each target still records
+// its own GC result roots and computes its own destination slot offset.
+type branchPayload struct {
+	fromSlot, nSlots int
+	gcRoots          []bool
+}
+
+func (f *fn) captureBranchPayload(d, arity int) branchPayload {
+	if arity == 0 {
+		return branchPayload{}
+	}
+	roots := f.rootsBottomToTop()
+	types := f.logicalTypes(roots)
+	from := slotOfLogicalTypes(types, d-arity)
+	payload := branchPayload{fromSlot: from, nSlots: slotOfLogicalTypes(types, d) - from}
+	if f.s.hasGCRoots {
+		// Only the immutable result bits survive case emission. Do not retain the
+		// reusable tmpRoots/tmpTypes views across target-local bookkeeping.
+		payload.gcRoots = gcRootFlags(roots[len(roots)-arity:])
+	}
+	return payload
+}
+
+func (f *fn) recordBranchPayloadRoots(fr *ctrlFrame, payload branchPayload) {
+	for i, root := range payload.gcRoots {
+		if root {
+			f.setFrameResultGCRoot(fr, i)
+		}
+	}
+}
+
+func (f *fn) emitBranchPayload(fr *ctrlFrame, payload branchPayload) {
+	if fr.has(ctrlRegMerge1) {
+		f.recordBranchPayloadRoots(fr, payload)
+		if fr.res0.isFloat() {
+			f.a.FLoadDisp(mergeFReg, RSP, f.spillOff(payload.fromSlot), fr.res0 == mtF64)
+		} else {
+			f.a.Load64(mergeReg, RSP, f.spillOff(payload.fromSlot))
+		}
+		return
+	}
+	if fr.kind != cfLoop {
+		f.recordBranchPayloadRoots(fr, payload)
+	}
+	if payload.nSlots != 0 {
+		f.moveSlots(payload.fromSlot, slotsOfTypes(f.frameBaseTypes(fr)), payload.nSlots)
+	}
+}
