+// brIfFused lowers `<compare> br_if L` as CMP + conditional jump.
+func (f *fn) brIfFused(r *wasm.Reader, top *elem, labelIdx uint32) error {
+	fi := f.sourceLabelFrame(labelIdx)
+	if fi < 0 {
+		return errBadLabel
+	}
+	fr := &f.ctrl[fi]
+	// A successful check before a forward branch also dominates its
+	// fallthrough. Keep only local-based facts, which are invalidated when
+	// their source local changes; other certificate kinds have different rules.
+	var savedBounds [2]boundsCert
+	if fallthroughBoundsEnabled && fr.kind == cfBlock && fi < len(f.ctrl)-1 && f.boundsCertSources != 0 {
+		n := 0
+		for _, c := range f.boundsCerts {
+			if c.kind == 1 {
+				savedBounds[n] = c
+				n++
+				if n == len(savedBounds) {
+					break
+				}
+			}
+		}
+	}
+	loopHeader := false
+	counter := -1
+	if f.opt(optCountedLoopLatch) && !f.interruptible && !f.usesCalls && top.deferredOp() == opEqz &&
+		labelIdx == 1 && len(f.ctrl) >= 2 && fi == len(f.ctrl)-2 {
+		loop := &f.ctrl[len(f.ctrl)-1]
+		counter, loopHeader = localAddressKey(top.arg0)
+		loopHeader = loopHeader && loop.kind == cfLoop && loop.paramN == 0 && loop.resultN == 0 &&
+			fr.kind == cfBlock && fr.branchArity() == 0 && f.a.Len() == loop.controlSite
+	}
+	k := f.flushBelow(top)
+	coldExit := f.callFreeLoopExit(fi)
+	var saved localStateSnapshot
+	if coldExit && len(f.locals) > len(saved) {
+		coldExit = false
+	}
+	if !coldExit {
+		f.convergeBranchLocals(fr) // before the compare: loads/stores stay clear of the flags window
+	}
+	if loopHeader && f.a.Len() != f.ctrl[len(f.ctrl)-1].controlSite {
+		loopHeader = false
+	}
+	cc := f.condenseToFlags(top)
+	directExit := false
+	if coldExit {
+		// Predicate evaluation can reclaim pins too. Snapshot the state actually
+		// present on the fallthrough path, after all deferred work has run.
+		saved, _ = f.snapshotLocalStates()
+		directExit = f.retainCallFreeLoopExitRegisters(fi)
+	} else if f.pinRelinquished {
+		// The compare can home a pin after the initial convergence. All lazy
+		// zeros were materialized above, so this repair emits only flag-preserving
+		// loads and stores before the conditional jump.
+		f.convergeBranchLocals(fr)
+	}
+	if f.tryScalarPosttestLoop(fr, fi, k, cc) {
+		return nil
+	}
+	a := fr.branchArity()
+	if directExit && k == 0 && a == 0 && !loopHeader {
+		// Every pin already satisfies the register-only target. No reconciliation,
+		// payload move or handler restore can execute on this guarded void edge.
+		f.frameAddEnd(fr, f.a.JccPlaceholder(cc))
+		fr.set(ctrlEndReachable, true)
+		f.restoreLocalStates(saved)
+		f.stats.peep("callfree-loop-exit-cold")
+		f.stats.peep("callfree-loop-direct-exit")
+		for _, c := range savedBounds {
+			if c.kind != 0 {
+				f.boundsCertUpdate(c.kind, c.idx, c.extent)
+			}
+		}
+		return nil
+	}
+	over := f.a.JccPlaceholder(invertCond(cc)) // fall through when the compare is false
+	if coldExit {
+		// MOV loads/stores used by local reconciliation preserve x86 flags, so
+		// the taken exit alone pays this work after the fused compare.
+		f.convergeBranchLocals(fr)
+	}
+	if fr.has(ctrlRegMerge1) {
+		f.branchEdgeToMerge1(fr, k)
+	} else {
+		f.moveBranchValues(fr, k, a)
+	}
+	f.restoreBranchHandlers(fi)
+	f.branchJump(fr)
+	f.a.PatchRel32(over, f.a.Len())
+	if coldExit {
+		f.restoreLocalStates(saved)
+		f.stats.peep("callfree-loop-exit-cold")
+	}
+	f.recordBrFold(over)
+	if loopHeader {
+		loop := &f.ctrl[len(f.ctrl)-1]
+		_, isFloat, pinned := f.pinReg(counter)
+		if pinned && !isFloat {
+			f.tryHoistLinearSumBounds(r, counter, loop)
+			f.ensureCtrlMerge(loop).setCountedLoop(counter, f.a.Len())
+		}
+	}
+	for _, c := range savedBounds {
+		if c.kind != 0 {
+			f.boundsCertUpdate(c.kind, c.idx, c.extent)
+		}
+	}
+	return nil
+}
+
+func gcFrameRefType(m *wasm.Module, t wasm.ValType) bool {
+	if t.Kind() != wasm.ValRef {
+		return false
+	}
+	heap := t.Ref().Heap()
+	switch heap.Kind() {
+	case wasm.HeapAbs:
+		switch heap.Abs() {
+		case wasm.HeapAny, wasm.HeapEq, wasm.HeapI31, wasm.HeapStruct, wasm.HeapArray, wasm.HeapNone:
+			return true
+		default:
+			return false
+		}
+	case wasm.HeapDefType:
+		kind, valid := heap.DefCompKind()
+		if !valid {
+			return true
+		}
+		return kind == wasm.CompStruct || kind == wasm.CompArray
+	case wasm.HeapTypeIndex:
+		index := heap.Type().Index
+		for _, group := range m.Types {
+			if index < uint32(len(group.SubTypes)) {
+				kind := group.SubTypes[index].Comp.Kind
+				return kind == wasm.CompStruct || kind == wasm.CompArray
+			}
+			index -= uint32(len(group.SubTypes))
+		}
+		return true
+	default:
+		return true
+	}
+}
+
+// globalCellPtr returns a register holding &global[x]'s cell (the pointer at
+// [[RBX-GlobalsPtrOffset] + x*8]), caching it across a straight-line run. Both the
+// array base and each cell pointer are loop-invariant, so a hot global reloads
+// neither after its first access: the value load/store then reads/writes [cellReg]
+// directly. Single-entry — a different global evicts the previous one. The pinned
+// register is allocated clear of the div/shift fixed-role registers RAX/RCX/RDX
+// (clobbered without consulting the operand model). Invalidated at every flush, so
+// it never spans a call or control-flow boundary; the pointer never changes, so
+// re-deriving it after a boundary is always correct.
+func (f *fn) globalCellPtr(x uint32) Reg {
+	if f.globalCellReg != regNone && f.globalCellIdx == x {
+		return f.globalCellReg
+	}
+	f.invalidateGlobalsCache() // evict a stale cell for a different global
+	r := f.allocReg(maskOf(RAX, RCX, RDX))
+	f.a.Load64(r, RBX, -int32(abi.GlobalsPtrOffset)) // r = slot array (base), used transiently
+	f.a.Load64(r, r, int32(x*8))                     // r = &global[x]
+	f.pinned = f.pinned.add(r)
+	f.globalCellReg, f.globalCellIdx = r, x
+	if regallocCheckEnabled {
+		checkGlobalCell(f)
+	}
+	return r
+}
+
+func (f *fn) globalSet(r *wasm.Reader) error {
+	x, err := r.U32()
+	if err != nil {
+		return err
+	}
+	return f.globalSetIndex(x)
+}
+
+func (f *fn) globalSetIndex(x uint32) error {
+	f.invalidateBoundsCertFor(2, x)
+	gt, ok := f.globalType(x)
+	if !ok {
+		return fmt.Errorf("amd64: unknown global %d", x)
+	}
+	f.materializePendingTraps()
+	gtv := wasm.GlobalValueType(gt)
+	if wasm.EqualValType(gtv, wasm.V128) {
+		xmm := f.materializeV128(f.popValue())
+		f.fpinned = f.fpinned.add(xmm)
+		cell := f.globalCellPtr(x) // cached, pinned
+		f.mov128StoreDisp(cell, 0, xmm)
+		f.fpinned = f.fpinned.remove(xmm)
+		f.releaseF(xmm)
+		return nil
+	}
+	if wasm.EqualValType(gtv, wasm.F32) || wasm.EqualValType(gtv, wasm.F64) {
+		f64 := wasm.EqualValType(gtv, wasm.F64)
+		xmm := f.materializeF(f.popValue())
+		f.fpinned = f.fpinned.add(xmm)
+		cell := f.globalCellPtr(x) // cached, pinned
+		f.a.FStoreDisp(cell, 0, xmm, f64)
+		f.fpinned = f.fpinned.remove(xmm)
+		f.releaseF(xmm)
+		return nil
+	}
+	// Value-pinned (int) global: compute the new value straight into its register
+	// (no memory write here — the coherent write-back to the cell happens once at the
+	// function epilogue, since value-pinning is only used in call-free functions).
+	if reg, ok := f.pinnedGlobalValueReg(x); ok {
+		e := f.s.back()
+		// In-place self-update `global.set $x (binop (global.get $x) …)`: let
+		// condenseInto consume the top expression straight into x's register instead
+		// of pre-copying its (global.get $x) operand (mirrors setLocal's skipFrom).
+		var skipFrom *elem
+		if e != nil && e.isDeferred() && isBinALU(e.deferredOp()) {
+			skipFrom = baseOfValentBlock(e)
+		}
+		f.realizeGlobalRefs(x, skipFrom)
+		f.condenseInto(e, reg)
+		f.release(reg)
+		f.erase(e)
+		f.globalReg[x] |= globalRegDirty
+		return nil
+	}
+	rg := f.materialize(f.popValue())
+	f.pinned = f.pinned.add(rg)
+	cell := f.globalCellPtr(x) // cached, pinned (rg excluded)
+	switch {
+	case wasm.EqualValType(gtv, wasm.I64) || gtv.Kind() == wasm.ValRef:
+		f.a.Store64(cell, 0, rg)
+	case wasm.EqualValType(gtv, wasm.I32):
+		f.a.Store32(cell, 0, rg)
+	default:
+		f.pinned = f.pinned.remove(rg)
+		f.release(rg)
+		return fmt.Errorf("amd64: global.set type %s not yet supported (global %d)", gtv, x)
+	}
+	f.pinned = f.pinned.remove(rg)
+	f.release(rg)
+	return nil
+}
+
+func scanFuncBodyWithLoopIntConsts(fn wasm.Func, nLocals, nGlobals int, selfIdx uint32, h funcHintView, elig *globalEligibilityTracker, memory64 bool, m *wasm.Module, classifier *wasm.ModuleInstructionClassifier, gcTypeLayouts []codegen.GCTypeLayout, gcStructHelpers bool, moduleHints []funcHints, importedFuncs int, globalHints *shared.GlobalHintAccumulator, collect bool) (funcHintView, [2]int64, uint8, error) {
+	if len(fn.BodyBytes) == 0 {
+		view := scanBodyInto(fn.Body, nLocals, nGlobals, selfIdx, h, elig, m, gcTypeLayouts, gcStructHelpers, globalHints)
+		return view, [2]int64{}, 0, nil
+	}
+	return scanBodyBytesWithLoopIntConsts(fn.BodyBytes, nLocals, nGlobals, selfIdx, h, elig, memory64, m, classifier, gcTypeLayouts, gcStructHelpers, moduleHints, nil, importedFuncs, globalHints, collect)
+}
+
+func scanBodyBytesWithLoopIntConsts(body []byte, nLocals int, nGlobals int, selfIdx uint32, h funcHintView, elig *globalEligibilityTracker, memory64 bool, m *wasm.Module, classifier *wasm.ModuleInstructionClassifier, gcTypeLayouts []codegen.GCTypeLayout, gcStructHelpers bool, moduleHints []funcHints, parallelCalls []parallelCalleeHints, importedFuncs int, globalHints *shared.GlobalHintAccumulator, collect bool) (funcHintView, [2]int64, uint8, error) {
+	elig.reset()
+	r := wasm.ReaderFrom(body)
+	var cached wasm.ModuleInstructionClassifier
+	if classifier != nil {
+		cached = *classifier
+	} else {
+		cached = wasm.NewModuleInstructionClassifier(m, true)
+	}
+	s := byteBodyScanner{r: byteScanReader{Reader: r}, h: h, nLocals: nLocals, nGlobals: nGlobals, selfIdx: selfIdx, elig: elig, globalHints: globalHints, entryPrefix: true, memory64: memory64, m: m, classifier: cached, gcTypeLayouts: gcTypeLayouts, gcStructHelpers: gcStructHelpers, moduleHints: moduleHints, parallelCalls: parallelCalls, importedFuncs: importedFuncs, collectLoopIntConsts: collect}
+	called, term, err := s.scanExpr(0, 0, -1, false)
+	if err != nil {
+		return s.h, s.selectedLoopIntConsts, s.selectedLoopIntConstN, err
+	}
+	if called {
+		s.h.flags.set(hintHasCall)
+	}
+	if term != 0x0b || s.r.has() {
+		return s.h, s.selectedLoopIntConsts, s.selectedLoopIntConstN, s.r.err(wasm.ErrInvalidInstruction, s.r.off())
+	}
+	if s.loopIntConstN != 0 {
+		s.finishLoopIntConsts()
+	}
+	return s.h, s.selectedLoopIntConsts, s.selectedLoopIntConstN, nil
+}
+
+func (s *byteBodyScanner) recordPhysicalEvent(op byte, kind shared.LocalEventKind, depth int) {
+	if op >= 0x6d && op <= 0x70 || op >= 0x7f && op <= 0x82 {
+		s.h.noteFixedScratchLease()
+	}
+	s.h.noteBoundaryEvent(kind, depth)
+}
+
+func (s *byteBodyScanner) scanExpr(depth int, loopDepth int, curLoop int, stopAtElse bool) (bool, byte, error) {
+	if depth > 20000 {
+		return true, 0, s.r.err(wasm.ErrInstructionNestingLimitExceeded, s.r.off())
+	}
+	subHasCall := false
+	weight := loopWeight(loopDepth)
+	var prevOp byte
+	var prevI32 int32
+	var variableShiftDepth uint8
+	for {
+		op, err := s.r.byte()
+		if err != nil {
+			return true, 0, err
+		}
+		s.notePhysicalEvent(op, depth)
+		switch op {
+		case 0x0b: // end
+			return subHasCall, op, nil
+		case 0x05: // else
+			if stopAtElse {
+				return subHasCall, op, nil
+			}
+			return true, op, s.r.err(wasm.ErrInvalidInstruction, s.r.off()-1)
+		case 0x0e: // br_table: exact jump-table-data admission hint
+			s.h.flags.set(hintHasControlFlow)
+			s.entryPrefix = false
+			n, err := s.r.U32()
+			if err != nil {
+				return true, 0, err
+			}
+			if n >= brTableJumpMin {
+				s.h.flags.set(hintHasJumpTableData)
+			}
+			for i := uint32(0); i < n; i++ {
+				if _, err := s.r.U32(); err != nil {
+					return true, 0, err
+				}
+			}
+			if _, err := s.r.U32(); err != nil { // default label
+				return true, 0, err
+			}
+		case 0x02, 0x03, 0x04: // block, loop, if
+			s.h.flags.set(hintHasControlFlow)
+			s.entryPrefix = false
+			if op == 0x03 {
+				s.h.flags.set(hintHasLoop)
+			}
+			s.h.noteControlDepth(depth + 1)
+			if err := wasm.SkipInstructionImmediate(&s.r.Reader, op); err != nil {
+				return true, 0, err
+			}
+			switch op {
+			case 0x02: // block
+				calls, term, err := s.scanExpr(depth+1, loopDepth, curLoop, false)
+				if err != nil {
+					return true, 0, err
+				}
+				if term != 0x0b {
+					return true, term, s.r.err(wasm.ErrInvalidInstruction, s.r.off()-1)
+				}
+				subHasCall = subHasCall || calls
+			case 0x03: // loop
+				loop := s.elig.push()
+				calls, term, err := s.scanExpr(depth+1, loopDepth+1, loop, false)
+				if err != nil {
+					return true, 0, err
+				}
+				if term != 0x0b {
+					return true, term, s.r.err(wasm.ErrInvalidInstruction, s.r.off()-1)
+				}
+				if calls {
+					subHasCall = true
+				} else {
+					for _, g := range s.elig.globalsIn(loop) {
+						markGlobalEligible(s.globalHints, g)
+					}
+				}
+				s.elig.pop(loop)
+			case 0x04: // if
+				callsThen, term, err := s.scanExpr(depth+1, loopDepth, curLoop, true)
+				if err != nil {
+					return true, 0, err
+				}
+				callsElse := false
+				if term == 0x05 {
+					callsElse, term, err = s.scanExpr(depth+1, loopDepth, curLoop, false)
+					if err != nil {
+						return true, 0, err
+					}
+				}
+				if term != 0x0b {
+					return true, term, s.r.err(wasm.ErrInvalidInstruction, s.r.off()-1)
+				}
+				subHasCall = subHasCall || callsThen || callsElse
+			}
+		case 0x10, 0x12: // call, return_call
+			idx, err := s.r.U32()
+			if err != nil {
+				return true, 0, err
+			}
+			s.h.flags.set(hintHasCall)
+			subHasCall = true
+			if op == 0x12 {
+				s.h.flags.set(hintHasTailCall)
+			}
+			if op == 0x10 && idx == s.selfIdx {
+				s.h.flags.set(hintCallsSelf)
+			}
+			if tape := s.h.inlineCaller; tape != nil {
+				if op == 0x10 {
+					tape.record(idx)
+				} else {
+					tape.blocked = true
+				}
+			}
+			s.noteDirectCallRef(idx, op == 0x10)
+		case 0x11, 0x13: // indirect calls
+			if tape := s.h.inlineCaller; tape != nil {
+				tape.blocked = true
+			}
+			var imm wasm.InstructionImmediate
+			err := s.classifyInstructionInto(op, &imm)
+			if err != nil {
+				return true, 0, err
+			}
+			s.h.flags.set(hintHasCall)
+			s.h.markNonDirectCall()
+			if op == 0x14 || op == 0x15 {
+				s.h.markUnsupportedDynamicCall()
+			}
+			subHasCall = true
+			if op == 0x13 || op == 0x15 {
+				s.h.flags.set(hintHasTailCall)
+			}
+		case 0x14, 0x15: // call_ref, return_call_ref
+			if tape := s.h.inlineCaller; tape != nil {
+				tape.blocked = true
+			}
+			if _, err := s.r.U32(); err != nil {
+				return true, 0, err
+			}
+			s.h.flags.set(hintHasCall)
+			subHasCall = true
+			if op == 0x15 {
+				s.h.flags.set(hintHasTailCall)
+			}
+		case 0x20, 0x21, 0x22: // local.get/set/tee
+			idx, err := s.r.U32()
+			if err != nil {
+				return true, 0, err
+			}
+			if int(idx) < s.nLocals {
+				kind := shared.LocalEventDefine
+				if op == 0x20 {
+					kind = shared.LocalEventRead
+				}
+				s.h.noteLocalEvent(kind, idx, depth)
+				if s.entryPrefix && idx < 64 {
+					bit := uint64(1) << idx
+					if s.entrySeen&bit == 0 {
+						s.entrySeen |= bit
+						if op != 0x20 {
+							s.h.markEntryInitialized(idx)
+						}
+					}
+				}
+				if op == 0x20 {
+					addHotness(s.h.localScore, idx, weight)
+					if int(idx) < len(s.h.localLastGet) {
+						s.h.localLastGet[idx] = uint32(s.r.off())
+					}
+				} else {
+					addHotness(s.h.localScore, idx, 2*weight)
+				}
+			}
+		case 0x23, 0x24: // global.get/set
+			idx, err := s.r.U32()
+			if err != nil {
+				return true, 0, err
+			}
+			if int(idx) < s.nGlobals {
+				if op == 0x24 {
+					addGlobalHotness(s.globalHints, idx, 2*weight)
+				} else {
+					addGlobalHotness(s.globalHints, idx, weight)
+				}
+				s.elig.add(curLoop, idx)
+			}
+		case 0x41, 0x42: // i32.const, i64.const
+			var bits int64
+			var typ uint8
+			if op == 0x41 {
+				v, err := s.r.Reader.I32()
+				if err != nil {
+					return true, 0, err
+				}
+				bits, typ = int64(v), 1
+				prevI32 = v
+			} else {
+				v, err := s.r.Reader.I64()
+				if err != nil {
+					return true, 0, err
+				}
+				bits, typ = v, 2
+			}
+			if s.collectLoopIntConsts && loopDepth != 0 {
+				if next, ok := s.r.Reader.Peek(); ok && amd64LoopIntConstNeedsRegister(next, bits, typ) {
+					s.noteLoopIntConst(bits, loopDepth)
+				}
+			}
+		case 0x43: // f32.const
+			s.h.flags.set(hintHasFloatConst)
+			if _, err := s.r.Bytes(4); err != nil {
+				return true, 0, err
+			}
+		case 0x44: // f64.const
+			s.h.flags.set(hintHasFloatConst)
+			if _, err := s.r.Bytes(8); err != nil {
+				return true, 0, err
+			}
+		case 0x0c, 0x0d: // br, br_if
+			s.h.flags.set(hintHasControlFlow)
+			s.entryPrefix = false
+			if _, err := s.r.U32(); err != nil {
+				return true, 0, err
+			}
+		case 0x00, 0x0f: // unreachable, return
+			s.h.flags.set(hintHasControlFlow)
+			s.entryPrefix = false
+		case 0x25, 0x26: // table.get/set
+			if _, err := s.r.U32(); err != nil {
+				return true, 0, err
+			}
+			if op == 0x26 {
+				s.h.flags.set(hintMutatesTable)
+			}
+		case 0xd2, 0xd5, 0xd6: // ref.func, br_on_null, br_on_non_null
+			if _, err := s.r.U32(); err != nil {
+				return true, 0, err
+			}
+			if op != 0xd2 {
+				s.h.flags.set(hintHasControlFlow)
+				s.entryPrefix = false
+			}
+		case 0x28, 0x29, 0x2a, 0x2b, 0x2c, 0x2d, 0x2e, 0x2f, 0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39, 0x3a, 0x3b, 0x3c, 0x3d, 0x3e:
+			// Ordinary scalar accesses cannot call, collect, mutate tables or create
+			// GC resolver sites. Consume just their memarg instead of constructing
+			// the full proposal classifier payload and rechecking those properties.
+			var err error
+			if s.m != nil {
+				err = s.classifier.SkipScalarMemoryImmediate(&s.r.Reader)
+			} else {
+				err = s.classifyUnboundHintMemory(op)
+			}
+			if err != nil {
+				return true, 0, err
+			}
+			s.h.flags.set(hintTouchesMemory)
+		case 0x3f, 0x40, 0xfc, 0xfd, 0xfe, 0xfb:
+			calls, err := s.scanExtendedHint(op, depth, prevOp, prevI32)
+			if err != nil {
+				return true, 0, err
+			}
+			subHasCall = subHasCall || calls
+		case 0x1f: // try_table: blocktype, catch vector, body
+			s.h.flags.set(hintHasControlFlow)
+			s.entryPrefix = false
+			s.h.flags.set(hintModuleEH)
+			s.h.noteControlDepth(depth + 1)
+			if err := wasm.SkipInstructionImmediate(&s.r.Reader, op); err != nil {
+				return true, 0, err
+			}
+			calls, term, err := s.scanExpr(depth+1, loopDepth, curLoop, false)
+			if err != nil {
+				return true, 0, err
+			}
+			if term != 0x0b {
+				return true, term, s.r.err(wasm.ErrInvalidInstruction, s.r.off()-1)
+			}
+			subHasCall = subHasCall || calls
+		case 0x08: // throw
+			s.h.flags.set(hintModuleEH)
+			if _, err := s.r.U32(); err != nil {
+				return true, 0, err
+			}
+		case 0x0a: // throw_ref
+			s.h.flags.set(hintModuleEH)
+		default:
+			if _, ok := wasm.ImmediateFreeInstructionKind(op); ok {
+				if count := s.h.immediateFreeOpCount(); count < defaultStackArenaCap {
+					s.h.immediateFreeOps = s.h.immediateFreeOps&fixedScratchLeaseMask | count + 1
+				}
+				break
+			}
+			if err := s.scanFallbackHint(op); err != nil {
+				return true, 0, err
+			}
+		}
+		if variableShiftOpcode(op) && prevOp != 0x41 && prevOp != 0x42 {
+			if variableShiftDepth < maxDeferDepth {
+				variableShiftDepth++
+			}
+			if variableShiftDepth >= maxDeferDepth {
+				s.h.noteDeepVariableShift()
+			}
+		} else if op != 0x20 { // local.get may supply the next variable shift count.
+			variableShiftDepth = 0
+		}
+		prevOp = op
+	}
+}
+
+// Proposal payloads are cold for ordinary scalar functions. Keep them out of
+// every recursive scanExpr frame while preserving the same classifier and hints.
+//
+//go:noinline
+func (s *byteBodyScanner) scanExtendedHint(op byte, depth int, prevOp byte, prevI32 int32) (bool, error) {
+	calls := false
+	var imm wasm.InstructionImmediate
+	err := s.classifyInstructionInto(op, &imm)
+	if err != nil {
+		return false, err
+	}
+	if op == 0xfd {
+		s.h.flags.set(hintHasSIMD)
+	}
+	if imm.Kind == wasm.InstrI64MulWideS || imm.Kind == wasm.InstrI64MulWideU {
+		s.h.noteFixedScratchLease()
+		s.h.noteBoundaryEvent(shared.LocalEventFixedReg, depth)
+	}
+	if shared.InstructionNeedsInlineBoundary(op, imm.Kind) {
+		s.h.flags.set(hintHasControlFlow)
+	}
+	if shared.InstructionNeedsEHFrame(op, imm.Kind) {
+		s.h.flags.set(hintModuleEH)
+	}
+	if gcOrAtomicInstructionMayCall(imm.Kind, s.gcStructHelpers) || shared.SharedMemoryGrowMayCall(s.m, imm.Kind, imm.Index) {
+		s.h.noteBoundaryEvent(shared.LocalEventCollection, depth)
+		s.h.flags.set(hintHasCall)
+		s.h.markUnsupportedDynamicCall()
+		calls = true
+	}
+	if op == 0xfb {
+		switch imm.Kind {
+		case wasm.InstrArrayFill:
+			if prevOp == 0x41 && directGCArrayFillResolver(s.m, s.gcTypeLayouts, imm.Index, prevI32) {
+				s.h.addGCResolverSite()
+			}
+		case wasm.InstrStructGet, wasm.InstrStructGetS, wasm.InstrStructGetU, wasm.InstrStructSet,
+			wasm.InstrArrayGet, wasm.InstrArrayGetS, wasm.InstrArrayGetU, wasm.InstrArraySet, wasm.InstrArrayLen:
+			if directGCResolverInstruction(s.m, s.gcTypeLayouts, imm.Kind, imm.Index, imm.Index2) {
+				s.h.addGCResolverSite()
+			}
+		}
+	}
+	if imm.TouchesMemory {
+		s.h.flags.set(hintTouchesMemory)
+	}
+	if imm.UsesBulkMemory || imm.Kind == wasm.InstrMemoryInit {
+		s.h.noteBoundaryEvent(shared.LocalEventInvalidate, depth)
+		s.h.flags.set(hintUsesBulkMem)
+	}
+	return calls, nil
+}
+
+func (s *byteBodyScanner) classifyInstructionInto(op byte, imm *wasm.InstructionImmediate) error {
+	var err error
+	if s.m != nil {
+		err = s.classifier.ClassifyInto(&s.r.Reader, op, imm)
+	} else {
+		err = wasm.ClassifyInstructionImmediateIntoWithFeatures(&s.r.Reader, op, imm, s.memory64, true)
+	}
+	if err == nil && isTableMutation(imm.Kind) {
+		s.h.flags.set(hintMutatesTable)
+	}
+	return err
+}
+
+func (f *fn) deferIfPrefix(reader *wasm.Reader, fr *ctrlFrame) {
+	if !ifPrefixRematEnabled || fr.paramN != 0 || fr.resultN != 1 || fr.res0 != mtI32 ||
+		f.depth() != 2 || f.moduleEH || f.gcFrameRoots != nil || f.interruptible || len(f.customInstructions) != 0 {
+		return
+	}
+	root := baseOfValentBlock(f.s.back()).prev
+	if root == f.s.head {
+		return
+	}
+	local := ifPrefixLocal(root)
+	if local == nil || !f.ifPrefixUnchanged(reader, local.st.index()) {
+		return
+	}
+	// Removing the sole prefix leaves a zero-height frame: its cold type-prefix
+	// pointer is unused and can retain this existing arena-owned recipe. Its
+	// original profiling identity and child links remain intact. AMD64 stack
+	// nodes are not recycled during the function.
+	if root.isDeferred() {
+		f.consumeBlockBelow(root)
+	}
+	f.erase(root)
+	f.ensureCtrlMerge(fr).baseTypeTop = root
+	fr.set(ctrlIfDeferredPrefix, true)
+	f.stats.peep("if-prefix-remat")
+}
+
+// buildInlineTargets returns the straight-line leaf inline candidates keyed by
+// GLOBAL function index, or an empty table when inlining is disabled. Candidacy
+// here is a property of the callee alone (the call-site count only mattered for the report),
+// so a call to one of these can be spliced wherever it appears.
+// buildInlineTargets derives the splice set from the per-function hints already
+// gathered by computeModuleHints — no second body walk. inlineFacts is
+// reconstructed from the hints (any call ⇒ not a leaf ⇒ ineligible, so hasCall
+// stands in for both calleeCount>0 and hasControlCall), plus the signature.
+func buildInlineTargets(m *wasm.Module, allHints []funcHints, policy CodegenPolicy, tailLoops ...bool) inlineTargetTable {
+	allowTail := len(tailLoops) > 0 && tailLoops[0]
+	if !policy.EnabledOption(optInline) {
+		return inlineTargetTable{}
+	}
+	hasCall := false
+	for i := range allHints {
+		if allHints[i].flags.has(hintHasCall) {
+			hasCall = true
+			break
+		}
+	}
+	if !hasCall {
+		return inlineTargetTable{}
+	}
+	importedFuncs := m.ImportedFuncCount()
+	if uint64(len(m.Code)) > uint64(^uint32(0)) {
+		return inlineTargetTable{}
+	}
+	candidateCount, typeCount := 0, 0
+	for i := range m.Code {
+		ft, _, ok := inlineTargetFacts(m, allHints, i, policy, allowTail)
+		if !ok {
+			continue
+		}
+		candidateCount++
+		add := int(allHints[i].localCount) + len(ft.Results)
+		if add < 0 || typeCount > int(^uint32(0))-add {
+			// Inlining is optional. Fall back to direct calls instead of retaining a
+			// sidecar whose compact 32-bit ranges cannot represent this module.
+			return inlineTargetTable{}
+		}
+		typeCount += add
+	}
+	if candidateCount == 0 || candidateCount >= int(inlineTargetInvalid) {
+		return inlineTargetTable{}
+	}
+	data := &inlineTargetData{
+		slots:   make([]uint32, len(m.Code)),
+		targets: make([]inlineTarget, 0, candidateCount),
+		types:   make([]machineType, 0, typeCount),
+	}
+	targets := inlineTargetTable{first: importedFuncs, data: data, classifier: wasm.NewModuleInstructionClassifier(m, true)}
+	for i := range m.Code {
+		ft, facts, ok := inlineTargetFacts(m, allHints, i, policy, allowTail)
+		if !ok {
+			continue
+		}
+		h := allHints[i]
+		localStart := len(data.types)
+		for _, p := range ft.Params {
+			data.types = append(data.types, mtOf(p))
+		}
+		for _, run := range m.Code[i].Locals.Runs {
+			for k := 0; k < int(run.Count); k++ {
+				data.types = append(data.types, mtOf(run.Type))
+			}
+		}
+		localEnd := len(data.types)
+		for _, result := range ft.Results {
+			data.types = append(data.types, mtOf(result))
+		}
+		resultEnd := len(data.types)
+		res0 := mtNone
+		if len(ft.Results) > 0 {
+			res0 = data.types[localEnd]
+		}
+		addConst, addImmediate := inlineI32AddConst(m.Code[i].BodyBytes, ft)
+		localDeclBytes := m.Code[i].LocalDeclBytes
+		params := uint32(facts.params)
+		if facts.inlineTupleLoop(policy) {
+			params |= inlineTupleLoopFlag
+		}
+		if !policy.CompactNative && !profileEnabled && policy.EnabledOption(optTupleIfSelect) && facts.declaredLocals == 0 &&
+			facts.params <= 4 && integerTupleSelectTarget(m, m.Code[i], ft) {
+			params |= inlineTupleSelectFlag
+		}
+		if allowTail && tailLoopInlineCandidate(m, allHints, i, policy) {
+			params |= inlineTailLoopFlag
+			params |= uint32(tailInlineZeroMask(m.Code[i].BodyBytes, facts.params, int(h.localCount), targets.classifier)) << inlineTailZeroShift
+			facts.hasControlFlow = true
+		}
+		if addConst {
+			params |= inlineI32AddConstFlag
+			localDeclBytes = uint32(addImmediate)
+		} else if facts.declaredLocals == 0 && inlineI32AddParams(m.Code[i].BodyBytes, ft) {
+			params |= inlineI32AddParamsFlag
+		}
+		if recursiveInlineCandidate(m, allHints, i, facts, policy) {
+			params |= inlineRecursiveFlag
+		}
+		data.targets = append(data.targets, inlineTarget{
+			body:           m.Code[i].BodyBytes,
+			globalIdx:      importedFuncs + i,
+			localDeclBytes: localDeclBytes,
+			typeStart:      uint32(localStart),
+			localTypeEnd:   uint32(localEnd),
+			resultTypeEnd:  uint32(resultEnd),
+			params:         params,
+			res0:           res0,
+			touchesMem:     facts.touchesMem,
+			hasCtrl:        facts.hasControlFlow,
+			omitStandalone: policy.CompactNative &&
+				h.inlineCallSites == 1,
+		})
+		data.slots[i] = uint32(len(data.targets))
+	}
+	if policy.CompactNative {
+		pruneNestedSizeInlineTargets(m, &targets)
+	}
+	return targets
+}
+
+func inlineTargetFacts(m *wasm.Module, allHints []funcHints, i int, policy CodegenPolicy, tailLoops ...bool) (*wasm.CompType, inlineFacts, bool) {
+	body := m.Code[i].BodyBytes
+	if len(body) == 0 {
+		return nil, inlineFacts{}, false
+	}
+	ft, ok := m.LocalFuncType(i)
+	if !ok || ft == nil {
+		return nil, inlineFacts{}, false
+	}
+	h := allHints[i]
+	if h.flags.has(hintModuleEH) {
+		return nil, inlineFacts{}, false
+	}
+	facts := inlineFacts{
+		bodyBytes:      len(body),
+		hasLoop:        h.flags.has(hintHasLoop),
+		hasControlFlow: h.flags.has(hintHasControlFlow),
+		touchesMem:     h.flags.has(hintTouchesMemory | hintUsesBulkMem),
+		params:         len(ft.Params),
+		results:        len(ft.Results),
+		declaredLocals: int(h.localCount) - len(ft.Params),
+		callSites:      int(h.inlineCallSiteCount()),
+		regABIIntOnly:  sigFitsRegABI(ft) && sigIsIntOnly(ft),
+	}
+	if h.flags.has(hintHasCall) {
+		facts.calleeCount = 1
+	}
+	facts.boundedTupleLoop = boundedIntegerTupleLoopBody(m.Code[i], facts, wasm.NewModuleInstructionClassifier(m, true))
+	return ft, facts, inlineOK(facts, policy) || recursiveInlineCandidate(m, allHints, i, facts, policy) || len(tailLoops) > 0 && tailLoops[0] && tailLoopInlineCandidate(m, allHints, i, policy)
+}
+
+// buildInlineCallerPlan finds the distinct splice targets and determines
+// whether they replace every call in one body walk. Common immediate-free
+// instructions bypass the module classifier because neither result depends on
+// their decoded kind.
+func buildInlineCallerPlan(caller *wasm.Func, targets inlineTargetTable) inlineCallerPlan {
+	if targets.empty() || len(caller.BodyBytes) == 0 {
+		return inlineCallerPlan{}
+	}
+	var plan inlineCallerPlan
+	var accumulate inlineCallerAccumulator
+	r := wasm.NewReader(caller.BodyBytes)
+	var imm wasm.InstructionImmediate
+	sawCall := false
+	allInline := true
+	for r.HasNext() {
+		op, err := r.Byte()
+		if err != nil {
+			return plan
+		}
+		if _, ok := wasm.ImmediateFreeInstructionKind(op); ok {
+			continue
+		}
+		if op == 0x10 { // call
+			idx, err := r.U32()
+			if err != nil {
+				return plan
+			}
+			sawCall = true
+			if !accumulate.add(&plan, targets.target(int(idx))) {
+				allInline = false
+			}
+			continue
+		}
+		switch op {
+		case 0x05, 0x0b: // else, end
+			continue
+		case 0x12, 0x14, 0x15: // return_call, call_ref, return_call_ref
+			if _, err := r.U32(); err != nil {
+				return plan
+			}
+			sawCall = true
+			allInline = false
+			continue
+		case 0x08, 0x0c, 0x0d, 0x20, 0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0xd2, 0xd5, 0xd6:
+			if _, err := r.U32(); err != nil {
+				return plan
+			}
+			continue
+		case 0x41:
+			if _, err := r.I32(); err != nil {
+				return plan
+			}
+			continue
+		case 0x42:
+			if _, err := r.I64(); err != nil {
+				return plan
+			}
+			continue
+		case 0x43:
+			if _, err := r.Bytes(4); err != nil {
+				return plan
+			}
+			continue
+		case 0x44:
+			if _, err := r.Bytes(8); err != nil {
+				return plan
+			}
+			continue
+		}
+		if err := targets.classifier.ClassifyInto(r, op, &imm); err != nil {
+			return plan
+		}
+		switch imm.Kind {
+		case wasm.InstrReturnCall, wasm.InstrCallIndirect, wasm.InstrReturnCallIndirect,
+			wasm.InstrCallRef, wasm.InstrReturnCallRef:
+			sawCall = true
+			allInline = false
+		}
+	}
+	plan.allCallsInline = sawCall && allInline
+	return plan
+}
+
+// inlineCall splices target t's body at the current call site: it binds the p
+// argument operands into the callee's param locals, zeroes the callee's declared
+// locals, runs the body with localBase set (remapping the callee's locals onto
+// the reserved region), then decouples the results from the reserved slots so a
+// later splice of the same callee cannot alias them. A straight-line callee runs
+// on the cheap frameless path; a control-flow callee runs under a synthetic
+// boundary frame (inlineBodyCtrl).
+func (f *fn) inlineCall(t *inlineTarget, caller *wasm.Reader) error {
+	stores := tupleStoreHint{locals: [2]int{-1, -1}}
+	if t.tupleSelect() {
+		stores = f.inlineTupleStoreLocals(caller)
+	}
+	f.stats.call(callKindInline)
+	start := f.a.Len()
+	if t.isI32AddParams() {
+		right := f.s.back()
+		left := baseOfValentBlock(right).prev
+		if right.isValue() && right.st.kind == stConst || left.isValue() && left.st.kind == stConst {
+			if !treeReorderSafe(left) || !treeReorderSafe(right) {
+				f.materializeTrapsBefore(f.s.head)
+			}
+			if profileEnabled && f.stats != nil && f.stats.RecordSources {
+				previous := f.enterProfileInlineAdd(t)
+				defer f.leaveProfileInlineAdd(previous)
+			}
+			f.pushBinOp(opAdd, mtI32)
+			f.stats.peep("inline-i32-add-argument")
+			f.stats.addInlineSiteBytes(f.a.Len() - start)
+			return nil
+		}
+	}
+	if t.isI32AddConst() {
+		if !treeReorderSafe(f.s.back()) {
+			f.materializeTrapsBefore(f.s.head)
+		}
+		if profileEnabled && f.stats != nil && f.stats.RecordSources {
+			previous := f.enterProfileInlineAdd(t)
+			defer f.leaveProfileInlineAdd(previous)
+		}
+		f.pushValue(storage{kind: stConst, typ: mtI32, cval: int64(t.i32AddImmediate())})
+		f.pushBinOp(opAdd, mtI32)
+		f.stats.peep("inline-i32-add-const")
+		f.stats.addInlineSiteBytes(f.a.Len() - start)
+		return nil
+	}
+	// Parameter binding pops arguments before the live prefix. The add-constant
+	// fast path above only needs the walk when its argument can trap.
+	f.materializeTrapsBefore(f.s.head)
+	base := f.inlineBase[t.globalIdx]
+	constants := f.captureInlineTailConstants(t, base)
+	previousForward, previousForwardN := f.inlineForward, f.inlineForwardN
+	if !f.forwardIntegerParams(t) {
+		f.bindInlineParams(t, base)
+	}
+	var prefix [8]storage
+	prefixCount := f.detachInlineTailPrefix(t, base, &prefix)
+
+	old := f.localBase
+	oldTraceFunc, oldTraceBase, oldPC := f.traceFuncIdx, f.tracePCBase, f.wasmPC
+	if profileEnabled && f.stats != nil && f.stats.RecordSources {
+		previous := f.enterProfileInline()
+		defer f.leaveProfileInline(previous)
+	}
+	f.localBase = base
+	f.traceFuncIdx, f.tracePCBase = uint32(t.globalIdx), t.localDeclBytes
+	oldInlineDepth := f.inlineDepth
+	oldLoopAlign32 := f.compactLoopAlign32
+	if t.tupleLoop() && f.opt(optCompactLoopAlign32) {
+		// The small callee keeps its loop fetch alignment when its caller is
+		// too large for whole-function compact alignment.
+		f.compactLoopAlign32 = true
+	}
+	f.inlineDepth++
+	var err error
+	storesConsumed := false
+	if t.tupleSelect() {
+		storesConsumed, err = f.inlineTupleSelectBody(t, stores)
+	} else if t.hasCtrl {
+		err = f.inlineBodyCtrl(t, constants)
+	} else {
+		err = f.inlineBody(t.body)
+	}
+	f.inlineForward, f.inlineForwardN = previousForward, previousForwardN
+	f.localBase = old
+	f.inlineDepth = oldInlineDepth
+	f.compactLoopAlign32 = oldLoopAlign32
+	f.traceFuncIdx, f.tracePCBase, f.wasmPC = oldTraceFunc, oldTraceBase, oldPC
+	if err != nil {
+		return err
+	}
+
+	// The callee's results sit on the operand stack; a bare `local.get` result is a
+	// lazy stLocalRef into a reserved slot, and a deferred result may read one. A
+	// later splice of the same callee rebinds those slots, so realize any operand
+	// still referencing the reserved region into a register/value now. (The control-
+	// flow path already merged results into canonical slots, so this is a no-op there.)
+	nLocals := int(t.localTypeEnd - t.typeStart)
+	f.realizeInlineRange(base, base+nLocals)
+	if prefixCount != 0 {
+		f.restoreInlineTailPrefix(t, prefix[:prefixCount])
+	}
+	if storesConsumed {
+		if err := caller.JumpTo(stores.end); err != nil {
+			return err
+		}
+	}
+	f.stats.addInlineSiteBytes(f.a.Len() - start)
+	return nil
+}
+
+// bindInlineParams binds the p argument operands into the callee's param locals
+// and zero-initializes its declared locals (wasm zero-init, re-done each splice
+// so a call in a loop or a second site always starts from zero). Each declared
+// local is cleared across its full slot width (a v128 local clears both halves).
+func (f *fn) bindInlineParams(t *inlineTarget, base int) {
+	nLocals := int(t.localTypeEnd - t.typeStart)
+	params := t.paramCount()
+	localTypes := f.inlineTargets.localTypes(t)
+	// The p args are the top operands (deepest = param 0). Pop each into its param
+	// local. setLocal takes the absolute index (localBase is still 0 here).
+	for i := params - 1; i >= 0; i-- {
+		f.setLocal(nil, base+i, false)
+	}
+	if t.tailLoop() {
+		f.zeroTailInlineLocals(t, base)
+		return
+	}
+	if nLocals > params {
+		var initialized, loopInitialized uint64
+		if !profileEnabled && !f.moduleEH && f.gcFrameRoots == nil && len(f.customInstructions) == 0 &&
+			len(f.intervalLast) == 0 && !f.intervalControl && !f.pinRelinquished {
+			initialized = inlineEntryConstantLocals(t.body, params, localTypes)
+			if t.tupleLoop() {
+				loopInitialized = inlineLoopEntryInitializedLocals(f.m, t.body, params, localTypes) &^ initialized
+				initialized |= loopInitialized
+			}
+		}
+		z := regNone
+		for i := params; i < nLocals; i++ {
+			local := base + i
+			if i < 64 && initialized&(uint64(1)<<i) != 0 {
+				f.realizeLocalRefs(local, nil)
+				if _, floating, pinned := f.pinReg(local); pinned && !floating {
+					// The first source write replaces this dead home before any get.
+					// Do not rematerialize an older lazy zero over that new value.
+					f.locals[local].state = lsReg
+				} else {
+					f.locals[local].state = lsMem
+				}
+				f.invalidateGCLoadFactsForLocal(local)
+				if loopInitialized&(uint64(1)<<i) != 0 {
+					f.stats.peep("inline-loop-entry-init")
+				} else {
+					f.stats.peep("inline-entry-constant-init")
+				}
+				continue
+			}
+			if reg, floating, pinned := f.pinReg(local); pinned && !floating {
+				f.realizeLocalRefs(local, nil)
+				f.a.XorSelf32(reg)
+				f.locals[local].state = lsReg
+				f.invalidateGCLoadFactsForLocal(local)
+				continue
+			}
+			if z == regNone {
+				z = f.allocReg(0)
+				f.a.XorSelf32(z)
+			}
+			for s := 0; s < localTypes[i].stackSlots(); s++ {
+				f.a.Store64(RSP, f.localAddr(local)+int32(8*s), z)
+			}
+			f.locals[local].state = lsMem
+			f.invalidateGCLoadFactsForLocal(local)
+		}
+		if z != regNone {
+			f.release(z)
+		}
+	}
+}
+
+// inlineBodyCtrl splices a control-flow callee: it pushes a synthetic block frame
+// standing in for the callee's function boundary (0 params — the args were bound
+// to locals — with the callee's result types), runs the body through the normal
+// opcode driver until that frame's terminating `end` pops it, and routes the
+// callee's `return` to that frame. The callee's own blocks/loops/ifs and its
+// result merge are lowered by the existing control-flow machinery.
+func (f *fn) inlineBodyCtrl(t *inlineTarget, constants *inlineTailConstants) error {
+	previousCompare := f.inlineTailCompare
+	f.inlineTailCompare = inlineTailCompare{active: t.tailLoop(), lastCompare: -1, reuseResume: -1}
+	defer func() {
+		f.inlineTailCompare = previousCompare
+		f.inlineTailCompare.reuseResume = -1
+	}()
+	minCtrl := len(f.ctrl)
+	resultTypes := f.inlineTargets.resultTypes(t)
+	rN := len(resultTypes)
+	fr := ctrlFrame{
+		kind:        cfBlock,
+		resultN:     rN,
+		branchN:     uint32(rN),
+		types:       resultTypes,
+		res0:        t.res0,
+		controlSite: -1,
+		height:      f.depth(),
+	}
+	fr.set(ctrlRegMerge1, f.regMerge && rN == 1 && t.res0 != mtNone && t.res0 != mtV128)
+	f.setFrameBaseTypePrefix(&fr, fr.height)
+	f.captureGCFrameShape(&fr)
+	if f.inlineTupleLoopFallthrough(t) {
+		fr.set(ctrlRegMerge1, false)
+		fr.set(ctrlInlineFallthrough, true)
+	} else {
+		f.flush()
+	}
+	f.pushCtrl(&fr)
+
+	prevRet := f.inlineRetFrame
+	f.inlineRetFrame = len(f.ctrl) - 1
+	oldTail := f.inlineTailLoopFrame
+	oldArgumentStart := f.inlineTailArgumentStart
+	f.inlineTailArgumentStart = -1
+	oldRoot, oldPartner, oldCopyBytes := f.inlineTailRoot, f.inlineTailPartner, f.inlineTailCopyBytes
+
+	oldBytes, oldDepth, oldSource := f.inlineTailExpandBytes, f.inlineTailExpandDepth, f.inlineTailSourceFrame
+	f.inlineTailExpandBytes, f.inlineTailExpandDepth, f.inlineTailSourceFrame = 0, 0, 0
+
+	limit := minCtrl
+	if t.tailLoop() {
+		f.configureInlineTailCycle(t)
+		typ := byte(0x40)
+		if t.res0 == mtI32 {
+			typ = 0x7f
+		}
+		if t.res0 == mtI64 {
+			typ = 0x7e
+		}
+		if err := f.opBlock(wasm.NewReader([]byte{typ}), 0x03); err != nil {
+			return err
+		}
+		// Only compiler-generated backedges enter this loop, and they carry no
+		// results. Its sole exit can retain the enclosing boundary's result home.
+		loop := &f.ctrl[len(f.ctrl)-1]
+		loop.set(ctrlRegMerge1, f.ctrl[f.inlineRetFrame].has(ctrlRegMerge1))
+		if loop.has(ctrlRegMerge1) {
+			f.stats.peep("inline-tail-result-register")
+		}
+		f.inlineTailLoopFrame = len(f.ctrl)
+		if constants != nil {
+			loop.controlSite = -2
+			constants.entry = &inlineTailPeelEntry{}
+			f.inlineTailExpandBytes = inlineTailExpansionBytes
+			if _, err := f.tryExpandInlineTail(t, constants); err != nil {
+				return err
+			}
+			loop = &f.ctrl[f.inlineTailLoopFrame-1]
+			f.setDepthTypesWithGCRoots(f.frameBaseTypes(loop), f.frameBaseGCRoots(loop))
+			f.setLocalsState(f.frameBranchState(loop))
+			f.unreachable = false
+			if f.compactLoopAlign32 {
+				f.a.AlignLoop64()
+			} else {
+				f.a.AlignLoop()
+			}
+			loop.controlSite = f.a.Len()
+			for _, site := range constants.entry.sites {
+				f.a.PatchRel32(site, loop.controlSite)
+			}
+			f.inlineTailExpandBytes = 0
+			f.stats.peep("inline-tail-entry-peel")
+		}
+		limit++
+		f.hasLoop = true
+		if f.sc != nil {
+			f.sc.directPreparedBounded = false
+		}
+	}
+	err := f.bodyLoop(wasm.NewReader(t.body), limit)
+	if err == nil && t.tailLoop() {
+		err = f.opEnd()
+	}
+	f.inlineTailLoopFrame = oldTail
+	f.inlineTailArgumentStart = oldArgumentStart
+	f.inlineTailRoot, f.inlineTailPartner, f.inlineTailCopyBytes = oldRoot, oldPartner, oldCopyBytes
+
+	f.inlineTailExpandBytes, f.inlineTailExpandDepth, f.inlineTailSourceFrame = oldBytes, oldDepth, oldSource
+
+	f.inlineRetFrame = prevRet
+	return err
+}
+
+// inlineBody runs a straight-line callee body's opcodes on the current operand
+// stack (with localBase already set), stopping at the terminating `end`. The
+// callee is a leaf with no control flow, so every opcode is a plain (non-control)
+// op that emitPlain lowers; results are left on the operand stack.
+func (f *fn) inlineBody(body []byte) error {
+	r := wasm.NewReader(body)
+	for {
+		f.wasmPC = f.tracePCBase + uint32(r.Offset())
+		op, err := r.Byte()
+		if err != nil {
+			return err
+		}
+		switch op {
+		case 0x0b: // terminating end: results are on the stack
+			return nil
+		case 0x01: // nop — the driver's body() handles this outside emitPlain
+			continue
+		}
+		var previous profileOrigin
+		if profileEnabled && f.stats != nil && f.stats.RecordSources {
+			previous = f.enterProfileInstruction()
+		}
+		err = f.emitPlain(r, op)
+		if profileEnabled && f.stats != nil && f.stats.RecordSources {
+			f.switchProfileOrigin(previous)
+		}
+		if err != nil {
+			return err
+		}
+	}
+}
+
+func (p *integerMapPlan) guardPlan(facts *[integerMapMaxNodes + 1]integerMapAffine, ind integerMapInduction, used *[integerMapMaxNodes + 1]bool) (integerMapGuards, bool) {
+	// A post-test != latch with a positive power-of-two update admits a cheap
+	// exact trip-count check. Other predicates remain candidates for later plans.
+	if ind.predicate != 0x47 || ind.step == 0 || ind.step >= 1<<31 || ind.step&(ind.step-1) != 0 {
+		return integerMapGuards{}, false
+	}
+	if int(ind.local) >= int(p.localN) || int(ind.limit) > int(p.nodeN) || !facts[ind.limit].valid {
+		return integerMapGuards{}, false
+	}
+	memory, ok := p.memoryPlan(facts, ind, used)
+	if !ok {
+		return integerMapGuards{}, false
+	}
+	g := integerMapGuards{localN: p.localN, counter: ind.local, lanes: 4, step: ind.step, limit: facts[ind.limit], memory: memory}
+	// An invariant load may overlap a destination somewhere in the loop.
+	// Check that relationship per packet instead of rejecting the whole loop;
+	// overlapping packets execute one source iteration in order.
+	g.memory.pairN = 0
+	for _, pair := range memory.pairs[:memory.pairN] {
+		a, b := memory.streams[pair.a], memory.streams[pair.b]
+		if a.write && b.read && !b.write && b.stride == 0 {
+			g.packetPairs[g.packetN] = pair
+			g.packetN++
+		} else {
+			g.memory.pairs[g.memory.pairN] = pair
+			g.memory.pairN++
+		}
+	}
+	if integerMapPackEnabled {
+		g.selectAdjacentStores(p)
+	}
+	return g, true
+}
+
+// A cheap, bounded admission screen keeps the candidate workspace and detailed
+// analysis away from ordinary loops. All failed screens consume the same budget.
+func (f *fn) integerMapScreen(source wasm.Reader) bool {
+	if f.integerMapWork >= integerMapFunctionWorkLimit-integerMapMaxNodes {
+		return false
+	}
+	bt, err := source.Byte()
+	if err != nil || bt != 0x40 {
+		return false
+	}
+	for i := 0; i < 24; i++ {
+		f.integerMapWork++
+		op, err := source.Byte()
+		if err != nil {
+			return false
+		}
+		switch {
+		case op == 0x28:
+			return f.integerMapAfterLoad(source)
+		case op == 0x20 || op == 0x21 || op == 0x22:
+			if _, err := source.U32(); err != nil {
+				return false
+			}
+		case op == 0x41:
+			if _, err := source.I32(); err != nil {
+				return false
+			}
+		case op == 0x01 || op == 0x1a || op == 0x1b || op >= 0x45 && op <= 0x4f || op >= 0x6a && op <= 0x6c || op >= 0x71 && op <= 0x76:
+		default:
+			return false
+		}
+	}
+	return false
+}
+
+func (f *fn) tryIntegerMapLoop(r *wasm.Reader) (bool, error) {
+	if f.unreachable {
+		f.stats.peep("integer-map-unreachable-reject")
+		return false, nil
+	}
+	if f.depth() > 4 {
+		f.stats.peep("integer-map-stack-reject")
+		return false, nil
+	}
+	if f.moduleEH || f.localBase != 0 || f.interruptible || f.gcFrameRoots != nil || len(f.customInstructions) != 0 || f.nLocals > 256 || f.m.MemCount() == 0 || f.memoryAddr64(0) || f.threadedMemory0 || profileEnabled {
+		f.stats.peep("integer-map-context-reject")
+		return false, nil
+	}
+	if f.memSizeReg == regNone {
+		f.stats.peep("integer-map-memory-size-reject")
+		return false, nil
+	}
+	if len(f.intervalReg) != 0 {
+		f.stats.peep("integer-map-interval-reject")
+		return false, nil
+	}
+	features := shared.AMD64ModernBaseline | shared.AMD64BMI2
+	if f.sc != nil {
+		features = f.sc.amd64Features
+	}
+	if !features.Has(shared.AMD64SSE41) || !f.integerMapScreen(*r) {
+		f.stats.peep("integer-map-screen-reject")
+		return false, nil
+	}
+	// Accepted recipes store a word in the bounded window. Raw byte screening
+	// can have false positives in immediates, but not false negatives for a
+	// store within the bounded planner window.
+	look := *r
+	size := look.BytesLeft()
+	if size > integerMapMaxBytes+1 {
+		size = integerMapMaxBytes + 1
+	}
+	window, _ := look.Bytes(size)
+	if bytes.IndexByte(window, 0x36) < 0 {
+		return false, nil
+	}
+	return f.tryIntegerMapCandidate(r)
+}
+
+// Keep the large bounded workspace off the ordinary loop-screen path.
+//
+//go:noinline
+func (f *fn) tryIntegerMapCandidate(r *wasm.Reader) (bool, error) {
+	look := *r
+	if _, err := look.Byte(); err != nil {
+		return false, nil
+	}
+	// Charge the complete bounded probe even if decoding rejects early.
+	f.integerMapWork += integerMapMaxNodes
+	var p integerMapPlan
+	if !inspectIntegerMapLoop(look, f.localType, f.classifier, &p) {
+		f.stats.peep("integer-map-capture-reject")
+		return false, nil
+	}
+	facts := p.affineFacts()
+	ind, ok := p.induction(&facts)
+	if !ok {
+		f.stats.peep("integer-map-induction-reject")
+		return false, nil
+	}
+	used := p.requiredNodes()
+	guards, ok := p.guardPlan(&facts, ind, &used)
+	if !ok {
+		f.stats.peep("integer-map-guard-reject")
+		return false, nil
+	}
+	recipe, ok := p.buildIntegerMapRecipe(ind, &guards.memory, &facts)
+	if ok && guards.packStores {
+		if recipe.registers <= 13 {
+			recipe.registers += 3
+		} else {
+			guards.packStores = false
+		}
+	}
+	if !ok || !integerMapBodySupported(&p, &guards, &recipe) {
+		f.stats.peep("integer-map-recipe-reject")
+		return false, nil
+	}
+	if guards.packStores {
+		f.stats.peep("integer-map-packed-stores")
+	}
+	f.stats.peep("integer-map-candidate")
+	if recipe.strided && (!guards.packStores || !integerMapWideInterleave) {
+		guards.lanes = 2
+	}
+	var slp integerMapSLP
+	var hasSLP bool
+	if integerMapSLPEnabled && guards.packStores && guards.lanes == 4 {
+		slp, hasSLP = buildIntegerMapSLP(&p, &guards, &recipe, ind)
+	}
+	guards.minTrip = 16
+	prefixDepth := f.depth()
+	depth := len(f.ctrl)
+	if err := f.opBlockPlain(r, 0x03); err != nil {
+		return true, err
+	}
+	pinExchange := f.ctrl[len(f.ctrl)-1].has(ctrlLoopPinExchange)
+	var gp [4]Reg
+	n := 0
+	blocked := f.pinned.union(f.pinnedLocalMask).union(f.reserved)
+	for _, reg := range gpAlloc {
+		if !blocked.has(reg) && f.regUser[reg] == nil {
+			gp[n] = reg
+			n++
+			if n == len(gp) {
+				break
+			}
+		}
+	}
+	if n != len(gp) {
+		f.stats.peep("integer-map-gp-reject")
+		return true, nil
+	}
+	var entry [256]regionEntryLocal
+	for i := 0; i < f.nLocals; i++ {
+		entry[i] = regionEntryLocal{f.locals[i].reg, f.locals[i].state}
+	}
+	entryF := f.fpinned.union(f.fpinnedLocalMask).union(f.fconstMask()).union(f.v128ConstMask())
+	reserved, pinned, memSize, memLease := f.reserved, f.pinned, f.memSizeReg, f.memSizeRegionalLease
+	slots := int(p.localN) + 1 + 2*int(guards.memory.streamN) + int(p.localN)
+	slot := f.allocSpillSlots(slots)
+	slotBase := f.spillOff(slot)
+	entryDispatch := f.a.JmpPlaceholder()
+	capture := f.a.Len()
+	for i, l := range p.locals[:p.localN] {
+		d := f.locals[l.index]
+		switch {
+		case d.state == lsConstZero:
+			f.a.Xor32(gp[0], gp[0])
+		case d.reg != regNone && d.state != lsMem:
+			f.a.MovRegReg32(gp[0], d.reg)
+		default:
+			f.loadFrameInt(gp[0], f.localAddr(int(l.index)), mtI32)
+		}
+		f.a.Store64(RSP, slotBase+int32(i*8), gp[0])
+	}
+	ge := integerMapGuardEmitter{a: f.a, plan: guards, gp: gp, memorySize: memSize, slotBase: slotBase}
+	ge.emit()
+	if hasSLP && ge.failureN+int(slp.relationN) > len(ge.failures) {
+		hasSLP = false
+	}
+	if hasSLP {
+		for _, rel := range slp.relations[:slp.relationN] {
+			f.a.Load64(gp[0], RSP, ge.slot(ge.startSlot(int(rel.a))))
+			f.a.Load64(gp[1], RSP, ge.slot(ge.startSlot(int(rel.b))))
+			f.a.AluRI(0, gp[1], 4, true)
+			f.a.Cmp64(gp[0], gp[1])
+			ge.fail(condNE)
+		}
+	}
+	toFast := f.a.JmpPlaceholder()
+	f.a.AlignLoop()
+	fallback := f.a.Len()
+	ge.patchFallback(fallback)
+	if integerMapTestFast {
+		f.trapAlways(trapUnreachable)
+	}
+	f.ctrl[len(f.ctrl)-1].controlSite = f.a.Len()
+	f.integerMapActive = true
+	err := f.bodyLoop(r, depth)
+	f.integerMapActive = false
+	if err != nil {
+		return true, err
+	}
+	toDone := f.a.JmpPlaceholder()
+	f.a.PatchRel32(toFast, f.a.Len())
+	valid := !f.unreachable && f.depth() == prefixDepth && f.s.canonicalSlots && f.reserved == reserved && f.pinned == pinned && f.memSizeReg == memSize && f.memSizeRegionalLease == memLease
+	var written [256]bool
+	for _, l := range p.locals[:p.localN] {
+		if l.written {
+			written[l.index] = true
+		}
+	}
+	var reload [256]bool
+	for i := 0; i < f.nLocals; i++ {
+		old, current := entry[i], f.locals[i]
+		if old.reg == current.reg {
+			if !written[i] && old.state != current.state {
+				valid = false
+			}
+			continue
+		}
+		if !pinExchange {
+			valid = false
+			continue
+		}
+		if written[i] {
+			continue
+		} // the fast path publishes this final local
+		switch {
+		case old.reg == regNone && old.state == lsMem && current.reg != regNone && current.state != lsMem && !current.isFloat:
+			// The exchanged-out owner was homed before the loop. Restore its
+			// final register on the fast path, which skips scalar loop exit.
+			reload[i] = true
+		case old.reg != regNone && old.state == lsStackReg && current.reg == regNone && current.state == lsMem:
+			// An unchanged exchanged-in local still has its original home.
+		default:
+			valid = false
+		}
+	}
+	for _, reg := range gp {
+		if f.regUser[reg] != nil || f.pinnedLocalMask.has(reg) {
+			valid = false
+		}
+	}
+	mask := entryF.union(f.fpinned).union(f.fpinnedLocalMask).union(f.fconstMask()).union(f.v128ConstMask())
+	var fp [16]Reg
+	n = 0
+	wantFP := int(recipe.registers)
+	if integerMapIncrementCache && recipe.used[p.locals[ind.local].entry] && wantFP < len(fp) {
+		wantFP++
+	}
+	for reg := Reg(0); reg < 16; reg++ {
+		if !mask.has(reg) && f.fregUser[reg] == nil && n < wantFP {
+			fp[n] = reg
+			n++
+		}
+	}
+	if n < int(recipe.registers) {
+		valid = false
+	}
+	if valid {
+		f.a.PatchRel32(entryDispatch, capture)
+		f.cpuHas(shared.AMD64SSE41)
+		outputBase := slotBase + int32((int(p.localN)+1+2*int(guards.memory.streamN))*8)
+		increment := regNone
+		if n > int(recipe.registers) {
+			increment = fp[recipe.registers]
+		}
+		be := integerMapBodyEmitter{a: f.a, plan: &p, guard: &ge, recipe: &recipe, facts: &facts, induction: ind, gp: gp, fp: fp, increment: increment, hasIncrement: increment != regNone, memoryBase: RBX, outputBase: outputBase}
+		if hasSLP {
+			be.slp = &slp
+			f.stats.peep("integer-map-slp")
+			if integerMapSLPWide && f.cpuHas(shared.AMD64AVX|shared.AMD64AVX2) {
+				be.slpWide = true
+				f.stats.peep("integer-map-slp-wide")
+			}
+		}
+		if integerMapAddressCache {
+			blocked := f.pinned.union(f.pinnedLocalMask).union(f.reserved)
+			for _, reg := range gp {
+				blocked = blocked.add(reg)
+			}
+			for i, stream := range guards.memory.streams[:guards.memory.streamN] {
+				base, _ := shareStream(&guards.memory, i)
+				if stream.stride == 0 || base != i || be.addressN == uint8(len(be.addressReg)) {
+					continue
+				}
+				for _, reg := range gpAlloc {
+					if !blocked.has(reg) && f.regUser[reg] == nil {
+						be.addressBase[be.addressN], be.addressReg[be.addressN] = base, reg
+						be.addressN++
+						blocked = blocked.add(reg)
+						break
+					}
+				}
+			}
+		}
+		be.emit()
+		if integerMapWideUnroll && be.slpWide {
+			f.stats.peep("integer-map-slp-wide-unroll")
+		}
+		if be.wideInvariant {
+			f.stats.peep("integer-map-wide-invariant-cache")
+		}
+		for i, needed := range reload[:f.nLocals] {
+			if needed {
+				f.loadLocalReg(i, f.locals[i].reg, false)
+			}
+		}
+		for i, l := range p.locals[:p.localN] {
+			if !l.written {
+				continue
+			}
+			d := f.locals[l.index]
+			if d.state == lsConstZero {
+				continue
+			}
+			f.a.Load32(gp[0], RSP, outputBase+int32(i*8))
+			if d.reg == regNone || d.state != lsReg {
+				f.a.Store32(RSP, f.localAddr(int(l.index)), gp[0])
+			}
+			if d.reg != regNone && d.state != lsMem {
+				f.a.MovRegReg32(d.reg, gp[0])
+			}
+		}
+		f.stats.peep("integer-map-loop")
+	} else {
+		f.a.PatchRel32(entryDispatch, fallback)
+		f.a.JmpBack(fallback)
+		f.stats.peep("integer-map-exit-reject")
+	}
+	f.a.PatchRel32(toDone, f.a.Len())
+	return true, nil
+}
+
+// memoryPlan collects small affine memory streams and the pairs for which a
+// future recipe must prove non-overlap. This is not a bounds, wrap, alias, or
+// trap-order proof. In particular, an invariant load cannot alias a store.
+func (p *integerMapPlan) memoryPlan(facts *[integerMapMaxNodes + 1]integerMapAffine, ind integerMapInduction, used *[integerMapMaxNodes + 1]bool) (m integerMapMemoryPlan, ok bool) {
+	if !p.independentInputs(ind, used) {
+		return m, false
+	}
+	stores := 0
+	for i, e := range p.effects[:p.effectN] {
+		a := facts[e.address]
+		stride, valid := p.addressStride(facts, e.address)
+		// The initial recipes operate on forward word streams and invariant loads.
+		// Later target recipes may admit other strides with their own proofs.
+		if !valid || stride >= 1<<31 || stride%4 != 0 || (e.op == 0x36 && stride == 0) {
+			return m, false
+		}
+		if e.op == 0x36 {
+			stores++
+		}
+		stream := -1
+		for j, s := range m.streams[:m.streamN] {
+			if s.address == a && s.offset == e.offset && s.stride == stride {
+				stream = j
+				break
+			}
+		}
+		if stream < 0 {
+			stream = int(m.streamN)
+			m.streamN++
+			m.streams[stream] = integerMapStream{address: a, offset: e.offset, stride: stride}
+		}
+		m.effectStream[i] = uint8(stream)
+		if e.op == 0x28 {
+			m.streams[stream].read = true
+		} else if e.op == 0x36 {
+			m.streams[stream].write = true
+		} else {
+			return m, false
+		}
+	}
+	if stores == 0 {
+		return m, false
+	}
+	for i, a := range m.streams[:m.streamN] {
+		if !a.write {
+			continue
+		}
+		for j, b := range m.streams[:m.streamN] {
+			if i == j || b.write && j < i || disjointWordResidues(a, b) {
+				continue
+			}
+			if int(m.pairN) == len(m.pairs) {
+				return m, false
+			}
+			m.pairs[m.pairN] = integerMapAliasPair{a: uint8(i), b: uint8(j)}
+			m.pairN++
+		}
+	}
+	return m, true
+}
