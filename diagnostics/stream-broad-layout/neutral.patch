+func (a *GlobalHintAccumulator) Add(index uint32, delta int64) {
+	if delta <= 0 || !a.touch(index) {
+		return
+	}
+	const max = ^uint32(0)
+	if uint64(a.scores[index])+uint64(delta) >= uint64(max) {
+		a.scores[index] = max
+	} else {
+		a.scores[index] += uint32(delta)
+	}
+}
