+//go:noinline
+func (m *Module) typeFunc(idx TypeIdx) (*CompType, bool) {
+	st, ok := m.subtypeByTypeIdx(idx)
+	if !ok || st.Comp.Kind != CompFunc {
+		return nil, false
+	}
+	return &st.Comp, true
+}
+
+// StructuralTypeKeyChecked is stable across modules with equivalent indexed or
+// recursive graphs. It bounds canonicalization work and shares completed group
+// digests in the module-local type-key cache. The boolean is false for a
+// non-function type, malformed graph, or a graph exceeding the work limit.
+func (m *Module) StructuralTypeKeyChecked(typeIdx uint32) (uint64, bool) {
+	ft, ok := m.TypeFunc(typeIdx)
+	if !ok {
+		return 0, false
+	}
+	sub, declared := m.TypeSubType(typeIdx)
+	if !declared {
+		return 0, false
+	}
+	if compTypeHasIndexedReferences(ft) || m.typeInNonSingletonRecGroup(typeIdx) || !sub.Final || len(sub.Supers) != 0 || sub.Metadata.Describes.Present() || sub.Metadata.Descriptor.Present() {
+		return m.structuralIndexedFuncTypeKey(typeIdx)
+	}
+	return StructuralFuncTypeKey(ft), true
+}
+
+func StructuralFuncTypeKey(ft *CompType) uint64 {
+	// Native call signatures have at most 256 parameters and 256 results.
+	// Each encoded value uses at most four bytes. Larger parser-side shapes
+	// keep the heap fallback without retaining scratch storage in module state.
+	var inline [16 + 4*512]byte
+	encoded := inline[:0]
+	if len(ft.Params)+len(ft.Results) > 512 {
+		encoded = make([]byte, 0, 16+8*(len(ft.Params)+len(ft.Results)))
+	}
+	mixU32 := func(v uint32) {
+		encoded = append(encoded, byte(v), byte(v>>8), byte(v>>16), byte(v>>24))
+	}
+	writeValue := func(t ValType) {
+		encoded = append(encoded, byte(t.Kind()))
+		switch t.Kind() {
+		case ValNum:
+			encoded = append(encoded, byte(t.Num()))
+		case ValRef:
+			flags := byte(0)
+			rt := t.Ref()
+			if rt.Nullable() {
+				flags |= 1
+			}
+			if rt.Exact() {
+				flags |= 2
+			}
+			encoded = append(encoded, flags, byte(rt.Heap().Kind()), byte(rt.Heap().Abs()))
+		}
+	}
+	mixU32(uint32(len(ft.Params)))
+	for _, t := range ft.Params {
+		writeValue(t)
+	}
+	encoded = append(encoded, 0xfe)
+	mixU32(uint32(len(ft.Results)))
+	for _, t := range ft.Results {
+		writeValue(t)
+	}
+	sum := sha256.Sum256(encoded)
+	return binary.LittleEndian.Uint64(sum[:8])
+}
+
+func decodeFCWithMultiMemory(r *reader, multiMemory bool) (Instruction, error) {
+	sub, err := r.u32()
+	if err != nil {
+		return Instruction{}, err
+	}
+	if k, ok := lookupPrefixKind(fcNoImm[:], sub); ok {
+		return Instruction{Kind: k}, nil
+	}
+	switch sub {
+	case 8:
+		a, err := r.u32()
+		if err != nil {
+			return Instruction{}, err
+		}
+		b, err := readMemoryIndex(r, multiMemory)
+		return Instruction{Kind: InstrMemoryInit, Index: a, Index2: b}, err
+	case 9:
+		return indexInst(r, InstrDataDrop)
+	case 10:
+		a, err := readMemoryIndex(r, multiMemory)
+		if err != nil {
+			return Instruction{}, err
+		}
+		b, err := readMemoryIndex(r, multiMemory)
+		return Instruction{Kind: InstrMemoryCopy, Index: a, Index2: b}, err
+	case 11:
+		mi, err := readMemoryIndex(r, multiMemory)
+		return Instruction{Kind: InstrMemoryFill, Index: mi}, err
+	case 12:
+		return twoIndexInst(r, InstrTableInit)
+	case 13:
+		return indexInst(r, InstrElemDrop)
+	case 14:
+		return twoIndexInst(r, InstrTableCopy)
+	case 15:
+		return indexInst(r, InstrTableGrow)
+	case 16:
+		return indexInst(r, InstrTableSize)
+	case 17:
+		return indexInst(r, InstrTableFill)
+	default:
+		return Instruction{}, &DecodeError{Code: ErrInvalidInstruction, Offset: r.off()}
+	}
+}
