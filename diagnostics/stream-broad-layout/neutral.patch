+		wasm.RefVal(wasm.AbsRef(wasm.HeapAny)),
+		wasm.FuncRef,
+		wasm.RefVal(wasm.AbsRef(wasm.HeapExn)),
+		wasm.ExternRef,
+		indexed,
+	}
