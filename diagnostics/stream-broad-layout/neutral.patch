+		checkGraphDefine(s, id, dst)
+	}
+	s.release(n.left)
+	s.release(n.right)
+	value := s.node(id)
+	value.kind = ScalarRegister
+	value.constant = 0
+	value.reg = dst
+	value.depth = 0
+	value.left = 0
+	value.right = 0
+	s.owners[dst] = id
+	return dst
+}
