+		literalCode, moduleLiterals := buildModuleLiteralIsland(literalWords, literalOffsets)
+		literalBase := -1
+		if len(literalCode) != 0 {
+			literalBase = len(codeBuffer.Bytes())
+			if err := codeBuffer.Append(literalCode); err != nil {
