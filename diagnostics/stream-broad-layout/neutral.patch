+func stagedNullReferenceProductShape(m *wasm.Module) (stagedNullReferenceProduct, error) {
+	if m == nil || len(m.Imports) != 0 || m.Start != nil || m.TagCount() != 0 || m.MemCount() != 0 || m.TableCount() != 0 || len(m.Elements) != 0 || len(m.Data) != 0 {
