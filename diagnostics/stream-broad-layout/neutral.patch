+		f.a.Pop(R10) // alignment pad
+		f.a.Pop(R9)  // caller context
+	}
+	if b.EHTransfer {
+		f.a.Pop(RBP)
+	} else {
+		f.a.Pop(RAX) // alignment pad
+	}
+	f.a.Pop(R15)
+	f.a.Pop(R14)
+	f.a.Pop(R13)
+	f.a.Pop(R12)
+	f.a.Pop(RBX)
+	if b.Dynamic {
+		f.copyInstanceContext(RBX, R9)
