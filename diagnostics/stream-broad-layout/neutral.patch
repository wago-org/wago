+	f.a.Load64(RAX, RBX, -offTrapReentry)
+	f.a.Store64(RSI, -offTrapReentry, RAX)
+	f.a.Load64(RAX, RBX, -offStackFence)
+	f.a.Store64(RSI, -offStackFence, RAX)
