+func TestScopedPublicDynamicIntegerLanes(t *testing.T) {
+	arm := os.Getenv("WAGO_ORDINARY_DYNAMIC_INTEGER_LANES_ARM")
+	if arm != "wide" && arm != "compact" {
+		t.Fatal("run only under the predeclared gate")
+	}
+	emit := func(kind string, v any) {
+		q, e := json.Marshal(v)
+		if e != nil {
+			t.Fatal(e)
+		}
+		t.Logf("PUBLIC_INTEGER_LANES_%s %s", kind, q)
+	}
+	compile := func(name string, body []byte, sites, i32, native, void uint64) *Compiled {
+		t.Helper()
+		cfg := NewRuntimeConfig().WithFunctionWorkers(1).WithMaxModuleBytes(uint64(len(body)))
+		proof := railshot.NewOwnedForestPublicFixture(arm == "compact")
+		cfg.ownedForestPublicFixture = proof
+		c, e := Compile(cfg, body)
+		if e != nil {
+			t.Fatalf("%s public compile: %v", name, e)
+		}
+		t.Cleanup(func() {
+			if e := c.Close(); e != nil {
+				t.Error(e)
+			}
+		})
+		if proof.DynamicImportSites() != sites || proof.DynamicImportI32Sites() != i32 || proof.DynamicImportNativeLeafSites() != native || proof.DynamicImportVoidSites() != void {
+			t.Fatalf("%s emitted sites=%d/%d/%d/%d want %d/%d/%d/%d", name, proof.DynamicImportSites(), proof.DynamicImportI32Sites(), proof.DynamicImportNativeLeafSites(), proof.DynamicImportVoidSites(), sites, i32, native, void)
+		}
+		if c.dynamicImports != (sites > 0) || (sites > 0 && !c.supportsGoHostDispatchTag()) {
+			t.Fatal("missing public dispatch metadata")
+		}
+		var out bytes.Buffer
+		if _, e = c.WriteCodeTo(&out); e != nil {
+			t.Fatal(e)
+		}
+		md, e := compiledMetadataBytes(c, true)
+		if e != nil {
+			t.Fatal(e)
+		}
+		emit("ARTIFACT", map[string]any{"arm": arm, "module": name, "body": fmt.Sprintf("%x", sha256.Sum256(body)), "native": fmt.Sprintf("%x", sha256.Sum256(out.Bytes())), "metadata": fmt.Sprintf("%x", sha256.Sum256(md)), "nativeBytes": out.Len(), "metadataBytes": len(md), "sites": sites, "i32Sites": i32, "nativeLeafSites": native, "voidSites": void})
+		return c
+	}
+	i := compile("i32-caller", intLaneI32Consumer(), 1, 1, 1, 0)
+	v := compile("void-caller", intLaneVoidConsumer(), 2, 1, 1, 1)
+	p := compile("producer", intLaneProducer(), 0, 0, 0, 0)
+	for _, lane := range []string{"go", "reentry", "cross", "leaf"} {
+		t.Run("i32-"+lane, func(t *testing.T) {
+			calls, nested := intLaneI32Run(t, i, p, lane)
+			emit("RUNTIME", map[string]any{"lane": "i32-" + lane, "outer": 3, "callbacks": calls, "nested": nested})
+		})
+	}
+	for _, lane := range []string{"go", "cross"} {
+		t.Run("void-"+lane, func(t *testing.T) {
+			returning, effects := intLaneVoidRun(t, v, p, lane == "cross")
+			emit("RUNTIME", map[string]any{"lane": "void-" + lane, "outer": 3, "callbacks": returning + effects, "nested": 0})
+		})
+	}
+}
