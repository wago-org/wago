+//go:norace
+//go:noinline
+func intLaneNativeLeaf(v int32) int32 { return v + 1 }
+
+type intLaneDispatch struct{ tag, home, code uint64 }
+
+func intLaneReadDispatch(t *testing.T, in *Instance, index int) intLaneDispatch {
+	t.Helper()
+	ptr := in.jm.CaptureInstanceContext().ImportDispatch
+	if ptr == 0 || index < 0 || index >= in.c.NumImports {
+		t.Fatal("missing ordinary dispatch entry")
+	}
+	cells := unsafe.Slice((*byte)(offHeapPtr(ptr)), in.c.NumImports*coreruntime.ImportDispatchEntryBytes)
+	e := cells[index*coreruntime.ImportDispatchEntryBytes:]
+	return intLaneDispatch{
+		binary.LittleEndian.Uint64(e[coreruntime.ImportDispatchCallerContextOffset:]) & (uint64(coreruntime.ImportDispatchCallerGoHostTag) | uint64(coreruntime.ImportDispatchCallerNativeLeafTag)),
+		binary.LittleEndian.Uint64(e[coreruntime.ImportDispatchHomeLinMemOffset:]),
+		binary.LittleEndian.Uint64(e[coreruntime.ImportDispatchCodePtrOffset:]),
+	}
+}
+func intLaneRequireDispatch(t *testing.T, in, producer *Instance, index, target int, tag uint64) {
+	t.Helper()
+	d := intLaneReadDispatch(t, in, index)
+	if d.tag != tag {
+		t.Fatalf("installed dispatch tag %x want %x", d.tag, tag)
+	}
+	if producer != nil {
+		if d.home != uint64(producer.jm.LinMemBase()) || d.code != uint64(producer.base)+uint64(producer.c.Entry[target]) {
+			t.Fatal("cross-instance binding does not use exact producer entry/home")
+		}
+	} else if d.home != uint64(in.jm.LinMemBase()) {
+		t.Fatal("Go/native leaf binding does not retain consumer home")
+	}
+}
+func intLaneRaw(t *testing.T, h HostCall, index int, want uint64) {
+	t.Helper()
+	lo, hi := h.RawParam(index)
+	if lo != want || hi != 0 {
+		t.Errorf("raw param %d got %x/%x, want %x/0", index, lo, hi, want)
+	}
+}
+func intLaneI32Run(t *testing.T, c, p *Compiled, lane string) (calls, nested int) {
+	t.Helper()
+	var in, prod *Instance
+	var x uint32
+	im := NewImports()
+	bind := func(f any) { im.HostFunc("env", "step", f).Params(ValI32).Results(ValI32) }
+	goTag := uint64(coreruntime.ImportDispatchCallerGoHostTag)
+	leafTag := uint64(coreruntime.ImportDispatchCallerNativeLeafTag)
+	tag := goTag
+	switch lane {
+	case "go":
+		bind(HostCallFunc(func(h HostCall) { calls++; intLaneRaw(t, h, 0, uint64(x)); h.SetRawResult(0, uint64(x*7+2), 0) }))
+	case "reentry":
+		bind(CallerHostCallFunc(func(caller Caller, h HostCall) {
+			calls++
+			intLaneRaw(t, h, 0, uint64(x))
+			got, e := in.InvokeFromHost(context.Background(), caller, "leaf", uint64(x))
+			if e != nil || len(got) != 1 || got[0] != uint64(x*3-1) {
+				t.Errorf("nested I32 leaf=%v err=%v", got, e)
+				return
+			}
+			nested++
+			h.SetRawResult(0, got[0], 0)
+		}))
+	case "cross":
+		tag = 0
+		var e error
+		prod, e = Instantiate(p, InstantiateOptions{})
+		if e != nil {
+			t.Fatal(e)
+		}
+		defer prod.Close()
+		export, e := prod.ExportedFunc("step")
+		if e != nil {
+			t.Fatal(e)
+		}
+		im.Function("env", "step", export)
+	case "leaf":
+		tag = leafTag
+		bind(intLaneNativeLeaf)
+	}
+	var e error
+	in, e = Instantiate(c, InstantiateOptions{Imports: im})
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer in.Close()
+	intLaneRequireDispatch(t, in, prod, 0, 0, tag)
+	if leaf := in.executionFlags.Load()&executionFlagNativeScalarLeaf != 0; leaf != (lane == "leaf") {
+		t.Fatalf("native scalar leaf flag=%v for %s", leaf, lane)
+	}
+	for _, old := range []uint32{0, 0x80000000, 0xffffffff} {
+		x = old ^ 95
+		var step uint32
+		switch lane {
+		case "go":
+			step = x*7 + 2
+		case "reentry":
+			step = x*3 - 1
+		case "cross":
+			step = x*5 - 9
+		case "leaf":
+			step = x + 1
+		}
+		got, e := in.Invoke("run", uint64(old))
+		if want := uint64((old ^ step) + x); e != nil || len(got) != 1 || got[0] != want {
+			t.Fatalf("%s i32 old %x: got %v err %v want %x", lane, old, got, e, want)
+		}
+	}
+	wantCalls, wantNested := 0, 0
+	if lane == "go" || lane == "reentry" {
+		wantCalls = 3
+	}
+	if lane == "reentry" {
+		wantNested = 3
+	}
+	if calls != wantCalls || nested != wantNested {
+		t.Fatalf("%s Go callbacks/nested %d/%d want %d/%d", lane, calls, nested, wantCalls, wantNested)
+	}
+	return
+}
+
+func intLaneVoidRun(t *testing.T, c, p *Compiled, cross bool) (returning, effects int) {
+	t.Helper()
+	var x uint32
+	var y uint64
+	var order []string
+	var mem *Memory
+	wantMemory := make([]byte, 65536)
+	im := NewImports()
+	im.HostFunc("env", "step", HostCallFunc(func(h HostCall) {
+		returning++
+		order = append(order, "step")
+		if cross && (mem == nil || !bytes.Equal(mem.UnsafeBytes(), wantMemory)) {
+			t.Error("cross-instance void effect preceded the returning step callback")
+		}
+		intLaneRaw(t, h, 0, uint64(x))
+		h.SetRawResult(0, uint64(x^0x9e3779b9), 0)
+	})).Params(ValI32).Results(ValI32)
+	var prod *Instance
+	if cross {
+		var e error
+		prod, e = Instantiate(p, InstantiateOptions{})
+		if e != nil {
+			t.Fatal(e)
+		}
+		defer prod.Close()
+		export, e := prod.ExportedFunc("effect")
+		if e != nil {
+			t.Fatal(e)
+		}
+		im.Function("env", "effect", export)
+	} else {
+		im.HostFunc("env", "effect", HostCallFunc(func(h HostCall) {
+			effects++
+			order = append(order, "effect")
+			intLaneRaw(t, h, 0, uint64(x))
+			intLaneRaw(t, h, 1, y^95)
+			if h.ResultCount() != 0 {
+				t.Error("void callback exposes a result")
+			}
+		})).Params(ValI32, ValI64)
+	}
+	in, e := Instantiate(c, InstantiateOptions{Imports: im})
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer in.Close()
+	goTag := uint64(coreruntime.ImportDispatchCallerGoHostTag)
+	intLaneRequireDispatch(t, in, nil, 0, 0, goTag)
+	tag := goTag
+	if cross {
+		tag = 0
+	}
+	intLaneRequireDispatch(t, in, prod, 1, 1, tag)
+	if cross {
+		mem = prod.Memory()
+		if mem == nil {
+			t.Fatal("missing producer memory")
+		}
+	}
+	for _, sample := range [][2]uint64{{0, 1}, {0x80000005, 0xa187009901002033}, {0xffffffff, 0xffeeccaa88775533}} {
+		x, y = uint32(sample[0]), sample[1]
+		order = order[:0]
+		if cross && !bytes.Equal(mem.UnsafeBytes(), wantMemory) {
+			t.Fatal("effect ran before invocation")
+		}
+		got, e := in.Invoke("run", uint64(x), y)
+		if want := (y + uint64(x^0x9e3779b9)) ^ (y ^ 95); e != nil || len(got) != 1 || got[0] != want {
+			t.Fatalf("void-lane caller result %v err %v want %x", got, e, want)
+		}
+		if cross {
+			if len(order) != 1 || order[0] != "step" {
+				t.Fatalf("returning callback lane %v", order)
+			}
+			binary.LittleEndian.PutUint32(wantMemory[16:], x)
+			binary.LittleEndian.PutUint64(wantMemory[24:], y^95)
+			if !bytes.Equal(mem.UnsafeBytes(), wantMemory) {
+				t.Fatal("unexpected full producer memory after void effect")
+			}
+		} else if len(order) != 2 || order[0] != "step" || order[1] != "effect" {
+			t.Fatalf("Go synchronous effect order %v", order)
+		}
+	}
+	if returning != 3 || (!cross && effects != 3) || (cross && effects != 0) {
+		t.Fatalf("returning=%d Go effects=%d cross=%v", returning, effects, cross)
+	}
+	return
+}
