+func (f *fn) hasFixtureReturningDynamicIntegerImport() bool {
+	for i := 0; i < f.importedFunctionCount() && i < len(f.importBindings); i++ {
+		b := f.importBindings[i]
+		if !b.Dynamic || b.CrossInstance || b.EHTransfer || b.ImportIndex != uint32(i) {
+			continue
+		}
+		ft, ok := f.functionSignature(uint32(i))
+		if ok && len(ft.Params) <= 2 && len(ft.Results) == 1 && sigIsIntOnly(ft) {
+			return true
+		}
+	}
+	return false
+}
