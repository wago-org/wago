+func intLaneImport(name string, ty uint32) []byte {
+	p := append([]byte{3, 'e', 'n', 'v'}, wasmtest.ULEB(uint32(len(name)))...)
+	p = append(p, name...)
+	return append(append(p, 0), wasmtest.ULEB(ty)...)
+}
+func intLaneI32Consumer() []byte {
+	ft := wasmtest.FuncType([]wasm.ValType{wasm.I32}, []wasm.ValType{wasm.I32})
+	// old x below call result, current (x XOR 95) is used after the call.
+	run := []byte{0x20, 0, 0x20, 0, 0x41, 0xdf, 0, 0x73, 0x21, 0, 0x20, 0, 0x10, 0, 0x73, 0x20, 0, 0x6a, 0x0b}
+	leaf := []byte{0x20, 0, 0x41, 3, 0x6c, 0x41, 1, 0x6b, 0x0b}
+	return wasmtest.Module(
+		wasmtest.Section(1, wasmtest.Vec(ft)),
+		wasmtest.Section(2, wasmtest.Vec(intLaneImport("step", 0))),
+		wasmtest.Section(3, wasmtest.Vec([]byte{0}, []byte{0})),
+		wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("run", 0, 1), wasmtest.ExportEntry("leaf", 0, 2))),
+		wasmtest.Section(10, wasmtest.Vec(wasmtest.Code(run), wasmtest.Code(leaf))),
+	)
+}
+func intLaneVoidConsumer() []byte {
+	i, j := wasm.I32, wasm.I64
+	step := wasmtest.FuncType([]wasm.ValType{i}, []wasm.ValType{i})
+	effect := wasmtest.FuncType([]wasm.ValType{i, j}, nil)
+	runType := wasmtest.FuncType([]wasm.ValType{i, j}, []wasm.ValType{j})
+	// Retain old y. Preserve unsigned returning sibling result across the void
+	// call, and supply current y XOR 95 and original x to that call.
+	run := []byte{0x20, 1, 0x20, 1, 0x42, 0xdf, 0, 0x85, 0x21, 1, 0x20, 0, 0x10, 0, 0xad, 0x20, 0, 0x20, 1, 0x10, 1, 0x7c, 0x20, 1, 0x85, 0x0b}
+	return wasmtest.Module(
+		wasmtest.Section(1, wasmtest.Vec(step, effect, runType)),
+		wasmtest.Section(2, wasmtest.Vec(intLaneImport("step", 0), intLaneImport("effect", 1))),
+		wasmtest.Section(3, wasmtest.Vec([]byte{2})),
+		wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("run", 0, 2))),
+		wasmtest.Section(10, wasmtest.Vec(wasmtest.Code(run))),
+	)
+}
+func intLaneProducer() []byte {
+	i, j := wasm.I32, wasm.I64
+	step := wasmtest.FuncType([]wasm.ValType{i}, []wasm.ValType{i})
+	effect := wasmtest.FuncType([]wasm.ValType{i, j}, nil)
+	// step(x) = 5x - 9. effect saves both full typed arguments in its own memory.
+	stepBody := []byte{0x20, 0, 0x41, 5, 0x6c, 0x41, 9, 0x6b, 0x0b}
+	effectBody := []byte{0x41, 16, 0x20, 0, 0x36, 2, 0, 0x41, 24, 0x20, 1, 0x37, 3, 0, 0x0b}
+	return wasmtest.Module(
+		wasmtest.Section(1, wasmtest.Vec(step, effect)),
+		wasmtest.Section(3, wasmtest.Vec([]byte{0}, []byte{1})),
+		wasmtest.Section(5, wasmtest.Vec([]byte{1, 1, 1})),
+		wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("step", 0, 0), wasmtest.ExportEntry("effect", 0, 1), wasmtest.ExportEntry("memory", 2, 0))),
+		wasmtest.Section(10, wasmtest.Vec(wasmtest.Code(stepBody), wasmtest.Code(effectBody))),
+	)
+}
