+func signedSaturationFC(sub uint32) bool {
+	return sub <= 6 && sub&1 == 0
+}
+
+// checkFixtureFC separates scalar numeric conversions from memory-index
+// immediates. For dead code the polymorphic stack has no concrete input.
+func (f *fn) checkFixtureFC(sub uint32, probe wasm.Reader) error {
+	if !signedSaturationFC(sub) {
+		return f.checkFixtureBulkMemory(sub, probe)
+	}
+	if !f.fixtureScalarFPEnabled() || !f.sc.fixtureWork.ScalarFPSignedSaturation {
+		return fmt.Errorf("fixture forest: unsupported opcode 0xfc subopcode %d", sub)
+	}
+	if !f.unreachable {
+		typ := mtF32
+		if sub&2 != 0 {
+			typ = mtF64
+		}
+		if x := f.s.back(); x == nil || rootMachineType(x) != typ {
+			return fmt.Errorf("fixture forest: unsupported signed saturation operand")
+		}
+	}
+	return nil
+}
+
