index 00000000..00da765c
--- /dev/null
+++ b/src/core/compiler/backend/railshot/amd64/owned_forest_signed_sat_independent_test.go
@@ -0,0 +1,112 @@
+//go:build linux && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"math"
+	"testing"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+)
+
+func TestOwnedForestSignedSaturationOrdinary(t *testing.T) {
+	for _, in := range []struct {
+		raw  wasm.ValType
+		into byte
+		wide bool
+		bits func(float64) uint64
+	}{
+		{wasm.I32, 0xbe, false, func(v float64) uint64 { return uint64(math.Float32bits(float32(v))) }},
+		{wasm.I64, 0xbf, true, math.Float64bits},
+	} {
+		for _, out := range []struct {
+			raw                             wasm.ValType
+			sub, xor, narrow                byte
+			width, minusStep32, minusStep64 int
+		}{
+			{wasm.I32, 0, 0x73, 1, 32, 7, 0},
+			{wasm.I64, 4, 0x85, 0, 64, 39, 10},
+		} {
+			sub := out.sub
+			if in.wide {
+				sub += 2
+			}
+			t.Run(fmt.Sprintf("FC%d", sub), func(t *testing.T) {
+				// Preserve old parameter 1 below the conversion; overwrite its
+				// canonical binding after saturation, then consume the old alias.
+				b := []byte{0, 0x20, 1, 0x20, 0, in.into, 0xfc, sub}
+				if out.narrow != 0 {
+					b = append(b, 0x41, 23)
+				} else {
+					b = append(b, 0x42, 23)
+				}
+				b = append(b, 0x21, 1, out.xor, 0x0b)
+				m := mod1(t, []wasm.ValType{in.raw, out.raw}, []wasm.ValType{out.raw}, b)
+				limit := math.Ldexp(1, out.width-1)
+				sign := uint64(1) << (out.width - 1)
+				mask := sign | (sign - 1)
+				step := out.minusStep32
+				if in.wide {
+					step = out.minusStep64
+				}
+				prev := sign - (uint64(1) << step)
+				cases := []struct {
+					value float64
+					sat   uint64
+				}{
+					{-1.5 * limit, sign}, {-limit, sign}, {-37.875, mask - 36}, {-0.75, 0}, {math.Copysign(0, -1), 0}, {0, 0}, {37.875, 37},
+					{limit - math.Ldexp(1, step), prev}, {limit, sign - 1}, {1.5 * limit, sign - 1},
+				}
+				for _, intr := range []bool{false, true} {
+					var native, metaOracle []byte
+					for _, candidate := range []bool{false, true} {
+						work := &fixtureModuleWork{Forest: candidate, ScalarFP: true, ScalarFPSignedSaturation: true}
+						var stats ModuleStats
+						cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+						if err != nil {
+							t.Fatal(err)
+						}
+						if cm.CodeImage != nil {
+							defer cm.CodeImage.Close()
+						}
+						if work.LegacyBodies != 1 || work.Opcodes == 0 || work.Rejected != 0 || candidate && work.Vector.stores == 0 {
+							t.Fatalf("inactive legacy forest: %+v", work)
+						}
+						wantEmissions := [8]uint64{}
+						wantEmissions[sub] = 1
+						if work.FPSignedSaturationEmissions != wantEmissions {
+							t.Fatalf("wrong FC activation: %v", work.FPSignedSaturationEmissions)
+						}
+						for i, tc := range cases {
+							old := uint64(0x3141592671828182) & mask
+							if i%2 == 0 {
+								old ^= sign
+							}
+							want := old ^ tc.sat
+							got, err := ownedRunModule(t, cm, []uint64{in.bits(tc.value), old})
+							if err != nil || got != want {
+								t.Fatalf("intr=%v forest=%v input=%g got=%x want=%x err=%v", intr, candidate, tc.value, got, want, err)
+							}
+						}
+						meta := *cm
+						meta.Code, meta.CodeImage = nil, nil
+						encoded, err := json.Marshal(meta)
+						if err != nil {
+							t.Fatal(err)
+						}
+						if !candidate {
+							native = append([]byte(nil), cm.Code...)
+							metaOracle = encoded
+						} else if !bytes.Equal(native, cm.Code) || !bytes.Equal(metaOracle, encoded) {
+							t.Fatal("native or encoder metadata differs")
+						}
+						t.Logf("sub=%d intr=%v candidate=%v bytes=%d work=%+v", sub, intr, candidate, len(cm.Code), work)
+					}
+				}
+			})
+		}
+	}
+}
