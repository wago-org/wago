--- /dev/null
+++ b/src/core/compiler/backend/railshot/amd64/owned_forest_fp_internal_independent_test.go
@@ -0,0 +1,135 @@
+//go:build linux && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"testing"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+)
+
+func ownedFPInternalModule(t *testing.T, wide, void bool) *wasm.Module {
+	t.Helper()
+	it, ft := wasm.I32, wasm.F32
+	toFP, toInt, iConst, sub, add, xor, literal := byte(0xbe), byte(0xbc), byte(0x41), byte(0x6b), byte(0x6a), byte(0x73), byte(0x43)
+	bits := uint64(0x40200000)
+	if wide {
+		it, ft = wasm.I64, wasm.F64
+		toFP, toInt, iConst, sub, add, xor, literal = 0xbf, 0xbd, 0x42, 0x7d, 0x7c, 0x85, 0x44
+		bits = 0x4004000000000000
+	}
+	// Call with (b, literal, a), keeping the old a beneath the call.
+	caller := []byte{0, 0x20, 0, 0x20, 1, toFP, literal}
+	if wide {
+		caller = binary.LittleEndian.AppendUint64(caller, bits)
+	} else {
+		caller = binary.LittleEndian.AppendUint32(caller, uint32(bits))
+	}
+	caller = append(caller, 0x20, 0, toFP, 0x10, 1, iConst, 23, 0x21, 0)
+	// A real, nontrivial loop body length keeps the existing inline policy.
+	callee := []byte{0, 0x03, 0x40, 0x01, 0x0b}
+	callee = append(callee, bytes.Repeat([]byte{0x01}, 512)...)
+	callee = append(callee, 0x20, 0, toInt, 0x20, 2, toInt, sub, 0x20, 1, toInt, xor)
+	results := []wasm.ValType{ft}
+	if void {
+		results = nil
+		caller = append(caller, 0x23, 0)
+		callee = append(callee, 0x24, 0)
+	} else {
+		caller = append(caller, toInt)
+		callee = append(callee, toFP)
+	}
+	caller = append(caller, add, 0x20, 0, add, 0x0b)
+	callee = append(callee, 0x0b)
+	sections := [][]byte{
+		wasmtest.Section(1, wasmtest.Vec(wasmtest.FuncType([]wasm.ValType{it, it}, []wasm.ValType{it}), wasmtest.FuncType([]wasm.ValType{ft, ft, ft}, results))),
+		wasmtest.Section(3, wasmtest.Vec(wasmtest.ULEB(0), wasmtest.ULEB(1))),
+	}
+	if void {
+		sections = append(sections, wasmtest.Section(6, wasmtest.Vec(wasmtest.GlobalEntry(it, true, []byte{iConst, 0, 0x0b}))))
+	}
+	sections = append(sections, wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("f", 0, 0))), wasmtest.Section(10, wasmtest.Vec(append(wasmtest.ULEB(uint32(len(caller))), caller...), append(wasmtest.ULEB(uint32(len(callee))), callee...))))
+	m, err := wasm.DecodeModule(wasmtest.Module(sections...))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = wasm.ValidateModule(m); err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+
+func TestOwnedForestFPInternalCallsOrdinary(t *testing.T) {
+	for _, wide := range []bool{false, true} {
+		for _, void := range []bool{false, true} {
+			t.Run(fmt.Sprintf("wide=%v/void=%v", wide, void), func(t *testing.T) {
+				m := ownedFPInternalModule(t, wide, void)
+				literal := uint64(0x40200000)
+				carriers := []uint64{0, 0x80000000, 0x7fc01234, 0x40c00000}
+				if wide {
+					literal = 0x4004000000000000
+					carriers = []uint64{0, 0x8000000000000000, 0x7ff8000000001234, 0x4018000000000000}
+				}
+				narrow := func(x uint64) uint64 {
+					if !wide {
+						return uint64(uint32(x))
+					}
+					return x
+				}
+				for _, intr := range []bool{false, true} {
+					var native, metaOracle []byte
+					for _, candidate := range []bool{false, true} {
+						work := &fixtureModuleWork{Forest: candidate, ScalarFP: true, ScalarFPFunctionABI: true, ScalarFPInternalDirectCalls: true}
+						var stats ModuleStats
+						cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+						if err != nil {
+							t.Fatal(err)
+						}
+						if cm.CodeImage != nil {
+							defer cm.CodeImage.Close()
+						}
+						st := stats.Funcs[0]
+						if work.LegacyBodies != 2 || work.Opcodes == 0 || work.Rejected != 0 || candidate && work.Vector.stores == 0 {
+							t.Fatalf("inactive bodies: %+v", work)
+						}
+						if work.FPInternalDirectCalls != 1 || work.FPInternalDeferredConstants != 1 || st.Calls["inline"] != 0 || st.Calls["wrapper"] != 0 {
+							t.Fatalf("wrong path: calls=%v work=%+v", st.Calls, work)
+						}
+						if len(cm.Entry) != 2 || len(cm.InternalEntry) != 2 || cm.Entry[0] >= cm.InternalEntry[0] || st.NativeSize.HostAdapterBytes <= 0 {
+							t.Fatal("exported integer caller adapter absent")
+						}
+						// Solve the integer formula for each requested raw result, and pair
+						// each one with a different input carrier. FP operations only move bits.
+						for i, raw := range carriers {
+							a := carriers[(i+1)%len(carriers)]
+							b := narrow(a + (raw ^ literal))
+							want := narrow(a + 23 + raw)
+							got, err := ownedRunModule(t, cm, []uint64{a, b})
+							if err != nil || got != want {
+								t.Fatalf("intr=%v forest=%v a=%x b=%x got=%x want=%x err=%v", intr, candidate, a, b, got, want, err)
+							}
+						}
+						meta := *cm
+						meta.Code, meta.CodeImage = nil, nil
+						encoded, err := json.Marshal(meta)
+						if err != nil {
+							t.Fatal(err)
+						}
+						if !candidate {
+							native = append([]byte(nil), cm.Code...)
+							metaOracle = encoded
+						} else if !bytes.Equal(native, cm.Code) || !bytes.Equal(metaOracle, encoded) {
+							t.Fatal("native or encoder metadata differs")
+						}
+						t.Logf("intr=%v forest=%v bytes=%d calls=%v work=%+v", intr, candidate, len(cm.Code), st.Calls, work)
+					}
+				}
+			})
+		}
+	}
+}
