+//go:build (linux || darwin || windows) && amd64 && wago_owned_forest_fixture
+
+package amd64
+
+import (
+	"bytes"
+	"fmt"
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	"testing"
+)
+
+// Ordinary well-typed scalar inputs only. Exceptional inputs and failure
+// reproductions are deliberately outside this staged fixture.
+func TestOwnedForestDropOrdinarySemantics(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		tail []byte
+		args []uint64
+		want uint64
+	}{
+		{"binary", []byte{0x20, 0, 0x20, 1, 0x73, 0x20, 0, 0x6a, 0x1a, 0x20, 0, 0x0b}, []uint64{23, 5}, 23},
+		{"unary", []byte{0x20, 0, 0x45, 0x1a, 0x20, 1, 0x0b}, []uint64{23, 5}, 5},
+		{"retained-old-local", []byte{0x20, 0, 0x20, 0, 0x20, 1, 0x73, 0x1a, 0x20, 1, 0x21, 0, 0x20, 0, 0x6a, 0x0b}, []uint64{23, 5}, 28},
+		{"in-bounds-effect", []byte{0x41, 0, 0x41, 29, 0x36, 2, 0, 0x41, 0, 0x28, 2, 0, 0x41, 1, 0x6a, 0x1a, 0x41, 0, 0x28, 2, 0, 0x0b}, []uint64{23, 5}, 29},
+		{"valid-division", []byte{0x20, 0, 0x20, 1, 0x6e, 0x41, 1, 0x6a, 0x1a, 0x20, 0, 0x0b}, []uint64{23, 5}, 23},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			body := append([]byte{0, 0x03, 0x40, 0x01, 0x0b}, tc.tail...)
+			m := mod1(t, []wasm.ValType{wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, body)
+			if tc.name == "in-bounds-effect" {
+				m = modMem(t, 1, []wasm.ValType{wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, body)
+			}
+			for _, intr := range []bool{false, true} {
+				t.Run(fmt.Sprintf("interruptible=%v", intr), func(t *testing.T) {
+					var oracle []byte
+					for _, candidate := range []bool{false, true} {
+						work := &fixtureModuleWork{Forest: candidate}
+						cm, e := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, fixtureWork: work})
+						if e != nil {
+							t.Fatal(e)
+						}
+						if work.LegacyBodies != 1 || work.Opcodes == 0 || work.Rejected != 0 {
+							t.Fatalf("inactive legacy driver: %+v", work)
+						}
+						if candidate && work.Vector.stores == 0 {
+							t.Fatal("forest root operations absent")
+						}
+						got, e := ownedRunModule(t, cm, tc.args)
+						if e != nil || got != tc.want {
+							t.Fatalf("candidate=%v got=%d want=%d err=%v", candidate, got, tc.want, e)
+						}
+						if !candidate {
+							oracle = append([]byte(nil), cm.Code...)
+						} else if !bytes.Equal(oracle, cm.Code) {
+							t.Fatal("native differs")
+						}
+						t.Logf("candidate=%v bytes=%d work=%+v", candidate, len(cm.Code), work)
+						if cm.CodeImage != nil {
+							cm.CodeImage.Close()
+						}
+					}
+				})
+			}
+		})
+	}
+}
