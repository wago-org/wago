@@ -1916,3 +1916,117 @@ func TestOwnedForestTypedStorageAccessorsOrdinary(t *testing.T) {
 		layoutEmit(t, "STORAGE_ACCESSORS", map[string]any{"case": "borrow-displacements-tee-and-deferred", "memoryRows": 5, "maxBorrowCode": uint64(0x100000000), "compact": compactOperandNodes})
 	})
 }
+
+func TestOwnedForestStorageConstructorsOrdinary(t *testing.T) {
+	t.Run("constructor-raw-equivalence", func(t *testing.T) {
+		const bits32 int64 = 0x80000000
+		const bits64 int64 = -0x7ffffffffff1abcf
+		raw := []struct {
+			got, want storage
+		}{
+			{floatLiteralPayload(mtF32, bits32), storage{kind: stInvalid, typ: mtF32, cval: bits32}},
+			{floatLiteralPayload(mtF64, bits64), storage{kind: stInvalid, typ: mtF64, cval: bits64}},
+			{constantStorage(mtF32, bits32), storage{kind: stConst, typ: mtF32, cval: bits32}},
+			{constantStorage(mtF64, bits64), storage{kind: stConst, typ: mtF64, cval: bits64}},
+			{constantStorage(mtI64, bits64), storage{kind: stConst, typ: mtI64, cval: bits64}},
+			{indexedStorage(stLocalRef, mtI32, regNone, 0xfffffff0, uint8(factUpper32Zero)), storage{kind: stLocalRef, typ: mtI32, reg: regNone, idx: 0xfffffff0, meta: uint8(factUpper32Zero)}},
+			{indexedStorage(stLocalReg, mtV128, RCX, 19, uint8(factBytesBelow16)), storage{kind: stLocalReg, typ: mtV128, reg: RCX, idx: 19, meta: uint8(factBytesBelow16)}},
+			{indexedStorage(stGlobalRef, mtI64, regNone, 0xfedcba98, 0), storage{kind: stGlobalRef, typ: mtI64, reg: regNone, idx: 0xfedcba98}},
+			{indexedStorage(stGlobReg, mtI64, RDX, 29, 0), storage{kind: stGlobReg, typ: mtI64, reg: RDX, idx: 29}},
+			{indexedStorage(stFuncRef, mtI64, 0, 0x76543210, 0), storage{kind: stFuncRef, typ: mtI64, idx: 0x76543210}},
+			{memRefStorage(RCX, -1<<31, 2, true, true, 0xffffffff), storage{kind: stMemRef, typ: mtI64, reg: RCX, slot: 0x80000000, idx: 0x102, cval: 0x100000000}},
+			{fmemRefStorage(RDX, 1<<31-1, false, -1), storage{kind: stMemRef, typ: mtF32, reg: RDX, slot: 0x7fffffff, idx: 4}},
+			{fmemRefStorage(RDX, -17, true, 510), storage{kind: stMemRef, typ: mtF64, reg: RDX, slot: 0xffffffef, idx: 8, cval: 511}},
+		}
+		for i, row := range raw {
+			if row.got != row.want {
+				t.Fatalf("case%d differs from original constructor literal: %+v != %+v", i, row.got, row.want)
+			}
+			donor := elem{st: row.got}
+			donor.setForestLive(true)
+			donor.setForestPending(true)
+			var dst elem
+			dst.setFreshStorage(donor.st)
+			if dst.st != row.want || dst.forestIsLive() || dst.forestIsPending() || !donor.forestIsPending() {
+				t.Fatalf("case%d fresh transition lost data or copied donor ownership", i)
+			}
+		}
+		layoutEmit(t, "STORAGE_CONSTRUCTORS", map[string]any{"case": "constructor-raw-equivalence", "rows": len(raw), "compact": compactOperandNodes})
+	})
+	t.Run("occupy-and-vector-tee", func(t *testing.T) {
+		f := layoutOwnedTagState()
+		f.a = f.sc.asm
+		// Two scalar FP widths retain stale slot/index/meta while only
+		// clearing cval; the value has an actual allocator owner afterward.
+		for _, typ := range []machineType{mtF32, mtF64} {
+			e := f.pushValue(storage{kind: stSlot, typ: typ, reg: RDX, slot: 11, idx: 0x87654321, cval: -55, meta: uint8(factUpper32Zero)})
+			e.setForestPending(true)
+			f.occupyF(e, RCX)
+			want := storage{kind: stReg, typ: typ, reg: RCX, slot: 11, idx: 0x87654321, meta: uint8(factUpper32Zero | storageLogicalRoot)}
+			copy := elem{}
+			copy.setFreshStorage(e.st)
+			if !e.forestIsLive() || !e.forestIsPending() || f.fregUser[RCX] != e || copy.st != want {
+				t.Fatalf("occupyF(%v) raw contract: %+v want %+v", typ, copy.st, want)
+			}
+			e.setForestPending(false)
+			f.releaseF(RCX)
+			f.s.erase(e)
+		}
+		f.sc.fixtureWork.TemporaryV128SIMD = true
+		f.fixtureTemporarySIMD = true
+		f.sc.fixtureWork.TemporaryV128Locals = true
+		f.nLocals = 1
+		f.localType = []machineType{mtV128}
+		f.localSlot = []uint32{0}
+		f.locals = []localDef{{typ: mtV128, reg: regNone, isFloat: true, state: lsMem}}
+		v := f.pushValue(storage{kind: stSlot, typ: mtV128, slot: 5, idx: 59, cval: 17, meta: uint8(factBytesBelow16)})
+		v.setForestPending(true)
+		f.occupyF(v, RCX)
+		if v.st.vectorAliasCookie() != 0 || v.st.slot != 5 || v.st.idx != 59 {
+			t.Fatal("V128 occupyF altered stale fields or kept cval")
+		}
+		// Exercise actual unpinned full-width tee lowering into inert assembler
+		// scratch, without running any generated instructions.
+		start := f.a.Len()
+		next := wasm.NewReader([]byte{0x0b})
+		f.setLocal(next, 0, true)
+		if f.a.Len() <= start || f.depth() != 1 || f.s.back() != v || f.fregUser[RCX] != v || !v.forestIsLive() || !v.forestIsPending() ||
+			v.st.kind != stReg || v.st.slot != 5 || v.st.idx != 59 || v.st.cval != 1 || v.st.vectorAliasCookie() != 1 || !v.st.valueFacts().has(factBytesBelow16) {
+			t.Fatalf("actual V128 post-occupy tee changed ownership or stale/alias data: %+v", v.st)
+		}
+		layoutEmit(t, "STORAGE_CONSTRUCTORS", map[string]any{"case": "occupy-and-vector-tee", "fpWidths": 2, "actualTee": 1, "compact": compactOperandNodes})
+	})
+	t.Run("captured-extent-slot-and-gp-transition", func(t *testing.T) {
+		f := layoutOwnedTagState()
+		original := storage{kind: stSlot, typ: mtI32, slot: 0xfffffffe, idx: 0xfedcba98, cval: -9, meta: uint8(factUpper32Zero)}
+		extent := original
+		extent.setCapturedBoundsExtent(0x7fffffff)
+		want := original
+		want.cval = 0x7fffffff
+		want.meta |= uint8(storageCapturedBounds)
+		if extent != want || extent.capturedBoundsExtent() != 0x7fffffff {
+			t.Fatalf("setting captured extent rewrote provenance fields: %+v", extent)
+		}
+		// Detached preservation is independent of spill range. Real attached
+		// occupy uses a small ordinary slot while keeping the other payload.
+		donor := elem{st: extent}
+		donor.setForestLive(true)
+		donor.setForestPending(true)
+		var detached elem
+		detached.setStoragePreservingOwnership(donor.st)
+		if detached.st != want || detached.forestIsLive() || detached.forestIsPending() {
+			t.Fatal("detached captured/slot replacement lost data or copied ownership")
+		}
+		extent.slot = 3
+		e := f.pushValue(extent)
+		e.setForestPending(true)
+		f.occupy(e, RAX)
+		fresh := elem{}
+		fresh.setFreshStorage(e.st)
+		want = storage{kind: stReg, typ: mtI32, reg: RAX, meta: uint8(factUpper32Zero | storageLogicalRoot)}
+		if fresh.st != want || !e.forestIsLive() || !e.forestIsPending() || f.regUser[RAX] != e || !donor.forestIsPending() {
+			t.Fatalf("GP occupy did not clear captured/slot/index payload or retain destination owner: %+v", fresh.st)
+		}
+		layoutEmit(t, "STORAGE_CONSTRUCTORS", map[string]any{"case": "captured-extent-slot-and-gp-transition", "gpClears": 1, "compact": compactOperandNodes})
+	})
+}
