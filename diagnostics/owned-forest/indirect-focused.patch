+//go:build linux && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"testing"
+	"unsafe"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	encoder "github.com/wago-org/wago/src/core/encoder/amd64"
+	wr "github.com/wago-org/wago/src/core/runtime"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+)
+
+func ownedImmutableIndirectModule(t *testing.T, poly, oneArg bool) (*wasm.Module, [2]int) {
+	t.Helper()
+	slots := [2]int{1, 1}
+	if poly {
+		slots[1] = 2
+	}
+	i32 := wasm.I32
+	params := []wasm.ValType{i32, i32}
+	reduce := []byte{}
+	second := []byte{0x20, 0, 0x20, 1}
+	firstTarget := []byte{0x20, 0, 0x41, 3, 0x6c, 0x20, 1, 0x6a, 0x0b}
+	secondTarget := []byte{0x20, 0, 0x41, 5, 0x6c, 0x20, 1, 0x6b, 0x0b}
+	if oneArg {
+		params = params[:1]
+		reduce = []byte{0x6a}
+		second = append(second, 0x6a)
+		firstTarget = []byte{0x20, 0, 0x41, 3, 0x6c, 0x41, 7, 0x6a, 0x0b}
+		secondTarget = []byte{0x20, 0, 0x41, 5, 0x6c, 0x41, 11, 0x6b, 0x0b}
+	}
+	body := []byte{0x20, 0, 0x20, 0, 0x20, 3, 0x74, 0x20, 1, 0x20, 3, 0x41, 1, 0x6a, 0x6e}
+	body = append(body, reduce...)
+	body = append(body, 0x20, 2, 0x11, 1, 0, 0x41, 23, 0x21, 0)
+	body = append(body, second...)
+	body = append(body, 0x20, 2, 0x11, 1, 0, 0x6a, 0x6a, 0x0b)
+	mod := wasmtest.Module(
+		wasmtest.Section(1, wasmtest.Vec(wasmtest.FuncType([]wasm.ValType{i32, i32, i32, i32}, []wasm.ValType{i32}), wasmtest.FuncType(params, []wasm.ValType{i32}))),
+		wasmtest.Section(3, wasmtest.Vec(wasmtest.ULEB(0), wasmtest.ULEB(1), wasmtest.ULEB(1))),
+		wasmtest.Section(4, wasmtest.Vec([]byte{0x70, 0, 2})),
+		wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("f", 0, 0))),
+		wasmtest.Section(9, wasmtest.Vec([]byte{0, 0x41, 0, 0x0b, 2, byte(slots[0]), byte(slots[1])})),
+		wasmtest.Section(10, wasmtest.Vec(wasmtest.Code(body), wasmtest.Code(firstTarget), wasmtest.Code(secondTarget))),
+	)
+	m, err := wasm.DecodeModule(mod)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = wasm.ValidateModule(m); err != nil {
+		t.Fatal(err)
+	}
+	return m, slots
+}
+
+func ownedImmutableIndirectRun(t *testing.T, m *wasm.Module, cm *encoder.CompiledModule, slots [2]int, args [4]uint32, want uint32) {
+	t.Helper()
+	eng, err := wr.NewEngine()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer eng.Close()
+	jm, err := wr.NewJobMemory(65536)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer jm.Close()
+	ar, err := wr.NewArena(4096)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ar.Close()
+	image, entry, err := wr.MapCode(cm.Code)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer wr.Unmap(image)
+	// Conventional local descriptors from the same compiled image and module.
+	table := ar.Alloc(8 + len(slots)*wr.TableEntryBytes)
+	binary.LittleEndian.PutUint32(table, uint32(len(slots)))
+	binary.LittleEndian.PutUint32(table[4:], uint32(len(slots)))
+	for i, fidx := range slots {
+		off := 8 + i*wr.TableEntryBytes
+		binary.LittleEndian.PutUint64(table[off+wr.TableEntryCodePtrOffset:], uint64(entry)+uint64(cm.InternalEntry[fidx]))
+		binary.LittleEndian.PutUint64(table[off+wr.TableEntrySigKeyOffset:], m.StructuralTypeKey(m.FuncTypes[fidx].Index))
+		binary.LittleEndian.PutUint64(table[off+wr.TableEntryHomeLinMemOffset:], uint64(jm.LinMemBase())|uint64(1)<<63)
+	}
+	jm.SetTablePtr(uintptr(unsafe.Pointer(&table[0])))
+	a, r, tr := ar.Alloc(256), ar.Alloc(256), ar.Alloc(wr.TrapBufferBytes)
+	for i, v := range args {
+		binary.LittleEndian.PutUint64(a[8*i:], uint64(v))
+	}
+	if err = eng.Call(entry+uintptr(cm.Entry[0]), a, jm.LinearMemory(), tr, r); err != nil {
+		t.Fatal(err)
+	}
+	if got := binary.LittleEndian.Uint32(r); got != want {
+		t.Fatalf("args=%v got=%d want=%d", args, got, want)
+	}
+}
+
+func TestOwnedForestImmutableIndirectOrdinary(t *testing.T) {
+	for _, tc := range []struct {
+		name, peep   string
+		poly, oneArg bool
+	}{{"mono", "monomorphic-call-indirect", false, false}, {"poly", "immutable-local-call-indirect", true, false}, {"poly-one-arg", "immutable-local-call-indirect", true, true}} {
+		t.Run(tc.name, func(t *testing.T) {
+			m, slots := ownedImmutableIndirectModule(t, tc.poly, tc.oneArg)
+			for _, intr := range []bool{false, true} {
+				var native, metaOracle []byte
+				for _, candidate := range []bool{false, true} {
+					work := &fixtureModuleWork{Forest: candidate, ImmutableIntegerIndirect: true}
+					var stats ModuleStats
+					cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+					if err != nil {
+						t.Fatal(err)
+					}
+					if cm.CodeImage != nil {
+						defer cm.CodeImage.Close()
+					}
+					if work.LegacyBodies == 0 || work.Opcodes == 0 || work.Rejected != 0 || candidate && work.Vector.stores == 0 {
+						t.Fatalf("inactive legacy forest: %+v", work)
+					}
+					peeps := stats.Funcs[0].Peephole
+					if peeps[tc.peep] != 2 || peeps["immutable-table-type-check-elide"] != 2 {
+						t.Fatalf("immutable call strategy inactive: %v", peeps)
+					}
+					for _, args := range [][4]uint32{{7, 48, 0, 2}, {13, 63, 1, 3}, {0x80000001, 99, 1, 0}, {11, 14, 0, 1}} {
+						calc := func(x, y uint32) uint32 {
+							if tc.oneArg {
+								if slots[args[2]] == 2 {
+									return (x+y)*5 - 11
+								}
+								return (x+y)*3 + 7
+							}
+							if slots[args[2]] == 2 {
+								return x*5 - y
+							}
+							return x*3 + y
+						}
+						want := args[0] + calc(args[0]<<args[3], args[1]/(args[3]+1)) + calc(23, args[1])
+						ownedImmutableIndirectRun(t, m, cm, slots, args, want)
+					}
+					meta := *cm
+					meta.Code, meta.CodeImage = nil, nil
+					encoded, err := json.Marshal(meta)
+					if err != nil {
+						t.Fatal(err)
+					}
+					if !candidate {
+						native = append([]byte(nil), cm.Code...)
+						metaOracle = encoded
+					} else {
+						t.Logf("intr=%v nativeExact=%v encoderJSONExact=%v", intr, bytes.Equal(native, cm.Code), bytes.Equal(metaOracle, encoded))
+					}
+					t.Logf("intr=%v candidate=%v bytes=%d peeps=%v work=%+v", intr, candidate, len(cm.Code), peeps, work)
+				}
+			}
+		})
+	}
+}
