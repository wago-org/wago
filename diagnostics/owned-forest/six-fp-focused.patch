+//go:build linux && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"testing"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	encoder "github.com/wago-org/wago/src/core/encoder/amd64"
+	wr "github.com/wago-org/wago/src/core/runtime"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+)
+
+func ownedSixFPModule(t *testing.T, mixed, overlap bool) *wasm.Module {
+	t.Helper()
+	ft, ftByte, store, align := wasm.F64, byte(0x7c), byte(0x39), byte(3)
+	if mixed {
+		ft, ftByte, store, align = wasm.F32, 0x7d, 0x38, 2
+	}
+	ps := []wasm.ValType{ft, ft, ft, ft, ft, ft}
+	ordinal := []byte{0, 1, 2, 3, 4, 5}
+	rs := []wasm.ValType{ft}
+	gp := byte(0)
+	if mixed {
+		ps = []wasm.ValType{ft, wasm.I64, ft, ft, ft, ft, ft}
+		ordinal = []byte{0, 2, 3, 4, 5, 6}
+		gp = 1
+		rs[0] = wasm.I64
+	}
+	caller := []byte{0}
+	for i := range ordinal {
+		caller = append(caller, 0x20, ordinal[5-i])
+		if mixed && i == 0 {
+			caller = append(caller, 0x20, gp)
+		}
+	}
+	caller = append(caller, 0x10, 1, 0x0b)
+	// Natural long noninline callee. Exactly five additional FP locals raise
+	// the fifth incoming argument to the XMM5 pin home by natural scoring.
+	callee := []byte{0}
+	if overlap {
+		callee = []byte{1, 5, ftByte}
+	}
+	callee = append(callee, 0x03, 0x40, 1, 0x0b)
+	callee = append(callee, bytes.Repeat([]byte{1}, 512)...)
+	write := func(addr, local byte) {
+		callee = append(callee, 0x41)
+		callee = append(callee, wasmtest.SLEB32(int32(addr))...)
+		callee = append(callee, 0x20, local, store, align, 0)
+	}
+	if overlap {
+		for i := 0; i < 5; i++ {
+			idx := byte(len(ps) + i)
+			callee = append(callee, 0x20, ordinal[i%4], 0x21, idx)
+			for n := 0; n < 3; n++ {
+				write(byte(64+8*i), idx)
+			}
+		}
+	}
+	if overlap {
+		write(32, ordinal[4])
+	} // keep the fifth at least as hot as the sixth
+	for i, id := range ordinal {
+		write(byte(8*i), id)
+	}
+	// Distinct returned carrier checks the final parameter, or the interleaved GP.
+	if mixed {
+		callee = append(callee, 0x20, gp, 0x0b)
+	} else {
+		callee = append(callee, 0x20, ordinal[5], 0x0b)
+	}
+	m, err := wasm.DecodeModule(wasmtest.Module(
+		wasmtest.Section(1, wasmtest.Vec(wasmtest.FuncType(ps, rs))),
+		wasmtest.Section(3, wasmtest.Vec(wasmtest.ULEB(0), wasmtest.ULEB(0))),
+		wasmtest.Section(5, wasmtest.Vec([]byte{0, 1})),
+		wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("f", 0, 0))),
+		wasmtest.Section(10, wasmtest.Vec(append(wasmtest.ULEB(uint32(len(caller))), caller...), append(wasmtest.ULEB(uint32(len(callee))), callee...))),
+	))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = wasm.ValidateModule(m); err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+
+func ownedSixFPRun(t *testing.T, cm *encoder.CompiledModule, mixed, overlap bool, fp []uint64, gp uint64) {
+	t.Helper()
+	args := append([]uint64(nil), fp...)
+	if mixed {
+		args = append([]uint64{fp[0], gp}, fp[1:]...)
+	}
+	eng, err := wr.NewEngine()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer eng.Close()
+	jm, err := wr.NewJobMemory(65536)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer jm.Close()
+	a, err := wr.NewArena(4096)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer a.Close()
+	mapped, entry, err := wr.MapCode(cm.Code)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer wr.Unmap(mapped)
+	in, out, tr := a.Alloc(256), a.Alloc(256), a.Alloc(wr.TrapBufferBytes)
+	for i, v := range args {
+		binary.LittleEndian.PutUint64(in[8*i:], v)
+	}
+	mem := jm.LinearMemory()
+	for i := range mem {
+		mem[i] = 0x5a
+	}
+	if err = eng.Call(entry+uintptr(cm.Entry[0]), in, mem, tr, out); err != nil {
+		t.Fatal(err)
+	}
+	wantResult := fp[0]
+	if mixed {
+		wantResult = gp
+	}
+	if got := binary.LittleEndian.Uint64(out); got != wantResult {
+		t.Fatalf("result=%x want=%x", got, wantResult)
+	}
+	want := bytes.Repeat([]byte{0x5a}, len(mem))
+	put := func(dst int, v uint64) {
+		if mixed {
+			binary.LittleEndian.PutUint32(want[dst:], uint32(v))
+		} else {
+			binary.LittleEndian.PutUint64(want[dst:], v)
+		}
+	}
+	for i := range fp {
+		put(8*i, fp[5-i])
+	}
+	if overlap {
+		for i := range 5 {
+			put(64+8*i, fp[5-i%4])
+		}
+	}
+	if !bytes.Equal(mem, want) {
+		t.Fatalf("entry/call argument bits out of order: got %x want %x", mem[:104], want[:104])
+	}
+}
+
+func TestOwnedForestSixFPOrdinary(t *testing.T) {
+	for _, mixed := range []bool{false, true} {
+		for _, overlap := range []bool{false, true} {
+			t.Run(fmt.Sprintf("mixed=%v/overlap=%v", mixed, overlap), func(t *testing.T) {
+				m := ownedSixFPModule(t, mixed, overlap)
+				for _, intr := range []bool{false, true} {
+					var native, metaOracle []byte
+					for _, candidate := range []bool{false, true} {
+						work := &fixtureModuleWork{Forest: candidate, ScalarFP: true, ScalarFPFunctionABI: true, ScalarFPInternalDirectCalls: true, ScalarFPMixedDirectCalls: true, ScalarFPSixArgABI: true}
+						var stats ModuleStats
+						cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+						if err != nil {
+							t.Fatal(err)
+						}
+						if cm.CodeImage != nil {
+							defer cm.CodeImage.Close()
+						}
+						if work.LegacyBodies != 2 || work.Rejected != 0 || work.Opcodes == 0 || candidate && work.Vector.stores == 0 {
+							t.Fatalf("inactive legacy fixture %+v", work)
+						}
+						if (!mixed && (work.FPInternalDirectCalls != 1 || work.FPMixedDirectCalls != 0)) || (mixed && (work.FPMixedDirectCalls != 1 || work.FPInternalDirectCalls != 0)) {
+							t.Fatalf("wrong private call: %+v", work)
+						}
+						st := stats.Funcs[0]
+						if st.Calls["mixed"] != 1 || st.Calls["inline"] != 0 || st.Calls["wrapper"] != 0 || len(cm.Entry) != 2 || len(cm.InternalEntry) != 2 || cm.Entry[0] >= cm.InternalEntry[0] || st.NativeSize.HostAdapterBytes <= 0 {
+							t.Fatalf("not a genuine adapter + direct call: %v", st.Calls)
+						}
+						if overlap {
+							if work.FPEntryForwardOverlaps == 0 || work.FPEntryStagedFunctions != 1 || work.FPEntryExtraStores == 0 {
+								t.Fatalf("missing natural forward overlap/staging: %+v", work)
+							}
+						} else if work.FPEntryForwardOverlaps != 0 || work.FPEntryStagedFunctions != 0 || work.FPEntryExtraStores != 0 {
+							t.Fatalf("nonoverlap unexpectedly staged: %+v", work)
+						}
+						fp := []uint64{0, 0x8000000000000000, 0x7ff8000000001234, 0x3ff0000000000000, 0x402d000000000000, 0xbffc000000000000}
+						if mixed {
+							fp = []uint64{0xbeef000000000000, 0xface000080000000, 0xdead00007fc01234, 0xabcd00003f800000, 0x1234000041680000, 0x87650000bfe00000}
+						}
+						for i := range fp {
+							rotated := append(append([]uint64(nil), fp[i:]...), fp[:i]...)
+							ownedSixFPRun(t, cm, mixed, overlap, rotated, 0x81723456789abcde+uint64(i))
+						}
+						meta := *cm
+						meta.Code, meta.CodeImage = nil, nil
+						encoded, err := json.Marshal(meta)
+						if err != nil {
+							t.Fatal(err)
+						}
+						if !candidate {
+							native = append([]byte(nil), cm.Code...)
+							metaOracle = encoded
+						} else if !bytes.Equal(native, cm.Code) || !bytes.Equal(metaOracle, encoded) {
+							t.Fatal("native or encoder metadata differs")
+						}
+						t.Logf("intr=%v forest=%v bytes=%d calls=%v work=%+v", intr, candidate, len(cm.Code), st.Calls, work)
+					}
+				}
+			})
+		}
+	}
+}
