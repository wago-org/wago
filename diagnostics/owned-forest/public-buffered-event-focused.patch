new file mode 100644
index 00000000..321aa194
--- /dev/null
+++ b/src/wago/owned_forest_public_buffered_event_ordinary_test.go
@@ -0,0 +1,188 @@
+//go:build linux && amd64 && !tinygo && !wago_target_tinygo && !wago_standalone && wago_owned_forest_public_fixture
+
+package wago
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"os"
+	"testing"
+
+	railshot "github.com/wago-org/wago/src/core/compiler/backend/railshot/amd64"
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	coreruntime "github.com/wago-org/wago/src/core/runtime"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+)
+
+func ordinaryBufferedEventModule() []byte {
+	event := wasmtest.FuncType([]wasm.ValType{wasm.I32}, nil)
+	run := wasmtest.FuncType([]wasm.ValType{wasm.I32}, []wasm.ValType{wasm.I32})
+	imp := append(wasmtest.Name("env"), wasmtest.Name("event")...)
+	imp = append(imp, 0, 0)
+	// Preserve original x under the entire IF. Nonzero path emits two
+	// events with different same-page markers and a local overwrite.
+	b := []byte{0x20, 0, 0x20, 0, 0x04, 0x40}
+	store := func(marker byte) { b = append(b, 0x41, 0xc0, 0, 0x41, marker, 0x3a, 0, 0) }
+	store(17)
+	b = append(b, 0x20, 0, 0x10, 0)
+	store(29)
+	b = append(b, 0x20, 0, 0x41, 0xdf, 0, 0x73, 0x21, 0, 0x20, 0, 0x10, 0)
+	store(43)
+	b = append(b, 0x05)
+	store(7)
+	b = append(b, 0x41, 13, 0x21, 0, 0x0b, 0x20, 0, 0x41, 3, 0x6c, 0x6a, 0x0b)
+	return wasmtest.Module(
+		wasmtest.Section(1, wasmtest.Vec(event, run)),
+		wasmtest.Section(2, wasmtest.Vec(imp)),
+		wasmtest.Section(3, wasmtest.Vec([]byte{1})),
+		wasmtest.Section(5, wasmtest.Vec([]byte{1, 1, 1})),
+		wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("run", 0, 1), wasmtest.ExportEntry("memory", 2, 0))),
+		wasmtest.Section(10, wasmtest.Vec(wasmtest.Code(b))),
+	)
+}
+
+type ordinaryBufferedEventObservation struct {
+	Value  uint32
+	Marker byte
+}
+
+func ordinaryBufferedEventRun(t *testing.T, c *Compiled, buffered bool) int {
+	t.Helper()
+	var page []byte
+	var calls []ordinaryBufferedEventObservation
+	observe := func(x uint32) {
+		if len(page) != 65536 {
+			t.Error("callback did not see active fixed page")
+			return
+		}
+		calls = append(calls, ordinaryBufferedEventObservation{x, page[64]})
+	}
+	im := NewImports()
+	if buffered {
+		im.Function("env", "event", I32HostEvent(func(value int32) { observe(uint32(value)) }))
+	} else {
+		im.HostFunc("env", "event", HostCallFunc(func(h HostCall) {
+			if h.ParamCount() != 1 || h.ResultCount() != 0 {
+				t.Error("wrong synchronous void signature")
+				return
+			}
+			low, high := h.RawParam(0)
+			value := uint32(h.I32(0))
+			if low != uint64(value) || high != 0 {
+				t.Errorf("noncanonical synchronous argument: %x/%x", low, high)
+			}
+			observe(value)
+		})).Params(ValI32)
+	}
+	in, err := Instantiate(c, InstantiateOptions{Imports: im})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if err := in.Close(); err != nil {
+			t.Error(err)
+		}
+	}()
+	if buffered {
+		if in.syncMode || in.hostEvents == nil || len(in.hostLog) != coreruntime.HostCallLogBytes || len(in.syncHosts) != 0 {
+			t.Fatal("explicit I32HostEvent did not select installed buffered event log")
+		}
+	} else if !in.syncMode || in.hostEvents != nil || len(in.hostLog) != 0 || len(in.syncHosts) != 1 {
+		t.Fatal("ordinary HostCallFunc did not select installed synchronous frame")
+	}
+	mem := in.Memory()
+	if mem == nil {
+		t.Fatal("missing fixed memory")
+	}
+	page = mem.UnsafeBytes()
+	wantPage := make([]byte, 65536)
+	if !bytes.Equal(page, wantPage) {
+		t.Fatal("unexpected initial memory")
+	}
+	for _, x := range []uint32{0x80000017, 0, 0xffeeddcc} {
+		start := len(calls)
+		got, err := in.Invoke("run", uint64(x))
+		current := uint32(13)
+		finalMarker := byte(7)
+		var want []ordinaryBufferedEventObservation
+		if x != 0 {
+			current = x ^ 95
+			finalMarker = 43
+			first, second := byte(17), byte(29)
+			if buffered {
+				first, second = 43, 43
+			}
+			want = []ordinaryBufferedEventObservation{{x, first}, {current, second}}
+		}
+		if result := uint64(x + 3*current); err != nil || len(got) != 1 || got[0] != result {
+			t.Fatalf("run(%x)=%v err=%v expectedI32=%x", x, got, err, result)
+		}
+		batch := calls[start:]
+		if len(batch) != len(want) {
+			t.Fatalf("run(%x) delivered %v want %v", x, batch, want)
+		}
+		for i := range want {
+			if batch[i] != want[i] {
+				t.Fatalf("run(%x) event %d got %+v want %+v", x, i, batch[i], want[i])
+			}
+		}
+		wantPage[64] = finalMarker
+		if !bytes.Equal(page, wantPage) {
+			t.Fatalf("run(%x) changed wrong memory", x)
+		}
+	}
+	if len(calls) != 4 {
+		t.Fatalf("exactly four callbacks, got %v", calls)
+	}
+	return len(calls)
+}
+
+func TestScopedPublicBufferedIntegerHostEvent(t *testing.T) {
+	arm := os.Getenv("WAGO_ORDINARY_BUFFERED_EVENT_ARM")
+	if arm != "wide" && arm != "compact" {
+		t.Fatal("run only within predeclared public gate")
+	}
+	emit := func(kind string, v any) {
+		q, e := json.Marshal(v)
+		if e != nil {
+			t.Fatal(e)
+		}
+		t.Logf("PUBLIC_BUFFERED_EVENT_%s %s", kind, q)
+	}
+	body := ordinaryBufferedEventModule()
+	cfg := NewRuntimeConfig().WithFunctionWorkers(1).WithMaxModuleBytes(uint64(len(body)))
+	proof := railshot.NewOwnedForestPublicDescriptorFixture(arm == "compact")
+	cfg.ownedForestPublicFixture = proof
+	c, err := Compile(cfg, body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if err := c.Close(); err != nil {
+			t.Error(err)
+		}
+	}()
+	if !c.dynamicImports || c.NumImports != 1 {
+		t.Fatal("missing real public dynamic import")
+	}
+	if proof.DescriptorImportSites() != 2 || proof.DynamicImportSites() != 0 || proof.DescriptorImportTypeChecks() == 0 || proof.DescriptorImportRootChecks() == 0 {
+		t.Fatalf("actual descriptor/dynamic/type/root receipts = %d/%d/%d/%d", proof.DescriptorImportSites(), proof.DynamicImportSites(), proof.DescriptorImportTypeChecks(), proof.DescriptorImportRootChecks())
+	}
+	var code bytes.Buffer
+	if _, err = c.WriteCodeTo(&code); err != nil {
+		t.Fatal(err)
+	}
+	meta, err := compiledMetadataBytes(c, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	emit("ARTIFACT", map[string]any{"arm": arm, "body": fmt.Sprintf("%x", sha256.Sum256(body)), "native": fmt.Sprintf("%x", sha256.Sum256(code.Bytes())), "metadata": fmt.Sprintf("%x", sha256.Sum256(meta)), "nativeBytes": code.Len(), "metadataBytes": len(meta), "descriptor": proof.DescriptorImportSites(), "dynamic": proof.DynamicImportSites(), "typeChecks": proof.DescriptorImportTypeChecks(), "rootChecks": proof.DescriptorImportRootChecks()})
+	for _, lane := range []string{"buffered", "synchronous"} {
+		t.Run(lane, func(t *testing.T) {
+			count := ordinaryBufferedEventRun(t, c, lane == "buffered")
+			emit("RUNTIME", map[string]any{"lane": lane, "invokes": 3, "callbacks": count, "zeroEventCalls": 1})
+		})
+	}
+}
