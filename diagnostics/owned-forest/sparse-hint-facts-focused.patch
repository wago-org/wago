+type fixtureVectorHintState uint8
+
+const (
+	fixtureVectorHintUnknown fixtureVectorHintState = iota
+	fixtureVectorHintScalar
+	fixtureVectorHintVector
+	fixtureVectorHintError
+)
+
+type fixtureVectorHintErrorRow struct {
+	index int
+	err   error
+}
+
+type fixtureVectorHintTable struct {
+	states []fixtureVectorHintState
+	errors []fixtureVectorHintErrorRow
+}
+
+func (w *fixtureModuleWork) initFixtureVectorHintTable(n int) {
+	w.fixtureVectorHintFacts.states = make([]fixtureVectorHintState, n)
+	w.TemporaryV128HintStateBackingBytes = uintptr(cap(w.fixtureVectorHintFacts.states)) * unsafe.Sizeof(fixtureVectorHintState(0))
+	w.TemporaryV128HintFactBackingBytes = w.TemporaryV128HintStateBackingBytes
+	w.TemporaryV128HintFactHeaderBytes = unsafe.Sizeof(fixtureVectorHintTable{})
+}
+
+// Facts publish exactly once, after the complete serial hint scan succeeds.
+// Error rows retain the original interface, in increasing function order.
+func (w *fixtureModuleWork) publishFixtureVectorHintFact(index int, fact fixtureVectorHintFact) {
+	t := &w.fixtureVectorHintFacts
+	if !fact.ready {
+		return
+	}
+	if fact.err != nil {
+		if len(t.errors) != 0 && t.errors[len(t.errors)-1].index >= index {
+			panic("fixture forest: unordered SIMD classification errors")
+		}
+		t.states[index] = fixtureVectorHintError
+		oldLen, oldCap := len(t.errors), cap(t.errors)
+		t.errors = append(t.errors, fixtureVectorHintErrorRow{index: index, err: fact.err})
+		if cap(t.errors) > oldCap {
+			w.TemporaryV128HintErrorGrows++
+			w.TemporaryV128HintErrorGrowthCopies += uint64(oldLen)
+		}
+		w.TemporaryV128HintErrorRows++
+		w.TemporaryV128HintErrorBackingBytes = uintptr(cap(t.errors)) * unsafe.Sizeof(fixtureVectorHintErrorRow{})
+		w.TemporaryV128HintFactBackingBytes = w.TemporaryV128HintStateBackingBytes + w.TemporaryV128HintErrorBackingBytes
+		return
+	}
+	if fact.vector {
+		t.states[index] = fixtureVectorHintVector
+	} else {
+		t.states[index] = fixtureVectorHintScalar
+	}
+}
+
+func (t *fixtureVectorHintTable) fact(index int) fixtureVectorHintFact {
+	if uint(index) >= uint(len(t.states)) {
+		return fixtureVectorHintFact{}
+	}
+	switch t.states[index] {
+	case fixtureVectorHintUnknown:
+		return fixtureVectorHintFact{}
+	case fixtureVectorHintScalar:
+		return fixtureVectorHintFact{ready: true}
+	case fixtureVectorHintVector:
+		return fixtureVectorHintFact{ready: true, vector: true}
+	case fixtureVectorHintError:
+		lo, hi := 0, len(t.errors)
+		for lo < hi {
+			mid := lo + (hi-lo)/2
+			if t.errors[mid].index < index {
+				lo = mid + 1
+			} else {
+				hi = mid
+			}
+		}
+		if lo < len(t.errors) && t.errors[lo].index == index {
+			return fixtureVectorHintFact{ready: true, err: t.errors[lo].err}
+		}
+	}
+	panic("fixture forest: invalid SIMD classification fact")
+}
