+//go:build linux && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"testing"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	encoder "github.com/wago-org/wago/src/core/encoder/amd64"
+	wr "github.com/wago-org/wago/src/core/runtime"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+)
+
+func ownedV128BlockModule(t *testing.T, lane string) *wasm.Module {
+	t.Helper()
+	b := []byte{0, 0x20, 0}
+	if lane == "regional-if" {
+		b = []byte{1, 16, 0x7b, 0x20, 0}
+	}
+	pc := func(i int) { b = append(b, 0x41); b = append(b, wasmtest.SLEB32(int32(i))...) }
+	ld := func(i int) { pc(i); b = append(b, 0xfd, 0, 4, 0) }
+	st := func() { b = append(b, 0xfd, 11, 4, 0) }
+	pc(512)
+	ld(112) // Full-width immutable prefix beside the scalar old parameter.
+	if lane == "regional-if" {
+		// Source-reviewed scoring: eight pinned dummies score15, all
+		// target local set/get pairs score3 and occupy regional leases.
+		for i := byte(2); i < 10; i++ {
+			for range 3 {
+				b = append(b, 0x20, i, 0x22, i, 0x21, i)
+			}
+		}
+		for i := range 5 {
+			ld(16 * i)
+			b = append(b, 0x21, byte(10+i))
+			pc(256 + i*16)
+			b = append(b, 0x20, byte(10+i))
+		}
+	}
+	pc(528)
+	switch lane {
+	case "straight":
+		b = append(b, 0x02, 0x7b)
+		ld(0)
+		b = append(b, 0x0b)
+	case "regional-if":
+		b = append(b, 0x20, 1, 0x04, 0x7b)
+		ld(16)
+		b = append(b, 0x05)
+		ld(32)
+		b = append(b, 0x0b)
+	case "overlap":
+		b = append(b, 0x02, 0x7b)
+		pc(33) // one extra scalar slot: source = destination + 1 on taken edge
+		ld(48)
+		b = append(b, 0x20, 1, 0x0d, 0, 0x1a, 0x1a)
+		ld(64)
+		b = append(b, 0x0c, 0, 0x0b)
+	}
+	st()
+	if lane == "regional-if" {
+		for range 5 {
+			st()
+		}
+	}
+	st()
+	ld(528)
+	b = append(b, 0xfd, 27, 0, 0x73, 0x0b)
+	m := modMem(t, 1, []wasm.ValType{wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, b)
+	if err := wasm.ValidateModule(m); err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+
+func ownedV128BlockRun(t *testing.T, cm *encoder.CompiledModule, lane string, cond uint32, salt int) {
+	t.Helper()
+	eng, err := wr.NewEngine()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer eng.Close()
+	jm, err := wr.NewJobMemory(65536)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer jm.Close()
+	a, err := wr.NewArena(4096)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer a.Close()
+	mapped, entry, err := wr.MapCode(cm.Code)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer wr.Unmap(mapped)
+	mem := jm.CurrentBytes()
+	for i := range mem {
+		mem[i] = byte(i*31 + salt*7)
+	}
+	want := append([]byte(nil), mem...)
+	copy(want[512:528], mem[112:128])
+	src := 0
+	if lane == "regional-if" {
+		for i := range 5 {
+			copy(want[256+i*16:], mem[i*16:i*16+16])
+		}
+		src = 32
+		if cond != 0 {
+			src = 16
+		}
+	}
+	if lane == "overlap" {
+		src = 64
+		if cond != 0 {
+			src = 48
+		}
+	}
+	copy(want[528:544], mem[src:src+16])
+	old := uint32(0xabc12300 + salt)
+	expected := old ^ binary.LittleEndian.Uint32(mem[src:src+4])
+	in, out, tr := a.Alloc(256), a.Alloc(256), a.Alloc(wr.TrapBufferBytes)
+	binary.LittleEndian.PutUint64(in, uint64(old))
+	binary.LittleEndian.PutUint64(in[8:], uint64(cond))
+	err = eng.Call(entry+uintptr(cm.Entry[0]), in, jm.LinearMemory(), tr, out)
+	if got := binary.LittleEndian.Uint32(out); err != nil || got != expected {
+		t.Fatalf("lane=%s condition=%d got=%x want=%x err=%v", lane, cond, got, expected, err)
+	}
+	if !bytes.Equal(mem, want) {
+		for i := range mem {
+			if mem[i] != want[i] {
+				t.Fatalf("lane=%s condition=%d byte[%d]=%x want=%x", lane, cond, i, mem[i], want[i])
+			}
+		}
+	}
+}
+
+func TestOwnedForestV128BlockOrdinary(t *testing.T) {
+	for _, lane := range []string{"straight", "regional-if", "overlap"} {
+		t.Run(lane, func(t *testing.T) {
+			m := ownedV128BlockModule(t, lane)
+			for _, intr := range []bool{false, true} {
+				var native, metaOracle []byte
+				for _, candidate := range []bool{false, true} {
+					work := &fixtureModuleWork{Forest: candidate, TemporaryV128SIMD: true, TemporaryV128Locals: true, TemporaryV128RegionalLocals: true, TemporaryV128BlockResults: true}
+					var stats ModuleStats
+					cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+					if err != nil {
+						t.Fatal(err)
+					}
+					if cm.CodeImage != nil {
+						defer cm.CodeImage.Close()
+					}
+					if work.LegacyBodies != 1 || work.Rejected != 0 || work.Opcodes == 0 || candidate && work.Vector.stores == 0 || work.TemporaryV128Bodies != 1 {
+						t.Fatalf("inactive lane: %+v", work)
+					}
+					if lane == "straight" && (work.TemporaryV128BlockStraightFallthroughs != 1 || work.TemporaryV128BlockSlotMerges != 0) {
+						t.Fatalf("inactive straightline vector block: %+v", work)
+					}
+					if lane != "straight" && (work.TemporaryV128BlockSlotMerges != 1 || work.TemporaryV128BlockStraightFallthroughs != 0) {
+						t.Fatalf("inactive vector slot merge: %+v", work)
+					}
+					if lane == "overlap" && (work.TemporaryV128BlockTwoSlotMoves == 0 || work.TemporaryV128BlockOverlappingMoves != 1) {
+						t.Fatalf("inactive two-slot branch move: %+v", work)
+					}
+					if lane == "regional-if" && (work.TemporaryV128RegionAdmissions < 5 || work.TemporaryV128RegionBoundaryWritebacks < 4 || work.TemporaryV128RegionAliasRebases < 5 || work.TemporaryV128RegionEvictions == 0 || candidate && work.TemporaryV128RegionRebaseVisits == 0) {
+						t.Fatalf("inactive regional IF drain: %+v", work)
+					}
+					for _, cond := range []uint32{0, 1} {
+						for _, salt := range []int{3, 29} {
+							ownedV128BlockRun(t, cm, lane, cond, salt)
+						}
+					}
+					meta := *cm
+					meta.Code, meta.CodeImage = nil, nil
+					encoded, err := json.Marshal(meta)
+					if err != nil {
+						t.Fatal(err)
+					}
+					if !candidate {
+						native = append([]byte(nil), cm.Code...)
+						metaOracle = encoded
+					} else if !bytes.Equal(native, cm.Code) || !bytes.Equal(metaOracle, encoded) {
+						t.Fatal("native or encoder metadata differs")
+					}
+					t.Logf("intr=%v candidate=%v bytes=%d peeps=%v work=%+v", intr, candidate, len(cm.Code), stats.Funcs[0].Peephole, work)
+				}
+			}
+		})
+	}
+}
