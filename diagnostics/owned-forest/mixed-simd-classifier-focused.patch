+//go:build linux && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"testing"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	encoder "github.com/wago-org/wago/src/core/encoder/amd64"
+	wr "github.com/wago-org/wago/src/core/runtime"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+)
+
+func ownedMixedSIMDClassifierModule(t *testing.T) *wasm.Module {
+	t.Helper()
+	i := wasm.I32
+	// Preserve the first x across direct and naturally selected inline calls.
+	// The typed mutable global is also read directly in ordinary scalar bodies.
+	caller := []byte{0, 0x20, 0, 0x20, 0, 0x10, 1, 0x6a, 0x20, 0, 0x10, 2, 0x6a, 0x23, 0, 0x6a, 0x0b}
+	direct := []byte{0, 0x03, 0x40, 1, 0x0b}
+	direct = append(direct, bytes.Repeat([]byte{1}, 512)...)
+	direct = append(direct, 0x20, 0, 0x23, 0, 0x6a, 0x0b)
+	leaf := []byte{0, 0x20, 0, 0x41, 3, 0x6a, 0x0b}
+	// Read full vector, xor constant, store to offset 32; independent scalar
+	// return reads lane 0 from the transformed destination.
+	vec := []byte{0, 0x20, 0, 0x41, 32, 0x41, 0, 0xfd, 0, 4, 0, 0xfd, 12}
+	vec = append(vec, ownedSIMDTempMask[:]...)
+	vec = append(vec, 0xfd, 81, 0xfd, 11, 4, 0, 0x41, 32, 0xfd, 0, 4, 0, 0xfd, 27, 0, 0x73, 0x0b)
+	code := func(b []byte) []byte { return append(wasmtest.ULEB(uint32(len(b))), b...) }
+	m, err := wasm.DecodeModule(wasmtest.Module(
+		wasmtest.Section(1, wasmtest.Vec(wasmtest.FuncType([]wasm.ValType{i}, []wasm.ValType{i}))),
+		wasmtest.Section(3, wasmtest.Vec(wasmtest.ULEB(0), wasmtest.ULEB(0), wasmtest.ULEB(0), wasmtest.ULEB(0))),
+		wasmtest.Section(5, wasmtest.Vec([]byte{0, 1})),
+		wasmtest.Section(6, wasmtest.Vec(wasmtest.GlobalEntry(i, true, []byte{0x41, 17, 0x0b}))),
+		wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("scalar", 0, 0), wasmtest.ExportEntry("vector", 0, 3))),
+		wasmtest.Section(10, wasmtest.Vec(code(caller), code(direct), code(leaf), code(vec))),
+	))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = wasm.ValidateModule(m); err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+
+func ownedMixedSIMDClassifierRun(t *testing.T, cm *encoder.CompiledModule) {
+	t.Helper()
+	if len(cm.Entry) != 4 || len(cm.InternalEntry) != 4 || cm.Entry[0] >= cm.InternalEntry[0] || cm.Entry[3] >= cm.InternalEntry[3] {
+		t.Fatal("missing genuine exported adapters")
+	}
+
+	for _, x := range []uint32{7, 0x80000001, 0xfffffff0} {
+		want := 3*x + 37
+		got, err := ownedRunModule(t, cm, []uint64{uint64(x)})
+		if err != nil || got != uint64(want) {
+			t.Fatalf("scalar x=%x got=%x want=%x err=%v", x, got, want, err)
+		}
+		ownedMixedSIMDVectorRun(t, cm, x)
+
+	}
+}
+
+func ownedMixedSIMDMetadata(t *testing.T, cm *encoder.CompiledModule) []byte {
+	t.Helper()
+	meta := *cm
+	meta.Code, meta.CodeImage = nil, nil
+	encoded, err := json.Marshal(meta)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return encoded
+}
+
+func ownedMixedSIMDVectorRun(t *testing.T, cm *encoder.CompiledModule, x uint32) {
+	t.Helper()
+	eng, err := wr.NewEngine()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer eng.Close()
+	jm, err := wr.NewJobMemory(65536)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer jm.Close()
+	a, err := wr.NewArena(4096)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer a.Close()
+	mapped, entry, err := wr.MapCode(cm.Code)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer wr.Unmap(mapped)
+	mem := jm.CurrentBytes()
+	for i := range mem {
+		mem[i] = byte(i*31 + int(x&15))
+	}
+	want := append([]byte(nil), mem...)
+	for i := range 16 {
+		want[32+i] = mem[i] ^ ownedSIMDTempMask[i]
+	}
+	in, out, tr := a.Alloc(256), a.Alloc(256), a.Alloc(wr.TrapBufferBytes)
+	binary.LittleEndian.PutUint64(in, uint64(x))
+	err = eng.Call(entry+uintptr(cm.Entry[3]), in, jm.LinearMemory(), tr, out)
+	expected := x ^ binary.LittleEndian.Uint32(want[32:36])
+	if got := binary.LittleEndian.Uint32(out); err != nil || got != expected {
+		t.Fatalf("vector got=%x want=%x err=%v", got, expected, err)
+	}
+	if !bytes.Equal(mem, want) {
+		t.Fatal("incorrect full 16-byte vector transform or unrelated memory changed")
+	}
+}
+
+func TestOwnedForestMixedSIMDClassifierOrdinary(t *testing.T) {
+	m := ownedMixedSIMDClassifierModule(t)
+	for _, intr := range []bool{false, true} {
+		var native, metaOracle []byte
+		for _, candidate := range []bool{false, true} {
+			work := &fixtureModuleWork{Forest: candidate, TemporaryV128SIMD: true, TemporaryV128PerFunction: true}
+			var stats ModuleStats
+			cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if cm.CodeImage != nil {
+				defer cm.CodeImage.Close()
+			}
+			if work.LegacyBodies < 3 || work.Opcodes == 0 || work.Rejected != 0 || candidate && work.Vector.stores == 0 || work.TemporaryV128Bodies != 1 || work.TemporaryV128ScalarSiblings != 3 {
+				t.Fatalf("inactive scalar/vector sibling lowering: %+v", work)
+			}
+			if c := work.TemporaryV128Classifier; c.Bodies != 4 || c.Bytes == 0 || c.Opcodes == 0 || c.TypeVisits != 14 || work.TemporaryV128PreflightBytes == 0 || work.TemporaryV128PreflightOpcodes == 0 {
+				t.Fatalf("inactive per-body classification: %+v", work)
+			}
+			// Only the forest arm runs the selected, type-free inline leaf
+			// through the pre-bind classifier; it has no referenced types.
+			c := work.TemporaryV128InlineClassifier
+			if candidate && (c.Bodies != 1 || c.Bytes == 0 || c.Opcodes == 0 || c.TypeVisits != 0) ||
+				!candidate && c != (fixtureVectorClassificationWork{}) {
+				t.Fatalf("unexpected selected-inline work: %+v", c)
+			}
+			st := stats.Funcs[0]
+			if st.Calls["inline"] != 1 || st.Calls["regabi"] != 1 || st.Calls["wrapper"] != 0 || st.Calls["mixed"] != 0 {
+				t.Fatalf("unexpected scalar caller strategies: %v", st.Calls)
+			}
+			ownedMixedSIMDClassifierRun(t, cm)
+			encoded := ownedMixedSIMDMetadata(t, cm)
+			if !candidate {
+				native = append([]byte(nil), cm.Code...)
+				metaOracle = encoded
+			} else if !bytes.Equal(native, cm.Code) || !bytes.Equal(metaOracle, encoded) {
+				t.Fatal("native or encoder metadata differs")
+			}
+			t.Logf("intr=%v forest=%v bytes=%d calls=%v work=%+v", intr, candidate, len(cm.Code), st.Calls, work)
+		}
+	}
+}
