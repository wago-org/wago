+
+// Classification work is separate from the closed SIMD-lane preflight and the
+// ordinary module hint scan. Byte counts include duplicate immediate probes.
+type fixtureVectorClassificationWork struct {
+	Bodies, Bytes, Opcodes, TypeVisits uint64
+}
+
+func (w *fixtureVectorClassificationWork) signatureHasVector(ft *wasm.CompType) bool {
+	vector := false
+	for _, t := range ft.Params {
+		w.TypeVisits++
+		vector = wasm.EqualValType(t, wasm.V128) || vector
+	}
+	for _, t := range ft.Results {
+		w.TypeVisits++
+		vector = wasm.EqualValType(t, wasm.V128) || vector
+	}
+	return vector
+}
+
+// The body has already passed Wasm validation. Decode instruction boundaries,
+// including unreachable instructions, rather than searching for raw bytes.
+// Metadata can expose vector state even when the body contains no FD opcode.
+func classifyFixtureVectorBody(m *wasm.Module, classifier *wasm.ModuleInstructionClassifier, body []byte, work *fixtureVectorClassificationWork) (bool, error) {
+	r := wasm.NewReader(body)
+	work.Bodies++
+	defer func() { work.Bytes += uint64(r.Offset()) }()
+	vector := false
+	depth := 1
+	for r.HasNext() {
+		op, err := r.Byte()
+		if err != nil {
+			return false, err
+		}
+		work.Opcodes++
+		start := r.Offset()
+		probe := *r
+		switch op {
+		case 0x02, 0x03, 0x04, 0x1f:
+			depth++
+			b, ok := probe.Peek()
+			if !ok {
+				return false, fmt.Errorf("fixture forest: missing SIMD classification block type")
+			}
+			work.Bytes++ // peek
+			switch {
+			case isValByte(b) || b == 0x63 || b == 0x64:
+				vector = b == 0x7b || vector
+				work.TypeVisits++
+			case b != 0x40:
+				idx, err := probe.S33()
+				work.Bytes += uint64(probe.Offset() - start)
+				if err != nil || idx < 0 {
+					return false, fmt.Errorf("fixture forest: unknown SIMD classification block type")
+				}
+				ft, ok := m.TypeFunc(uint32(idx))
+				if !ok {
+					return false, fmt.Errorf("fixture forest: unresolved SIMD classification block type")
+				}
+				vector = work.signatureHasVector(ft) || vector
+			}
+		case 0x1c:
+			n, err := probe.U32()
+			b, ok := probe.Peek()
+			work.Bytes += uint64(probe.Offset() - start)
+			if err != nil || n != 1 || !ok {
+				return false, fmt.Errorf("fixture forest: unknown SIMD classification select type")
+			}
+			work.Bytes++ // peek
+			work.TypeVisits++
+			vector = b == 0x7b || vector
+		case 0x23, 0x24:
+			idx, err := r.U32()
+			if err != nil {
+				return false, err
+			}
+			g, ok := m.GlobalTypeByIndex(idx)
+			if !ok {
+				return false, fmt.Errorf("fixture forest: unresolved SIMD classification global")
+			}
+			work.TypeVisits++
+			vector = wasm.EqualValType(wasm.GlobalValueType(g), wasm.V128) || vector
+			continue
+		case 0x10, 0x11, 0x12, 0x13, 0x14, 0x15:
+			idx, err := probe.U32()
+			work.Bytes += uint64(probe.Offset() - start)
+			if err != nil {
+				return false, err
+			}
+			var ft *wasm.CompType
+			var ok bool
+			if op == 0x10 || op == 0x12 {
+				ft, ok = m.FuncSignature(idx)
+			} else {
+				ft, ok = m.TypeFunc(idx)
+			}
+			if !ok {
+				return false, fmt.Errorf("fixture forest: unresolved SIMD classification call type")
+			}
+			vector = work.signatureHasVector(ft) || vector
+		case 0xfd:
+			vector = true
+		case 0x0b:
+			depth--
+			if depth == 0 {
+				if r.HasNext() {
+					return false, fmt.Errorf("fixture forest: trailing SIMD classification bytes")
+				}
+				return vector, nil
+			}
+		}
+		if err := classifier.SkipImmediate(r, op); err != nil {
+			return false, err
+		}
+	}
+	return false, fmt.Errorf("fixture forest: missing SIMD classification body end")
+}
