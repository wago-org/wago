+// This proves address-carrier ownership only: it deliberately emits no load.
+func TestOwnedForestIntervalOrdinaryCarrier(t *testing.T) {
+	for _, candidate := range []bool{false, true} {
+		f := &fn{a: &encoderamd64.Asm{}, s: newStack()}
+		if candidate {
+			f.s.forest = &fixtureForest{}
+			f.s.head.prev = nil
+			f.s.head.next = nil
+		}
+		for r := range f.intervalOwner {
+			f.intervalOwner[r] = -1
+		}
+		f.intervalOwner[R12] = 0
+		for _, r := range gpAlloc {
+			if r != RAX && r != RDX && r != RCX && r != R8 {
+				f.reserved = f.reserved.add(r)
+			}
+		}
+		reserved := f.reserved
+		load := f.pushValue(memRefStorage(R12, 7, 4, false, false, 0))
+		if got := f.detachControlIntervalAddresses(); got != maskOf(R8) {
+			t.Fatalf("candidate=%v carrier=%x", candidate, got)
+		}
+		if load.st.kind != stMemRef || load.st.reg != R8 || load.st.memBorrow() != -1 || f.regUser[R8] != load || f.reserved != reserved {
+			t.Fatalf("candidate=%v ownership=%+v", candidate, load.st)
+		}
+		want := &encoderamd64.Asm{}
+		want.MovReg64(R8, R12)
+		if !bytes.Equal(f.a.B, want.B) {
+			t.Fatalf("candidate=%v unexpected load/code %x", candidate, f.a.B)
+		}
+		if candidate && (load.prev != nil || load.next != nil || f.s.head.prev != nil || f.s.head.next != nil) {
+			t.Fatal("candidate used physical links")
+		}
+	}
+}
