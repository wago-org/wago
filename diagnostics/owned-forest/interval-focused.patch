+//go:build linux && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	encoderamd64 "github.com/wago-org/wago/src/core/encoder/amd64"
+	"testing"
+)
+
+func ownedIntervalModule(t *testing.T, name string) (*wasm.Module, uint64) {
+	base := intervalRegionBody()
+	const cut = 3 + 20*4
+	body := append([]byte(nil), base[:cut]...)
+	// A normal in-bounds store keeps the memory witness in legacy lowering.
+	if name != "call-old-alias" {
+		body = append(body, 0x41, 0, 0x20, 0, 0x36, 2, 0)
+	}
+	if name != "region-final-transfer" {
+		// Keep the old local live while its canonical binding changes.
+		body = append(body, 0x20, 0)
+	}
+	switch name {
+	case "region-final-transfer":
+	case "if-true", "if-false":
+		cond := byte(1)
+		if name == "if-false" {
+			cond = 0
+		}
+		body = append(body, 0x41, cond, 0x04, 0x40, 0x41, 23, 0x21, 0, 0x05, 0x41, 29, 0x21, 0, 0x0b)
+	case "call-old-alias":
+		body = append(body, 0x20, 0, 0x10, 1, 0x41, 23, 0x21, 0, 0x6a)
+	default:
+		t.Fatal("unknown case")
+	}
+	body = append(body, base[cut:len(base)-1]...)
+	if name != "region-final-transfer" {
+		body = append(body, 0x6a)
+	}
+	if name != "call-old-alias" {
+		// Consume the stored value in the returned result.
+		body = append(body, 0x41, 0, 0x28, 2, 0, 0x6a)
+	}
+	body = append(body, 0x0b)
+	if name == "call-old-alias" {
+		// Ordinary fallthrough loop and body size prevent inline/shared-scalar
+		// selection naturally, without changing either arm's optimization policy.
+		callee := []byte{0, 0x03, 0x40, 0x01, 0x0b}
+		for i := 0; i < 512; i++ {
+			callee = append(callee, 0x01)
+		}
+		callee = append(callee, 0x20, 0, 0x41, 7, 0x6a, 0x0b)
+		return modFuncs(t, funcDef{results: []wasm.ValType{wasm.I32}, body: body}, funcDef{params: []wasm.ValType{wasm.I32}, results: []wasm.ValType{wasm.I32}, body: callee}), 241
+	}
+	want := map[string]uint64{"region-final-transfer": 211, "if-true": 234, "if-false": 240}[name]
+	return modMem(t, 1, nil, []wasm.ValType{wasm.I32}, body), want
+}
+
+func TestOwnedForestIntervalOrdinary(t *testing.T) {
+	for _, name := range []string{"region-final-transfer", "if-true", "if-false", "call-old-alias"} {
+		t.Run(name, func(t *testing.T) {
+			m, want := ownedIntervalModule(t, name)
+			for _, intr := range []bool{false, true} {
+				var oracle []byte
+				for _, candidate := range []bool{false, true} {
+					work := &fixtureModuleWork{Forest: candidate}
+					var stats ModuleStats
+					cm, e := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+					if e != nil {
+						t.Fatal(e)
+					}
+					st := stats.Funcs[0]
+					if work.LegacyBodies == 0 || work.Opcodes == 0 || (candidate && work.Vector.stores == 0) {
+						t.Fatalf("inactive: %+v", work)
+					}
+					if st.Residency.Activations == 0 {
+						t.Fatalf("interval inactive: %+v %v", st.Residency, st.Peephole)
+					}
+					if name == "region-final-transfer" && (st.Peephole["interval-region"] != 1 || st.Residency.FinalTransfers == 0) {
+						t.Fatalf("final transfer inactive: %+v %v", st.Residency, st.Peephole)
+					}
+					if name != "region-final-transfer" && st.Peephole["interval-control"] != 1 {
+						t.Fatalf("control interval inactive: %v", st.Peephole)
+					}
+					if name == "call-old-alias" && st.Calls["regabi"] != 1 {
+						t.Fatalf("noninline register call inactive: %v", st.Calls)
+					}
+					got, e := ownedRunModule(t, cm, nil)
+					if e != nil || got != want {
+						t.Fatalf("candidate=%v got=%d want=%d err=%v", candidate, got, want, e)
+					}
+					if !candidate {
+						oracle = append([]byte(nil), cm.Code...)
+					} else if !bytes.Equal(oracle, cm.Code) {
+						t.Fatal("native differs")
+					}
+					t.Logf("case=%s intr=%v candidate=%v bytes=%d residency=%+v peepholes=%v calls=%v work=%+v", name, intr, candidate, len(cm.Code), st.Residency, st.Peephole, st.Calls, work)
+					if cm.CodeImage != nil {
+						cm.CodeImage.Close()
+					}
+				}
+			}
+		})
+	}
+}
