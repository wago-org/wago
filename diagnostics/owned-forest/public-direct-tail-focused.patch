+//go:build linux && amd64 && !tinygo && !wago_target_tinygo && !wago_standalone && wago_owned_forest_public_fixture
+
+package wago
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"os"
+	"testing"
+
+	railshot "github.com/wago-org/wago/src/core/compiler/backend/railshot/amd64"
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+)
+
+func ordinaryDirectTailModule() []byte {
+	i, j := wasm.I32, wasm.I64
+	caller := wasmtest.FuncType([]wasm.ValType{i, j}, []wasm.ValType{j})
+	target := wasmtest.FuncType([]wasm.ValType{j, i}, []wasm.ValType{j})
+	// Keep old y live across overwriting its home; send y then unsigned x^95.
+	prepare := []byte{0x20, 1, 0x20, 1, 0x42, 23, 0x85, 0x21, 1, 0x20, 0, 0x41, 0xdf, 0, 0x73, 0x21, 0, 0x20, 0}
+	tail := append(bytes.Clone(prepare), 0x12, 2, 0x0b)
+	ordinary := append(bytes.Clone(prepare), 0x10, 2, 0x0f, 0x0b)
+	// Scalar loop is a natural noninline target. Starting acc=y, execute
+	// acc=3*acc-z twice. One i32 count local, followed by the function body.
+	callee := []byte{1, 1, 0x7f, 0x41, 2, 0x21, 2, 0x03, 0x40,
+		0x20, 0, 0x42, 3, 0x7e, 0x20, 1, 0xad, 0x7d, 0x21, 0,
+		0x20, 2, 0x41, 1, 0x6b, 0x22, 2, 0x0d, 0, 0x0b, 0x20, 0, 0x0b}
+	code := append(wasmtest.ULEB(uint32(len(callee))), callee...)
+	return wasmtest.Module(
+		wasmtest.Section(1, wasmtest.Vec(caller, target)),
+		wasmtest.Section(3, wasmtest.Vec([]byte{0}, []byte{0}, []byte{1})),
+		wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("tail", 0, 0), wasmtest.ExportEntry("ordinary", 0, 1))),
+		wasmtest.Section(10, wasmtest.Vec(wasmtest.Code(tail), wasmtest.Code(ordinary), code)),
+	)
+}
+
+func TestScopedPublicDirectIntegerReturnCall(t *testing.T) {
+	arm := os.Getenv("WAGO_ORDINARY_DIRECT_TAIL_ARM")
+	if arm != "wide" && arm != "compact" {
+		t.Fatal("run only within predeclared public gate")
+	}
+	emit := func(kind string, v any) {
+		q, e := json.Marshal(v)
+		if e != nil {
+			t.Fatal(e)
+		}
+		t.Logf("PUBLIC_DIRECT_TAIL_%s %s", kind, q)
+	}
+	body := ordinaryDirectTailModule()
+	cfg := NewRuntimeConfig().WithFunctionWorkers(1).WithMaxModuleBytes(uint64(len(body)))
+	proof := railshot.NewOwnedForestPublicDirectTailFixture(arm == "compact")
+	cfg.ownedForestPublicFixture = proof
+	c, err := Compile(cfg, body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if err := c.Close(); err != nil {
+			t.Error(err)
+		}
+	}()
+	if !c.requiredFeatures.IsEnabled(CoreFeatureTailCall) || c.NumImports != 0 || len(c.InternalEntry) != 3 || len(c.Entry) != 3 {
+		t.Fatalf("wrong required tail/module/entry metadata: %x %d %d %d", c.requiredFeatures, c.NumImports, len(c.InternalEntry), len(c.Entry))
+	}
+	if proof.DirectTailInternalRelocs() != 1 || proof.DirectTailRootChecks() == 0 {
+		t.Fatalf("terminal internal-reloc/root receipts=%d/%d", proof.DirectTailInternalRelocs(), proof.DirectTailRootChecks())
+	}
+	var code bytes.Buffer
+	if _, err = c.WriteCodeTo(&code); err != nil {
+		t.Fatal(err)
+	}
+	meta, err := compiledMetadataBytes(c, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	emit("ARTIFACT", map[string]any{"arm": arm, "body": fmt.Sprintf("%x", sha256.Sum256(body)), "native": fmt.Sprintf("%x", sha256.Sum256(code.Bytes())), "metadata": fmt.Sprintf("%x", sha256.Sum256(meta)), "nativeBytes": code.Len(), "metadataBytes": len(meta), "requiredTailCall": true, "internalRelocs": proof.DirectTailInternalRelocs(), "rootChecks": proof.DirectTailRootChecks()})
+	in, err := Instantiate(c, InstantiateOptions{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if err := in.Close(); err != nil {
+			t.Error(err)
+		}
+	}()
+	for _, entry := range []string{"tail", "ordinary"} {
+		for _, p := range [][2]uint64{{0, 0}, {0x80000007, 0x8000000187654321}, {0xffffffff, 0xfedcba9876543210}} {
+			x, y := uint32(p[0]), p[1]
+			expected := 9*y - 4*uint64(x^95)
+			got, e := in.Invoke(entry, uint64(x), y)
+			if e != nil || len(got) != 1 || got[0] != expected {
+				t.Fatalf("%s(%x,%x)=%v err=%v want %x", entry, x, y, got, e, expected)
+			}
+		}
+		emit("RUNTIME", map[string]any{"entry": entry, "invokes": 3})
+	}
+}
