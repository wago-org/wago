+func ownedMixedDirectModule(t *testing.T, lane string) *wasm.Module {
+	t.Helper()
+	// Keep the exported integer ABI independent of the private mixed call.
+	// GP1 is a deferred XOR, FP0 eagerly reinterprets a raw input, GP2
+	// reads the old parameter, FP1 is deliberately a late literal.
+	caller := []byte{0, 0x20, 0, 0x20, 1, 0x20, 0, 0x85, 0x20, 2, 0xbf, 0x20, 0, 0x44}
+	caller = binary.LittleEndian.AppendUint64(caller, 0x4004000000000000)
+	caller = append(caller, 0x10, 1, 0x42, 23, 0x21, 0)
+	// The old parameter survives below the call. Combine it with the selected
+	// result and the updated local; for void use the callee's observed effect.
+	callee := []byte{0, 0x03, 0x40, 0x01, 0x0b}
+	callee = append(callee, bytes.Repeat([]byte{0x01}, 512)...)
+	callee = append(callee,
+		0x20, 0, 0x42, 3, 0x7e, 0x20, 2, 0x7d,
+		0x20, 1, 0xbd, 0x7c, 0x20, 3, 0xbd, 0x85)
+	results := []wasm.ValType{wasm.I64}
+	if lane == "fp-result" {
+		callee = append(callee, 0xbf)
+		results[0] = wasm.F64
+		caller = append(caller, 0xbd)
+	} else if lane == "void" {
+		callee = append(callee, 0x24, 0)
+		caller = append(caller, 0x23, 0)
+		results = nil
+	}
+	caller = append(caller, 0x7c, 0x20, 0, 0x7c, 0x0b)
+	callee = append(callee, 0x0b)
+	sections := [][]byte{
+		wasmtest.Section(1, wasmtest.Vec(wasmtest.FuncType([]wasm.ValType{wasm.I64, wasm.I64, wasm.I64}, []wasm.ValType{wasm.I64}), wasmtest.FuncType([]wasm.ValType{wasm.I64, wasm.F64, wasm.I64, wasm.F64}, results))),
+		wasmtest.Section(3, wasmtest.Vec(wasmtest.ULEB(0), wasmtest.ULEB(1))),
+	}
+	if lane == "void" {
+		sections = append(sections, wasmtest.Section(6, wasmtest.Vec(wasmtest.GlobalEntry(wasm.I64, true, []byte{0x42, 0, 0x0b}))))
+	}
+	sections = append(sections, wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("f", 0, 0))), wasmtest.Section(10, wasmtest.Vec(append(wasmtest.ULEB(uint32(len(caller))), caller...), append(wasmtest.ULEB(uint32(len(callee))), callee...))))
+	m, err := wasm.DecodeModule(wasmtest.Module(sections...))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = wasm.ValidateModule(m); err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+
+func TestOwnedForestMixedDirectOrdinary(t *testing.T) {
+	for _, lane := range []string{"int-result", "fp-result", "void"} {
+		t.Run(lane, func(t *testing.T) {
+			m := ownedMixedDirectModule(t, lane)
+			for _, intr := range []bool{false, true} {
+				var native, metaOracle []byte
+				for _, candidate := range []bool{false, true} {
+					work := &fixtureModuleWork{Forest: candidate, ScalarFP: true, ScalarFPMixedDirectCalls: true}
+					var stats ModuleStats
+					cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+					if err != nil {
+						t.Fatal(err)
+					}
+					if cm.CodeImage != nil {
+						defer cm.CodeImage.Close()
+					}
+					if work.LegacyBodies != 2 || work.Opcodes == 0 || work.Rejected != 0 || candidate && work.Vector.stores == 0 {
+						t.Fatalf("inactive legacy forest: %+v", work)
+					}
+					if work.FPMixedDirectCalls != 1 || work.FPMixedDeferredConstants != 1 {
+						t.Fatalf("mixed call/late FP literal inactive: %+v", work)
+					}
+					st := stats.Funcs[0]
+					if st.Calls["mixed"] != 1 || st.Calls["regabi"] != 0 || st.Calls["wrapper"] != 0 || st.Calls["inline"] != 0 || st.Peephole["mixed-call-reg-arg"] == 0 {
+						t.Fatalf("wrong strategy: %v %v", st.Calls, st.Peephole)
+					}
+					if len(cm.Entry) != 2 || len(cm.InternalEntry) != 2 || cm.Entry[0] >= cm.InternalEntry[0] || st.NativeSize.HostAdapterBytes <= 0 {
+						t.Fatal("exported caller adapter absent")
+					}
+					inputs := [][3]uint64{{19, 47, 0x8000000000000000}, {0xfffffffffffffff0, 11, 0x7ff8000000001234}, {0x100000001, 0x200000003, 0x401a000000000000}}
+					if lane == "fp-result" {
+						inputs = nil
+						for _, raw := range []uint64{0, 0x8000000000000000, 0x7ff8000000001234, 0x401a000000000000} {
+							// Solve the integer formula so the FP boundary moves
+							// each exact requested carrier; no FP arithmetic on it.
+							a, b := uint64(19), uint64(47)
+							bits := (raw ^ 0x4004000000000000) - ((a^b)*3 - a)
+							inputs = append(inputs, [3]uint64{a, b, bits})
+						}
+					}
+					for _, args := range inputs {
+						want := args[0] + 23 + (((args[0]^args[1])*3 - args[0] + args[2]) ^ 0x4004000000000000)
+						got, err := ownedRunModule(t, cm, args[:])
+						if err != nil || got != want {
+							t.Fatalf("intr=%v forest=%v args=%x got=%x want=%x err=%v", intr, candidate, args, got, want, err)
+						}
+					}
+					meta := *cm
+					meta.Code, meta.CodeImage = nil, nil
+					encoded, err := json.Marshal(meta)
+					if err != nil {
+						t.Fatal(err)
+					}
+					if !candidate {
+						native = append([]byte(nil), cm.Code...)
+						metaOracle = encoded
+					} else if !bytes.Equal(native, cm.Code) || !bytes.Equal(metaOracle, encoded) {
+						t.Fatal("native or encoder metadata differs")
+					}
+					t.Logf("intr=%v candidate=%v bytes=%d calls=%v peeps=%v work=%+v", intr, candidate, len(cm.Code), st.Calls, st.Peephole, work)
+				}
+			}
+		})
+	}
+}
