+// Exercise a legal two-cycle in each register bank directly. This fixture
+// uses the same mixed caller emitter, then executes an ordinary rel32 callee.
+func TestOwnedForestMixedDirectCycles(t *testing.T) {
+	var oracle []byte
+	for _, candidate := range []bool{false, true} {
+		f := closureStart(candidate)
+		work := &fixtureModuleWork{Forest: candidate, ScalarFP: true, ScalarFPMixedDirectCalls: true}
+		f.sc = &scratch{fixtureWork: work}
+		ft := &wasm.CompType{Params: []wasm.ValType{wasm.I64, wasm.F64, wasm.I64, wasm.F64}, Results: []wasm.ValType{wasm.I64}}
+		f.pushValue(storage{kind: stConst, typ: mtI64, cval: 13})
+		f.a.MovImm64(RCX, 17)
+		f.pushReg(RCX, mtI64)
+		f.a.MovImm64(R11, 41)
+		f.a.MovGprToXmm(1, R11, true)
+		f.pushFReg(1, mtF64)
+		f.a.MovImm64(RAX, 5)
+		f.pushReg(RAX, mtI64)
+		f.a.MovImm64(R11, 29)
+		f.a.MovGprToXmm(0, R11, true)
+		f.pushFReg(0, mtF64)
+		start := f.a.Len()
+		f.emitMixedRegisterCall(1, ft)
+		lowering := f.a.B[start:]
+		gp := &encoder.Asm{}
+		gp.Xchg64(RAX, RCX)
+		gpReverse := &encoder.Asm{}
+		gpReverse.Xchg64(RCX, RAX)
+		if !bytes.Contains(lowering, gp.B) && !bytes.Contains(lowering, gpReverse.B) {
+			t.Fatal("GP cycle did not emit swap")
+		}
+		fpCycle := false
+		for _, r := range []Reg{0, 1} {
+			x := &encoder.Asm{}
+			off := f.spillOff(1)
+			x.FStoreDisp(RSP, off, r, true)
+			x.FMov(r, 1-r, true)
+			x.FLoadDisp(1-r, RSP, off, true)
+			fpCycle = fpCycle || bytes.Contains(lowering, x.B)
+		}
+		if !fpCycle || len(f.relocs) != 1 || f.depth() != 2 || work.FPMixedDirectCalls != 1 {
+			t.Fatalf("FP cycle/ABI ownership missing: %x", lowering)
+		}
+		f.pushBinOp(opAdd, mtI64)
+		closureFinish(t, f, 37)
+		f.a.PatchRel32(int(f.relocs[0].at), f.a.Len())
+		// Callee observes argument ordering independently in each bank.
+		f.a.AluRR(0x29, RAX, RCX, true)
+		f.a.MovXmmToGpr(RDX, 0, true)
+		f.a.MovXmmToGpr(R8, 1, true)
+		f.a.AluRR(0x29, RDX, R8, true)
+		f.a.AluRR(0x01, RAX, RDX, true)
+		f.a.Ret()
+		closureRun(t, f, 37)
+		if !candidate {
+			oracle = append([]byte(nil), f.a.B...)
+		} else if !bytes.Equal(oracle, f.a.B) {
+			t.Fatal("paired cycle native code differs")
+		}
+	}
+}
