+// fixtureScalarFPMixedSignature admits both numeric banks, but restricts FP
+// entry to XMM0–3, disjoint from the extended float-local pin pool.
+func fixtureScalarFPMixedSignature(ft *wasm.CompType) bool {
+	if len(ft.Results) > 1 {
+		return false
+	}
+	gp, fp := 0, 0
+	for _, t := range ft.Params {
+		if isIntValType(t) {
+			gp++
+		} else if isFloatValType(t) {
+			fp++
+		} else {
+			return false
+		}
+	}
+	if gp > len(intArgRegs) || fp > 4 {
+		return false
+	}
+	hasGP, hasFP := gp != 0, fp != 0
+	for _, t := range ft.Results {
+		if isIntValType(t) {
+			hasGP = true
+		} else if isFloatValType(t) {
+			hasFP = true
+		} else {
+			return false
+		}
+	}
+	return hasGP && hasFP
+}
