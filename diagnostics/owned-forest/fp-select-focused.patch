+func (f *fn) fixtureScalarFPSelectEnabled() bool {
+	return f.fixtureScalarFPEnabled() && f.sc.fixtureWork.ScalarFPSelect
+}
+
+// Preflight the typed immediate and logical operands without consuming the
+// emitter reader or changing effect/ownership state.
+func (f *fn) checkFixtureSelect(op byte, probe wasm.Reader) error {
+	typ := mtNone
+	if op == 0x1c {
+		n, err := probe.U32()
+		if err != nil {
+			return err
+		}
+		if n != 1 {
+			return fmt.Errorf("fixture forest: unsupported typed float select immediate")
+		}
+		bt, err := probe.Byte()
+		if err != nil {
+			return err
+		}
+		switch bt {
+		case 0x7d:
+			typ = mtF32
+		case 0x7c:
+			typ = mtF64
+		default:
+			return fmt.Errorf("fixture forest: unsupported typed float select immediate")
+		}
+	}
+	if f.unreachable {
+		return nil // No concrete alternatives in the polymorphic stack.
+	}
+	b, a := f.s.forestLast(1), f.s.forestLast(2)
+	if op == 0x1b && (b == nil || a == nil ||
+		!rootMachineType(a).isFloat() && !rootMachineType(b).isFloat()) {
+		return nil // Existing integer lane.
+	}
+	if !f.fixtureScalarFPSelectEnabled() {
+		return fmt.Errorf("fixture forest: unsupported float select")
+	}
+	c := f.s.forestLast(0)
+	if a == nil || b == nil || c == nil || rootMachineType(c) != mtI32 {
+		return fmt.Errorf("fixture forest: unsupported float select operands")
+	}
+	if typ == mtNone {
+		typ = rootMachineType(a)
+	}
+	if !typ.isFloat() || rootMachineType(a) != typ || rootMachineType(b) != typ {
+		return fmt.Errorf("fixture forest: unsupported float select alternatives")
+	}
+	return nil
+}
