+// layoutPriorCursor is a test-only transcription of the pre-opt-in forest
+// traversal. All roots first get push/pop frames, including concrete or pending.
+type layoutPriorCursor struct {
+	roots                            []*elem
+	root, endRoot, n, writes, visits int
+	frames                           [maxDeferDepth + 4]fixtureCursorFrame
+}
+
+func (c *layoutPriorCursor) push(e *elem) {
+	if c.n >= len(c.frames) || !e.forestLive || e.hasPhysicalLinks() {
+		panic("prior cursor invalid child")
+	}
+	c.frames[c.n] = fixtureCursorFrame{node: e}
+	c.n++
+	c.writes++
+}
+
+func (c *layoutPriorCursor) next() *elem {
+	for {
+		if c.n == 0 {
+			if c.root == c.endRoot {
+				return nil
+			}
+			c.push(c.roots[c.root])
+			c.root++
+		}
+		top := &c.frames[c.n-1]
+		e := top.node
+		if e.isDeferred() && !e.forestPending {
+			switch top.phase {
+			case 0:
+				top.phase = 1
+				c.writes++
+				c.push(e.arg0)
+				continue
+			case 1:
+				top.phase = 2
+				c.writes++
+				if e.arg1 != nil {
+					c.push(e.arg1)
+					continue
+				}
+			}
+		}
+		c.n--
+		c.frames[c.n] = fixtureCursorFrame{}
+		c.writes++
+		c.visits++
+		return e
+	}
+}
+
+func TestOwnedForestReadyRootTraversalOrdinary(t *testing.T) {
+	val := func() *elem { return &elem{forestLive: true, st: storage{kind: stConst, typ: mtI32}} }
+	def := func(l, r *elem) *elem {
+		return &elem{forestLive: true, st: storage{kind: deferredStorageKind, typ: mtI32}, arg0: l, arg1: r}
+	}
+	t.Run("mixed-postorder", func(t *testing.T) {
+		ready, l, r, innerChild, tail := val(), val(), val(), val(), val()
+		inner := def(innerChild, nil)
+		pending := def(nil, nil)
+		pending.forestPending = true
+		left := def(l, r)
+		tree := def(left, inner)
+		checkLayoutReadyRoot(t, []*elem{ready, pending, tree, tail}, []*elem{ready, pending, l, r, left, innerChild, inner, tree, tail}, map[int]bool{0: true, 1: true, 8: true}, nil)
+	})
+	t.Run("retag-after-child-and-nested-scan", func(t *testing.T) {
+		child, nextChild, tail := val(), val(), val()
+		first := def(child, nextChild)
+		nextDeferredChild := val()
+		nextDeferred := def(nextDeferredChild, nil)
+		roots := []*elem{first, nextDeferred, tail}
+		checkLayoutReadyRoot(t, roots, []*elem{child, first, nextDeferred, tail}, map[int]bool{2: true, 3: true}, func(i int) {
+			if i == 0 {
+				// Complete materialization after the first child was yielded:
+				// neither cursor may consult the now-retired sibling.
+				first.st.kind = stConst
+				first.arg0, first.arg1 = nil, nil
+				child.forestLive, nextChild.forestLive = false, false
+				// A pending flags result has no remaining children to revisit.
+				nextDeferred.arg0 = nil
+				nextDeferred.forestPending = true
+				nextDeferredChild.forestLive = false
+				// Independent nested walk sees current state, while the
+				// suspended cursor retains and resumes its own frame.
+				checkLayoutReadyRoot(t, roots, []*elem{first, nextDeferred, tail}, map[int]bool{0: true, 1: true, 2: true}, nil)
+			}
+		})
+	})
+	t.Run("fixed-end-and-early-limit", func(t *testing.T) {
+		a, b, unseen := val(), val(), val()
+		// Deliberately stop after first yield and verify no later root was
+		// touched; then start an independent cursor restricted to prefix.
+		v := fixtureForest{roots: []*elem{a, b, unseen}}
+		s := stack{forest: &v}
+		c := s.fixtureScan(false)
+		if got := c.next(); got != a || c.root != 1 || v.visits != 1 || v.readyRootReturns != 1 || v.cursorWrites != 0 {
+			t.Fatalf("early yield=%p root=%d work=%+v", got, c.root, v)
+		}
+		checkLayoutReadyRoot(t, v.roots[:2], []*elem{a, b}, map[int]bool{0: true, 1: true}, nil)
+	})
+}
+
+func checkLayoutReadyRoot(t *testing.T, roots, want []*elem, ready map[int]bool, after func(int)) {
+	t.Helper()
+	v := fixtureForest{roots: roots}
+	s := stack{forest: &v}
+	got := s.fixtureScan(false)
+	old := layoutPriorCursor{roots: roots, endRoot: len(roots)}
+	for i, w := range want {
+		pw, cw, cr, cv := old.writes, v.cursorWrites, v.readyRootReturns, v.visits
+		o, n := old.next(), got.next()
+		if o != w || n != w {
+			t.Fatalf("yield%d old=%p current=%p want=%p", i, o, n, w)
+		}
+		saved := uint64(0)
+		if ready[i] {
+			saved = 1
+		}
+		if v.visits-cv != 1 || v.readyRootReturns-cr != saved || uint64(old.writes-pw) != v.cursorWrites-cw+2*saved {
+			t.Fatalf("yield%d old writes=%d current writes=%d bypass=%d expected=%d", i, old.writes-pw, v.cursorWrites-cw, v.readyRootReturns-cr, saved)
+		}
+		if after != nil {
+			after(i)
+		}
+	}
+	if old.next() != nil || got.next() != nil || old.visits != len(want) || v.visits != uint64(len(want)) || got.n != 0 || old.n != 0 {
+		t.Fatal("cursor failed exact exhaustion")
+	}
+}
