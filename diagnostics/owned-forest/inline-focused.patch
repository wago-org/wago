+//go:build (linux || darwin || windows) && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+	"testing"
+)
+
+func ownedInlineModule(t *testing.T, name string) *wasm.Module {
+	t.Helper()
+	prefix := []byte{0, 0x03, 0x40, 0x01, 0x0b}
+	var caller, helper []byte
+	hp := []wasm.ValType{wasm.I32}
+	hr := []wasm.ValType{wasm.I32}
+	switch name {
+	case "add-constant":
+		caller = []byte{0x20, 0, 0x20, 0, 0x10, 1, 0x6a, 0x0b}
+		helper = []byte{0, 0x20, 0, 0x41, 3, 0x6a, 0x0b}
+	case "add-parameters":
+		caller = []byte{0x20, 0, 0x20, 0, 0x41, 5, 0x10, 1, 0x6a, 0x0b}
+		hp = append(hp, wasm.I32)
+		helper = []byte{0, 0x20, 0, 0x20, 1, 0x6a, 0x0b}
+	case "forwarded-parameter", "scratch-repeated":
+		caller = []byte{0x20, 0, 0x20, 0, 0x10, 1, 0x41, 13, 0x21, 0, 0x20, 0, 0x10, 1, 0x6a, 0x6a, 0x0b}
+		helper = []byte{0, 0x20, 0, 0x41, 3, 0x6c, 0x41, 1, 0x6a, 0x0b}
+		if name == "scratch-repeated" {
+			helper = []byte{1, 1, 0x7f, 0x20, 0, 0x41, 3, 0x6c, 0x41, 1, 0x6a, 0x22, 0, 0x20, 1, 0x6a, 0x41, 7, 0x21, 1, 0x0b}
+		}
+	case "store-leaf":
+		caller = []byte{0x20, 0, 0x41, 0, 0x20, 0, 0x10, 1, 0x41, 23, 0x21, 0, 0x41, 0, 0x28, 2, 0, 0x6a, 0x20, 0, 0x6a, 0x0b}
+		hp = append(hp, wasm.I32)
+		hr = nil
+		helper = []byte{0, 0x20, 0, 0x20, 1, 0x36, 2, 0, 0x0b}
+	default:
+		t.Fatal("unknown fixture")
+	}
+	caller = append(prefix, caller...)
+	ss := [][]byte{wasmtest.Section(1, wasmtest.Vec(wasmtest.FuncType([]wasm.ValType{wasm.I32}, []wasm.ValType{wasm.I32}), wasmtest.FuncType(hp, hr))), wasmtest.Section(3, wasmtest.Vec(wasmtest.ULEB(0), wasmtest.ULEB(1)))}
+	if name == "store-leaf" {
+		ss = append(ss, wasmtest.Section(5, wasmtest.Vec([]byte{0, 1})))
+	}
+	ss = append(ss, wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("f", 0, 0))), wasmtest.Section(10, wasmtest.Vec(append(wasmtest.ULEB(uint32(len(caller))), caller...), append(wasmtest.ULEB(uint32(len(helper))), helper...))))
+	m, e := wasm.DecodeModule(wasmtest.Module(ss...))
+	if e != nil {
+		t.Fatal(e)
+	}
+	return m
+}
+
+func TestOwnedForestInlineOrdinary(t *testing.T) {
+	for _, name := range []string{"add-constant", "add-parameters", "forwarded-parameter", "scratch-repeated", "store-leaf"} {
+		t.Run(name, func(t *testing.T) {
+			m := ownedInlineModule(t, name)
+			expectedCalls := 1
+			if name == "forwarded-parameter" || name == "scratch-repeated" {
+				expectedCalls = 2
+			}
+			for _, intr := range []bool{false, true} {
+				var oracle []byte
+				for _, candidate := range []bool{false, true} {
+					work := &fixtureModuleWork{Forest: candidate}
+					var stats ModuleStats
+					cm, e := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+					if e != nil {
+						t.Fatal(e)
+					}
+					st := stats.Funcs[0]
+					if st.Calls["inline"] != expectedCalls || st.Calls["regabi"] != 0 || st.Calls["wrapper"] != 0 {
+						t.Fatalf("inline not selected: %+v", st.Calls)
+					}
+					if work.LegacyBodies == 0 || work.Opcodes == 0 || work.InlineCallGaps != 0 || (candidate && work.Vector.stores == 0) {
+						t.Fatalf("forest inactive: %+v", work)
+					}
+					switch name {
+					case "add-constant":
+						if st.Peephole["inline-i32-add-const"] == 0 {
+							t.Fatal("addconst inactive")
+						}
+					case "add-parameters":
+						if st.Peephole["inline-i32-add-argument"] == 0 {
+							t.Fatal("addparams inactive")
+						}
+					case "forwarded-parameter":
+						if st.Peephole["inline-integer-scalar-param-forward"] != 2 {
+							t.Fatal("forwarding inactive")
+						}
+					case "scratch-repeated":
+						if st.Peephole["inline-integer-scalar-param-forward"] != 0 {
+							t.Fatal("mutating callee unexpectedly forwarded")
+						}
+					}
+					for _, arg := range []uint64{7, 0x80000001, 0xffffffff} {
+						want := 2*arg + 3
+						switch name {
+						case "add-parameters":
+							want = 2*arg + 5
+						case "forwarded-parameter", "scratch-repeated":
+							want = 4*arg + 41
+						case "store-leaf":
+							want = 2*arg + 23
+						}
+						want = uint64(uint32(want))
+						got, e := ownedRunModule(t, cm, []uint64{arg})
+						if e != nil || got != want {
+							t.Fatalf("candidate=%v input=%x got=%x want=%x err=%v", candidate, arg, got, want, e)
+						}
+					}
+					if !candidate {
+						oracle = append([]byte(nil), cm.Code...)
+					} else if !bytes.Equal(oracle, cm.Code) {
+						t.Fatal("native differs")
+					}
+					t.Logf("case=%s intr=%v candidate=%v bytes=%d calls=%v peepholes=%v work=%+v", name, intr, candidate, len(cm.Code), st.Calls, st.Peephole, work)
+					if cm.CodeImage != nil {
+						cm.CodeImage.Close()
+					}
+				}
+			}
+		})
+	}
+}
