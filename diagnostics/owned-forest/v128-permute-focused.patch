+// Neither detached spill slots nor detached local aliases are visible to the
+// allocator's operand walk. Keep them live through all permutation scratch.
+func (f *fn) protectFixtureV128Permute(a, b *elem) (int, regMask) {
+	floor, pins := f.spillFloor, f.fpinned
+	work := f.sc.fixtureWork
+	for _, e := range [2]*elem{a, b} {
+		switch e.st.kind {
+		case stSlot:
+			end := e.st.slotIndex() + 2
+			if end > f.spillFloor {
+				f.spillFloor = end
+				work.TemporaryV128PermuteSlotLeases++
+			}
+		case stLocalReg:
+			if !f.fpinned.has(e.st.reg) {
+				f.fpinned = f.fpinned.add(e.st.reg)
+				work.TemporaryV128PermuteLocalLeases++
+			}
+		}
+	}
+	return floor, pins
+}
+
+func (f *fn) restoreFixtureV128Permute(floor int, pins regMask) {
+	f.spillFloor, f.fpinned = floor, pins
+}
+
 func (f *fn) fixtureV128BlockResultsEnabled() bool {
 	return f.fixtureTemporarySIMD && f.sc.fixtureWork.TemporaryV128BlockResults
