@@ -0,0 +1,148 @@
+//go:build linux && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"testing"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	encoder "github.com/wago-org/wago/src/core/encoder/amd64"
+	wr "github.com/wago-org/wago/src/core/runtime"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+)
+
+func ownedMemorySizeModule(t *testing.T, lane string) *wasm.Module {
+	t.Helper()
+	body := []byte{0, 0x20, 0}
+	switch lane {
+	case "prefix":
+		body = append(body, 0x3f, 0)
+	case "if":
+		body = append(body, 0x20, 1, 0x04, 0x7f, 0x3f, 0, 0x05, 0x3f, 0, 0x41, 1, 0x6a, 0x0b)
+	case "call":
+		body = append(body, 0x3f, 0, 0x20, 0, 0x10, 1, 0x3f, 0, 0x6a, 0x6a)
+	}
+	body = append(body, 0x41, 23, 0x21, 0, 0x6a, 0x20, 0, 0x6a, 0x0b)
+	if lane != "call" {
+		return modMem(t, 1, []wasm.ValType{wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, body)
+	}
+	caller := append(wasmtest.ULEB(uint32(len(body))), body...)
+	callee := []byte{0, 0x03, 0x40, 0x01, 0x0b}
+	callee = append(callee, bytes.Repeat([]byte{1}, 512)...)
+	callee = append(callee, 0x20, 0, 0x41, 7, 0x6a, 0x0b)
+	callee = append(wasmtest.ULEB(uint32(len(callee))), callee...)
+	i := wasm.I32
+	m, err := wasm.DecodeModule(wasmtest.Module(
+		wasmtest.Section(1, wasmtest.Vec(wasmtest.FuncType([]wasm.ValType{i, i}, []wasm.ValType{i}), wasmtest.FuncType([]wasm.ValType{i}, []wasm.ValType{i}))),
+		wasmtest.Section(3, wasmtest.Vec(wasmtest.ULEB(0), wasmtest.ULEB(1))),
+		wasmtest.Section(5, wasmtest.Vec([]byte{0, 1})),
+		wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("f", 0, 0))),
+		wasmtest.Section(10, wasmtest.Vec(caller, callee)),
+	))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+
+func ownedMemorySizeRun(t *testing.T, cm *encoder.CompiledModule, pages int, x, cond, want uint32) {
+	t.Helper()
+	eng, err := wr.NewEngine()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer eng.Close()
+	jm, err := wr.NewJobMemory(pages * 65536)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer jm.Close()
+	ar, err := wr.NewArena(4096)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ar.Close()
+	image, entry, err := wr.MapCode(cm.Code)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer wr.Unmap(image)
+	a, r, tr := ar.Alloc(256), ar.Alloc(256), ar.Alloc(wr.TrapBufferBytes)
+	binary.LittleEndian.PutUint64(a, uint64(x))
+	binary.LittleEndian.PutUint64(a[8:], uint64(cond))
+	err = eng.Call(entry+uintptr(cm.Entry[0]), a, jm.LinearMemory(), tr, r)
+	got := binary.LittleEndian.Uint32(r)
+	if err != nil || got != want {
+		t.Fatalf("pages=%d x=%x cond=%d got=%x want=%x err=%v", pages, x, cond, got, want, err)
+	}
+}
+
+func TestOwnedForestMemorySizeOrdinary(t *testing.T) {
+	for _, lane := range []string{"prefix", "if", "call"} {
+		t.Run(lane, func(t *testing.T) {
+			m := ownedMemorySizeModule(t, lane)
+			if err := wasm.ValidateModule(m); err != nil {
+				t.Fatal(err)
+			}
+			for _, intr := range []bool{false, true} {
+				var native, metaOracle []byte
+				for _, candidate := range []bool{false, true} {
+					work := &fixtureModuleWork{Forest: candidate}
+					var stats ModuleStats
+					cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+					if err != nil {
+						t.Fatal(err)
+					}
+					if cm.CodeImage != nil {
+						defer cm.CodeImage.Close()
+					}
+					if work.LegacyBodies == 0 || work.Opcodes == 0 || work.Rejected != 0 || candidate && work.Vector.stores == 0 {
+						t.Fatalf("inactive forest: %+v", work)
+					}
+					wantEmissions := uint64(2)
+					if lane == "prefix" {
+						wantEmissions = 1
+					}
+					if work.MemorySizeEmissions != wantEmissions {
+						t.Fatalf("actual size emissions=%d want %d", work.MemorySizeEmissions, wantEmissions)
+					}
+					if lane == "call" && stats.Funcs[0].Calls["regabi"] != 1 {
+						t.Fatalf("native call inactive: %v", stats.Funcs[0].Calls)
+					}
+					for _, pages := range []int{1, 3, 7} {
+						for _, cond := range []uint32{0, 1} {
+							x := uint32(19)
+							if cond == 1 {
+								x = 0xfffffff0
+							}
+							want := x + 23 + uint32(pages)
+							if lane == "if" && cond == 0 {
+								want++
+							}
+							if lane == "call" {
+								want += x + 7 + uint32(pages)
+							}
+							ownedMemorySizeRun(t, cm, pages, x, cond, want)
+						}
+					}
+					meta := *cm
+					meta.Code, meta.CodeImage = nil, nil
+					encoded, err := json.Marshal(meta)
+					if err != nil {
+						t.Fatal(err)
+					}
+					if !candidate {
+						native = append([]byte(nil), cm.Code...)
+						metaOracle = encoded
+					} else if !bytes.Equal(native, cm.Code) || !bytes.Equal(metaOracle, encoded) {
+						t.Fatal("native or encoder metadata differs")
+					}
+					t.Logf("intr=%v candidate=%v bytes=%d calls=%v work=%+v", intr, candidate, len(cm.Code), stats.Funcs[0].Calls, work)
+				}
+			}
+		})
+	}
+}
