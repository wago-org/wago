@@ -0,0 +1,234 @@
+//go:build linux && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"math"
+	"testing"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+)
+
+type ownedFPShape struct {
+	integer                                                  wasm.ValType
+	floatCode, load, store, add, eq, ne, intoFP, fromFP, xor byte
+	bits                                                     func(float64) uint64
+	quiet, sign                                              uint64
+}
+
+func (sh ownedFPShape) constant(b []byte, x float64) []byte {
+	v := sh.bits(x)
+	if sh.floatCode == 0x7d {
+		return binary.LittleEndian.AppendUint32(append(b, 0x43), uint32(v))
+	}
+	return binary.LittleEndian.AppendUint64(append(b, 0x44), v)
+}
+
+func TestOwnedForestScalarFPOrdinary(t *testing.T) {
+	for _, sh := range []ownedFPShape{
+		{wasm.I32, 0x7d, 0x2a, 0x38, 0x92, 0x5b, 0x5c, 0xbe, 0xbc, 0x73, func(x float64) uint64 { return uint64(math.Float32bits(float32(x))) }, 0x7fc01234, 1 << 31},
+		{wasm.I64, 0x7c, 0x2b, 0x39, 0xa0, 0x61, 0x62, 0xbf, 0xbd, 0x85, math.Float64bits, 0x7ff8000000001234, 1 << 63},
+	} {
+		for _, name := range []string{"load-store", "local-set", "local-tee", "compare-eq", "compare-ne", "pressure"} {
+			t.Run(fmt.Sprintf("width=%x/%s", sh.floatCode, name), func(t *testing.T) {
+				out := sh.integer
+				var b []byte
+				var expect func(a, b uint64) uint64
+				params := []wasm.ValType{sh.integer, sh.integer}
+				align := byte(2)
+				if sh.floatCode == 0x7c {
+					align = 3
+				}
+				switch name {
+				case "load-store":
+					// Nonconstant integer prefix feeds XMM, with exact float bits
+					// crossing back to GP only after the in-bounds store/load.
+					b = []byte{0, 0x41, 0, 0x20, 0, 0x20, 1, sh.xor, sh.intoFP}
+					b = sh.constant(b, 2.5)
+					b = append(b, sh.add, sh.store, align, 0, 0x41, 0, sh.load, align, 0, sh.fromFP, 0x0b)
+					expect = func(a, b uint64) uint64 { return sh.bits(5.75) }
+				case "local-set", "local-tee":
+					b = []byte{1, 1, sh.floatCode, 0x20, 0, sh.intoFP, 0x21, 2, 0x20, 2, 0x20, 2}
+					b = sh.constant(b, 2.5)
+					opcode := byte(0x21)
+					if name == "local-tee" {
+						opcode = 0x22
+					}
+					b = append(b, sh.add, opcode, 2)
+					if name == "local-set" {
+						b = append(b, 0x20, 2)
+					}
+					// New value leaves XMM; preserved old reference remains live
+					// below it until the second reinterpret.
+					b = append(b, sh.fromFP, 0x21, 1, sh.fromFP, 0x20, 1, sh.xor, 0x0b)
+					expect = func(a, b uint64) uint64 { return a ^ sh.bits(5.75) }
+				case "compare-eq", "compare-ne":
+					out = wasm.I32
+					cmp := sh.eq
+					if name == "compare-ne" {
+						cmp = sh.ne
+					}
+					b = []byte{0, 0x20, 0, sh.intoFP, 0x20, 1, sh.intoFP, cmp, 0x04, 0x7f, 0x41, 11, 0x05, 0x41, 17, 0x0b, 0x0b}
+				case "pressure":
+					b = []byte{0}
+					for range 24 {
+						b = append(b, 0x20, 0, 0x20, 1, sh.xor, sh.intoFP)
+						b = sh.constant(b, 0.75)
+						b = append(b, sh.add)
+					}
+					for range 23 {
+						b = append(b, sh.add)
+					}
+					b = append(b, sh.fromFP, 0x0b)
+					expect = func(a, b uint64) uint64 { return sh.bits(96) }
+				}
+				m := modMem(t, 1, params, []wasm.ValType{out}, b)
+				for _, intr := range []bool{false, true} {
+					var oracle, metaOracle []byte
+					for _, candidate := range []bool{false, true} {
+						var stats ModuleStats
+						work := &fixtureModuleWork{Forest: candidate, ScalarFP: true}
+						cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+						if err != nil {
+							t.Fatal(err)
+						}
+						if cm.CodeImage != nil {
+							defer cm.CodeImage.Close()
+						}
+						if work.LegacyBodies != 1 || work.Opcodes == 0 || work.Rejected != 0 || candidate && work.Vector.stores == 0 {
+							t.Fatalf("inactive scalar FP legacy body: %+v", work)
+						}
+						peeps := stats.Funcs[0].Peephole
+						if (name == "local-set" || name == "local-tee") && peeps["float-local-sink"] != 1 {
+							t.Fatalf("float local sink inactive: %v", peeps)
+						}
+						if (name == "compare-eq" || name == "compare-ne") && (peeps["float-branch-defer"] != 1 || peeps["float-branch-fuse"] != 1) {
+							t.Fatalf("float branch inactive: %v", peeps)
+						}
+						run := func(a, b, want uint64) {
+							got, err := ownedRunModule(t, cm, []uint64{a, b})
+							if got != want || err != nil {
+								t.Fatalf("intr=%v forest=%v args=%x,%x got=%x want=%x err=%v", intr, candidate, a, b, got, want, err)
+							}
+						}
+						if expect != nil {
+							a := sh.bits(3.25)
+							key := uint64(0x123)
+							if name == "local-set" || name == "local-tee" {
+								key = 0
+							}
+							run(a^key, key, expect(a, key))
+						} else {
+							for _, pair := range [][3]uint64{{sh.quiet, sh.quiet, 0}, {sh.sign, 0, 1}, {sh.bits(3.25), sh.bits(-2), 0}, {sh.bits(4), sh.bits(4), 1}} {
+								want := pair[2]
+								if name == "compare-ne" {
+									want = 1 - want
+								}
+								if want == 1 {
+									want = 11
+								} else {
+									want = 17
+								}
+								run(pair[0], pair[1], want)
+							}
+						}
+						meta := *cm
+						meta.Code, meta.CodeImage = nil, nil
+						encoded, err := json.Marshal(meta)
+						if err != nil {
+							t.Fatal(err)
+						}
+						if !candidate {
+							oracle = append([]byte(nil), cm.Code...)
+							metaOracle = encoded
+						} else if !bytes.Equal(oracle, cm.Code) || !bytes.Equal(metaOracle, encoded) {
+							t.Fatal("native or encoder metadata differs")
+						}
+						t.Logf("intr=%v candidate=%v bytes=%d peeps=%v work=%+v", intr, candidate, len(cm.Code), stats.Funcs[0].Peephole, work)
+					}
+				}
+			})
+		}
+	}
+}
+
+// Synthetic ownership checks only: no execution of these emitted snippets.
+func TestOwnedForestScalarFPOrdinaryPressureOwnership(t *testing.T) {
+	for _, lane := range []string{"oldest", "barrier", "cross-bank"} {
+		var oracle []byte
+		for _, candidate := range []bool{false, true} {
+			f := closureStart(candidate)
+			f.sc = &scratch{fixtureWork: &fixtureModuleWork{Forest: candidate, ScalarFP: true}}
+			f.fpinned = maskOf(0)
+			var floats [16]*elem
+			for r := Reg(1); r < 16; r++ {
+				floats[r] = f.pushFReg(r, mtF64)
+			}
+			switch lane {
+			case "oldest":
+				// Avoid the oldest stack owner and pin an independent XMM.
+				if r := f.allocFReg(maskOf(1)); r != 2 || floats[2].st.kind != stSlot || floats[2].st.typ != mtF64 || f.fregUser[2] != nil || f.fregUser[1] != floats[1] {
+					t.Fatalf("candidate=%v wrong XMM victim, allocated %d", candidate, r)
+				}
+			case "barrier":
+				f.locals[0] = localDef{state: lsReg, reg: R12, typ: mtI32}
+				f.pinnedLocalMask = f.pinnedLocalMask.add(R12)
+				var deepest *elem
+				for _, r := range gpAlloc {
+					if r == R12 {
+						continue
+					}
+					e := f.pushReg(r, mtI32)
+					if deepest == nil {
+						deepest = e
+					}
+				}
+				// One outer full effect walk forces an XMM spill from its
+				// first pending load, then resumes and forces a GP spill.
+				floatLoad := f.pushValue(fmemRefStorage(R12, 8, true, 0))
+				intLoad := f.pushValue(memRefStorage(R12, 16, 4, false, false, 0))
+				if floatLoad.st.kind != stMemRef || intLoad.st.kind != stMemRef {
+					t.Fatal("pending loads absent")
+				}
+				f.materializePendingLoads()
+				if floats[1].st.kind != stSlot || floats[1].st.typ != mtF64 || deepest.st.kind != stSlot {
+					t.Fatalf("candidate=%v pending effect walk did not force both oldest-owner spills", candidate)
+				}
+				if floatLoad.st.kind != stReg || f.fregUser[floatLoad.st.reg] != floatLoad ||
+					intLoad.st.kind != stReg || f.regUser[intLoad.st.reg] != intLoad {
+					t.Fatalf("candidate=%v outer walk failed to resume across nested allocators", candidate)
+				}
+				if candidate {
+					independentForestNilLinks(t, f, []*elem{floats[1], deepest, floatLoad, intLoad})
+				}
+			case "cross-bank":
+				// The only unreserved GP is owned by an ordinary pending FP
+				// load, so the GP victim scan itself invokes the XMM allocator.
+				address := gpAlloc[0]
+				for _, r := range gpAlloc[1:] {
+					f.reserved = f.reserved.add(r)
+				}
+				pending := f.pushValue(fmemRefStorage(address, 8, true, -1))
+				f.regUser[address] = pending
+				if r := f.allocReg(0); r != address || pending.st.kind != stSlot || pending.st.typ != mtF64 ||
+					floats[1].st.kind != stSlot || floats[1].st.typ != mtF64 ||
+					f.regUser[address] != nil || f.fregUser[1] != nil {
+					t.Fatalf("candidate=%v GP pressure did not spill oldest XMM owner and pending load: allocated %d", candidate, r)
+				}
+				if candidate {
+					independentForestNilLinks(t, f, []*elem{floats[1], pending})
+				}
+
+			}
+			if !candidate {
+				oracle = append([]byte(nil), f.a.B...)
+			} else if !bytes.Equal(oracle, f.a.B) {
+				t.Fatalf("lane=%s pressure lowering differs", lane)
+			}
+		}
+	}
+}
