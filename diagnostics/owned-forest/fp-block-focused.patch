diff --git a/src/core/compiler/backend/railshot/amd64/owned_forest_fp_block_independent_test.go b/src/core/compiler/backend/railshot/amd64/owned_forest_fp_block_independent_test.go
new file mode 100644
index 00000000..231d035c
--- /dev/null
+++ b/src/core/compiler/backend/railshot/amd64/owned_forest_fp_block_independent_test.go
@@ -0,0 +1,123 @@
+//go:build linux && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"math"
+	"testing"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+)
+
+func TestOwnedForestFPBlockOrdinary(t *testing.T) {
+	for _, sh := range []ownedFPShape{
+		{integer: wasm.I32, floatCode: 0x7d, add: 0x92, intoFP: 0xbe, fromFP: 0xbc, xor: 0x73, bits: func(v float64) uint64 { return uint64(math.Float32bits(float32(v))) }, quiet: 0x7fc01234, sign: 1 << 31},
+		{integer: wasm.I64, floatCode: 0x7c, add: 0xa0, intoFP: 0xbf, fromFP: 0xbd, xor: 0x85, bits: math.Float64bits, quiet: 0x7ff8000000001234, sign: 1 << 63},
+	} {
+		for _, name := range []string{"if-merge", "block-br-merge", "block-br-if-merge", "if-pinned-slot"} {
+			t.Run(fmt.Sprintf("width=%x/%s", sh.floatCode, name), func(t *testing.T) {
+				slot := name == "if-pinned-slot"
+				n := byte(1)
+				if slot {
+					n = 12
+				}
+				b := []byte{1, n, sh.floatCode}
+				if slot {
+					for i := byte(0); i < n; i++ {
+						b = sh.constant(b, float64(i+1))
+						b = append(b, 0x21, 4+i)
+					}
+					// Preserve raw FP prefix while 12 independent FP locals
+					// retain their natural homes for reads after the join.
+					b = append(b, 0x20, 3, sh.intoFP)
+				} else {
+					b = append(b, 0x20, 3, sh.intoFP, 0x21, 4, 0x20, 4)
+				}
+				pick := func(b []byte, i byte) []byte { return append(b, 0x20, i, sh.intoFP) }
+				switch name {
+				case "if-merge", "if-pinned-slot":
+					b = append(b, 0x20, 0, 0x04, sh.floatCode)
+					b = pick(b, 1)
+					b = append(b, 0x05)
+					b = pick(b, 2)
+				case "block-br-merge":
+					b = append(b, 0x02, sh.floatCode)
+					b = pick(b, 1)
+					b = append(b, 0x0c, 0)
+				case "block-br-if-merge":
+					b = append(b, 0x02, sh.floatCode)
+					b = pick(b, 1)
+					b = append(b, 0x20, 0, 0x0d, 0, 0x1a)
+					b = pick(b, 2)
+				}
+				b = append(b, 0x0b, sh.fromFP)
+				// Save the result bits in integer local 2, then consume the
+				// separate raw FP prefix without performing arithmetic on it.
+				b = append(b, 0x21, 2, sh.fromFP, 0x20, 2, sh.xor)
+				if slot {
+					b = sh.constant(b, 0)
+					for i := byte(0); i < n; i++ {
+						b = append(b, 0x20, 4+i, 0x20, 4+i, sh.add, sh.add)
+					}
+					b = append(b, sh.fromFP, sh.xor)
+				}
+				b = append(b, 0x0b)
+				m := mod1(t, []wasm.ValType{wasm.I32, sh.integer, sh.integer, sh.integer}, []wasm.ValType{sh.integer}, b)
+				for _, intr := range []bool{false, true} {
+					var native, metaOracle []byte
+					for _, candidate := range []bool{false, true} {
+						work := &fixtureModuleWork{Forest: candidate, ScalarFP: true, ScalarFPBlockResults: true}
+						var stats ModuleStats
+						cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+						if err != nil {
+							t.Fatal(err)
+						}
+						if cm.CodeImage != nil {
+							defer cm.CodeImage.Close()
+						}
+						if work.LegacyBodies != 1 || work.Opcodes == 0 || work.Rejected != 0 || candidate && work.Vector.stores == 0 {
+							t.Fatalf("inactive FP block legacy: %+v", work)
+						}
+						wantMerge, wantSlot := uint64(1), uint64(0)
+						if slot {
+							wantMerge, wantSlot = 0, 1
+						}
+						if work.FPBlockRegMerges != wantMerge || work.FPBlockPinConflictSlots != wantSlot {
+							t.Fatalf("pin total=%d, mode reg=%d slot-conflict=%d; want %d/%d", stats.Funcs[0].PinnedLocals, work.FPBlockRegMerges, work.FPBlockPinConflictSlots, wantMerge, wantSlot)
+						}
+						for _, args := range [][4]uint64{{1, sh.sign, sh.quiet, 0}, {0, sh.sign, sh.quiet, sh.sign}, {1, sh.quiet, 0, sh.sign}, {0, sh.quiet, 0, sh.quiet}} {
+							chosen := args[1]
+							if args[0] == 0 && name != "block-br-merge" {
+								chosen = args[2]
+							}
+							want := chosen ^ args[3]
+							if slot {
+								want ^= sh.bits(156)
+							}
+							got, err := ownedRunModule(t, cm, args[:])
+							if err != nil || got != want {
+								t.Fatalf("intr=%v forest=%v args=%x got=%x want=%x err=%v", intr, candidate, args, got, want, err)
+							}
+						}
+						meta := *cm
+						meta.Code, meta.CodeImage = nil, nil
+						encoded, err := json.Marshal(meta)
+						if err != nil {
+							t.Fatal(err)
+						}
+						if !candidate {
+							native = append([]byte(nil), cm.Code...)
+							metaOracle = encoded
+						} else if !bytes.Equal(native, cm.Code) || !bytes.Equal(metaOracle, encoded) {
+							t.Fatal("native or encoder metadata differs")
+						}
+						t.Logf("intr=%v candidate=%v bytes=%d pins=%d work=%+v", intr, candidate, len(cm.Code), stats.Funcs[0].PinnedLocals, work)
+					}
+				}
+			})
+		}
+	}
+}
