diff --git a/src/core/compiler/backend/railshot/amd64/owned_forest_bulk_independent_test.go b/src/core/compiler/backend/railshot/amd64/owned_forest_bulk_independent_test.go
new file mode 100644
index 00000000..8f223e83
--- /dev/null
+++ b/src/core/compiler/backend/railshot/amd64/owned_forest_bulk_independent_test.go
@@ -0,0 +1,166 @@
+//go:build linux && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"testing"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	encoder "github.com/wago-org/wago/src/core/encoder/amd64"
+	wr "github.com/wago-org/wago/src/core/runtime"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+)
+
+func ownedBulkRun(t *testing.T, cm *encoder.CompiledModule, args [4]int, want []byte) {
+	t.Helper()
+	eng, err := wr.NewEngine()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer eng.Close()
+	jm, err := wr.NewJobMemory(65536)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer jm.Close()
+	mem := jm.LinearMemory()
+	for i := range mem {
+		mem[i] = byte(i*29 + 13)
+	}
+	ar, err := wr.NewArena(4096)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ar.Close()
+	image, entry, err := wr.MapCode(cm.Code)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer wr.Unmap(image)
+	a, r, tr := ar.Alloc(256), ar.Alloc(256), ar.Alloc(wr.TrapBufferBytes)
+	for i, v := range args {
+		binary.LittleEndian.PutUint64(a[i*8:], uint64(v))
+	}
+	if err = eng.Call(entry+uintptr(cm.Entry[0]), a, mem, tr, r); err != nil {
+		t.Fatal(err)
+	}
+	if got := binary.LittleEndian.Uint64(r); got != uint64(args[0]+23) {
+		t.Fatalf("old local prefix: got %d want %d", got, args[0]+23)
+	}
+	if !bytes.Equal(mem, want) {
+		for i := range want {
+			if mem[i] != want[i] {
+				t.Fatalf("memory[%d]: got %d want %d", i, mem[i], want[i])
+			}
+		}
+		t.Fatal("memory length mismatch")
+	}
+}
+
+func TestOwnedForestBulkOrdinary(t *testing.T) {
+	for _, tc := range []struct {
+		name, op, peep string
+		fixed          int
+	}{
+		{"copy-dynamic", "copy", "", -1},
+		{"copy-constant-small", "copy", "memcopy-unroll", 9},
+		{"copy-constant-vector", "copy", "memcopy-unroll", 39},
+		{"fill-dynamic", "fill", "", -1},
+		{"fill-constant-small", "fill", "memfill-unroll", 9},
+		{"fill-constant-vector", "fill", "memfill-vector", 39},
+		{"fill-copy-forward", "forward", "bulk-fill-copy-forward", -1},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			// local0 = dst, 1 = src, 2 = length, 3 = fill pattern. Keep
+			// an older local0 snapshot live below arguments until after the effect.
+			body := []byte{0, 0x20, 0}
+			putLength := func(b []byte) []byte {
+				if tc.fixed < 0 {
+					return append(b, 0x20, 2)
+				}
+				return append(append(b, 0x41), wasmtest.SLEB32(int32(tc.fixed))...)
+			}
+			if tc.op == "forward" {
+				// Exact natural fill-copy pattern: same local sources/count.
+				body = append(body, 0x20, 1, 0x41, 7, 0x20, 2, 0xfc, 11, 0)
+			}
+			body = append(body, 0x20, 0)
+			if tc.op == "fill" {
+				body = append(body, 0x20, 3)
+			} else {
+				body = append(body, 0x20, 1)
+			}
+			body = putLength(body)
+			if tc.op == "fill" {
+				body = append(body, 0xfc, 11, 0)
+			} else {
+				body = append(body, 0xfc, 10, 0, 0)
+			}
+			body = append(body, 0x41, 23, 0x21, 0, 0x20, 0, 0x6a, 0x0b)
+			m := modMem(t, 1, []wasm.ValType{wasm.I32, wasm.I32, wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, body)
+			for _, intr := range []bool{false, true} {
+				var baselineCode, baselineMeta []byte
+				for _, candidate := range []bool{false, true} {
+					work := &fixtureModuleWork{Forest: candidate}
+					var stats ModuleStats
+					cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+					if err != nil {
+						t.Fatal(err)
+					}
+					if cm.CodeImage != nil {
+						defer cm.CodeImage.Close()
+					}
+					if work.LegacyBodies != 1 || work.Opcodes == 0 || work.Rejected != 0 || candidate && work.Vector.stores == 0 {
+						t.Fatalf("inactive bulk legacy body: %+v", work)
+					}
+					st := stats.Funcs[0]
+					if tc.peep != "" && st.Peephole[tc.peep] != 1 {
+						t.Fatalf("missing %s: %v", tc.peep, st.Peephole)
+					}
+					for _, args := range [][4]int{{51, 48, 72, 0x1db}, {45, 48, 72, 0x123}, {131, 32, 72, 0xfe}} {
+						t.Run(fmt.Sprintf("intr=%v/forest=%v/dst=%d", intr, candidate, args[0]), func(t *testing.T) {
+							want := make([]byte, 65536)
+							for i := range want {
+								want[i] = byte(i*29 + 13)
+							}
+							dst, src, n, val := args[0], args[1], args[2], byte(args[3])
+							if tc.fixed >= 0 {
+								n = tc.fixed
+							}
+							if tc.op == "forward" {
+								for i := 0; i < n; i++ {
+									want[src+i] = 7
+								}
+							}
+							if tc.op == "fill" {
+								for i := 0; i < n; i++ {
+									want[dst+i] = val
+								}
+							} else {
+								copy(want[dst:dst+n], want[src:src+n])
+							}
+							ownedBulkRun(t, cm, args, want)
+						})
+					}
+					meta := *cm
+					meta.Code, meta.CodeImage = nil, nil
+					encoded, err := json.Marshal(meta)
+					if err != nil {
+						t.Fatal(err)
+					}
+					if !candidate {
+						baselineCode = append([]byte(nil), cm.Code...)
+						baselineMeta = encoded
+					} else if !bytes.Equal(baselineCode, cm.Code) || !bytes.Equal(baselineMeta, encoded) {
+						t.Fatal("native or encoder metadata differs")
+					}
+					t.Logf("intr=%v candidate=%v bytes=%d peeps=%v work=%+v", intr, candidate, len(cm.Code), st.Peephole, work)
+				}
+			}
+		})
+	}
+}
