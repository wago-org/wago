+// allocBulkFReg leases transient XMM scratch for integer bulk copy and fill.
+// The forest slice does not admit guest XMM ownership or persistent FP local
+// pins, so only the ordinary free-register search is permitted. In particular,
+// it does not add a forest victim policy or enable guest FP allocation.
+func (f *fn) allocBulkFReg(avoid regMask) Reg {
+	if f.s.forest == nil {
+		return f.allocFReg(avoid)
+	}
+	if f.fpinnedLocalMask != 0 {
+		panic("fixture forest: bulk XMM scratch with FP local pins")
+	}
+	for _, owner := range f.fregUser {
+		if owner != nil {
+			panic("fixture forest: bulk XMM scratch with live guest XMM owner")
+		}
+	}
+	if r := f.freeFReg(avoid); r != regNone {
+		return r
+	}
+	panic("fixture forest: bulk XMM scratch exhausted")
+}
