+// checkFixtureBulkMemory validates the closed fixture subset without consuming
+// the emitter reader or changing stack, region, or memory-forwarding state.
+func (f *fn) checkFixtureBulkMemory(sub uint32, probe wasm.Reader) error {
+	count := 1
+	switch sub {
+	case 10:
+		count = 2
+	case 11:
+	default:
+		return fmt.Errorf("fixture forest: unsupported opcode 0xfc subopcode %d", sub)
+	}
+	for range count {
+		idx, err := probe.U32()
+		if err != nil {
+			return err
+		}
+		if idx != 0 {
+			return fmt.Errorf("fixture forest: unsupported bulk memory index %d", idx)
+		}
+	}
+	mt, ok := f.memoryType(0)
+	if !ok || mt.Limits.Addr64 || mt.Shared || f.guardMode || f.threadedMemory0 {
+		return fmt.Errorf("fixture forest: unsupported bulk memory state")
+	}
+	return nil
+}
