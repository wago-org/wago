+// Preflight a selected non-tail control splice before binding arguments or
+// changing the caller's local base. A recursive target may call only itself;
+// the ordinary selector suppresses re-splicing at nonzero inlineDepth.
+func (f *fn) fixtureInlineIntegerControlBody(t *inlineTarget) bool {
+	if !t.hasCtrl || t.tupleSelect() || t.tupleLoop() || t.tailLoop() {
+		return false
+	}
+	r := wasm.NewReader(t.body)
+	depth := 1 // synthetic function-result frame
+	for r.HasNext() {
+		op, err := r.Byte()
+		if err != nil || !fixtureScalarOpcode(op) {
+			return false
+		}
+		switch op {
+		case 0x03, 0x0e, 0x23, 0x24, 0xfc: // loop, br_table, globals, prefixed effects
+			return false
+		case 0x02, 0x04:
+			bt, ok := r.Peek()
+			if !ok || (bt != 0x40 && bt != 0x7f && bt != 0x7e) {
+				return false
+			}
+			depth++
+		case 0x0b:
+			depth--
+			if depth == 0 {
+				return !r.HasNext()
+			}
+		case 0x10:
+			callee, err := r.U32()
+			if err != nil || !t.recursive() || callee != uint32(t.globalIdx) {
+				return false
+			}
+			// The existing direct-call sink uses an unrebased local index.
+			if next, ok := r.Peek(); ok && next == 0x21 {
+				return false
+			}
+			continue
+		}
+		if f.classifier.SkipImmediate(r, op) != nil {
+			return false
+		}
+	}
+	return false
+}
