diff --git a/src/core/compiler/backend/railshot/amd64/owned_forest_control_inline_independent_test.go b/src/core/compiler/backend/railshot/amd64/owned_forest_control_inline_independent_test.go
new file mode 100644
index 00000000..c14153f2
--- /dev/null
+++ b/src/core/compiler/backend/railshot/amd64/owned_forest_control_inline_independent_test.go
@@ -0,0 +1,118 @@
+//go:build linux && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"encoding/json"
+	"testing"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+)
+
+func ownedControlInlineMemoryModule(t *testing.T) *wasm.Module {
+	t.Helper()
+	i32 := wasm.I32
+	params := []wasm.ValType{i32, i32}
+	caller := []byte{0, 0x20, 0, 0x20, 0, 0x20, 1, 0x10, 1, 0x41, 23, 0x21, 0, 0x6a, 0x20, 0, 0x6a, 0x0b}
+	leaf := []byte{1, 1, 0x7f, 0x20, 0, 0x41, 3, 0x6a, 0x21, 2, 0x20, 1, 0x04, 0x40,
+		// True branch stores the new numerically private local and returns directly.
+		0x41, 24, 0x20, 2, 0x36, 2, 0, 0x41, 24, 0x28, 2, 0, 0x0f, 0x05,
+		// False branch overwrites the private local and reaches ordinary end.
+		0x20, 0, 0x41, 5, 0x6b, 0x21, 2, 0x0b,
+		0x41, 24, 0x20, 2, 0x36, 2, 0, 0x41, 24, 0x28, 2, 0, 0x0b}
+	m, e := wasm.DecodeModule(wasmtest.Module(
+		wasmtest.Section(1, wasmtest.Vec(wasmtest.FuncType(params, []wasm.ValType{i32}))),
+		wasmtest.Section(3, wasmtest.Vec(wasmtest.ULEB(0), wasmtest.ULEB(0))),
+		wasmtest.Section(5, wasmtest.Vec([]byte{0, 1})),
+		wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("f", 0, 0))),
+		wasmtest.Section(10, wasmtest.Vec(append(wasmtest.ULEB(uint32(len(caller))), caller...), append(wasmtest.ULEB(uint32(len(leaf))), leaf...))),
+	))
+	if e != nil {
+		t.Fatal(e)
+	}
+	return m
+}
+
+func TestOwnedForestControlInlineOrdinary(t *testing.T) {
+	for _, name := range []string{"memory-leaf", "one-level-fib"} {
+		t.Run(name, func(t *testing.T) {
+			var m *wasm.Module
+			recursive := name == "one-level-fib"
+			if recursive {
+				// Same bounded non-tail one-level recursive class as existing backend test.
+				body := []byte{0, 0x20, 0, 0x41, 2, 0x48, 0x04, 0x7e, 0x20, 0, 0xac, 0x05,
+					0x20, 0, 0x41, 1, 0x6b, 0x10, 0, 0x20, 0, 0x41, 2, 0x6b, 0x10, 0, 0x7c, 0x0b, 0x0b}
+				m = modFuncs(t, funcDef{params: []wasm.ValType{wasm.I32}, results: []wasm.ValType{wasm.I64}, body: body})
+			} else {
+				m = ownedControlInlineMemoryModule(t)
+			}
+			if err := wasm.ValidateModule(m); err != nil {
+				t.Fatal(err)
+			}
+			for _, intr := range []bool{false, true} {
+				var native, metaOracle []byte
+				for _, candidate := range []bool{false, true} {
+					work := &fixtureModuleWork{Forest: candidate, IntegerControlInline: true}
+					var stats ModuleStats
+					cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+					if err != nil {
+						t.Fatal(err)
+					}
+					if cm.CodeImage != nil {
+						defer cm.CodeImage.Close()
+					}
+					if work.LegacyBodies == 0 || work.Opcodes == 0 || work.Rejected != 0 || candidate && work.Vector.stores == 0 {
+						t.Fatalf("inactive forest: %+v", work)
+					}
+					inline, nativeCalls := 1, 0
+					if recursive {
+						inline, nativeCalls = 2, 4
+					}
+					if (!recursive && (work.IntegerControlInlineLeaves != 1 || work.IntegerControlInlineRecursive != 0)) || (recursive && (work.IntegerControlInlineLeaves != 0 || work.IntegerControlInlineRecursive != 2)) {
+						t.Fatalf("control inline inactive: %+v", work)
+					}
+					st := stats.Funcs[0]
+					if st.Calls["inline"] != inline || st.Calls["regabi"] != nativeCalls || st.Calls["wrapper"] != 0 || st.Calls["mixed"] != 0 {
+						t.Fatalf("wrong inline strategy: %v", st.Calls)
+					}
+					if !recursive {
+						for _, args := range [][2]uint64{{7, 0}, {7, 1}, {0x80000001, 1}, {0xffffffff, 0}} {
+							want := uint32(args[0]) + uint32(args[0]) + 23
+							if args[1] != 0 {
+								want += 3
+							} else {
+								want -= 5
+							}
+							got, e := ownedRunModule(t, cm, args[:])
+							if e != nil || got != uint64(want) {
+								t.Fatalf("args=%v result=%v want=%v err=%v", args, got, want, e)
+							}
+						}
+					} else {
+						for _, row := range [][2]uint64{{0, 0}, {1, 1}, {2, 1}, {5, 5}, {10, 55}} {
+							got, e := ownedRunModule(t, cm, row[:1])
+							if e != nil || got != row[1] {
+								t.Fatalf("n=%v result=%v want=%v err=%v", row[0], got, row[1], e)
+							}
+						}
+					}
+					meta := *cm
+					meta.Code, meta.CodeImage = nil, nil
+					encoded, err := json.Marshal(meta)
+					if err != nil {
+						t.Fatal(err)
+					}
+					if !candidate {
+						native = append([]byte(nil), cm.Code...)
+						metaOracle = encoded
+					} else if !bytes.Equal(native, cm.Code) || !bytes.Equal(metaOracle, encoded) {
+						t.Fatal("native or encoder metadata differs")
+					}
+					t.Logf("intr=%v candidate=%v bytes=%d calls=%v work=%+v", intr, candidate, len(cm.Code), st.Calls, work)
+				}
+			}
+		})
+	}
+}
