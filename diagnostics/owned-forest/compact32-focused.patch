@@ -0,0 +1,52 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+//
+// SPDX-License-Identifier: MPL-2.0
+// Copyright (c) 2026 Wago authors and contributors
+
+//go:build amd64 && wago_owned_forest_compact && !wago_owned_forest_compact32
+
+package amd64
+
+const (
+	compactForestLive          uint32 = 1 << 31
+	compactForestPending       uint32 = 1 << 30
+	compactForestOwnershipMask        = compactForestLive | compactForestPending
+)
+
+func (e *elem) forestIsLive() bool    { return e.st.cold&compactForestLive != 0 }
+func (e *elem) forestIsPending() bool { return e.st.cold&compactForestPending != 0 }
+func (e *elem) setForestLive(v bool) {
+	if v {
+		e.st.cold |= compactForestLive
+	} else {
+		e.st.cold &^= compactForestLive
+	}
+}
+func (e *elem) setForestPending(v bool) {
+	if v {
+		e.st.cold |= compactForestPending
+	} else {
+		e.st.cold &^= compactForestPending
+	}
+}
+
+func (st storage) coldIndex() uint32 { return st.cold &^ compactForestOwnershipMask }
+func (st *storage) setColdIndex(index uint32) {
+	if index != 0 {
+		panic("compact operand nodes: custom cold index is unsupported")
+	}
+	st.cold &= compactForestOwnershipMask
+}
+
+// Value storage snapshots may contain the donor's ownership bits. A fresh
+// node starts detached; a replacement retains the destination's ownership.
+func (e *elem) setFreshStorage(st storage) {
+	st.cold &^= compactForestOwnershipMask
+	e.st = st
+}
+func (e *elem) setStoragePreservingOwnership(st storage) {
+	st.cold = st.coldIndex() | (e.st.cold & compactForestOwnershipMask)
+	e.st = st
+}
diff --git a/src/core/compiler/backend/railshot/amd64/operand_storage_compact32.go b/src/core/compiler/backend/railshot/amd64/operand_storage_compact32.go
new file mode 100644
index 00000000..5755acd9
--- /dev/null
+++ b/src/core/compiler/backend/railshot/amd64/operand_storage_compact32.go
@@ -0,0 +1,195 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+//
+// SPDX-License-Identifier: MPL-2.0
+// Copyright (c) 2026 Wago authors and contributors
+
+//go:build amd64 && wago_owned_forest_compact && wago_owned_forest_compact32
+
+package amd64
+
+import "unsafe"
+
+// Keep the complete slot/displacement/label word. payload is a type-checked
+// union of literal/owned bits, an index, or a deferred memory reference.
+type storage struct {
+	payload int64
+	slot    uint32
+	kind    storageKind
+	typ     machineType // low machine type; high two bits hold node ownership
+	reg     Reg
+	meta    uint8
+}
+
+var (
+	_ [16 - unsafe.Sizeof(storage{})]byte
+	_ [unsafe.Sizeof(storage{}) - 16]byte
+	_ [32 - unsafe.Sizeof(elem{})]byte
+	_ [unsafe.Sizeof(elem{}) - 32]byte
+)
+
+const (
+	compactForestLive          machineType = 1 << 7
+	compactForestPending       machineType = 1 << 6
+	compactForestOwnershipMask             = compactForestLive | compactForestPending
+	compactBorrowBits                      = 33
+	compactBorrowMask          uint64      = 1<<compactBorrowBits - 1
+	compactMemIndexMask        uint32      = (1 << 9) - 1
+)
+
+func (st storage) machineType() machineType { return st.typ &^ compactForestOwnershipMask }
+func (st *storage) setMachineType(typ machineType) {
+	if typ > mtCustom {
+		panic("compact32: invalid machine type")
+	}
+	st.typ = st.typ&compactForestOwnershipMask | typ
+}
+
+func (e *elem) forestIsLive() bool    { return e.st.typ&compactForestLive != 0 }
+func (e *elem) forestIsPending() bool { return e.st.typ&compactForestPending != 0 }
+func (e *elem) setForestLive(v bool) {
+	if v {
+		e.st.typ |= compactForestLive
+	} else {
+		e.st.typ &^= compactForestLive
+	}
+}
+func (e *elem) setForestPending(v bool) {
+	if v {
+		e.st.typ |= compactForestPending
+	} else {
+		e.st.typ &^= compactForestPending
+	}
+}
+
+func (storage) coldIndex() uint32 { return 0 }
+func (*storage) setColdIndex(index uint32) {
+	if index != 0 {
+		panic("compact operand nodes: custom cold index is unsupported")
+	}
+}
+
+func (e *elem) setFreshStorage(st storage) {
+	st.typ &^= compactForestOwnershipMask
+	e.st = st
+}
+func (e *elem) setStoragePreservingOwnership(st storage) {
+	st.typ = st.machineType() | (e.st.typ & compactForestOwnershipMask)
+	e.st = st
+}
+
+func constantStorage(typ machineType, bits int64) storage {
+	return storage{kind: stConst, typ: typ, payload: bits}
+}
+
+func floatLiteralPayload(typ machineType, bits int64) storage {
+	if !typ.isFloat() {
+		panic("compact32: invalid scratch float type")
+	}
+	return storage{typ: typ, payload: bits}
+}
+
+func compactIndexedKind(kind storageKind) bool {
+	switch kind {
+	case stLocalRef, stLocalReg, stGlobalRef, stGlobReg, stFuncRef:
+		return true
+	default:
+		return false
+	}
+}
+
+func indexedStorage(kind storageKind, typ machineType, reg Reg, index uint32, meta uint8) storage {
+	if !compactIndexedKind(kind) {
+		panic("compact32: invalid indexed storage kind")
+	}
+	return storage{kind: kind, typ: typ, reg: reg, payload: int64(index), meta: meta}
+}
+
+func memoryReferenceStorage(typ machineType, carrier Reg, disp, memIndexBits uint32, borrow int) storage {
+	if memIndexBits&^compactMemIndexMask != 0 || borrow < -1 || borrow > int(^uint32(0)) {
+		panic("compact32: invalid memory reference payload")
+	}
+	payload := uint64(borrow+1) | uint64(memIndexBits)<<compactBorrowBits
+	return storage{kind: stMemRef, typ: typ, reg: carrier, slot: disp, payload: int64(payload)}
+}
+
+func (st storage) constantBits() int64 {
+	if st.kind != stConst && !(st.kind == stInvalid && st.machineType().isFloat()) {
+		panic("compact32: literal payload read from incompatible kind")
+	}
+	return st.payload
+}
+func (st *storage) setConstantBits(bits int64) {
+	if st.kind != stConst {
+		panic("compact32: literal payload write to incompatible kind")
+	}
+	st.payload = bits
+}
+
+func (st storage) indexBits() uint32 {
+	if !compactIndexedKind(st.kind) {
+		panic("compact32: index payload read from incompatible kind")
+	}
+	return uint32(st.payload)
+}
+func (st *storage) setIndexBits(index uint32) {
+	if !compactIndexedKind(st.kind) {
+		panic("compact32: index payload write to incompatible kind")
+	}
+	st.payload = int64(index)
+}
+
+func (st storage) memPayload() uint64 {
+	if st.kind != stMemRef {
+		panic("compact32: memory reference payload read from incompatible kind")
+	}
+	return uint64(st.payload)
+}
+func (st storage) memDisp() int32 {
+	_ = st.memPayload()
+	return int32(st.slot)
+}
+func (st storage) memSize() int    { return int(st.memPayload() >> compactBorrowBits & 0xff) }
+func (st storage) memSigned() bool { return st.memPayload()>>compactBorrowBits&0x100 != 0 }
+func (st storage) memBorrow() int  { return int(st.memPayload()&compactBorrowMask) - 1 }
+func (st *storage) clearMemBorrow() {
+	st.payload = int64(st.memPayload() &^ compactBorrowMask)
+}
+
+func (st *storage) setOccupiedGP(reg Reg) {
+	st.kind, st.reg, st.payload = stReg, reg, 0
+	st.meta &^= uint8(storageCapturedBounds)
+	st.slot = 0
+}
+func (st *storage) setOccupiedFP(reg Reg) {
+	// The source index is no longer semantically available, but aux retains
+	// the old slot/proof bits exactly as in the other representations.
+	st.kind, st.reg, st.payload = stReg, reg, 0
+}
+
+func (st storage) capturedBoundsExtent() int64 {
+	if st.kind != stReg || st.machineType() != mtI32 || st.meta&uint8(storageCapturedBounds) == 0 {
+		panic("compact32: invalid captured bounds extent read")
+	}
+	return st.payload
+}
+func (st *storage) setCapturedBoundsExtent(extent int32) {
+	if st.kind != stReg || st.machineType() != mtI32 {
+		panic("compact32: invalid captured bounds extent write")
+	}
+	st.payload = int64(extent)
+	st.meta |= uint8(storageCapturedBounds)
+}
+func (st storage) vectorAliasCookie() int64 {
+	if st.kind != stReg || st.machineType() != mtV128 {
+		panic("compact32: invalid vector alias read")
+	}
+	return st.payload
+}
+func (st *storage) setVectorAliasCookie(cookie int64) {
+	if st.kind != stReg || st.machineType() != mtV128 {
+		panic("compact32: invalid vector alias write")
+	}
+	st.payload = cookie
+}
