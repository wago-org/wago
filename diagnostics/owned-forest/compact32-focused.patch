+func TestOwnedForestCompact32LegalStorageOrdinary(t *testing.T) {
+	t.Run("full-payloads", func(t *testing.T) {
+		for _, tc := range []struct {
+			typ  machineType
+			bits int64
+		}{{mtI64, -1 << 63}, {mtI64, 1<<63 - 1}, {mtF32, 0x80000000}, {mtF64, -0x7ffffffffff1abcf}} {
+			st := constantStorage(tc.typ, tc.bits)
+			if st.kind != stConst || st.machineType() != tc.typ || st.constantBits() != tc.bits {
+				t.Fatal("constant lost legal type or bits")
+			}
+			st.setConstantBits(^tc.bits)
+			if st.constantBits() != ^tc.bits || st.machineType() != tc.typ {
+				t.Fatal("literal mutation changed another field")
+			}
+			if tc.typ.isFloat() {
+				raw := floatLiteralPayload(tc.typ, tc.bits)
+				if raw.kind != stInvalid || raw.machineType() != tc.typ || raw.constantBits() != tc.bits {
+					t.Fatal("stInvalid float scratch lost bits")
+				}
+			}
+		}
+		for _, kind := range []storageKind{stLocalRef, stLocalReg, stGlobalRef, stGlobReg, stFuncRef} {
+			st := indexedStorage(kind, mtI64, RCX, 0xffffffff, uint8(factUpper32Zero))
+			if st.kind != kind || st.reg != RCX || st.machineType() != mtI64 || st.indexBits() != 0xffffffff || !st.valueFacts().has(factUpper32Zero) {
+				t.Fatal("indexed payload lost type, fact or width")
+			}
+			st.setIndexBits(0xf0e0d0c0)
+			if st.indexBits() != 0xf0e0d0c0 || st.kind != kind || st.reg != RCX {
+				t.Fatal("index mutation changed kind/role")
+			}
+		}
+		for _, row := range []struct {
+			disp   int32
+			width  int
+			signed bool
+			borrow int
+		}{
+			{-1 << 31, 1, true, -1}, {1<<31 - 1, 2, true, 255}, {-3, 4, false, 510}, {-1, 2, true, 0xffffffff},
+		} {
+			st := memRefStorage(RAX, row.disp, row.width, row.signed, true, row.borrow)
+			if st.memDisp() != row.disp || st.memSize() != row.width || st.memSigned() != row.signed || st.memBorrow() != row.borrow || st.machineType() != mtI64 || st.reg != RAX {
+				t.Fatalf("memref record %+v lost bits", row)
+			}
+			st.clearMemBorrow()
+			if st.memBorrow() != -1 || st.memDisp() != row.disp || st.memSize() != row.width || st.memSigned() != row.signed || st.reg != RAX {
+				t.Fatalf("memref record %+v borrow-clear corrupted another field", row)
+			}
+		}
+		// Synthetic storage-width boundary only: no load is emitted or run.
+		full := memoryReferenceStorage(mtI64, RAX, 0xffffffff, 0x1ff, 0xffffffff)
+		if full.memDisp() != -1 || full.memSize() != 255 || !full.memSigned() || full.memBorrow() != 0xffffffff {
+			t.Fatal("full 33+9-bit memref payload did not coexist with signed displacement")
+		}
+		fl := fmemRefStorage(RCX, -123, true, 7)
+		if fl.memDisp() != -123 || fl.memBorrow() != 7 || fl.memSize() != 8 || fl.memSigned() || fl.machineType() != mtF64 {
+			t.Fatal("float memref lost a field")
+		}
+		layout32Emit(t, "COMPACT32_STORAGE", map[string]any{"case": "full-payloads", "constants": 4, "scratchFloats": 2, "indexed": 5, "memoryRows": 6, "maxBorrowCode": uint64(1) << 32})
+	})
+	t.Run("owners-retag-and-aux", func(t *testing.T) {
+		w := &fixtureModuleWork{Forest: true}
+		s := newCompileScratch(32)
+		s.fixtureWork = w
+		s.ensureTargetStack()
+		f := &fn{s: s.stack, sc: s}
+		donor := elem{st: constantStorage(mtI64, -7)}
+		donor.setForestLive(true)
+		donor.setForestPending(true)
+		e := f.pushValue(donor.st)
+		if e.st.machineType() != mtI64 || e.st.constantBits() != -7 || !e.forestIsLive() || e.forestIsPending() || !donor.forestIsPending() {
+			t.Fatal("push copied donor lease or lost literal")
+		}
+		e.setForestPending(true)
+		f.replaceStorage(e, floatLiteralPayload(mtF64, -1<<63))
+		if !e.forestIsLive() || !e.forestIsPending() || e.st.machineType() != mtF64 || e.st.constantBits() != -1<<63 {
+			t.Fatal("replacement did not preserve destination owner")
+		}
+		e.setElemKind(ekDeferred)
+		e.setDeferredOp(opAdd)
+		e.setDeferredDepth(maxDeferDepth)
+		e.setRegisterNeed(maxDeferDepth + 1)
+		e.setValueType(mtV128)
+		if !e.forestIsPending() || !e.forestIsLive() || e.valueType() != mtV128 || e.deferredOp() != opAdd || e.deferredDepth() != maxDeferDepth || e.registerNeed() != maxDeferDepth+1 {
+			t.Fatal("value type retag changed owner or deferred aux labels")
+		}
+		// Start from an actual legal frame-backed typed V128 slot. FP
+		// occupancy preserves aux, and the cookie then owns the union.
+		slot := storage{kind: stSlot, slot: 17, meta: uint8(factBytesBelow16)}
+		slot.setMachineType(mtV128)
+		f.replaceStorage(e, slot)
+		f.occupyF(e, RCX)
+		if e.st.kind != stReg || e.st.reg != RCX || e.st.slotIndex() != 17 || e.st.vectorAliasCookie() != 0 || !e.st.valueFacts().has(factBytesBelow16) || !e.forestIsPending() || f.fregUser[RCX] != e {
+			t.Fatal("FP occupancy changed aux/facts/lease")
+		}
+		e.st.setVectorAliasCookie(0x7fffffff)
+		var fresh elem
+		fresh.setFreshStorage(e.st)
+		if fresh.forestIsLive() || fresh.forestIsPending() || fresh.st.vectorAliasCookie() != 0x7fffffff || fresh.st.slotIndex() != 17 || fresh.st.machineType() != mtV128 {
+			t.Fatal("copy lost vector cookie/aux or inherited lease")
+		}
+		f.releaseF(RCX)
+		i32 := storage{kind: stReg, reg: RAX, slot: 19, meta: uint8(factUpper32Zero)}
+		i32.setMachineType(mtI32)
+		i32.setCapturedBoundsExtent(0x7fffffff)
+		f.replaceStorage(e, i32)
+		if e.st.capturedBoundsExtent() != 0x7fffffff || e.st.slotIndex() != 19 || !e.forestIsLive() || !e.forestIsPending() {
+			t.Fatal("captured extent and aux or destination lease were not independent")
+		}
+		f.occupy(e, RDX)
+		if e.st.slotIndex() != 0 || e.st.meta&uint8(storageCapturedBounds) != 0 || !e.st.valueFacts().has(factUpper32Zero) || f.regUser[RDX] != e || !e.forestIsLive() || !e.forestIsPending() {
+			t.Fatal("GP occupancy did not clear aux/capture or keep facts and lease")
+		}
+		e.setForestPending(false)
+		f.release(RDX)
+		f.s.erase(e)
+		if e.forestIsLive() || e.forestIsPending() || e.st.hasLogicalRoot() || !donor.forestIsLive() || !donor.forestIsPending() {
+			t.Fatal("retirement changed donor ownership or leaked destination owner")
+		}
+		layout32Emit(t, "COMPACT32_STORAGE", map[string]any{"case": "owners-retag-and-aux", "actualFP": 1, "actualGP": 1})
+	})
+	t.Run("strict-accessors", func(t *testing.T) {
+		requireContractRefusal := func(message string, fn func()) {
+			t.Helper()
+			defer func() {
+				if got := recover(); got != message {
+					t.Errorf("contract refusal=%v want %q", got, message)
+				}
+			}()
+			fn()
+		}
+		st := constantStorage(mtI32, 7)
+		requireContractRefusal("compact32: index payload read from incompatible kind", func() { _ = st.indexBits() })
+		requireContractRefusal("compact32: memory reference payload read from incompatible kind", func() { _ = st.memBorrow() })
+		idx := indexedStorage(stLocalReg, mtF32, RCX, 9, 0)
+		requireContractRefusal("compact32: literal payload read from incompatible kind", func() { _ = idx.constantBits() })
+		idx.setOccupiedFP(RDX)
+		requireContractRefusal("compact32: index payload read from incompatible kind", func() { _ = idx.indexBits() })
+		requireContractRefusal("compact32: invalid vector alias read", func() { _ = st.vectorAliasCookie() })
+		requireContractRefusal("compact32: invalid captured bounds extent read", func() { _ = idx.capturedBoundsExtent() })
+		requireContractRefusal("compact operand nodes: custom cold index is unsupported", func() { st.setColdIndex(1) })
+		st.setColdIndex(0)
+		if st.coldIndex() != 0 || st.constantBits() != 7 {
+			t.Fatal("refused accessor or zero cold reset changed legal literal")
+		}
+		layout32Emit(t, "COMPACT32_STORAGE", map[string]any{"case": "strict-accessors", "refusals": 7})
+	})
+}
