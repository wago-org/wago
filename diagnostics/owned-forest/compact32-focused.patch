+func layout32ProbeOwnedMixedSIMDClassifierRun(t *testing.T, cm *encoder.CompiledModule) {
+	t.Helper()
+	if len(cm.Entry) != 4 || len(cm.InternalEntry) != 4 || cm.Entry[0] >= cm.InternalEntry[0] || cm.Entry[3] >= cm.InternalEntry[3] {
+		t.Fatal("missing genuine exported adapters")
+	}
+
+	for _, x := range []uint32{7, 0x80000001, 0xfffffff0} {
+		want := 3*x + 37
+		got, err := layout32ProbeOwnedRunModule(t, cm, []uint64{uint64(x)})
+		if err != nil || got != uint64(want) {
+			t.Fatalf("scalar x=%x got=%x want=%x err=%v", x, got, want, err)
+		}
+		layout32ProbeOwnedMixedSIMDVectorRun(t, cm, x)
+
+	}
+}
+
+func layout32ProbeOwnedMixedSIMDVectorRun(t *testing.T, cm *encoder.CompiledModule, x uint32) {
+	t.Helper()
+	eng, err := wr.NewEngine()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer eng.Close()
+	jm, err := wr.NewJobMemory(65536)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer jm.Close()
+	a, err := wr.NewArena(4096)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer a.Close()
+	mapped, entry, err := wr.MapCode(cm.Code)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer wr.Unmap(mapped)
+	mem := jm.CurrentBytes()
+	for i := range mem {
+		mem[i] = byte(i*31 + int(x&15))
+	}
+	want := append([]byte(nil), mem...)
+	for i := range 16 {
+		want[32+i] = mem[i] ^ layout32ProbeOwnedSIMDTempMask[i]
+	}
+	in, out, tr := a.Alloc(256), a.Alloc(256), a.Alloc(wr.TrapBufferBytes)
+	binary.LittleEndian.PutUint64(in, uint64(x))
+	err = eng.Call(entry+uintptr(cm.Entry[3]), in, jm.LinearMemory(), tr, out)
+	expected := x ^ binary.LittleEndian.Uint32(want[32:36])
+	if got := binary.LittleEndian.Uint32(out); err != nil || got != expected {
+		t.Fatalf("vector got=%x want=%x err=%v", got, expected, err)
+	}
+	if !bytes.Equal(mem, want) {
+		t.Fatal("incorrect full 16-byte vector transform or unrelated memory changed")
+	}
+}
+
+var layout32ProbeOwnedSIMDTempMask = [16]byte{1, 33, 10, 17, 5, 93, 0xe0, 0x23, 4, 2, 97, 0x91, 7, 0x11, 55, 0xf1}
