diff --git a/src/core/compiler/backend/railshot/amd64/operand_storage_legacy.go b/src/core/compiler/backend/railshot/amd64/operand_storage_legacy.go
new file mode 100644
index 00000000..dbd1da14
--- /dev/null
+++ b/src/core/compiler/backend/railshot/amd64/operand_storage_legacy.go
@@ -0,0 +1,85 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+//
+// SPDX-License-Identifier: MPL-2.0
+// Copyright (c) 2026 Wago authors and contributors
+
+//go:build amd64 && (!wago_owned_forest_compact32 || !wago_owned_forest_compact)
+
+package amd64
+
+// storage records where a value lives and its machine type.
+type storage struct {
+	cval int64  // constant value/bits for stConst
+	slot uint32 // spill-slot index, bounded GC array length for local refs, or int32 displacement bits for stMemRef
+	cold uint32 // index+1 into stack.cold for custom plugin values
+	idx  uint32 // local/global/function index, bounded GC array length, or packed stMemRef metadata
+	kind storageKind
+	typ  machineType
+	reg  Reg
+	meta uint8 // semantic value facts and root-state bits
+}
+
+// These constructors describe the semantic source of each occupied word.
+// Keep the wide raw representation and all zero/default field values.
+func constantStorage(typ machineType, bits int64) storage {
+	return storage{kind: stConst, typ: typ, cval: bits}
+}
+
+// Some FP scratch loads use a typed literal payload without a stack value.
+func floatLiteralPayload(typ machineType, bits int64) storage {
+	return storage{typ: typ, cval: bits}
+}
+
+func indexedStorage(kind storageKind, typ machineType, reg Reg, index uint32, meta uint8) storage {
+	return storage{kind: kind, typ: typ, reg: reg, idx: index, meta: meta}
+}
+
+func memoryReferenceStorage(typ machineType, carrier Reg, disp, memIndexBits uint32, borrow int) storage {
+	return storage{kind: stMemRef, typ: typ, reg: carrier, slot: disp, idx: memIndexBits, cval: int64(borrow + 1)}
+}
+
+func (st *storage) setOccupiedGP(reg Reg) {
+	st.kind, st.reg = stReg, reg
+	st.setConstantBits(0)
+	st.meta &^= uint8(storageCapturedBounds)
+	st.setIndexBits(0)
+	st.slot = 0
+}
+
+// FP occupation has never cleared the inactive index or slot words.
+func (st *storage) setOccupiedFP(reg Reg) {
+	st.kind, st.reg = stReg, reg
+	st.setConstantBits(0)
+}
+
+func (st storage) capturedBoundsExtent() int64 { return st.constantBits() }
+func (st *storage) setCapturedBoundsExtent(extent int32) {
+	st.setConstantBits(int64(extent))
+	st.meta |= uint8(storageCapturedBounds)
+}
+
+func (st storage) vectorAliasCookie() int64           { return st.constantBits() }
+func (st *storage) setVectorAliasCookie(cookie int64) { st.setConstantBits(cookie) }
+
+// Raw storage words remain independent in this layout. Accessors centralize
+// their use without restricting the payload combinations accepted by copies.
+func (st storage) machineType() machineType        { return st.typ }
+func (st *storage) setMachineType(typ machineType) { st.typ = typ }
+func (st storage) constantBits() int64             { return st.cval }
+func (st *storage) setConstantBits(bits int64)     { st.cval = bits }
+func (st storage) indexBits() uint32               { return st.idx }
+func (st *storage) setIndexBits(index uint32)      { st.idx = index }
+
+// clearMemBorrow makes a memory-reference carrier owned without changing the
+// memory width, sign, displacement, or semantic value facts.
+func (st *storage) clearMemBorrow() { st.setConstantBits(0) }
+
+func (st storage) memDisp() int32  { return int32(st.slot) }
+func (st storage) memSize() int    { return int(st.indexBits() & 0xff) }
+func (st storage) memSigned() bool { return st.indexBits()&0x100 != 0 }
+
+// memBorrow returns the local whose pinned register serves as this deferred
+// load's address, or -1 when the address register is owned.
+func (st storage) memBorrow() int { return int(st.constantBits()) - 1 }
diff --git a/src/core/compiler/backend/railshot/amd64/owned_forest_compact32_independent_test.go b/src/core/compiler/backend/railshot/amd64/owned_forest_compact32_independent_test.go
