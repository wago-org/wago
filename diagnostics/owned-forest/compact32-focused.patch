+type layout32ProbeOwnedIntArithCase struct {
+	op       uint32
+	pressure bool
+}
+
+func layout32ProbeOwnedIntArithModule(t *testing.T, c layout32ProbeOwnedIntArithCase) *wasm.Module {
+	t.Helper()
+	b := []byte{1, 1, 0x7b, 0x20, 0}
+	if c.pressure {
+		b = []byte{0, 0x20, 0}
+	}
+	pc := func(i int) { b = append(b, 0x41); b = append(b, wasmtest.SLEB32(int32(i))...) }
+	ld := func(i int) { pc(i); b = append(b, 0xfd, 0, 4, 0) }
+	st := func() { b = append(b, 0xfd, 11, 4, 0) }
+	if !c.pressure {
+		pc(544)
+		ld(0)
+		b = append(b, 0x21, 1, 0x20, 1)
+		pc(512)
+		if c.op != 127 {
+			b = append(b, 0x20, 1)
+		} // binary left input
+		ld(16)
+		b = append(b, 0x21, 1, 0x20, 1) // current home supplies right or unary input
+	} else {
+		pc(512)
+		ld(0)
+		for i := 1; i <= 20; i++ {
+			ld(16 * i)
+			b = append(b, 0xfd, 77)
+		}
+		for range 19 {
+			b = append(b, 0xfd, 81)
+		}
+	}
+	b = append(b, 0xfd)
+	b = append(b, wasmtest.ULEB(c.op)...)
+	st()
+	if !c.pressure {
+		st() // independent old-value observation
+		pc(528)
+		b = append(b, 0x20, 1)
+		st()
+	}
+	ld(512)
+	b = append(b, 0xfd, 27, 0, 0x73, 0x0b)
+	m := layout32ProbeModMem(t, 1, []wasm.ValType{wasm.I32}, []wasm.ValType{wasm.I32}, b)
+	if err := wasm.ValidateModule(m); err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+
+func layout32ProbeOwnedIntArithRun(t *testing.T, cm *encoder.CompiledModule, c layout32ProbeOwnedIntArithCase, variant int) {
+	t.Helper()
+	eng, err := wr.NewEngine()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer eng.Close()
+	jm, err := wr.NewJobMemory(65536)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer jm.Close()
+	a, err := wr.NewArena(4096)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer a.Close()
+	mapped, entry, err := wr.MapCode(cm.Code)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer wr.Unmap(mapped)
+	mem := jm.CurrentBytes()
+	for i := range mem {
+		mem[i] = byte(i*31 + variant*7)
+	}
+	for i := range 21 {
+		for j := range 16 {
+			mem[16*i+j] = byte(i*i*3 + j*17 + i*j*7 + variant)
+		}
+	}
+	for j := range 16 {
+		// For byte operations, signs and low/high halves differ.
+		mem[j], mem[16+j] = byte(255-17*j+variant*19), byte(193+29*j-variant*17)
+	}
+	x, y := mem[:16], mem[16:32]
+	if c.op == 127 {
+		boundaries := [8]uint16{0xffff, 0xffff, 0x8000, 0x8001, 0x7fff, 1, 0, 0xf123}
+		for j := range 8 {
+			binary.LittleEndian.PutUint16(y[2*j:], boundaries[(j+2*variant)%8])
+		}
+	}
+	if c.op == 145 || c.op == 186 {
+		xp := []uint16{0x8000, 0x8000, 0, 0x7fff, 0xffff, 4, 0x7fff, 0x8000}
+		yp := []uint16{0x8000, 0x8000, 1, 0xffff, 0x8000, 0xfffe, 11, 7}
+		for j := range 8 {
+			v, w := xp[(j+2*variant)%8], yp[(j+2*variant)%8]
+			if variant == 1 {
+				v, w = w, v
+			}
+			binary.LittleEndian.PutUint16(x[2*j:], v)
+			binary.LittleEndian.PutUint16(y[2*j:], w)
+		}
+	}
+	if c.pressure {
+		var reduced [16]byte
+		for j := range reduced {
+			for i := 1; i <= 20; i++ {
+				reduced[j] ^= ^mem[16*i+j]
+			}
+		}
+		y = reduced[:]
+	}
+	var result [16]byte
+	u16 := func(v []byte, j int) uint16 { return binary.LittleEndian.Uint16(v[2*j:]) }
+	switch c.op {
+	case 127:
+		for j := range 4 {
+			binary.LittleEndian.PutUint32(result[4*j:], uint32(u16(y, 2*j))+uint32(u16(y, 2*j+1)))
+		}
+	case 145:
+		for j := range 8 {
+			binary.LittleEndian.PutUint16(result[2*j:], u16(x, j)-u16(y, j))
+		}
+	case 158, 159:
+		start := 0
+		if c.op == 159 {
+			start = 8
+		}
+		for j := range 8 {
+			binary.LittleEndian.PutUint16(result[2*j:], uint16(x[start+j])*uint16(y[start+j]))
+		}
+	case 186:
+		for j := range 4 {
+			var sum int64
+			for k := range 2 {
+				n := 2*j + k
+				sum += int64(int16(u16(x, n))) * int64(int16(u16(y, n)))
+			}
+			binary.LittleEndian.PutUint32(result[4*j:], uint32(sum))
+		}
+	default:
+		t.Fatalf("unknown arithmetic opcode %d", c.op)
+	}
+
+	want := append([]byte(nil), mem...)
+	copy(want[512:], result[:])
+	if !c.pressure {
+		copy(want[528:], y)
+		copy(want[544:], x)
+	}
+	in, out, tr := a.Alloc(256), a.Alloc(256), a.Alloc(wr.TrapBufferBytes)
+	old := uint32(0xe3c51200 + variant)
+	binary.LittleEndian.PutUint64(in, uint64(old))
+	err = eng.Call(entry+uintptr(cm.Entry[0]), in, jm.LinearMemory(), tr, out)
+	expected := old ^ binary.LittleEndian.Uint32(result[:])
+	if got := binary.LittleEndian.Uint32(out); err != nil || got != expected {
+		t.Fatalf("FD%d variant=%d got=%x want=%x err=%v", c.op, variant, got, expected, err)
+	}
+	if !bytes.Equal(mem, want) {
+		for i := range mem {
+			if mem[i] != want[i] {
+				t.Fatalf("FD%d variant=%d byte[%d]=%x want=%x", c.op, variant, i, mem[i], want[i])
+			}
+		}
+	}
+}
+
+func layout32ProbeOwnedMixedSIMDClassifierModule(t *testing.T) *wasm.Module {
+	t.Helper()
+	i := wasm.I32
+	// Preserve the first x across direct and naturally selected inline calls.
+	// The typed mutable global is also read directly in ordinary scalar bodies.
+	caller := []byte{0, 0x20, 0, 0x20, 0, 0x10, 1, 0x6a, 0x20, 0, 0x10, 2, 0x6a, 0x23, 0, 0x6a, 0x0b}
+	direct := []byte{0, 0x03, 0x40, 1, 0x0b}
+	direct = append(direct, bytes.Repeat([]byte{1}, 512)...)
+	direct = append(direct, 0x20, 0, 0x23, 0, 0x6a, 0x0b)
+	leaf := []byte{0, 0x20, 0, 0x41, 3, 0x6a, 0x0b}
+	// Read full vector, xor constant, store to offset 32; independent scalar
+	// return reads lane 0 from the transformed destination.
+	vec := []byte{0, 0x20, 0, 0x41, 32, 0x41, 0, 0xfd, 0, 4, 0, 0xfd, 12}
+	vec = append(vec, layout32ProbeOwnedSIMDTempMask[:]...)
+	vec = append(vec, 0xfd, 81, 0xfd, 11, 4, 0, 0x41, 32, 0xfd, 0, 4, 0, 0xfd, 27, 0, 0x73, 0x0b)
+	code := func(b []byte) []byte { return append(wasmtest.ULEB(uint32(len(b))), b...) }
+	m, err := wasm.DecodeModule(wasmtest.Module(
+		wasmtest.Section(1, wasmtest.Vec(wasmtest.FuncType([]wasm.ValType{i}, []wasm.ValType{i}))),
+		wasmtest.Section(3, wasmtest.Vec(wasmtest.ULEB(0), wasmtest.ULEB(0), wasmtest.ULEB(0), wasmtest.ULEB(0))),
+		wasmtest.Section(5, wasmtest.Vec([]byte{0, 1})),
+		wasmtest.Section(6, wasmtest.Vec(wasmtest.GlobalEntry(i, true, []byte{0x41, 17, 0x0b}))),
+		wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("scalar", 0, 0), wasmtest.ExportEntry("vector", 0, 3))),
+		wasmtest.Section(10, wasmtest.Vec(code(caller), code(direct), code(leaf), code(vec))),
+	))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = wasm.ValidateModule(m); err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
