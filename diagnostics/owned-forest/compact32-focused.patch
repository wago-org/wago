+func layout32ProbeOwnedRunModule(t *testing.T, cm *encoder.CompiledModule, args []uint64) (uint64, error) {
+	t.Helper()
+	eng, e := wr.NewEngine()
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer eng.Close()
+	jm, e := wr.NewJobMemory(65536)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer jm.Close()
+	jm.LinearMemory()[0] = 17
+	ar, e := wr.NewArena(4096)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer ar.Close()
+	cell, table := ar.Alloc(8), ar.Alloc(8)
+	binary.LittleEndian.PutUint64(cell, 17)
+	binary.LittleEndian.PutUint64(table, uint64(uintptr(unsafe.Pointer(&cell[0]))))
+	jm.SetGlobalsPtr(uintptr(unsafe.Pointer(&table[0])))
+	image, entry, e := wr.MapCode(cm.Code)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer wr.Unmap(image)
+	a, r, tr := ar.Alloc(256), ar.Alloc(256), ar.Alloc(wr.TrapBufferBytes)
+	for i, v := range args {
+		binary.LittleEndian.PutUint64(a[i*8:], v)
+	}
+	e = eng.Call(entry+uintptr(cm.Entry[0]), a, jm.LinearMemory(), tr, r)
+	return binary.LittleEndian.Uint64(r), e
+}
