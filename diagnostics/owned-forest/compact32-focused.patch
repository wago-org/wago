@@ -0,0 +1,886 @@
+//go:build linux && amd64 && wago_owned_forest_layout_probe && wago_owned_forest_compact && wago_owned_forest_compact32
+
+package amd64
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"os"
+	"testing"
+	"unsafe"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	encoder "github.com/wago-org/wago/src/core/encoder/amd64"
+	wr "github.com/wago-org/wago/src/core/runtime"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+)
+
+func TestOwnedForestCompact32LayoutOrdinary(t *testing.T) {
+	arm := os.Getenv("WAGO_LAYOUT_PROBE_ARM")
+	const forest = true
+	if arm != "compact32-forest" || !compactOperandNodes {
+		t.Fatalf("unexpected compact32 arm/build: %q compact=%v", arm, compactOperandNodes)
+	}
+	conditional, caller := layout32ScalarModules(t)
+	cases := []struct {
+		name string
+		m    *wasm.Module
+	}{
+		{"effectful-if", conditional}, {"natural-noninline-call", caller},
+		{"cold-prefix", layout32ProbeOwnedColdPrefixModule(t)}, {"v128-control-overlap", layout32ProbeOwnedV128BlockModule(t, "overlap")},
+		{"v128-dot-pressure", layout32ProbeOwnedIntArithModule(t, layout32ProbeOwnedIntArithCase{op: 186, pressure: true})}, {"mixed-simd", layout32ProbeOwnedMixedSIMDClassifierModule(t)},
+	}
+	for _, tc := range cases {
+		if err := wasm.ValidateModule(tc.m); err != nil {
+			t.Fatal(err)
+		}
+		var bytesTotal int
+		bodyHashes := make([]string, len(tc.m.Code))
+		for i, c := range tc.m.Code {
+			bytesTotal += len(c.BodyBytes)
+			bodyHashes[i] = fmt.Sprintf("%x", sha256.Sum256(c.BodyBytes))
+		}
+		if bytesTotal >= minParallelHintBodyBytes {
+			t.Fatalf("ordinary heap scope exceeded: %d", bytesTotal)
+		}
+		for _, intr := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/interruptible=%t", tc.name, intr), func(t *testing.T) {
+				w := &fixtureModuleWork{Forest: forest, RecordOperandLayout: true, RecordNoncanonicalFlushPlan: true, FuseNoncanonicalFlushPlan: compactOperandNodes}
+				switch tc.name {
+				case "v128-control-overlap":
+					w.TemporaryV128SIMD, w.TemporaryV128Locals, w.TemporaryV128RegionalLocals, w.TemporaryV128BlockResults = true, true, true, true
+				case "v128-dot-pressure":
+					w.TemporaryV128SIMD, w.TemporaryV128Locals, w.TemporaryV128WideningArithmetic = true, true, true
+				case "mixed-simd":
+					w.TemporaryV128SIMD, w.TemporaryV128PerFunction, w.TemporaryV128HintClassification = true, true, true
+				}
+				cm, err := CompileModuleWith(tc.m, CompileOptions{Workers: 1, Interruptible: intr, fixtureWork: w})
+				if err != nil {
+					t.Fatalf("compile: %v work: %+v", err, w)
+				}
+				if cm.CodeImage != nil {
+					defer cm.CodeImage.Close()
+				}
+				if w.Rejected != 0 || w.LegacyBodies == 0 || w.Opcodes == 0 || forest && w.Vector.stores == 0 || len(w.OperandCapacities) == 0 {
+					t.Fatalf("missing legacy/ownership/capacity activation: %+v", w)
+				}
+				l := w.OperandLayout
+				if !l.Compact || l.NodeBytes != 32 || l.NodePhysicalLinkBytes != 0 {
+					t.Fatalf("unexpected measured layout: %+v", l)
+				}
+				for _, r := range w.OperandCapacities {
+					if r.ArenaMappedBytes != 0 || r.ArenaAppendedBytes != 0 || r.NodeUsedBytes > r.NodeReservedBytes {
+						t.Fatalf("heap-only capacity contract: %+v", r)
+					}
+				}
+				meta := *cm
+				meta.Code, meta.CodeImage = nil, nil
+				enc, err := json.Marshal(meta)
+				if err != nil {
+					t.Fatal(err)
+				}
+				receipt := map[string]any{"arm": arm, "case": tc.name, "intr": intr, "nativeSHA": fmt.Sprintf("%x", sha256.Sum256(cm.Code)), "encoderSHA": fmt.Sprintf("%x", sha256.Sum256(enc)), "codeBytes": len(cm.Code), "bodyBytes": bytesTotal, "bodyHashes": bodyHashes, "layout": l, "caps": w.OperandCapacities, "forestHeaderBytes": unsafe.Sizeof(fixtureForest{}), "coldSidecarElemBytes": unsafe.Sizeof(elemCold{}), "attempts": w.Attempts, "legacy": w.LegacyBodies, "opcodes": w.Opcodes, "rootStores": w.Vector.stores, "rootRetirements": w.Vector.retirements, "cursorVisits": w.Vector.visits, "listLinkWrites": w.List.linkWrites, "listEffectVisits": w.List.effectVisits, "classifier": w.TemporaryV128Classifier, "inlineClassifier": w.TemporaryV128InlineClassifier, "vectorPreflightBytes": w.TemporaryV128PreflightBytes, "vectorPreflightOpcodes": w.TemporaryV128PreflightOpcodes}
+				receipt["flushPlan"] = w.NoncanonicalFlushPlan
+				receipt["hintClassifier"] = w.TemporaryV128HintClassifier
+				receipt["hintSharedBytes"] = w.TemporaryV128HintSharedBytes
+				receipt["hintFactsUsed"] = w.TemporaryV128HintFactsUsed
+				receipt["hintFallbacks"] = w.TemporaryV128HintFallbacks
+				receipt["hintBackingBytes"] = w.TemporaryV128HintFactBackingBytes
+				layout32SparseFactReceipt(receipt, w)
+				receipt["hintDensePriorFactElemBytes"] = unsafe.Sizeof(fixtureVectorHintFact{})
+				if tc.name != "mixed-simd" && (w.TemporaryV128HintClassifier != (fixtureVectorClassificationWork{}) || w.TemporaryV128HintSharedBytes != 0 || w.TemporaryV128HintFactsUsed != 0 || w.TemporaryV128HintFallbacks != 0 || w.TemporaryV128HintFactBackingBytes != 0) {
+					t.Fatalf("unrequested hint classification overhead: %+v", w)
+				}
+				layout32Emit(t, "COMPILE", receipt)
+				calls := 0
+				switch tc.name {
+				case "effectful-if":
+					for _, k := range [][2]uint64{{1, 30}, {0, 36}} {
+						got, e := layout32ProbeOwnedRunModule(t, cm, []uint64{k[0]})
+						if e != nil || got != k[1] {
+							t.Fatalf("IF input=%d got=%d want=%d err=%v", k[0], got, k[1], e)
+						}
+						calls++
+					}
+				case "natural-noninline-call":
+					got, e := layout32ProbeOwnedRunModule(t, cm, []uint64{7, 4})
+					if e != nil || got != 57 {
+						t.Fatalf("call got=%d err=%v", got, e)
+					}
+					calls++
+				case "cold-prefix":
+					if forest && (w.Vector.coldControlCaptures < 3 || w.Vector.coldControlPeak <= 64 || uint64(w.Vector.coldControlPeak) >= w.Vector.coldControlTypeCopies || w.Vector.coldControlCapacity < w.Vector.coldControlPeak) {
+						t.Fatalf("cold reuse not reached: %+v", w.Vector)
+					}
+					for _, a := range [][3]uint64{{17, 0, 0}, {0xfffffffffffffff0, 1, 0}, {23, 0, 1}, {0x123456789abcdef0, 1, 1}} {
+						want := a[0] + 70*71/2 + 23
+						if a[0] < 256 {
+							want++
+						}
+						for _, c := range a[1:] {
+							if c == 0 {
+								want += 29
+							} else {
+								want += 17
+							}
+						}
+						got, e := layout32ProbeOwnedColdPrefixRun(t, cm, a)
+						if e != nil || got != want {
+							t.Fatalf("cold args=%x got=%x want=%x err=%v", a, got, want, e)
+						}
+						calls++
+					}
+				case "v128-control-overlap":
+					if w.TemporaryV128BlockSlotMerges != 1 || w.TemporaryV128BlockOverlappingMoves != 1 || w.TemporaryV128BlockTwoSlotMoves == 0 {
+						t.Fatalf("vector overlap not reached: %+v", w)
+					}
+					for _, cond := range []uint32{0, 1} {
+						for _, salt := range []int{3, 29} {
+							layout32ProbeOwnedV128BlockRun(t, cm, "overlap", cond, salt)
+							calls++
+						}
+					}
+				case "v128-dot-pressure":
+					if w.TemporaryV128Dots != 1 || w.TemporaryV128WideningSlotLeases == 0 || w.TemporaryV128Spills == 0 {
+						t.Fatalf("dot pressure not reached: %+v", w)
+					}
+					for v := range 2 {
+						layout32ProbeOwnedIntArithRun(t, cm, layout32ProbeOwnedIntArithCase{op: 186, pressure: true}, v)
+						calls++
+					}
+				case "mixed-simd":
+					c, in := w.TemporaryV128Classifier, w.TemporaryV128InlineClassifier
+					if w.TemporaryV128Bodies != 1 || w.TemporaryV128ScalarSiblings != 3 || c != (fixtureVectorClassificationWork{TypeVisits: 8}) || w.TemporaryV128HintClassifier.Bodies != 4 || w.TemporaryV128HintClassifier.Opcodes == 0 || w.TemporaryV128HintClassifier.TypeVisits != 6 || w.TemporaryV128HintSharedBytes != uint64(bytesTotal) || w.TemporaryV128HintFactsUsed != 4 || w.TemporaryV128HintFallbacks != 0 || w.TemporaryV128HintFactBackingBytes != 4 || w.TemporaryV128HintStateBackingBytes != 4 || w.TemporaryV128HintErrorBackingBytes != 0 || w.TemporaryV128HintFactHeaderBytes != unsafe.Sizeof(fixtureVectorHintTable{}) || w.TemporaryV128PreflightBytes == 0 || forest && (in.Bodies != 1 || in.Opcodes == 0 || in.Bytes == 0 || in.TypeVisits != 0) || !forest && in != (fixtureVectorClassificationWork{}) {
+						t.Fatalf("classification not reached: %+v", w)
+					}
+					layout32ProbeOwnedMixedSIMDClassifierRun(t, cm)
+					calls += 6
+				}
+				layout32Emit(t, "EXEC", map[string]any{"arm": arm, "case": tc.name, "intr": intr, "calls": calls})
+			})
+		}
+	}
+}
