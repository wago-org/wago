+++ b/src/core/compiler/backend/railshot/amd64/owned_forest_brtable_independent_test.go
@@ -0,0 +1,135 @@
+//go:build (linux || darwin || windows) && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"fmt"
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+	"testing"
+)
+
+func TestOwnedForestBrTableOrdinaryTargets(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		labels   []uint32
+		def      uint32
+		compact  bool
+		strategy string
+	}{
+		{"chain", []uint32{0, 1}, 2, false, "chain"},
+		{"dense-deltas", []uint32{0, 1, 2, 3, 4}, 5, true, "deltas"},
+		{"compact-default-only", []uint32{0, 0, 1, 1, 0}, 2, true, "compact"},
+		{"compact-shared-default", []uint32{0, 0, 1, 1, 0}, 1, true, "compact"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			n := tc.def + 1
+			for _, v := range tc.labels {
+				if v >= n {
+					n = v + 1
+				}
+			}
+			body := []byte{0, 0x20, 1}
+			for i := uint32(0); i < n; i++ {
+				body = append(body, 0x02, 0x7f)
+			}
+			// Prefix and result retain the original local while its binding changes.
+			body = append(body, 0x20, 1, 0x41, 7, 0x21, 1, 0x20, 0, 0x0e)
+			body = append(body, wasmtest.ULEB(uint32(len(tc.labels)))...)
+			for _, v := range tc.labels {
+				body = append(body, wasmtest.ULEB(v)...)
+			}
+			body = append(body, wasmtest.ULEB(tc.def)...)
+			for i := uint32(0); i < n; i++ {
+				body = append(body, 0x0b, 0x41, byte(i+1), 0x6a)
+			}
+			body = append(body, 0x6a, 0x20, 1, 0x6a, 0x0b)
+			m := mod1(t, []wasm.ValType{wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, body)
+			for _, intr := range []bool{false, true} {
+				var oracle []byte
+				for _, candidate := range []bool{false, true} {
+					work := &fixtureModuleWork{Forest: candidate}
+					var stats ModuleStats
+					cm, e := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, CompactNative: tc.compact, Stats: &stats, fixtureWork: work})
+					if e != nil {
+						t.Fatal(e)
+					}
+					if work.LegacyBodies != 1 || work.Opcodes == 0 || (candidate && work.Vector.stores == 0) {
+						t.Fatalf("inactive: %+v", work)
+					}
+					jump, compact := stats.Funcs[0].Peephole["br-table-jump"], stats.Funcs[0].Peephole["br-table-compact"]
+					if (jump > 0) != (tc.strategy != "chain") || (compact > 0) != (tc.strategy == "compact") {
+						t.Fatalf("strategy=%s actualjump=%d compact=%d", tc.strategy, jump, compact)
+					}
+					indices := []uint64{uint64(len(tc.labels)), 0xffffffff}
+					for i := range tc.labels {
+						indices = append(indices, uint64(i))
+					}
+					for _, index := range indices {
+						label := tc.def
+						if index < uint64(len(tc.labels)) {
+							label = tc.labels[index]
+						}
+						want := uint64(33)
+						for i := label; i < n; i++ {
+							want += uint64(i + 1)
+						}
+						got, e := ownedRunModule(t, cm, []uint64{index, 13})
+						if e != nil || got != want {
+							t.Fatalf("candidate=%v index=%d got=%d want=%d err=%v", candidate, index, got, want, e)
+						}
+					}
+					if !candidate {
+						oracle = append([]byte(nil), cm.Code...)
+					} else if !bytes.Equal(oracle, cm.Code) {
+						t.Fatal("native differs")
+					}
+					t.Logf("strategy=%s intr=%v candidate=%v bytes=%d jump=%d compact=%d work=%+v", tc.strategy, intr, candidate, len(cm.Code), jump, compact, work)
+					if cm.CodeImage != nil {
+						cm.CodeImage.Close()
+					}
+				}
+			}
+		})
+	}
+}
+
+func TestOwnedForestBrTableOrdinaryLoop(t *testing.T) {
+	body := []byte{0, 0x20, 1, 0x02, 0x40, 0x03, 0x40, 0x41, 7, 0x21, 1, 0x20, 0, 0x41, 1, 0x6b, 0x22, 0, 0x45, 0x0e, 2, 0, 1, 1, 0x0b, 0x0b, 0x20, 1, 0x6a, 0x0b}
+	m := mod1(t, []wasm.ValType{wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, body)
+	for _, intr := range []bool{false, true} {
+		t.Run(fmt.Sprintf("interruptible=%v", intr), func(t *testing.T) {
+			var oracle []byte
+			for _, candidate := range []bool{false, true} {
+				work := &fixtureModuleWork{Forest: candidate}
+				var stats ModuleStats
+				cm, e := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+				if e != nil {
+					t.Fatal(e)
+				}
+				if work.LegacyBodies != 1 || work.Opcodes == 0 || (candidate && work.Vector.stores == 0) {
+					t.Fatal("inactive forest/legacy")
+				}
+				if stats.Funcs[0].Peephole["br-table-jump"] != 0 {
+					t.Fatal("expected chain")
+				}
+				for _, count := range []uint64{1, 3, 7} {
+					got, e := ownedRunModule(t, cm, []uint64{count, 13})
+					if e != nil || got != 20 {
+						t.Fatalf("count=%d got=%d err=%v", count, got, e)
+					}
+				}
+				if !candidate {
+					oracle = append([]byte(nil), cm.Code...)
+				} else if !bytes.Equal(oracle, cm.Code) {
+					t.Fatal("native differs")
+				}
+				t.Logf("candidate=%v bytes=%d work=%+v", candidate, len(cm.Code), work)
+				if cm.CodeImage != nil {
+					cm.CodeImage.Close()
+				}
+			}
+		})
+	}
+}
