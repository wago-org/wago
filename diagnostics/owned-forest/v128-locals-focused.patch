+//go:build linux && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"testing"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	encoder "github.com/wago-org/wago/src/core/encoder/amd64"
+	wr "github.com/wago-org/wago/src/core/runtime"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+)
+
+func ownedV128LocalsModule(t *testing.T, lane string) *wasm.Module {
+	t.Helper()
+	n, x := byte(13), byte(13)
+	if lane == "pressure" {
+		n, x = 1, 1
+	}
+	b := []byte{1, n, 0x7b, 0x20, 0}
+	pc := func(i int) { b = append(b, 0x41); b = append(b, wasmtest.SLEB32(int32(i))...) }
+	ld := func(i int) { pc(i); b = append(b, 0xfd, 0, 4, 0) }
+	st := func() { b = append(b, 0xfd, 11, 4, 0) }
+	if lane != "pressure" {
+		for i := byte(1); i < 13; i++ {
+			// Give earlier valid vector locals priority without changing pin policy.
+			// get(1)+tee(2)+set(2) ties or exceeds target with lower index.
+			b = append(b, 0x20, i, 0x22, i, 0x21, i)
+		}
+		pc(32)
+		ld(0)
+		b = append(b, 0x22, x)
+		if lane == "forward" {
+			b = append(b, 0x20, x, 0xfd, 80)
+			st()
+		} else {
+			ld(16)
+			b = append(b, 0x21, x)
+			st()
+			pc(48)
+			b = append(b, 0x20, x)
+			st()
+		}
+		if len(b) >= 120 {
+			t.Fatal("scratch fixture drifted out of bounded body")
+		}
+		b = append(b, 0x41, 23, 0x73, 0x0b)
+	} else {
+		pc(480)
+		b = append(b, 0x20, x)
+		st() // Wasm zero initialization, observed full 16 bytes.
+		pc(512)
+		for i := range 20 {
+			ld(16 * i)
+			b = append(b, 0xfd, 77)
+		}
+		for range 19 {
+			b = append(b, 0xfd, 81)
+		}
+		b = append(b, 0x22, x)
+		st()
+		b = append(b, 0x20, x, 0xfd, 83, 0x04, 0x7f)
+		b = append(b, 0x20, x, 0xfd, 27, 0, 0x05, 0x41, 23, 0x0b, 0x73, 0x0b)
+	}
+	m := modMem(t, 1, []wasm.ValType{wasm.I32}, []wasm.ValType{wasm.I32}, b)
+	if err := wasm.ValidateModule(m); err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+
+func ownedV128LocalsRun(t *testing.T, cm *encoder.CompiledModule, lane string, zero bool) {
+	t.Helper()
+	eng, err := wr.NewEngine()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer eng.Close()
+	jm, err := wr.NewJobMemory(65536)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer jm.Close()
+	mem := jm.LinearMemory()
+	for i := range mem {
+		mem[i] = byte(i*29 + 13)
+	}
+	for i := range 20 {
+		for j := range 16 {
+			mem[16*i+j] = byte(i*i*3 + j*17 + i*j*7 + 13)
+		}
+	}
+	if zero {
+		clear(mem[:320])
+	}
+	want := append([]byte(nil), mem...)
+	v := uint32(23)
+	switch lane {
+	case "forward":
+		copy(want[32:48], mem[:16])
+	case "aliases":
+		copy(want[32:48], mem[:16])
+		copy(want[48:64], mem[16:32])
+	case "pressure":
+		clear(want[480:496])
+		var out [16]byte
+		for j := range out {
+			for i := range 20 {
+				out[j] ^= ^mem[16*i+j]
+			}
+		}
+		if out != [16]byte{} {
+			v = binary.LittleEndian.Uint32(out[:])
+		}
+		copy(want[512:528], out[:])
+	}
+	a, err := wr.NewArena(4096)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer a.Close()
+	mapped, entry, err := wr.MapCode(cm.Code)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer wr.Unmap(mapped)
+	in, out, tr := a.Alloc(256), a.Alloc(256), a.Alloc(wr.TrapBufferBytes)
+	old := uint32(0xabcde112)
+	binary.LittleEndian.PutUint64(in, uint64(old))
+	err = eng.Call(entry+uintptr(cm.Entry[0]), in, mem, tr, out)
+	if got := binary.LittleEndian.Uint32(out); err != nil || got != old^v {
+		t.Fatalf("lane=%s zero=%v got=%x want=%x err=%v", lane, zero, got, old^v, err)
+	}
+	if !bytes.Equal(mem, want) {
+		t.Fatalf("lane=%s wrong full memory", lane)
+	}
+}
+
+func TestOwnedForestV128LocalsOrdinary(t *testing.T) {
+	for _, lane := range []string{"forward", "aliases", "pressure"} {
+		t.Run(lane, func(t *testing.T) {
+			m := ownedV128LocalsModule(t, lane)
+			for _, intr := range []bool{false, true} {
+				var native, metaOracle []byte
+				for _, candidate := range []bool{false, true} {
+					work := &fixtureModuleWork{Forest: candidate, TemporaryV128SIMD: true, TemporaryV128Locals: true}
+					var stats ModuleStats
+					cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+					if err != nil {
+						t.Fatal(err)
+					}
+					if cm.CodeImage != nil {
+						defer cm.CodeImage.Close()
+					}
+					if work.LegacyBodies != 1 || work.Opcodes == 0 || work.Rejected != 0 || candidate && work.Vector.stores == 0 || work.TemporaryV128Bodies != 1 {
+						t.Fatalf("inactive SIMD locals: %+v", work)
+					}
+					peeps := stats.Funcs[0].Peephole
+					if lane == "forward" && (work.TemporaryV128ForwardCopies != 1 || peeps["simd-local-forward"] != 1) {
+						t.Fatalf("no owned scratch forward: %v %+v", peeps, work)
+					}
+					if lane == "aliases" && (work.TemporaryV128AliasInvalidations == 0 || work.TemporaryV128ForwardCopies != 0) {
+						t.Fatalf("no stale alias retirement or wrong forward: %+v", work)
+					}
+					if lane == "pressure" && work.TemporaryV128Spills == 0 {
+						t.Fatalf("no fullwidth spills: %+v", work)
+					}
+					for _, zero := range []bool{false, true} {
+						ownedV128LocalsRun(t, cm, lane, zero)
+					}
+					meta := *cm
+					meta.Code, meta.CodeImage = nil, nil
+					encoded, err := json.Marshal(meta)
+					if err != nil {
+						t.Fatal(err)
+					}
+					if !candidate {
+						native = append([]byte(nil), cm.Code...)
+						metaOracle = encoded
+					} else if !bytes.Equal(native, cm.Code) || !bytes.Equal(metaOracle, encoded) {
+						t.Fatal("native or encoder metadata differs")
+					}
+					t.Logf("intr=%v forest=%v bytes=%d peeps=%v work=%+v", intr, candidate, len(cm.Code), peeps, work)
+				}
+			}
+		})
+	}
+}
