+
+func ownedV128SelectModule(t *testing.T, lane string) *wasm.Module {
+	t.Helper()
+	b := []byte{1, 1, 0x7b, 0x20, 0}
+	pc := func(i int) { b = append(b, 0x41); b = append(b, wasmtest.SLEB32(int32(i))...) }
+	ld := func(i int) { pc(i); b = append(b, 0xfd, 0, 4, 0) }
+	st := func() { b = append(b, 0xfd, 11, 4, 0) }
+	pc(544)
+	ld(0)
+	b = append(b, 0x21, 3, 0x20, 3)
+	pc(512)
+	b = append(b, 0x20, 3)
+	ld(16)
+	b = append(b, 0x21, 3, 0x20, 3)
+	if lane == "pressure" {
+		for i := 2; i <= 21; i++ {
+			ld(16 * i)
+			b = append(b, 0xfd, 77)
+		}
+		for range 19 {
+			b = append(b, 0xfd, 81)
+		}
+		b = append(b, 0x1a)
+	}
+	b = append(b, 0x20, 1)
+	if lane == "typed-eqz" {
+		b = append(b, 0x50, 0x1c, 1, 0x7b)
+	} else {
+		b = append(b, 0x20, 2, 0x54, 0x1b) // unsigned i64 compare yields semantic i32
+	}
+	st()
+	st() // original full-width local read survives overwrite and select
+	pc(528)
+	b = append(b, 0x20, 3)
+	st() // current local verified after select
+	ld(512)
+	b = append(b, 0xfd, 27, 0, 0x73, 0x0b)
+	m := modMem(t, 1, []wasm.ValType{wasm.I32, wasm.I64, wasm.I64}, []wasm.ValType{wasm.I32}, b)
+	if err := wasm.ValidateModule(m); err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+
+func ownedV128SelectRun(t *testing.T, cm *encoder.CompiledModule, lane string, x, y uint64, salt int) {
+	t.Helper()
+	eng, err := wr.NewEngine()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer eng.Close()
+	jm, err := wr.NewJobMemory(65536)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer jm.Close()
+	a, err := wr.NewArena(4096)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer a.Close()
+	mapped, entry, err := wr.MapCode(cm.Code)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer wr.Unmap(mapped)
+	mem := jm.CurrentBytes()
+	for i := range mem {
+		mem[i] = byte(i*31 + salt*7)
+	}
+	choose := x < y
+	if lane == "typed-eqz" {
+		choose = x == 0
+	}
+	src := 16
+	if choose {
+		src = 0
+	}
+	want := append([]byte(nil), mem...)
+	copy(want[512:], mem[src:src+16])
+	copy(want[528:], mem[16:32])
+	copy(want[544:], mem[:16])
+	in, out, tr := a.Alloc(256), a.Alloc(256), a.Alloc(wr.TrapBufferBytes)
+	old := uint32(0xe3c51200 + salt)
+	for i, v := range []uint64{uint64(old), x, y} {
+		binary.LittleEndian.PutUint64(in[i*8:], v)
+	}
+	err = eng.Call(entry+uintptr(cm.Entry[0]), in, jm.LinearMemory(), tr, out)
+	expected := old ^ binary.LittleEndian.Uint32(want[512:])
+	if got := binary.LittleEndian.Uint32(out); err != nil || got != expected {
+		t.Fatalf("lane=%s x=%x y=%x got=%x want=%x err=%v", lane, x, y, got, expected, err)
+	}
+	if !bytes.Equal(mem, want) {
+		for i := range mem {
+			if mem[i] != want[i] {
+				t.Fatalf("lane=%s byte[%d]=%x want=%x", lane, i, mem[i], want[i])
+			}
+		}
+	}
+}
+
+func TestOwnedForestV128SelectOrdinary(t *testing.T) {
+	for _, lane := range []string{"typed-eqz", "plain-compare", "pressure"} {
+		t.Run(lane, func(t *testing.T) {
+			m := ownedV128SelectModule(t, lane)
+			for _, intr := range []bool{false, true} {
+				var native, metaOracle []byte
+				for _, candidate := range []bool{false, true} {
+					work := &fixtureModuleWork{Forest: candidate, TemporaryV128SIMD: true, TemporaryV128Locals: true, TemporaryV128Select: true}
+					var stats ModuleStats
+					cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+					if err != nil {
+						t.Fatal(err)
+					}
+					if cm.CodeImage != nil {
+						defer cm.CodeImage.Close()
+					}
+					if work.LegacyBodies != 1 || work.Rejected != 0 || work.Opcodes == 0 || candidate && work.Vector.stores == 0 || work.TemporaryV128Bodies != 1 || work.TemporaryV128Selects != 1 || work.TemporaryV128SelectDeferredI64Predicates != 1 {
+						t.Fatalf("inactive select/deferred condition: %+v", work)
+					}
+					if lane == "pressure" && work.TemporaryV128Spills == 0 {
+						t.Fatalf("actual vector pressure absent: %+v", work)
+					}
+					for i, data := range [][2]uint64{{0, 1}, {1, 0}, {1 << 32, 1}, {7, 1 << 63}} {
+						ownedV128SelectRun(t, cm, lane, data[0], data[1], 3+i*17)
+					}
+					meta := *cm
+					meta.Code, meta.CodeImage = nil, nil
+					encoded, err := json.Marshal(meta)
+					if err != nil {
+						t.Fatal(err)
+					}
+					if !candidate {
+						native = append([]byte(nil), cm.Code...)
+						metaOracle = encoded
+					} else if !bytes.Equal(native, cm.Code) || !bytes.Equal(metaOracle, encoded) {
+						t.Fatal("native or encoder metadata differs")
+					}
+					t.Logf("intr=%v candidate=%v bytes=%d peeps=%v work=%+v", intr, candidate, len(cm.Code), stats.Funcs[0].Peephole, work)
+				}
+			}
+		})
+	}
+}
