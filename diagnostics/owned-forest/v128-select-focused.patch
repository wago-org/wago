+
+func fixtureV128SelectImmediate(r *wasm.Reader) error {
+	n, err := r.U32()
+	if err != nil {
+		return err
+	}
+	if n != 1 {
+		return fmt.Errorf("fixture forest: unsupported typed vector select immediate")
+	}
+	bt, err := r.Byte()
+	if err != nil {
+		return err
+	}
+	if bt != 0x7b {
+		return fmt.Errorf("fixture forest: unsupported typed vector select immediate")
+	}
+	return nil
+}
+
+func (f *fn) checkFixtureV128Select(op byte, r wasm.Reader) error {
+	if !f.fixtureV128SelectEnabled() {
+		return fmt.Errorf("fixture forest: unsupported vector select")
+	}
+	if op == 0x1c {
+		if err := fixtureV128SelectImmediate(&r); err != nil {
+			return err
+		}
+	}
+	if f.unreachable {
+		return nil
+	}
+	c := f.s.back()
+	if c == nil || c == f.s.head || !fixtureI32SelectCondition(c) {
+		return fmt.Errorf("fixture forest: unsupported vector select condition")
+	}
+	b := f.s.selectorPrevious(c, 1)
+	if b == nil || b == f.s.head || rootMachineType(b) != mtV128 {
+		return fmt.Errorf("fixture forest: unsupported vector select alternatives")
+	}
+	a := f.s.selectorPrevious(b, 2)
+	if a == nil || a == f.s.head || rootMachineType(a) != mtV128 {
+		return fmt.Errorf("fixture forest: unsupported vector select alternatives")
+	}
+	return nil
+}
