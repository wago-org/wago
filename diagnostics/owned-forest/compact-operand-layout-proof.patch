+func layoutEmit(t *testing.T, kind string, rec any) {
+	t.Helper()
+	data, e := json.Marshal(rec)
+	if e != nil {
+		t.Fatal(e)
+	}
+	t.Logf("LAYOUT_%s %s", kind, data)
