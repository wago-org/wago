+func layoutProbeOwnedV128BlockRun(t *testing.T, cm *encoder.CompiledModule, lane string, cond uint32, salt int) {
+	t.Helper()
+	eng, err := wr.NewEngine()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer eng.Close()
+	jm, err := wr.NewJobMemory(65536)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer jm.Close()
+	a, err := wr.NewArena(4096)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer a.Close()
+	mapped, entry, err := wr.MapCode(cm.Code)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer wr.Unmap(mapped)
+	mem := jm.CurrentBytes()
+	for i := range mem {
+		mem[i] = byte(i*31 + salt*7)
+	}
+	want := append([]byte(nil), mem...)
+	copy(want[512:528], mem[112:128])
+	src := 0
+	if lane == "regional-if" {
+		for i := range 5 {
+			copy(want[256+i*16:], mem[i*16:i*16+16])
+		}
+		src = 32
+		if cond != 0 {
+			src = 16
+		}
+	}
+	if lane == "overlap" {
+		src = 64
+		if cond != 0 {
+			src = 48
+		}
+	}
+	copy(want[528:544], mem[src:src+16])
+	old := uint32(0xabc12300 + salt)
+	expected := old ^ binary.LittleEndian.Uint32(mem[src:src+4])
+	in, out, tr := a.Alloc(256), a.Alloc(256), a.Alloc(wr.TrapBufferBytes)
+	binary.LittleEndian.PutUint64(in, uint64(old))
+	binary.LittleEndian.PutUint64(in[8:], uint64(cond))
+	err = eng.Call(entry+uintptr(cm.Entry[0]), in, jm.LinearMemory(), tr, out)
+	if got := binary.LittleEndian.Uint32(out); err != nil || got != expected {
+		t.Fatalf("lane=%s condition=%d got=%x want=%x err=%v", lane, cond, got, expected, err)
+	}
+	if !bytes.Equal(mem, want) {
+		for i := range mem {
+			if mem[i] != want[i] {
+				t.Fatalf("lane=%s condition=%d byte[%d]=%x want=%x", lane, cond, i, mem[i], want[i])
+			}
+		}
+	}
+}
