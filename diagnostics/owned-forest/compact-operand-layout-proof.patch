+func TestOwnedForestOperandMappingAllocation(t *testing.T) {
+	a := newOperandArena()
+	if a == nil {
+		t.Fatal("ordinary mapped operand arena not available")
+	}
+	defer a.Close()
+	pages := os.Getpagesize()
+	start := len(a.Mapping())
+	req := shared.MaxRetainedStackArenaBytes
+	if start != (req+pages-1)/pages*pages || len(a.Bytes()) != 0 {
+		t.Fatalf("mapping=%d requested=%d page=%d used=%d", start, req, pages, len(a.Bytes()))
+	}
+	caps := []int{17, 33}
+	appended := make([]int, 0, len(caps))
+	for _, n := range caps {
+		before := len(a.Bytes())
+		c := operandArenaChunk(a, n)
+		delta := len(a.Bytes()) - before
+		if cap(c) != n || len(c) != 0 || delta != n*int(unsafe.Sizeof(elem{})) || len(a.Mapping()) != start {
+			t.Fatalf("chunk=%d cap=%d len=%d delta=%d", n, cap(c), len(c), delta)
+		}
+		appended = append(appended, delta)
+	}
+	if err := a.Close(); err != nil {
+		t.Fatal(err)
+	}
+	layoutEmit(t, "MAPPING", map[string]any{"arm": os.Getenv("WAGO_LAYOUT_PROBE_ARM"), "nodeBytes": unsafe.Sizeof(elem{}), "pageBytes": pages, "requestedReservation": req, "actualMappingBytes": start, "requestedNodes": caps, "appendedBytes": appended, "explicitPayloadWrites": 0})
+}
