+func TestOwnedForestCompactLayoutOrdinary(t *testing.T) {
+	arm := os.Getenv("WAGO_LAYOUT_PROBE_ARM")
+	forest := arm != "wide-list"
+	if (arm != "wide-list" && arm != "wide-forest" && arm != "compact-forest") || compactOperandNodes != (arm == "compact-forest") {
+		t.Fatalf("unexpected arm/build: %q compact=%v", arm, compactOperandNodes)
+	}
+	conditional, caller := layoutScalarModules(t)
+	cases := []struct {
+		name string
+		m    *wasm.Module
+	}{
+		{"effectful-if", conditional}, {"natural-noninline-call", caller},
+		{"cold-prefix", layoutProbeOwnedColdPrefixModule(t)}, {"v128-control-overlap", layoutProbeOwnedV128BlockModule(t, "overlap")},
+		{"v128-dot-pressure", layoutProbeOwnedIntArithModule(t, layoutProbeOwnedIntArithCase{op: 186, pressure: true})}, {"mixed-simd", layoutProbeOwnedMixedSIMDClassifierModule(t)},
+	}
+	for _, tc := range cases {
+		if err := wasm.ValidateModule(tc.m); err != nil {
+			t.Fatal(err)
+		}
+		var bytesTotal int
+		bodyHashes := make([]string, len(tc.m.Code))
+		for i, c := range tc.m.Code {
+			bytesTotal += len(c.BodyBytes)
+			bodyHashes[i] = fmt.Sprintf("%x", sha256.Sum256(c.BodyBytes))
+		}
+		if bytesTotal >= minParallelHintBodyBytes {
+			t.Fatalf("ordinary heap scope exceeded: %d", bytesTotal)
+		}
+		for _, intr := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/interruptible=%t", tc.name, intr), func(t *testing.T) {
+				w := &fixtureModuleWork{Forest: forest, RecordOperandLayout: true}
+				switch tc.name {
+				case "v128-control-overlap":
+					w.TemporaryV128SIMD, w.TemporaryV128Locals, w.TemporaryV128RegionalLocals, w.TemporaryV128BlockResults = true, true, true, true
+				case "v128-dot-pressure":
+					w.TemporaryV128SIMD, w.TemporaryV128Locals, w.TemporaryV128WideningArithmetic = true, true, true
+				case "mixed-simd":
+					w.TemporaryV128SIMD, w.TemporaryV128PerFunction = true, true
+				}
+				cm, err := CompileModuleWith(tc.m, CompileOptions{Workers: 1, Interruptible: intr, fixtureWork: w})
+				if err != nil {
+					t.Fatalf("compile: %v work: %+v", err, w)
+				}
+				if cm.CodeImage != nil {
+					defer cm.CodeImage.Close()
+				}
+				if w.Rejected != 0 || w.LegacyBodies == 0 || w.Opcodes == 0 || forest && w.Vector.stores == 0 || len(w.OperandCapacities) == 0 {
+					t.Fatalf("missing legacy/ownership/capacity activation: %+v", w)
+				}
+				l := w.OperandLayout
+				if l.Compact != compactOperandNodes || (l.Compact && (l.NodeBytes != 48 || l.NodePhysicalLinkBytes != 0)) || (!l.Compact && (l.NodeBytes != 64 || l.NodePhysicalLinkBytes != 16)) {
+					t.Fatalf("unexpected measured layout: %+v", l)
+				}
+				for _, r := range w.OperandCapacities {
+					if r.ArenaMappedBytes != 0 || r.ArenaAppendedBytes != 0 || r.NodeUsedBytes > r.NodeReservedBytes {
+						t.Fatalf("heap-only capacity contract: %+v", r)
+					}
+				}
+				meta := *cm
+				meta.Code, meta.CodeImage = nil, nil
+				enc, err := json.Marshal(meta)
+				if err != nil {
+					t.Fatal(err)
+				}
+				receipt := map[string]any{"arm": arm, "case": tc.name, "intr": intr, "nativeSHA": fmt.Sprintf("%x", sha256.Sum256(cm.Code)), "encoderSHA": fmt.Sprintf("%x", sha256.Sum256(enc)), "codeBytes": len(cm.Code), "bodyBytes": bytesTotal, "bodyHashes": bodyHashes, "layout": l, "caps": w.OperandCapacities, "forestHeaderBytes": unsafe.Sizeof(fixtureForest{}), "coldSidecarElemBytes": unsafe.Sizeof(elemCold{}), "attempts": w.Attempts, "legacy": w.LegacyBodies, "opcodes": w.Opcodes, "rootStores": w.Vector.stores, "rootRetirements": w.Vector.retirements, "cursorVisits": w.Vector.visits, "listLinkWrites": w.List.linkWrites, "listEffectVisits": w.List.effectVisits, "classifier": w.TemporaryV128Classifier, "inlineClassifier": w.TemporaryV128InlineClassifier, "vectorPreflightBytes": w.TemporaryV128PreflightBytes, "vectorPreflightOpcodes": w.TemporaryV128PreflightOpcodes}
+				layoutEmit(t, "COMPILE", receipt)
+				calls := 0
+				switch tc.name {
+				case "effectful-if":
+					for _, k := range [][2]uint64{{1, 30}, {0, 36}} {
+						got, e := layoutProbeOwnedRunModule(t, cm, []uint64{k[0]})
+						if e != nil || got != k[1] {
+							t.Fatalf("IF input=%d got=%d want=%d err=%v", k[0], got, k[1], e)
+						}
+						calls++
+					}
+				case "natural-noninline-call":
+					got, e := layoutProbeOwnedRunModule(t, cm, []uint64{7, 4})
+					if e != nil || got != 57 {
+						t.Fatalf("call got=%d err=%v", got, e)
+					}
+					calls++
+				case "cold-prefix":
+					if forest && (w.Vector.coldControlCaptures < 3 || w.Vector.coldControlPeak <= 64 || uint64(w.Vector.coldControlPeak) >= w.Vector.coldControlTypeCopies || w.Vector.coldControlCapacity < w.Vector.coldControlPeak) {
+						t.Fatalf("cold reuse not reached: %+v", w.Vector)
+					}
+					for _, a := range [][3]uint64{{17, 0, 0}, {0xfffffffffffffff0, 1, 0}, {23, 0, 1}, {0x123456789abcdef0, 1, 1}} {
+						want := a[0] + 70*71/2 + 23
+						if a[0] < 256 {
+							want++
+						}
+						for _, c := range a[1:] {
+							if c == 0 {
+								want += 29
+							} else {
+								want += 17
+							}
+						}
+						got, e := layoutProbeOwnedColdPrefixRun(t, cm, a)
+						if e != nil || got != want {
+							t.Fatalf("cold args=%x got=%x want=%x err=%v", a, got, want, e)
+						}
+						calls++
+					}
+				case "v128-control-overlap":
+					if w.TemporaryV128BlockSlotMerges != 1 || w.TemporaryV128BlockOverlappingMoves != 1 || w.TemporaryV128BlockTwoSlotMoves == 0 {
+						t.Fatalf("vector overlap not reached: %+v", w)
+					}
+					for _, cond := range []uint32{0, 1} {
+						for _, salt := range []int{3, 29} {
+							layoutProbeOwnedV128BlockRun(t, cm, "overlap", cond, salt)
+							calls++
+						}
+					}
+				case "v128-dot-pressure":
+					if w.TemporaryV128Dots != 1 || w.TemporaryV128WideningSlotLeases == 0 || w.TemporaryV128Spills == 0 {
+						t.Fatalf("dot pressure not reached: %+v", w)
+					}
+					for v := range 2 {
+						layoutProbeOwnedIntArithRun(t, cm, layoutProbeOwnedIntArithCase{op: 186, pressure: true}, v)
+						calls++
+					}
+				case "mixed-simd":
+					c, in := w.TemporaryV128Classifier, w.TemporaryV128InlineClassifier
+					if w.TemporaryV128Bodies != 1 || w.TemporaryV128ScalarSiblings != 3 || c.Bodies != 4 || c.TypeVisits != 14 || c.Bytes == 0 || c.Opcodes == 0 || w.TemporaryV128PreflightBytes == 0 || forest && (in.Bodies != 1 || in.Opcodes == 0 || in.Bytes == 0 || in.TypeVisits != 0) || !forest && in != (fixtureVectorClassificationWork{}) {
+						t.Fatalf("classification not reached: %+v", w)
+					}
+					layoutProbeOwnedMixedSIMDClassifierRun(t, cm)
+					calls += 6
+				}
+				layoutEmit(t, "EXEC", map[string]any{"arm": arm, "case": tc.name, "intr": intr, "calls": calls})
+			})
+		}
+	}
+}
