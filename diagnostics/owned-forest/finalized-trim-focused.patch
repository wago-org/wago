+func TestOwnedForestFinalizedTrimLifecycleOrdinary(t *testing.T) {
+	// Existing natural non-inlined caller/callee; caller result57 uses
+	// the callee's result, so both compiled functions must remain usable.
+	_, m := layoutScalarModules(t)
+	if e := wasm.ValidateModule(m); e != nil {
+		t.Fatal(e)
+	}
+	for _, intr := range []bool{false, true} {
+		var native, meta []byte
+		for _, observe := range []bool{false, true} {
+			w := &fixtureModuleWork{Forest: true, RecordOperandLayout: true}
+			var callbacks int
+			opts := CompileOptions{Workers: 1, Interruptible: intr, DeferCodeMapping: true, fixtureWork: w}
+			if observe {
+				opts.MemoryPressureAt = 1
+				opts.MemoryPressure = func() {
+					callbacks++
+					if callbacks != 1 || w.Completed != 1 || w.Rejected != 0 || len(w.OperandCapacities) != 1 || w.OperandCapacities[0].Function != 0 || cap(w.Vector.roots) == 0 || w.OperandCapacities[0].NodeReservedBytes > shared.MaxRetainedStackArenaBytes || w.FinalizedTrim != (fixtureFinalizedTrimWork{}) {
+						t.Fatalf("small callback did not observe the first finalized, untrimmed function: %+v", w)
+					}
+					layoutEmit(t, "TRIM_CALLBACK", map[string]any{"intr": intr, "completed": w.Completed, "rootLen": len(w.Vector.roots), "rootCap": cap(w.Vector.roots), "beforeTrimRow": w.OperandCapacities[0], "trim": w.FinalizedTrim})
+				}
+			}
+			cm, e := CompileModuleWith(m, opts)
+			if e != nil {
+				t.Fatal(e)
+			}
+			if cm.CodeImage != nil {
+				defer cm.CodeImage.Close()
+			}
+			if observe != (callbacks == 1) || w.Completed != 2 || w.Rejected != 0 || w.LegacyBodies != 2 || len(w.OperandCapacities) != 2 || w.OperandCapacities[1].Function != 1 || w.FinalizedTrim != (fixtureFinalizedTrimWork{}) || w.Vector.roots != nil {
+				t.Fatalf("subsequent compile/module release state differs: %+v", w)
+			}
+			z := *cm
+			z.Code, z.CodeImage = nil, nil
+			encoded, e := json.Marshal(z)
+			if e != nil {
+				t.Fatal(e)
+			}
+			if !observe {
+				native = append([]byte(nil), cm.Code...)
+				meta = encoded
+			} else if !bytes.Equal(native, cm.Code) || !bytes.Equal(meta, encoded) {
+				t.Fatal("callback altered native or encoder metadata")
+			}
+			got, e := layoutProbeOwnedRunModule(t, cm, []uint64{7, 4})
+			if e != nil || got != 57 {
+				t.Fatalf("caller/callee result=%d want57 err=%v", got, e)
+			}
+			layoutEmit(t, "TRIM_LIFECYCLE", map[string]any{"intr": intr, "callback": observe, "calls": 1, "native": fmt.Sprintf("%x", sha256.Sum256(cm.Code)), "encoder": fmt.Sprintf("%x", sha256.Sum256(encoded))})
+		}
+	}
+}
