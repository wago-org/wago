+func TestOwnedForestFinalizedTrimAllocationOnly(t *testing.T) {
+	w := &fixtureModuleWork{Forest: true, RecordOperandLayout: true}
+	sc := newCompileScratch(32)
+	sc.fixtureWork = w
+	sc.ensureTargetStack()
+	s := sc.stack
+	_, reserved := s.nodeMemory()
+	// Bounded ordinary node allocation only. Allocations use the original
+	// geometric chunk path; no huge guest, execution, forced GC or heap size estimate.
+	for i := 0; reserved <= shared.MaxRetainedStackArenaBytes; i++ {
+		if i >= 32768 {
+			t.Fatal("fixture did not reach the actual retention ceiling")
+		}
+		s.pushValue(storage{kind: stConst, typ: mtI32, cval: int64(i + 1)})
+		if len(s.chunks) > 1 && len(*s.activeChunk) == 1 {
+			_, reserved = s.nodeMemory()
+		}
+	}
+	if len(s.chunks) < 2 || len(w.Vector.roots) == 0 {
+		t.Fatal("expected live arena-owned roots and overbudget chunks")
+	}
+	// The last live root is in the actual chunk about to be detached.
+	last := s.chunks[len(s.chunks)-1]
+	if w.Vector.roots[len(w.Vector.roots)-1] != &last[len(last)-1] {
+		t.Fatal("last operand not in suffix chunk")
+	}
+	backing := w.Vector.roots[:cap(w.Vector.roots)]
+	live, storeCount, retireCount := len(w.Vector.roots), w.Vector.stores, w.Vector.retirements
+	sc.ctrlMerges = make([]ctrlFrameMerge, 2)
+	sc.ctrlMergeTouched = 2 // two touched, empty finalized control rows
+	sc.observeFixtureOperandCapacity(0)
+	row := w.OperandCapacities[0]
+	if row.NodeReservedBytes != reserved || row.RootCapacity != len(backing) || row.RootPeak != live || row.RootStores != storeCount {
+		t.Fatalf("pretrim receipt differs: %+v", row)
+	}
+	sc.finishStackFunctionAfterAttempt(true)
+	newUsed, newReserved := s.nodeMemory()
+	p := w.FinalizedTrim
+	if p.Sites != 1 || p.LiveRootsAtScrub != uint64(live) || p.RootPointerScrubs != uint64(len(backing)) || p.ControlRecipeChecks != 2 || p.ControlHolderRejects != 0 || len(w.Vector.roots) != 0 || cap(w.Vector.roots) != len(backing) || w.Vector.stores-storeCount != p.RootPointerScrubs || w.Vector.retirements != retireCount || newReserved > shared.MaxRetainedStackArenaBytes || newReserved >= reserved || sc.nodeScratchDiscarded != reserved-newReserved || w.OperandCapacities[0] != row {
+		t.Fatalf("finalized trim/backing invariants differ: work=%+v pre=%d post=%d discard=%d", p, reserved, newReserved, sc.nodeScratchDiscarded)
+	}
+	for i, p := range backing {
+		if p != nil {
+			t.Fatalf("root pointer backing[%d] retained a reference", i)
+		}
+	}
+	s.reset()
+	next := s.pushValue(storage{kind: stConst, typ: mtI64, cval: 73})
+	if s.logicalDepth != 1 || s.back() != next || !next.forestIsLive() || next.forestIsPending() || next.st.cval != 73 || next.st.coldIndex() != 0 || next.arg0 != nil || next.arg1 != nil {
+		t.Fatal("next ordinary stack use acquired stale state")
+	}
+	layoutEmit(t, "TRIM_ALLOCATION", map[string]any{"pretrim": row, "trim": p, "postTrimNodeUsed": newUsed, "postTrimNodeReserved": newReserved, "discardedNodeRequested": sc.nodeScratchDiscarded, "oldBackingAllNil": true, "semanticRetireDelta": w.Vector.retirements - retireCount, "compact": compactOperandNodes})
+}
