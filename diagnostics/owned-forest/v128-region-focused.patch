+func ownedV128RegionModule(t *testing.T) *wasm.Module {
+	t.Helper()
+	// Param0 is an old scalar prefix, param1 controls the ordinary IF branch.
+	b := []byte{1, 16, 0x7b, 0x20, 0}
+	pc := func(i int) { b = append(b, 0x41); b = append(b, wasmtest.SLEB32(int32(i))...) }
+	ld := func(i int) { pc(i); b = append(b, 0xfd, 0, 4, 0) }
+	st := func() { b = append(b, 0xfd, 11, 4, 0) }
+	for i := byte(2); i < 10; i++ {
+		for range 3 {
+			b = append(b, 0x20, i, 0x22, i, 0x21, i)
+		}
+	}
+	// At least five unpinned local writes before any control boundary. Every
+	// immediately-following read stays live; the fifth lease evicts the first.
+	for i := range 5 {
+		ld(i * 16)
+		b = append(b, 0x21, byte(10+i))
+		pc(256 + i*16)
+		b = append(b, 0x20, byte(10+i))
+	}
+	b = append(b, 0x20, 1, 0x04, 0x40)
+	pc(448)
+	pc(17)
+	b = append(b, 0x3a, 0, 0, 0x05)
+	pc(448)
+	pc(29)
+	b = append(b, 0x3a, 0, 0, 0x0b)
+	// Overwrite the oldest home while the old read is still live on the stack.
+	// Store the five old aliases in reverse operand order, then reread new home.
+	ld(80)
+	b = append(b, 0x21, 10)
+	for range 5 {
+		st()
+	}
+	pc(352)
+	b = append(b, 0x20, 10)
+	st()
+	pc(368)
+	b = append(b, 0x20, 17)
+	st() // untouched local's full-width zero value
+	pc(448)
+	b = append(b, 0x2d, 0, 0, 0x73, 0x0b)
+	m := modMem(t, 1, []wasm.ValType{wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, b)
+	if err := wasm.ValidateModule(m); err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+
+func ownedV128RegionRun(t *testing.T, cm *encoder.CompiledModule, condition uint32, salt int) {
+	t.Helper()
+	eng, err := wr.NewEngine()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer eng.Close()
+	jm, err := wr.NewJobMemory(65536)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer jm.Close()
+	a, err := wr.NewArena(4096)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer a.Close()
+	mapped, entry, err := wr.MapCode(cm.Code)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer wr.Unmap(mapped)
+	mem := jm.CurrentBytes()
+	for i := range mem {
+		mem[i] = byte(i*31 + salt*7)
+	}
+	want := append([]byte(nil), mem...)
+	for i := range 5 {
+		copy(want[256+i*16:], mem[i*16:i*16+16])
+	}
+	copy(want[352:], mem[80:96])
+	clear(want[368:384])
+	want[448] = 29
+	if condition != 0 {
+		want[448] = 17
+	}
+	in, out, tr := a.Alloc(256), a.Alloc(256), a.Alloc(wr.TrapBufferBytes)
+	old := uint32(0x1234beef + salt)
+	binary.LittleEndian.PutUint64(in, uint64(old))
+	binary.LittleEndian.PutUint64(in[8:], uint64(condition))
+	err = eng.Call(entry+uintptr(cm.Entry[0]), in, jm.LinearMemory(), tr, out)
+	if got := binary.LittleEndian.Uint32(out); err != nil || got != old^uint32(want[448]) {
+		t.Fatalf("cond=%d got=%x want=%x err=%v", condition, got, old^uint32(want[448]), err)
+	}
+	if !bytes.Equal(mem, want) {
+		for i := range mem {
+			if mem[i] != want[i] {
+				t.Fatalf("condition=%d byte[%d]=%x want=%x", condition, i, mem[i], want[i])
+			}
+		}
+	}
+}
+
+func TestOwnedForestV128RegionOrdinary(t *testing.T) {
+	m := ownedV128RegionModule(t)
+	for _, intr := range []bool{false, true} {
+		var native, metaOracle []byte
+		for _, candidate := range []bool{false, true} {
+			work := &fixtureModuleWork{Forest: candidate, TemporaryV128SIMD: true, TemporaryV128Locals: true, TemporaryV128RegionalLocals: true}
+			var stats ModuleStats
+			cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if cm.CodeImage != nil {
+				defer cm.CodeImage.Close()
+			}
+			if work.LegacyBodies != 1 || work.Rejected != 0 || work.Opcodes == 0 || candidate && work.Vector.stores == 0 || work.TemporaryV128Bodies != 1 {
+				t.Fatalf("inactive lane: %+v", work)
+			}
+			peep := stats.Funcs[0].Peephole
+			if peep["vector-region-admit"] < 5 || peep["vector-region-writeback"] < 5 {
+				t.Fatalf("actual regional selector inactive: %v", peep)
+			}
+			if work.TemporaryV128RegionAdmissions < 5 || work.TemporaryV128RegionWritebacks < 5 || work.TemporaryV128RegionEvictions == 0 || work.TemporaryV128RegionBoundaryWritebacks < 4 || work.TemporaryV128RegionAliasRebases < 5 || candidate && work.TemporaryV128RegionRebaseVisits == 0 {
+				t.Fatalf("inactive eviction/boundary/live alias rebase: %+v", work)
+			}
+			for _, cond := range []uint32{0, 1} {
+				for _, salt := range []int{3, 29} {
+					ownedV128RegionRun(t, cm, cond, salt)
+				}
+			}
+			meta := *cm
+			meta.Code, meta.CodeImage = nil, nil
+			encoded, err := json.Marshal(meta)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !candidate {
+				native = append([]byte(nil), cm.Code...)
+				metaOracle = encoded
+			} else if !bytes.Equal(native, cm.Code) || !bytes.Equal(metaOracle, encoded) {
+				t.Fatal("native or encoder metadata differs")
+			}
+			t.Logf("intr=%v forest=%v bytes=%d peeps=%v work=%+v", intr, candidate, len(cm.Code), peep, work)
+		}
+	}
+}
