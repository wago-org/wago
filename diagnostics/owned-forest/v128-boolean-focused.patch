+func (f *fn) protectFixtureV128Boolean(a, b, c *elem) (int, regMask) {
+	work := f.sc.fixtureWork
+	floor, pins := f.protectFixtureV128Pair(a, b, &work.TemporaryV128BooleanSlotLeases, &work.TemporaryV128BooleanLocalLeases)
+	if c != nil {
+		f.protectFixtureV128Pair(c, nil, &work.TemporaryV128BooleanSlotLeases, &work.TemporaryV128BooleanLocalLeases)
