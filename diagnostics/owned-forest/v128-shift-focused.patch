+func (f *fn) fixtureMaterializeV128ShiftCount(e *elem) Reg {
+	floor, pins := f.spillFloor, f.pinned
+	defer func() { f.spillFloor, f.pinned = floor, pins }()
+	work := f.sc.fixtureWork
+	switch e.st.kind {
+	case stSlot:
+		if end := e.st.slotIndex() + 1; end > f.spillFloor {
+			f.spillFloor = end
+			work.TemporaryV128ShiftCountSlotLeases++
+		}
+	case stLocalReg, stGlobReg, stMemRef:
+		// Owned memref indexes are already allocator-tracked and reused.
+		if (e.st.kind != stMemRef || e.st.memBorrow() >= 0) && !f.pinned.has(e.st.reg) {
+			f.pinned = f.pinned.add(e.st.reg)
+			work.TemporaryV128ShiftCountRegLeases++
+		}
+	}
+	return f.materialize(e)
+}
+
+func (f *fn) protectFixtureV128ShiftVector(e *elem) (int, regMask) {
+	floor, pins := f.spillFloor, f.fpinned
+	work := f.sc.fixtureWork
+	switch e.st.kind {
+	case stSlot:
+		if end := e.st.slotIndex() + 2; end > f.spillFloor {
+			f.spillFloor = end
+			work.TemporaryV128ShiftVectorSlotLeases++
+		}
+	case stLocalReg:
+		if !f.fpinned.has(e.st.reg) {
+			f.fpinned = f.fpinned.add(e.st.reg)
+			work.TemporaryV128ShiftVectorRegLeases++
+		}
+	}
+	return floor, pins
+}
