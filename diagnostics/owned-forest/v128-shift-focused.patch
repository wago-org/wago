diff --git a/src/core/compiler/backend/railshot/amd64/owned_forest_v128_shift_independent_test.go b/src/core/compiler/backend/railshot/amd64/owned_forest_v128_shift_independent_test.go
new file mode 100644
index 00000000..17f9338d
--- /dev/null
+++ b/src/core/compiler/backend/railshot/amd64/owned_forest_v128_shift_independent_test.go
@@ -0,0 +1,271 @@
+//go:build linux && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"testing"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	encoder "github.com/wago-org/wago/src/core/encoder/amd64"
+	wr "github.com/wago-org/wago/src/core/runtime"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+)
+
+type ownedShiftLane struct {
+	name    string
+	width   int
+	dynamic bool
+}
+
+var ownedShiftLanes = []ownedShiftLane{{"i16-imm", 16, false}, {"i16-dyn", 16, true}, {"i32-imm", 32, false}, {"i32-dyn", 32, true}, {"rotate", 32, false}, {"near-miss", 32, false}, {"pressure", 32, true}}
+
+func ownedShiftModule(t *testing.T, l ownedShiftLane) *wasm.Module {
+	t.Helper()
+	b := []byte{0, 0x20, 0}
+	rot := l.name == "rotate" || l.name == "near-miss"
+	if rot {
+		b = []byte{1, 2, 0x7b, 0x20, 0}
+	}
+	pc := func(i int) { b = append(b, 0x41); b = append(b, wasmtest.SLEB32(int32(i))...) }
+	ld := func(i int) { pc(i); b = append(b, 0xfd, 0, 4, 0) }
+	st := func() { b = append(b, 0xfd, 11, 4, 0) }
+	fd := func(i uint32) { b = append(b, 0xfd); b = append(b, wasmtest.ULEB(i)...) }
+	count := func() { ld(352); b = append(b, 0xfd, 27, 0) }
+	if rot {
+		ld(16)
+		b = append(b, 0x21, 2)
+		pc(512)
+		ld(0)
+		b = append(b, 0x22, 1)
+		pc(39)
+		fd(173)
+		local := byte(1)
+		if l.name == "near-miss" {
+			local = 2
+		}
+		b = append(b, 0x20, local)
+		pc(57)
+		fd(171)
+		fd(80)
+		st()
+		// Keep an old local1 read alive across a real write, then observe
+		// the retired old and current values independently in full width.
+		pc(544)
+		b = append(b, 0x20, 1)
+		ld(16)
+		b = append(b, 0x21, 1)
+		st()
+		pc(560)
+		b = append(b, 0x20, 1)
+		st()
+	} else if l.name == "pressure" {
+		pc(512)
+		ld(0)
+		count()
+		// Retain value and count through separately bounded XMM/GP pressure.
+		for i := 1; i <= 20; i++ {
+			ld(16 * i)
+			fd(77)
+		}
+		for range 19 {
+			fd(81)
+		}
+		b = append(b, 0x1a)
+		for i := 1; i <= 24; i++ {
+			ld(16 * i)
+			b = append(b, 0xfd, 27, 0)
+		}
+		for range 23 {
+			b = append(b, 0x6a)
+		}
+		b = append(b, 0x1a)
+		fd(173)
+		st()
+	} else {
+		for i := range 2 {
+			pc(512 + 16*i)
+			ld(16 * i)
+			if l.dynamic {
+				b = append(b, 0x20, 1) // true pinned local borrow
+			} else {
+				pc(l.width + 7 + i)
+			}
+			sub := uint32(171 + 2*i)
+			if l.width == 16 {
+				sub = uint32(139 + 2*i)
+			}
+			fd(sub)
+			st()
+		}
+	}
+	ld(512)
+	b = append(b, 0xfd, 27, 0, 0x73, 0x0b)
+	params := []wasm.ValType{wasm.I32}
+	if l.dynamic && l.name != "pressure" {
+		params = append(params, wasm.I32)
+	}
+	m := modMem(t, 1, params, []wasm.ValType{wasm.I32}, b)
+	if err := wasm.ValidateModule(m); err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+
+func ownedShiftRun(t *testing.T, cm *encoder.CompiledModule, l ownedShiftLane, count uint32, salt int) {
+	t.Helper()
+	eng, err := wr.NewEngine()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer eng.Close()
+	jm, err := wr.NewJobMemory(65536)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer jm.Close()
+	a, err := wr.NewArena(4096)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer a.Close()
+	mapped, entry, err := wr.MapCode(cm.Code)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer wr.Unmap(mapped)
+	mem := jm.CurrentBytes()
+	for i := range mem {
+		mem[i] = byte(i*31 + salt*7)
+	}
+	binary.LittleEndian.PutUint32(mem[352:], count)
+	want := append([]byte(nil), mem...)
+	apply := func(dst, src int, k uint32, right bool) {
+		k &= uint32(l.width - 1)
+		modulus := l.width / 8
+		for off := 0; off < 16; off += modulus {
+			if modulus == 2 {
+				v := binary.LittleEndian.Uint16(mem[src+off:])
+				if right {
+					v >>= k
+				} else {
+					v <<= k
+				}
+				binary.LittleEndian.PutUint16(want[dst+off:], v)
+			} else {
+				v := binary.LittleEndian.Uint32(mem[src+off:])
+				if right {
+					v >>= k
+				} else {
+					v <<= k
+				}
+				binary.LittleEndian.PutUint32(want[dst+off:], v)
+			}
+		}
+	}
+	switch l.name {
+	case "rotate", "near-miss":
+		src := 0
+		if l.name == "near-miss" {
+			src = 16
+		}
+		for off := 0; off < 16; off += 4 {
+			a, b := binary.LittleEndian.Uint32(mem[off:]), binary.LittleEndian.Uint32(mem[src+off:])
+			binary.LittleEndian.PutUint32(want[512+off:], a>>7|b<<25)
+		}
+		copy(want[544:], mem[:16])
+		copy(want[560:], mem[16:32])
+	case "pressure":
+		apply(512, 0, count, true)
+	default:
+		for i := range 2 {
+			k := count
+			if !l.dynamic {
+				k = uint32(l.width + 7 + i)
+			}
+			apply(512+i*16, 16*i, k, i == 1)
+		}
+	}
+	in, out, tr := a.Alloc(256), a.Alloc(256), a.Alloc(wr.TrapBufferBytes)
+	old := uint32(0xe3c51200 + salt)
+	binary.LittleEndian.PutUint64(in, uint64(old))
+	binary.LittleEndian.PutUint64(in[8:], uint64(count))
+	err = eng.Call(entry+uintptr(cm.Entry[0]), in, jm.LinearMemory(), tr, out)
+	expected := old ^ binary.LittleEndian.Uint32(want[512:])
+	if got := binary.LittleEndian.Uint32(out); err != nil || got != expected {
+		t.Fatalf("lane=%s count=%x got=%x want=%x err=%v", l.name, count, got, expected, err)
+	}
+	if !bytes.Equal(mem, want) {
+		for i := range mem {
+			if mem[i] != want[i] {
+				t.Fatalf("lane=%s count=%x byte[%d]=%x want=%x", l.name, count, i, mem[i], want[i])
+			}
+		}
+	}
+}
+
+func TestOwnedForestV128ShiftsOrdinary(t *testing.T) {
+	for _, l := range ownedShiftLanes {
+		t.Run(l.name, func(t *testing.T) {
+			m := ownedShiftModule(t, l)
+			for _, intr := range []bool{false, true} {
+				var native, metaOracle []byte
+				for _, candidate := range []bool{false, true} {
+					work := &fixtureModuleWork{Forest: candidate, TemporaryV128SIMD: true, TemporaryV128Locals: true, TemporaryV128UnsignedShifts: true}
+					var stats ModuleStats
+					cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+					if err != nil {
+						t.Fatal(err)
+					}
+					if cm.CodeImage != nil {
+						defer cm.CodeImage.Close()
+					}
+					if work.LegacyBodies != 1 || work.Rejected != 0 || work.Opcodes == 0 || candidate && work.Vector.stores == 0 || work.TemporaryV128Bodies != 1 {
+						t.Fatalf("inactive lane: %+v", work)
+					}
+					peep := stats.Funcs[0].Peephole
+					switch l.name {
+					case "rotate":
+						if work.TemporaryV128ShiftRotates != 1 || peep["simd-rotr-imm"]+peep["simd-rotr-avx512"] != 1 {
+							t.Fatalf("natural same-local rotate inactive: %v %+v", peep, work)
+						}
+					case "near-miss":
+						if work.TemporaryV128ShiftRotates != 0 || work.TemporaryV128ShiftRotateMisses != 1 || work.TemporaryV128ShiftImmediate != 2 {
+							t.Fatalf("reader near-miss did not preserve both shifts: %+v", work)
+						}
+					case "pressure":
+						if work.TemporaryV128ShiftDynamic != 1 || work.TemporaryV128Spills == 0 || work.TemporaryV128ShiftCountSlotLeases == 0 || work.TemporaryV128ShiftVectorSlotLeases == 0 {
+							t.Fatalf("actual shift/GP/XMM lease pressure absent: %+v", work)
+						}
+					default:
+						if l.dynamic && (work.TemporaryV128ShiftDynamic != 2 || work.TemporaryV128ShiftCountRegLeases == 0) || !l.dynamic && (work.TemporaryV128ShiftImmediate != 2 || peep["simd-shift-imm"] != 2) {
+							t.Fatalf("ordinary shift path inactive: %+v", work)
+						}
+					}
+					counts := []uint32{17, 0xffffffff}
+					if l.dynamic {
+						counts = []uint32{0, uint32(l.width - 1), uint32(l.width), uint32(l.width + 1), 0xffffffff}
+					}
+					for i, k := range counts {
+						ownedShiftRun(t, cm, l, k, 3+17*i)
+					}
+					meta := *cm
+					meta.Code, meta.CodeImage = nil, nil
+					encoded, err := json.Marshal(meta)
+					if err != nil {
+						t.Fatal(err)
+					}
+					if !candidate {
+						native = append([]byte(nil), cm.Code...)
+						metaOracle = encoded
+					} else if !bytes.Equal(native, cm.Code) || !bytes.Equal(metaOracle, encoded) {
+						t.Fatal("native or encoder metadata differs")
+					}
+					t.Logf("intr=%v candidate=%v bytes=%d peeps=%v work=%+v", intr, candidate, len(cm.Code), peep, work)
+				}
+			}
+		})
+	}
+}
