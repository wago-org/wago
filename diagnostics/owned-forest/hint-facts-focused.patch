+func layoutOldVectorFacts(t *testing.T, c layoutFactCase) (bool, bool) {
+	t.Helper()
+	m := c.module
+	if err := wasm.ValidateModule(m); err != nil {
+		t.Fatalf("recipe %s validation: %v", c.name, err)
+	}
+	body := m.Code[c.bodyIndex]
+	cc := wasm.NewModuleInstructionClassifier(m, true)
+	var work fixtureVectorClassificationWork
+	hasVector, err := classifyFixtureVectorBody(m, &cc, body.BodyBytes, &work)
+	if err != nil {
+		t.Fatalf("recipe %s old classifier: %v", c.name, err)
+	}
+	ft, ok := m.LocalFuncType(c.bodyIndex)
+	if !ok {
+		t.Fatalf("recipe %s missing signature", c.name)
+	}
+	total := work.signatureHasVector(ft) || hasVector
+	for _, l := range body.Locals.Runs {
+		total = wasm.EqualValType(l.Type, wasm.V128) || total
+	}
+	if hasVector != c.bodyVector || total != c.functionVector {
+		t.Fatalf("recipe %s old body/whole=%t/%t want %t/%t", c.name, hasVector, total, c.bodyVector, c.functionVector)
+	}
+	return hasVector, total
+}
