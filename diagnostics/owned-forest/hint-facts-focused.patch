+		if e == nil || !strings.Contains(e.Error(), "unsupported noninteger function ABI") || w.TemporaryV128HintFallbacks != 1 || w.TemporaryV128HintFactsUsed != 0 || w.TemporaryV128Classifier.Bodies != 1 || w.Attempts != 1 || w.Rejected != 1 {
