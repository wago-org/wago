+// Metadata probes are shared by the standalone and hint-driven classifiers.
+// Only the standalone global case can consume from the supplied reader. In
+// hint mode every probe is counted as added work and remains on a copy.
+func fixtureVectorOpcode(m *wasm.Module, op byte, r *wasm.Reader, work *fixtureVectorClassificationWork, observing bool) (vector, consumed bool, err error) {
+	switch op {
+	case 0xfd:
+		return true, false, nil
+	case 0x02, 0x03, 0x04, 0x1f, 0x1c, 0x23, 0x24, 0x10, 0x11, 0x12, 0x13, 0x14, 0x15:
+	default:
+		return false, false, nil
+	}
+	start := r.Offset()
+	probe := *r
+	switch op {
+	case 0x02, 0x03, 0x04, 0x1f:
+		b, ok := probe.Peek()
+		if !ok {
+			return false, false, fmt.Errorf("fixture forest: missing SIMD classification block type")
+		}
+		work.Bytes++
+		switch {
+		case isValByte(b) || b == 0x63 || b == 0x64:
+			work.TypeVisits++
+			return b == 0x7b, false, nil
+		case b != 0x40:
+			idx, err := probe.S33()
+			work.Bytes += uint64(probe.Offset() - start)
+			if err != nil || idx < 0 {
+				return false, false, fmt.Errorf("fixture forest: unknown SIMD classification block type")
+			}
+			ft, ok := m.TypeFunc(uint32(idx))
+			if !ok {
+				return false, false, fmt.Errorf("fixture forest: unresolved SIMD classification block type")
+			}
+			return work.signatureHasVector(ft), false, nil
+		}
+	case 0x1c:
+		n, err := probe.U32()
+		b, ok := probe.Peek()
+		work.Bytes += uint64(probe.Offset() - start)
+		if err != nil || n != 1 || !ok {
+			return false, false, fmt.Errorf("fixture forest: unknown SIMD classification select type")
+		}
+		work.Bytes++
+		work.TypeVisits++
+		return b == 0x7b, false, nil
+	case 0x23, 0x24:
+		reader := r
+		if observing {
+			reader = &probe
+		}
+		idx, err := reader.U32()
+		if observing {
+			work.Bytes += uint64(probe.Offset() - start)
+		}
+		if err != nil {
+			return false, false, err
+		}
+		g, ok := m.GlobalTypeByIndex(idx)
+		if !ok {
+			return false, false, fmt.Errorf("fixture forest: unresolved SIMD classification global")
+		}
+		work.TypeVisits++
+		return wasm.EqualValType(wasm.GlobalValueType(g), wasm.V128), !observing, nil
+	case 0x10, 0x11, 0x12, 0x13, 0x14, 0x15:
+		idx, err := probe.U32()
+		work.Bytes += uint64(probe.Offset() - start)
+		if err != nil {
+			return false, false, err
+		}
+		var ft *wasm.CompType
+		var ok bool
+		if op == 0x10 || op == 0x12 {
+			ft, ok = m.FuncSignature(idx)
+		} else {
+			ft, ok = m.TypeFunc(idx)
+		}
+		if !ok {
+			return false, false, fmt.Errorf("fixture forest: unresolved SIMD classification call type")
+		}
+		return work.signatureHasVector(ft), false, nil
+	}
+	return false, false, nil
+}
