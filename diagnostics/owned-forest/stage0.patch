diff --git a/src/core/compiler/backend/railshot/amd64/owned_forest_census_test.go b/src/core/compiler/backend/railshot/amd64/owned_forest_census_test.go
new file mode 100644
index 00000000..c0b19860
--- /dev/null
+++ b/src/core/compiler/backend/railshot/amd64/owned_forest_census_test.go
@@ -0,0 +1,53 @@
+//go:build amd64 && wago_owned_forest_census
+
+package amd64
+
+import "testing"
+
+func TestOwnedForestImage(t *testing.T) {
+	for _, tc := range []struct{ mode, want string }{
+		{"valid", ""},
+		{"stale-value-edge", ""},
+		{"duplicate", "duplicate-owner"},
+		{"cycle", "child-cycle"},
+		{"missing", "child-missing-from-list"},
+		{"reordered", "postorder-mismatch"},
+		{"unowned", "list-node-without-owner"},
+		{"depth", "root-depth-mismatch"},
+	} {
+		t.Run(tc.mode, func(t *testing.T) {
+			h, a, b, r := new(elem), new(elem), new(elem), new(elem)
+			h.next, h.prev = a, r
+			a.prev, a.next = h, b
+			b.prev, b.next = a, r
+			r.prev, r.next = b, h
+			r.setElemKind(ekDeferred)
+			r.st.setLogicalRoot(true)
+			r.arg0, r.arg1 = a, b
+			depth := 1
+			switch tc.mode {
+			case "stale-value-edge":
+				a.arg0 = r
+			case "duplicate":
+				r.arg1 = a
+			case "cycle":
+				r.arg0 = r
+			case "missing":
+				r.arg0 = new(elem)
+			case "reordered":
+				r.arg0, r.arg1 = b, a
+			case "unowned":
+				r.arg1 = nil
+			case "depth":
+				depth = 0
+			}
+			got := compareOwnedForest(h, depth)
+			if got.reason != tc.want {
+				t.Fatalf("got %+v; want reason %q", got, tc.want)
+			}
+			if tc.want == "" && (got.physical != 3 || got.projected != 3 || got.roots != 1 || got.childEdges != 2 || got.peakFrames != 2) {
+				t.Fatalf("unexpected matched image: %+v", got)
+			}
+		})
+	}
+}
