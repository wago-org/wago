+//go:build linux && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"testing"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+)
+
+func TestOwnedForestIntegerPredicateFPSelectOrdinary(t *testing.T) {
+	for _, wide := range []bool{false, true} {
+		for _, eqz := range []bool{false, true} {
+			t.Run(fmt.Sprintf("wide=%v/eqz=%v", wide, eqz), func(t *testing.T) {
+				it, raw, into, from, xor := wasm.I32, byte(0x7d), byte(0xbe), byte(0xbc), byte(0x73)
+				sign, quiet, old := uint64(0x80000000), uint64(0x7fc01234), uint64(0x42345678)
+				if wide {
+					it, raw, into, from, xor = wasm.I64, 0x7c, 0xbf, 0xbd, 0x85
+					sign, quiet, old = 0x8000000000000000, 0x7ff8000000001234, 0x423456789abcdef0
+				}
+				// Two private FP locals: old local5 stays under the selected alternatives.
+				b := []byte{1, 2, raw, 0x20, 0, into, 0x21, 5, 0x20, 5, 0x20, 1, into, 0x20, 2, into, 0x20, 3}
+				if eqz {
+					b = append(b, 0x50, 0x1c, 1, raw)
+				} else {
+					b = append(b, 0x20, 4, 0x54, 0x1b)
+				}
+				b = append(b, 0x21, 6, 0x20, 2, into, 0x21, 5, from, 0x20, 6, from, xor, 0x0b)
+				m := mod1(t, []wasm.ValType{it, it, it, wasm.I64, wasm.I64}, []wasm.ValType{it}, b)
+				if err := wasm.ValidateModule(m); err != nil {
+					t.Fatal(err)
+				}
+				for _, intr := range []bool{false, true} {
+					var native, metaOracle []byte
+					for _, candidate := range []bool{false, true} {
+						work := &fixtureModuleWork{Forest: candidate, ScalarFP: true, ScalarFPSelect: true}
+						var stats ModuleStats
+						cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+						if err != nil {
+							t.Fatal(err)
+						}
+						if cm.CodeImage != nil {
+							defer cm.CodeImage.Close()
+						}
+						if work.LegacyBodies != 1 || work.Rejected != 0 || work.Opcodes == 0 || candidate && work.Vector.stores == 0 || work.FPSelectEmissions != 1 {
+							t.Fatalf("inactive select lane: %+v", work)
+						}
+						for _, tc := range []struct{ a, b, x, y uint64 }{
+							{0, sign, 0, 1}, {quiet, 0, 1 << 32, 1}, {sign, quiet, 0, 1 << 32}, {quiet, sign, ^uint64(0), 0},
+						} {
+							choose := tc.x < tc.y
+							if eqz {
+								choose = tc.x == 0
+							}
+							want := old ^ tc.b
+							if choose {
+								want = old ^ tc.a
+							}
+							got, err := ownedRunModule(t, cm, []uint64{old, tc.a, tc.b, tc.x, tc.y})
+							if err != nil || got != want {
+								t.Fatalf("got=%x want=%x err=%v", got, want, err)
+							}
+						}
+						meta := *cm
+						meta.Code, meta.CodeImage = nil, nil
+						encoded, err := json.Marshal(meta)
+						if err != nil {
+							t.Fatal(err)
+						}
+						if !candidate {
+							native = append([]byte(nil), cm.Code...)
+							metaOracle = encoded
+						} else if !bytes.Equal(native, cm.Code) || !bytes.Equal(metaOracle, encoded) {
+							t.Fatal("native or encoder metadata differs")
+						}
+						t.Logf("intr=%v forest=%v bytes=%d peeps=%v work=%+v", intr, candidate, len(cm.Code), stats.Funcs[0].Peephole, work)
+					}
+				}
+			})
+		}
+	}
+}
+
+func TestOwnedForestIntegerPredicateClassification(t *testing.T) {
+	for _, op := range []wOp{opLtU, opEqz, opAdd} {
+		f := closureStart(true)
+		f.pushReg(RAX, mtI64)
+		if op == opEqz {
+			f.pushUnOp(op, mtI64)
+		} else {
+			f.pushReg(RCX, mtI64)
+			f.pushBinOp(op, mtI64)
+		}
+		p := f.s.back()
+		if p == nil || !p.isDeferred() || p.deferredOp() != op || rootMachineType(p) != mtI64 {
+			t.Fatalf("not a width-retaining deferred op %v", op)
+		}
+		if fixtureI32SelectCondition(p) != (op != opAdd) {
+			t.Fatalf("wrong predicate semantic type for %v", op)
+		}
+	}
+}
