+//go:build linux && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"testing"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	encoder "github.com/wago-org/wago/src/core/encoder/amd64"
+	wr "github.com/wago-org/wago/src/core/runtime"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+)
+
+func ownedColdPrefixModule(t *testing.T) *wasm.Module {
+	t.Helper()
+	// Keep original local0 and 70 exact distinct i64 operands under two
+	// sequential nested scalar control frames. Each result then extends to i64.
+	b := []byte{0, 0x20, 0}
+	for i := int64(1); i <= 70; i++ {
+		b = append(b, 0x42)
+		b = append(b, wasmtest.SLEB64(i)...)
+	}
+	// Retain a semantic i32 result from a deferred i64 unsigned comparison.
+	b = append(b, 0x20, 0, 0x42)
+	b = append(b, wasmtest.SLEB64(256)...)
+	b = append(b, 0x54)
+	for _, condition := range []byte{1, 2} {
+		b = append(b, 0x02, 0x7f, 0x20, condition, 0x04, 0x7f,
+			0x41, 24, 0x41, 17, 0x3a, 0, 0, 0x41, 24, 0x2d, 0, 0, 0x05,
+			0x41, 24, 0x41, 29, 0x3a, 0, 0, 0x41, 24, 0x2d, 0, 0, 0x0b, 0x0c, 0, 0x0b)
+	}
+	b = append(b, 0x6a, 0x6a, 0xad)
+	for range 71 {
+		b = append(b, 0x7c)
+	}
+	b = append(b, 0x42, 23, 0x21, 0, 0x20, 0, 0x7c, 0x0b)
+	m := modMem(t, 1, []wasm.ValType{wasm.I64, wasm.I32, wasm.I32}, []wasm.ValType{wasm.I64}, b)
+	if err := wasm.ValidateModule(m); err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+
+func TestOwnedForestColdPrefixOrdinary(t *testing.T) {
+	m := ownedColdPrefixModule(t)
+	for _, intr := range []bool{false, true} {
+		var native, metaOracle []byte
+		for _, candidate := range []bool{false, true} {
+			work := &fixtureModuleWork{Forest: candidate}
+			var stats ModuleStats
+			cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if cm.CodeImage != nil {
+				defer cm.CodeImage.Close()
+			}
+			if work.LegacyBodies != 1 || work.Rejected != 0 || work.Opcodes == 0 || candidate && work.Vector.stores == 0 {
+				t.Fatalf("inactive cold-prefix fixture: %+v", work)
+			}
+			if candidate && (work.Vector.coldControlCaptures < 3 || work.Vector.coldControlPeak <= 64 || uint64(work.Vector.coldControlPeak) >= work.Vector.coldControlTypeCopies || work.Vector.coldControlCapacity < work.Vector.coldControlPeak) {
+				t.Fatalf("cold prefix capture/live slab reuse not reached: %+v", work.Vector)
+			}
+			for _, args := range [][3]uint64{{17, 0, 0}, {0xfffffffffffffff0, 1, 0}, {23, 0, 1}, {0x123456789abcdef0, 1, 1}} {
+				want := args[0] + 70*71/2 + 23
+				if args[0] < 256 {
+					want++
+				}
+				for _, cond := range args[1:] {
+					if cond == 0 {
+						want += 29
+					} else {
+						want += 17
+					}
+				}
+				got, err := ownedColdPrefixRun(t, cm, args)
+				if err != nil || got != want {
+					t.Fatalf("args=%x got=%x want=%x err=%v", args, got, want, err)
+				}
+			}
+			meta := *cm
+			meta.Code, meta.CodeImage = nil, nil
+			encoded, err := json.Marshal(meta)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !candidate {
+				native = append([]byte(nil), cm.Code...)
+				metaOracle = encoded
+			} else {
+				t.Logf("cold pair intr=%v nativeExact=%v encoderExact=%v listBytes=%d forestBytes=%d", intr, bytes.Equal(native, cm.Code), bytes.Equal(metaOracle, encoded), len(native), len(cm.Code))
+			}
+			t.Logf("intr=%v forest=%v bytes=%d peeps=%v work=%+v", intr, candidate, len(cm.Code), stats.Funcs[0].Peephole, work)
+		}
+	}
+}
+
+func ownedColdPrefixRun(t *testing.T, cm *encoder.CompiledModule, args [3]uint64) (uint64, error) {
+	t.Helper()
+	eng, err := wr.NewEngine()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer eng.Close()
+	jm, err := wr.NewJobMemory(65536)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer jm.Close()
+	a, err := wr.NewArena(4096)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer a.Close()
+	mapped, entry, err := wr.MapCode(cm.Code)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer wr.Unmap(mapped)
+	in, out, tr := a.Alloc(256), a.Alloc(256), a.Alloc(wr.TrapBufferBytes)
+	for i, v := range args {
+		binary.LittleEndian.PutUint64(in[8*i:], v)
+	}
+	mem := jm.CurrentBytes()
+	for i := range mem {
+		mem[i] = byte(i*29 + 13)
+	}
+	want := append([]byte(nil), mem...)
+	want[24] = 29
+	if args[2] != 0 {
+		want[24] = 17
+	}
+	err = eng.Call(entry+uintptr(cm.Entry[0]), in, jm.LinearMemory(), tr, out)
+	if err == nil && !bytes.Equal(mem, want) {
+		t.Fatalf("unexpected full memory after second branch: marker=%d want=%d", mem[24], want[24])
+	}
+	return binary.LittleEndian.Uint64(out), err
+}
