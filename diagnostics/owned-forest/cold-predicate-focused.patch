+// A deferred i64 comparison retains its input width until lowering, but
+// its Wasm result is i32. Do not change the encoder's width interpretation.
+func fixtureDeferredI64Predicate(c *elem) bool {
+	return c != nil && c.isDeferred() && rootMachineType(c) == mtI64 &&
+		(isCompare(c.deferredOp()) || c.deferredOp() == opEqz)
+}
+
+func fixtureI32SelectCondition(c *elem) bool {
+	return c != nil && (rootMachineType(c) == mtI32 || fixtureDeferredI64Predicate(c))
+}
