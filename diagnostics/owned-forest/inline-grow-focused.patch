+//go:build linux && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"encoding/json"
+	"testing"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+)
+
+func ownedInlineGrowModule(t *testing.T) *wasm.Module {
+	t.Helper()
+	// Retain old param, pre-grow byte and page count across a naturally selected
+	// private synthetic control leaf. The returned old page count is independent.
+	caller := []byte{0, 0x20, 2, 0x41, 0, 0x2d, 0, 0, 0x3f, 0, 0x20, 0, 0x10, 1,
+		0x6a, 0x6a, 0x6a, 0x3f, 0, 0x6a, 0x41, 23, 0x21, 2, 0x20, 2, 0x6a,
+		0x20, 1, 0x41, 37, 0x36, 2, 0, 0x20, 1, 0x28, 2, 0, 0x6a, 0x0b}
+	leaf := []byte{0, 0x20, 0, 0x04, 0x7f, 0x20, 0, 0x40, 0, 0x05, 0x41, 0, 0x40, 0, 0x0b, 0x0b}
+	i := wasm.I32
+	m, err := wasm.DecodeModule(wasmtest.Module(
+		wasmtest.Section(1, wasmtest.Vec(wasmtest.FuncType([]wasm.ValType{i, i, i}, []wasm.ValType{i}), wasmtest.FuncType([]wasm.ValType{i}, []wasm.ValType{i}))),
+		wasmtest.Section(3, wasmtest.Vec(wasmtest.ULEB(0), wasmtest.ULEB(1))),
+		wasmtest.Section(5, wasmtest.Vec([]byte{1, 1, 2})),
+		wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("f", 0, 0))),
+		wasmtest.Section(10, wasmtest.Vec(append(wasmtest.ULEB(uint32(len(caller))), caller...), append(wasmtest.ULEB(uint32(len(leaf))), leaf...))),
+	))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = wasm.ValidateModule(m); err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+
+func TestOwnedForestInlineGrowOrdinary(t *testing.T) {
+	m := ownedInlineGrowModule(t)
+	for _, intr := range []bool{false, true} {
+		var native, metaOracle []byte
+		for _, candidate := range []bool{false, true} {
+			work := &fixtureModuleWork{Forest: candidate, IntegerControlInline: true, IntegerControlInlineMemoryGrow: true, PrivateMemory32Grow: true}
+			var stats ModuleStats
+			cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if cm.CodeImage != nil {
+				defer cm.CodeImage.Close()
+			}
+			if work.LegacyBodies == 0 || work.Opcodes == 0 || work.Rejected != 0 || candidate && work.Vector.stores == 0 || work.IntegerControlInlineLeaves != 1 || work.IntegerControlInlineRecursive != 0 || work.MemoryGrowEmissions != 4 || work.MemorySizeEmissions != 2 {
+				t.Fatalf("inactive control leaf: %+v", work)
+			}
+			st := stats.Funcs[0]
+			if st.Calls["inline"] != 1 || st.Calls["regabi"] != 0 || st.Calls["wrapper"] != 0 || st.Calls["mixed"] != 0 {
+				t.Fatalf("wrong inline strategy: %v", st.Calls)
+			}
+			for _, delta := range []uint32{0, 1} {
+				for _, old := range []uint32{19, 0xfffffff0} {
+					ownedMemoryGrowRun(t, cm, delta, old, 1)
+				}
+			}
+			meta := *cm
+			meta.Code, meta.CodeImage = nil, nil
+			encoded, err := json.Marshal(meta)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !candidate {
+				native = append([]byte(nil), cm.Code...)
+				metaOracle = encoded
+			} else if !bytes.Equal(native, cm.Code) || !bytes.Equal(metaOracle, encoded) {
+				t.Fatal("staged list/forest native or encoder metadata differs")
+			}
+			t.Logf("intr=%v forest=%v bytes=%d calls=%v work=%+v", intr, candidate, len(cm.Code), st.Calls, work)
+		}
+	}
+}
