+package amd64
+
+import (
+	"fmt"
+
+	"github.com/wago-org/wago/src/core/compiler/codegen"
+)
+
+// OwnedForestPublicFixture is a per-compile test bridge, not an API admission
+// classifier. It is available only in an explicit fixture build and never
+// retries with linked-list lowering.
+type OwnedForestPublicFixture struct {
+	work fixtureModuleWork
+}
+
+func NewOwnedForestPublicFixture(forest bool) *OwnedForestPublicFixture {
+	return &OwnedForestPublicFixture{work: fixtureModuleWork{Forest: forest, DynamicIntegerHostImports: true}}
+}
+
+func (f *OwnedForestPublicFixture) Configure(opts *CompileOptions) error {
+	if codegen.SourceChecks || opts.Workers != 1 || opts.Profile || opts.Stats != nil ||
+		opts.CollectInlineReport || len(opts.CustomInstructions) != 0 {
+		return fmt.Errorf("owned forest public fixture requires ordinary serial compilation")
+	}
+	opts.fixtureWork = &f.work
+	return nil
+}
+
+// DynamicImportSites counts source sites for which both native paths were
+// emitted and joined. It is not a count of executed runtime dispatch paths.
+func (f *OwnedForestPublicFixture) DynamicImportSites() uint64 {
+	return f.work.DynamicIntegerHostImportSites
+}
