@@ -0,0 +1,247 @@
+//go:build linux && amd64 && !tinygo && !wago_target_tinygo && !wago_standalone && wago_owned_forest_public_fixture
+
+package wago
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"os"
+	"testing"
+
+	railshot "github.com/wago-org/wago/src/core/compiler/backend/railshot/amd64"
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	coreruntime "github.com/wago-org/wago/src/core/runtime"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+	"unsafe"
+)
+
+type ordinaryDynamicInput struct {
+	x uint64
+	y uint32
+}
+
+var ordinaryDynamicInputs = []ordinaryDynamicInput{
+	{0x0, 0}, {0x8000000000000001, 0x80000003}, {0xffffffffffffffff, 0xffffffff},
+}
+
+func ordinaryDynamicImport(module, name string, typeIndex uint32) []byte {
+	field := func(s string) []byte { return append(wasmtest.ULEB(uint32(len(s))), []byte(s)...) }
+	e := append(field(module), field(name)...)
+	return append(append(e, 0), wasmtest.ULEB(typeIndex)...)
+}
+func ordinaryDynamicHostBytes() []byte {
+	i, j := wasm.I32, wasm.I64
+	importType := wasmtest.FuncType([]wasm.ValType{i, j}, []wasm.ValType{j})
+	runType := wasmtest.FuncType([]wasm.ValType{j, i}, []wasm.ValType{j})
+	leafType := wasmtest.FuncType([]wasm.ValType{i, j}, []wasm.ValType{j})
+	body := []byte{0x20, 0, 0x20, 0, 0x42}
+	body = append(body, wasmtest.SLEB64(95)...)
+	body = append(body, 0x85, 0x21, 0, 0x20, 1, 0x20, 0, 0x10, 0)
+	body = append(body, 0x85, 0x20, 0, 0x7c, 0x0b)
+	// leaf(y, x) returns (x*3 + uint32(y)) - 1.
+	leaf := []byte{0x20, 1, 0x42, 3, 0x7e, 0x20, 0, 0xad, 0x7c, 0x42, 1, 0x7d, 0x0b}
+	return wasmtest.Module(
+		wasmtest.Section(1, wasmtest.Vec(importType, runType, leafType)),
+		wasmtest.Section(2, wasmtest.Vec(ordinaryDynamicImport("env", "combine", 0))),
+		wasmtest.Section(3, wasmtest.Vec(wasmtest.ULEB(1), wasmtest.ULEB(2))),
+		wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("run", 0, 1), wasmtest.ExportEntry("leaf", 0, 2))),
+		wasmtest.Section(10, wasmtest.Vec(wasmtest.Code(body), wasmtest.Code(leaf))),
+	)
+}
+
+func ordinaryDynamicProducerBytes() []byte {
+	i, j := wasm.I32, wasm.I64
+	ft := wasmtest.FuncType([]wasm.ValType{i, j}, []wasm.ValType{j})
+	// Independent local Wasm instance; x*5 - uint32(y).
+	body := []byte{0x20, 1, 0x42, 5, 0x7e, 0x20, 0, 0xad, 0x7d, 0x0b}
+	return wasmtest.Module(
+		wasmtest.Section(1, wasmtest.Vec(ft)),
+		wasmtest.Section(3, wasmtest.Vec(wasmtest.ULEB(0))),
+		wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("combine", 0, 0))),
+		wasmtest.Section(10, wasmtest.Vec(wasmtest.Code(body))),
+	)
+}
+func ordinaryDynamicGoValue(x uint64, y uint32) uint64 {
+	return (x<<11 | x>>53) ^ (uint64(y) * 0x100000001)
+}
+func ordinaryDynamicCheck(t *testing.T, c, producer *Compiled, lane string) {
+	t.Helper()
+	var in *Instance
+	var producerIn *Instance
+	imports := NewImports()
+	var target ordinaryDynamicInput
+	calls, reentries := 0, 0
+	read := func(h HostCall) (uint64, uint32) {
+		if h.ParamCount() != 2 || h.ResultCount() != 1 {
+			t.Errorf("args/results %d/%d want2/1", h.ParamCount(), h.ResultCount())
+			return 0, 0
+		}
+		y, yhi := h.RawParam(0)
+		x, xhi := h.RawParam(1)
+		if y != uint64(target.y) || x != target.x^95 || yhi != 0 || xhi != 0 || uint32(h.I32(0)) != target.y || uint64(h.I64(1)) != x {
+			t.Errorf("raw/typed ordered slots got (%x,%x)/(%x,%x), input=%+v", y, yhi, x, xhi, target)
+		}
+		return x, uint32(y)
+	}
+	bind := func(fn any) {
+		imports.HostFunc("env", "combine", fn).Params(ValI32, ValI64).Results(ValI64)
+	}
+	switch lane {
+	case "go-host":
+		bind(HostCallFunc(func(h HostCall) {
+			calls++
+			x, y := read(h)
+			z := ordinaryDynamicGoValue(x, y)
+			if calls%2 == 1 {
+				h.SetI64(0, int64(z))
+			} else {
+				h.SetRawResult(0, z, 0)
+			}
+		}))
+	case "same-instance-reentry":
+		bind(CallerHostCallFunc(func(caller Caller, h HostCall) {
+			calls++
+			x, y := read(h)
+			r, e := in.InvokeFromHost(context.Background(), caller, "leaf", uint64(y), x)
+			if e != nil || len(r) != 1 {
+				t.Errorf("ordinary nested leaf=%v err=%v", r, e)
+				return
+			}
+			got := r[0] // no retained invocation-owned slice
+			reentries++
+			if got != 3*x+uint64(y)-1 {
+				t.Errorf("nested leaf=%x want=%x", got, 3*x+uint64(y)-1)
+			}
+			h.SetRawResult(0, got, 0)
+		}))
+	case "native-cross-instance":
+		if producer == nil {
+			t.Fatal("invalid test lane setup")
+		}
+		var e error
+		producerIn, e = Instantiate(producer, InstantiateOptions{})
+		if e != nil {
+			t.Fatal(e)
+		}
+		defer producerIn.Close()
+		exp, e := producerIn.ExportedFunc("combine")
+		if e != nil {
+			t.Fatal(e)
+		}
+		imports.Function("env", "combine", exp)
+	default:
+		t.Fatal("unknown lane")
+	}
+	var e error
+	in, e = Instantiate(c, InstantiateOptions{Imports: imports})
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer in.Close()
+	if c.NumImports != 1 || !c.dynamicImports || !c.supportsGoHostDispatchTag() {
+		t.Fatal("public image lacks dynamic import or selected dispatch tag publication")
+	}
+	// Read the one real runtime-owned dispatch entry while its instance
+	// still owns it. No guest-provided offsets or process addresses logged.
+	ptr := in.jm.CaptureInstanceContext().ImportDispatch
+	if ptr == 0 {
+		t.Fatal("missing actual import dispatch entry")
+	}
+	dispatch := unsafe.Slice((*byte)(offHeapPtr(ptr)), coreruntime.ImportDispatchEntryBytes)
+	lo := func(off int) uint64 { return binary.LittleEndian.Uint64(dispatch[off:]) }
+	contextWord := lo(coreruntime.ImportDispatchCallerContextOffset)
+	contextTag := contextWord & uint64(coreruntime.ImportDispatchCallerGoHostTag)
+	if contextWord&uint64(coreruntime.ImportDispatchCallerNativeLeafTag) != 0 {
+		t.Fatal("out-of-scope native leaf route was installed")
+	}
+	if lane == "native-cross-instance" {
+		if contextTag != 0 || lo(coreruntime.ImportDispatchCodePtrOffset) != uint64(producerIn.base)+uint64(producerIn.c.Entry[0]) || lo(coreruntime.ImportDispatchHomeLinMemOffset) != uint64(producerIn.jm.LinMemBase()) {
+			t.Fatal("runtime import is not bound to the exact native producer")
+		}
+	} else if contextTag == 0 || lo(coreruntime.ImportDispatchHomeLinMemOffset) != uint64(in.jm.LinMemBase()) {
+		t.Fatal("runtime import has no ordinary Go caller dispatch tag")
+	}
+	for _, v := range ordinaryDynamicInputs {
+		target = v
+		x := v.x ^ 95
+		z := ordinaryDynamicGoValue(x, v.y)
+		switch lane {
+		case "same-instance-reentry":
+			z = 3*x + uint64(v.y) - 1
+		case "native-cross-instance":
+			z = 5*x - uint64(v.y)
+		}
+		want := (v.x ^ z) + x
+		r, e := in.Invoke("run", v.x, uint64(v.y))
+		if e != nil || len(r) != 1 || r[0] != want {
+			t.Fatalf("lane=%s v=%+v got=%v want=%x err=%v", lane, v, r, want, e)
+		}
+	}
+	expectedCalls, expectedReentries := len(ordinaryDynamicInputs), 0
+	if lane == "native-cross-instance" {
+		expectedCalls = 0
+	}
+	if lane == "same-instance-reentry" {
+		expectedReentries = len(ordinaryDynamicInputs)
+	}
+	if calls != expectedCalls || reentries != expectedReentries {
+		t.Fatalf("actual callbacks=%d reentries=%d want=%d/%d", calls, reentries, expectedCalls, expectedReentries)
+	}
+	r, e := json.Marshal(map[string]any{"lane": lane, "outer": len(ordinaryDynamicInputs), "callbacks": calls, "nested": reentries, "goTag": contextTag != 0})
+	if e != nil {
+		t.Fatal(e)
+	}
+	t.Logf("PUBLIC_DYNAMIC_RUNTIME %s", r)
+}
+
+func TestScopedPublicDynamicIntegerHostImports(t *testing.T) {
+	arm := os.Getenv("WAGO_ORDINARY_DYNAMIC_ARM")
+	if arm != "wide" && arm != "compact" {
+		t.Fatal("run only with the predeclared public gate arm")
+	}
+	forest := arm == "compact"
+	compile := func(name string, body []byte, sites uint64) *Compiled {
+		t.Helper()
+		cfg := NewRuntimeConfig().WithFunctionWorkers(1).WithMaxModuleBytes(uint64(len(body)))
+		proof := railshot.NewOwnedForestPublicFixture(forest)
+		cfg.ownedForestPublicFixture = proof
+		c, e := Compile(cfg, body)
+		if e != nil {
+			t.Fatalf("public compile of %s: %v", name, e)
+		}
+		t.Cleanup(func() {
+			if e := c.Close(); e != nil {
+				t.Error(e)
+			}
+		})
+		if proof.DynamicImportSites() != sites {
+			t.Fatalf("public compile of %s emitted %d completed dynamic sites, want%d", name, proof.DynamicImportSites(), sites)
+		}
+		if (sites == 1) != c.dynamicImports || (sites == 1) != c.supportsGoHostDispatchTag() {
+			t.Fatalf("public compile of %s published incorrect import or host dispatch metadata", name)
+		}
+		var out bytes.Buffer
+		if _, e = c.WriteCodeTo(&out); e != nil {
+			t.Fatal(e)
+		}
+		meta, e := compiledMetadataBytes(c, true)
+		if e != nil {
+			t.Fatal(e)
+		}
+		receipt, e := json.Marshal(map[string]any{"arm": arm, "module": name, "body": fmt.Sprintf("%x", sha256.Sum256(body)), "native": fmt.Sprintf("%x", sha256.Sum256(out.Bytes())), "metadata": fmt.Sprintf("%x", sha256.Sum256(meta)), "nativeBytes": out.Len(), "metadataBytes": len(meta), "sites": sites, "dynamic": c.dynamicImports, "goDispatchTag": c.supportsGoHostDispatchTag()})
+		if e != nil {
+			t.Fatal(e)
+		}
+		t.Logf("PUBLIC_DYNAMIC_ARTIFACT %s", receipt)
+		return c
+	}
+	consumer := compile("caller", ordinaryDynamicHostBytes(), 1)
+	producer := compile("producer", ordinaryDynamicProducerBytes(), 0)
+	for _, lane := range []string{"go-host", "same-instance-reentry", "native-cross-instance"} {
+		t.Run(lane, func(t *testing.T) { ordinaryDynamicCheck(t, consumer, producer, lane) })
+	}
+}
