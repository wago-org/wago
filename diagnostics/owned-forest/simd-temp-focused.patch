+//go:build amd64
+
+package amd64
+
+import (
+	"fmt"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+)
+
+// Preflight the entire validated body, not just the instructions visited by
+// bodyLoop. Existing SIMD selectors can consume adjacent operations, including
+// a load/extract packet and store/repeated-address/load packet.
+func (f *fn) preflightFixtureTemporarySIMD(body []byte) (bool, error) {
+	if f.moduleEH || f.gcFrameRoots != nil || f.guardMode || f.threadedMemory0 ||
+		f.vectorRegion.enabled || len(f.customInstructions) != 0 || !sigIsIntOnly(f.ft) {
+		return false, fmt.Errorf("fixture forest: unsupported temporary SIMD function state")
+	}
+	for _, typ := range f.localType {
+		if typ != mtI32 && typ != mtI64 {
+			return false, fmt.Errorf("fixture forest: unsupported temporary SIMD local type")
+		}
+	}
+
+	r := wasm.NewReader(body)
+	depth := 1
+	sawSIMD := false
+	for r.HasNext() {
+		op, err := r.Byte()
+		if err != nil {
+			return false, err
+		}
+		switch {
+		case op == 0xfd:
+			sub, err := r.U32()
+			if err != nil {
+				return false, err
+			}
+			switch sub {
+			case 0, 11: // v128.load/store
+				if err := f.checkFixtureSIMDMemory(r); err != nil {
+					return false, err
+				}
+			case 12: // v128.const
+				if _, err := r.Bytes(16); err != nil {
+					return false, err
+				}
+			case 21, 22, 24, 25, 27, 29: // integer lane extraction
+				if _, err := r.Byte(); err != nil {
+					return false, err
+				}
+			case 77, 78, 79, 80, 81, 82, 83: // bitwise and any_true
+			default:
+				return false, fmt.Errorf("fixture forest: unsupported temporary SIMD subopcode %d", sub)
+			}
+			sawSIMD = true
+		case op == 0x02 || op == 0x04:
+			bt, err := r.Byte()
+			if err != nil || (bt != 0x40 && bt != 0x7f && bt != 0x7e) {
+				return false, fmt.Errorf("fixture forest: unsupported temporary SIMD control signature")
+			}
+			depth++
+		case op == 0x0b:
+			depth--
+			if depth == 0 {
+				if r.HasNext() {
+					return false, fmt.Errorf("fixture forest: trailing temporary SIMD body bytes")
+				}
+				return sawSIMD, nil
+			}
+		case op == 0x0c || op == 0x0d:
+			label, err := r.U32()
+			if err != nil || uint64(label) >= uint64(depth-1) {
+				return false, fmt.Errorf("fixture forest: unsupported temporary SIMD branch target")
+			}
+		case op >= 0x28 && op <= 0x3e && fixtureScalarOpcode(op):
+			if err := f.checkFixtureSIMDMemory(r); err != nil {
+				return false, err
+			}
+		case op == 0x03 || op == 0x0e || op == 0x10 || op == 0x1b ||
+			op == 0x23 || op == 0x24 || op == 0x3f || op == 0xfc || !fixtureScalarOpcode(op):
+			return false, fmt.Errorf("fixture forest: unsupported temporary SIMD body opcode %#x", op)
+		default:
+			if err := f.classifier.SkipImmediate(r, op); err != nil {
+				return false, err
+			}
+		}
+	}
+	return false, fmt.Errorf("fixture forest: missing temporary SIMD body end")
+}
+
+func (f *fn) checkFixtureSIMDMemory(r *wasm.Reader) error {
+	index, _, err := f.readMemArg(r)
+	if err != nil {
+		return err
+	}
+	if f.checkFixtureMemorySize(index) != nil {
+		return fmt.Errorf("fixture forest: unsupported temporary SIMD memory")
+	}
+	return nil
+}
diff --git a/src/core/compiler/backend/railshot/amd64/owned_forest_simd_temp_independent_test.go b/src/core/compiler/backend/railshot/amd64/owned_forest_simd_temp_independent_test.go
