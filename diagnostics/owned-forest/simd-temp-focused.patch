index 00000000..ed6b28f2
--- /dev/null
+++ b/src/core/compiler/backend/railshot/amd64/owned_forest_simd_temp_independent_test.go
@@ -0,0 +1,172 @@
+//go:build linux && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"testing"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	encoder "github.com/wago-org/wago/src/core/encoder/amd64"
+	wr "github.com/wago-org/wago/src/core/runtime"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+)
+
+var ownedSIMDTempMask = [16]byte{1, 33, 10, 17, 5, 93, 0xe0, 0x23, 4, 2, 97, 0x91, 7, 0x11, 55, 0xf1}
+
+const ownedSIMDTempOut = 512
+const ownedSIMDTempPressureRoots = 20
+
+func ownedSIMDTempModule(t *testing.T, pressure bool) *wasm.Module {
+	t.Helper()
+	b := []byte{0, 0x20, 0}
+	pc := func(addr int) { b = append(b, 0x41); b = append(b, wasmtest.SLEB32(int32(addr))...) }
+	ld := func(addr int) { pc(addr); b = append(b, 0xfd, 0, 4, 0) }
+	pc(ownedSIMDTempOut)
+	if pressure {
+		for i := range ownedSIMDTempPressureRoots {
+			ld(16 * i)
+			b = append(b, 0xfd, 77) // eager v128.not
+		}
+		for range ownedSIMDTempPressureRoots - 1 {
+			b = append(b, 0xfd, 81)
+		} // v128.xor
+	} else {
+		ld(0)
+		b = append(b, 0xfd, 12)
+		b = append(b, ownedSIMDTempMask[:]...)
+		b = append(b, 0xfd, 81)
+	}
+	b = append(b, 0xfd, 11, 4, 0)
+	ld(ownedSIMDTempOut)
+	b = append(b, 0xfd, 83, 0x04, 0x7f) // v128.any_true, scalar i32 IF
+	ld(ownedSIMDTempOut)
+	b = append(b, 0xfd, 27, 0, 0x05, 0x41, 23, 0x0b, 0x73, 0x0b) // i32x4.extract_lane0; xor old prefix
+	m := modMem(t, 1, []wasm.ValType{wasm.I32}, []wasm.ValType{wasm.I32}, b)
+	if err := wasm.ValidateModule(m); err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+
+func ownedSIMDTempRun(t *testing.T, cm *encoder.CompiledModule, pressure, zero bool) {
+	t.Helper()
+	eng, err := wr.NewEngine()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer eng.Close()
+	jm, err := wr.NewJobMemory(65536)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer jm.Close()
+	mem := jm.LinearMemory()
+	for i := range mem {
+		mem[i] = byte(i*29 + 13)
+	}
+	for i := range ownedSIMDTempPressureRoots {
+		for j := range 16 {
+			mem[16*i+j] = byte(i*i*3 + j*17 + i*j*7 + 13)
+		}
+	}
+	if zero {
+		if pressure {
+			clear(mem[:16*ownedSIMDTempPressureRoots])
+		} else {
+			copy(mem, ownedSIMDTempMask[:])
+		}
+	}
+	var data [16]byte
+	for j := range data {
+		if pressure {
+			for i := range ownedSIMDTempPressureRoots {
+				data[j] ^= ^mem[i*16+j]
+			}
+		} else {
+			data[j] = mem[j] ^ ownedSIMDTempMask[j]
+		}
+	}
+	if zero != (data == [16]byte{}) {
+		t.Fatalf("invalid test oracle data %x (zero=%v)", data, zero)
+	}
+	if !zero && bytes.Equal(data[:8], data[8:]) {
+		t.Fatalf("invalid identical result halves: %x", data)
+	}
+	wantMem := append([]byte(nil), mem...)
+	copy(wantMem[ownedSIMDTempOut:], data[:])
+	a, err := wr.NewArena(4096)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer a.Close()
+	mapped, entry, err := wr.MapCode(cm.Code)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer wr.Unmap(mapped)
+	in, out, tr := a.Alloc(256), a.Alloc(256), a.Alloc(wr.TrapBufferBytes)
+	old := uint32(0xabcde112)
+	binary.LittleEndian.PutUint64(in, uint64(old))
+	err = eng.Call(entry+uintptr(cm.Entry[0]), in, mem, tr, out)
+	v := binary.LittleEndian.Uint32(data[:])
+	if zero {
+		v = 23
+	}
+	if got := binary.LittleEndian.Uint32(out); err != nil || got != old^v {
+		t.Fatalf("pressure=%v zero=%v got=%x want=%x err=%v", pressure, zero, got, old^v, err)
+	}
+	if !bytes.Equal(mem, wantMem) {
+		t.Fatalf("wrong full memory: SIMD output=%x want=%x", mem[ownedSIMDTempOut:ownedSIMDTempOut+16], data)
+	}
+}
+
+func TestOwnedForestTemporarySIMDOrdinary(t *testing.T) {
+	for _, pressure := range []bool{false, true} {
+		name := "memory-if"
+		if pressure {
+			name = "live-v128-pressure"
+		}
+		t.Run(name, func(t *testing.T) {
+			m := ownedSIMDTempModule(t, pressure)
+			for _, intr := range []bool{false, true} {
+				var native, metaOracle []byte
+				for _, candidate := range []bool{false, true} {
+					work := &fixtureModuleWork{Forest: candidate, TemporaryV128SIMD: true}
+					var stats ModuleStats
+					cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+					if err != nil {
+						t.Fatal(err)
+					}
+					if cm.CodeImage != nil {
+						defer cm.CodeImage.Close()
+					}
+					if work.LegacyBodies != 1 || work.Opcodes == 0 || work.Rejected != 0 || candidate && work.Vector.stores == 0 || work.TemporaryV128Bodies != 1 {
+						t.Fatalf("SIMD legacy lane inactive: %+v", work)
+					}
+					if pressure && work.TemporaryV128Spills == 0 {
+						t.Fatalf("actual full-width spill not observed: %+v", work)
+					}
+					for _, zero := range []bool{false, true} {
+						ownedSIMDTempRun(t, cm, pressure, zero)
+					}
+					meta := *cm
+					meta.Code, meta.CodeImage = nil, nil
+					encoded, err := json.Marshal(meta)
+					if err != nil {
+						t.Fatal(err)
+					}
+					if !candidate {
+						native = append([]byte(nil), cm.Code...)
+						metaOracle = encoded
+					} else if !bytes.Equal(native, cm.Code) || !bytes.Equal(metaOracle, encoded) {
+						t.Fatal("native or encoder metadata differs")
+					}
+					t.Logf("intr=%v forest=%v bytes=%d peeps=%v work=%+v", intr, candidate, len(cm.Code), stats.Funcs[0].Peephole, work)
+				}
+			}
+		})
+	}
+}
