+//go:build linux && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"testing"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	encoder "github.com/wago-org/wago/src/core/encoder/amd64"
+	wr "github.com/wago-org/wago/src/core/runtime"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+)
+
+func ownedMemoryGrowModule(t *testing.T, snapshots int) *wasm.Module {
+	t.Helper()
+	// Params are delta, valid post-growth store address, and caller alias.
+	// The prefix captures an old local and the old byte at address 0.
+	b := []byte{0, 0x20, 2, 0x41, 0, 0x2d, 0, 0}
+	for range snapshots {
+		b = append(b, 0x3f, 0)
+	}
+	b = append(b, 0x20, 0, 0x40, 0)
+	// Sum the separately captured old values, grow's old-page result,
+	// then read the current size after the staged grow completes.
+	for range snapshots + 2 {
+		b = append(b, 0x6a)
+	}
+	b = append(b, 0x3f, 0, 0x6a, 0x41, 23, 0x21, 2, 0x20, 2, 0x6a)
+	// Store and reread a caller-selected, in-bounds address. For delta=1
+	// this uses the new page; for delta=0 it stays inside the initial page.
+	b = append(b, 0x20, 1, 0x41, 37, 0x36, 2, 0, 0x20, 1, 0x28, 2, 0, 0x6a, 0x0b)
+	i := wasm.I32
+	m, err := wasm.DecodeModule(wasmtest.Module(
+		wasmtest.Section(1, wasmtest.Vec(wasmtest.FuncType([]wasm.ValType{i, i, i}, []wasm.ValType{i}))),
+		wasmtest.Section(3, wasmtest.Vec(wasmtest.ULEB(0))),
+		wasmtest.Section(5, wasmtest.Vec([]byte{1, 1, 2})),
+		wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("f", 0, 0))),
+		wasmtest.Section(10, wasmtest.Vec(append(wasmtest.ULEB(uint32(len(b))), b...))),
+	))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = wasm.ValidateModule(m); err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+
+func ownedMemoryGrowRun(t *testing.T, cm *encoder.CompiledModule, delta, old uint32, snapshots int) {
+	t.Helper()
+	wantPages := 1 + delta
+	addr := uint32(8)
+	if delta == 1 {
+		addr = 65536
+	}
+	eng, err := wr.NewEngine()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer eng.Close()
+	jm, err := wr.NewJobMemoryGrowable(65536, 2*65536)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer jm.Close()
+	jm.CurrentBytes()[0] = 0x5a
+	jm.CurrentBytes()[65535] = 0xc7
+	ar, err := wr.NewArena(4096)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ar.Close()
+	image, entry, err := wr.MapCode(cm.Code)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer wr.Unmap(image)
+	a, out, tr := ar.Alloc(256), ar.Alloc(256), ar.Alloc(wr.TrapBufferBytes)
+	for i, v := range []uint32{delta, addr, old} {
+		binary.LittleEndian.PutUint64(a[i*8:], uint64(v))
+	}
+	err = eng.Call(entry+uintptr(cm.Entry[0]), a, jm.LinearMemory(), tr, out)
+	want := old + 0x5a + uint32(snapshots) + 1 + wantPages + 23 + 37
+	if got := binary.LittleEndian.Uint32(out); err != nil || got != want || jm.CurrentPages() != wantPages {
+		t.Fatalf("delta=%d got=%x want=%x pages=%d wantPages=%d err=%v", delta, got, want, jm.CurrentPages(), wantPages, err)
+	}
+	full := make([]byte, int(wantPages)*65536)
+	full[0], full[65535] = 0x5a, 0xc7
+	binary.LittleEndian.PutUint32(full[addr:addr+4], 37)
+	if !bytes.Equal(jm.CurrentBytes(), full) {
+		t.Fatal("wrong memory contents after grow and store")
+	}
+}
+
+func TestOwnedForestMemoryGrowOrdinary(t *testing.T) {
+	for _, pressure := range []bool{false, true} {
+		name, snapshots := "ordinary", 1
+		if pressure {
+			name, snapshots = "gp-pressure", 16
+		}
+		t.Run(name, func(t *testing.T) {
+			m := ownedMemoryGrowModule(t, snapshots)
+			for _, intr := range []bool{false, true} {
+				var native, metaOracle []byte
+				for _, candidate := range []bool{false, true} {
+					// Both arms select the same staged helper, never the default grow.
+					work := &fixtureModuleWork{Forest: candidate, PrivateMemory32Grow: true}
+					cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, fixtureWork: work})
+					if err != nil {
+						t.Fatal(err)
+					}
+					if cm.CodeImage != nil {
+						defer cm.CodeImage.Close()
+					}
+					if work.LegacyBodies != 1 || work.Opcodes == 0 || work.Rejected != 0 || candidate && work.Vector.stores == 0 ||
+						work.MemoryGrowEmissions != 1 || work.MemorySizeEmissions != uint64(snapshots+1) {
+						t.Fatalf("inactive staged grow path: %+v", work)
+					}
+					if pressure && work.MemoryGrowPrebranchSpills == 0 {
+						t.Fatalf("staged GP spill witness inactive: %+v", work)
+					}
+					for _, delta := range []uint32{0, 1} {
+						for _, old := range []uint32{19, 0xfffffff0} {
+							ownedMemoryGrowRun(t, cm, delta, old, snapshots)
+						}
+					}
+					meta := *cm
+					meta.Code, meta.CodeImage = nil, nil
+					encoded, err := json.Marshal(meta)
+					if err != nil {
+						t.Fatal(err)
+					}
+					if !candidate {
+						native = append([]byte(nil), cm.Code...)
+						metaOracle = encoded
+					} else if !bytes.Equal(native, cm.Code) || !bytes.Equal(metaOracle, encoded) {
+						t.Fatal("staged list/forest native or encoder metadata differs")
+					}
+					t.Logf("intr=%v forest=%v bytes=%d work=%+v", intr, candidate, len(cm.Code), work)
+				}
+			}
+		})
+	}
+}
