+// Every table label, including the default, must name an empty frame inside
+// the callee. Bit zero represents the synthetic return and is never eligible.
+func fixtureInlineEmptyBranchTable(r *wasm.Reader, depth int, emptyFrames uint64) bool {
+	n, err := r.U32()
+	if err != nil || uint64(n)+1 > uint64(r.BytesLeft()) {
+		return false
+	}
+	for i := uint32(0); i <= n; i++ {
+		label, err := r.U32()
+		if err != nil || uint64(label) >= uint64(depth-1) ||
+			emptyFrames&(uint64(1)<<(depth-1-int(label))) == 0 {
+			return false
+		}
+	}
+	return true
+}
