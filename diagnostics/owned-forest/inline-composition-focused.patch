+//go:build linux && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"encoding/json"
+	"testing"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+)
+
+func ownedInlineCompositionModule(t *testing.T, combined bool) *wasm.Module {
+	t.Helper()
+	i32 := wasm.I32
+	caller := []byte{0, 0x20, 0, 0x20, 1, 0x20, 2, 0x10, 1, 0x41, 23, 0x21, 0, 0x20, 0, 0x6a, 0x0b}
+	leaf := []byte{1, 1, 0x7f,
+		0x41, 32, 0x20, 0, 0x41, 8, 0xfc, 11, 0,
+		0x41, 1, 0x21, 2}
+	if combined {
+		leaf = append(leaf,
+			0x02, 0x40, 0x02, 0x40, 0x02, 0x40,
+			0x20, 1, 0x0e, 2, 0, 1, 2,
+			0x0b, 0x20, 2, 0x41, 2, 0x6a, 0x21, 2,
+			0x0b, 0x20, 2, 0x41, 4, 0x6a, 0x21, 2,
+			0x0b)
+	} else {
+		leaf = append(leaf, 0x02, 0x40, 0x20, 1, 0x0d, 0, 0x41, 3, 0x21, 2, 0x0b)
+	}
+	leaf = append(leaf, 0x41, 40, 0x20, 2, 0x3a, 0, 0, 0x0b)
+	m, err := wasm.DecodeModule(wasmtest.Module(
+		wasmtest.Section(1, wasmtest.Vec(wasmtest.FuncType([]wasm.ValType{i32, i32, i32}, []wasm.ValType{i32}), wasmtest.FuncType([]wasm.ValType{i32, i32}, nil))),
+		wasmtest.Section(3, wasmtest.Vec(wasmtest.ULEB(0), wasmtest.ULEB(1))),
+		wasmtest.Section(5, wasmtest.Vec([]byte{0, 1})),
+		wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("f", 0, 0))),
+		wasmtest.Section(10, wasmtest.Vec(append(wasmtest.ULEB(uint32(len(caller))), caller...), append(wasmtest.ULEB(uint32(len(leaf))), leaf...))),
+	))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = wasm.ValidateModule(m); err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+
+func TestOwnedForestInlineCompositionOrdinary(t *testing.T) {
+	for _, name := range []string{"fill", "fill-table"} {
+		t.Run(name, func(t *testing.T) {
+			combined := name == "fill-table"
+			m := ownedInlineCompositionModule(t, combined)
+			rows := []struct {
+				args   [4]int
+				marker byte
+			}{
+				{[4]int{7, 0x123, 0, 0}, 7},
+				{[4]int{11, 0x2fa, 1, 0}, 5},
+				{[4]int{13, 0x374, 2, 0}, 1},
+				{[4]int{19, 0x4ff, 0xffffffff, 0}, 1},
+			}
+			for _, intr := range []bool{false, true} {
+				var native, metaOracle []byte
+				for _, candidate := range []bool{false, true} {
+					work := &fixtureModuleWork{Forest: candidate, IntegerControlInline: true, IntegerControlInlineComposition: true}
+					var stats ModuleStats
+					cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+					if err != nil {
+						t.Fatal(err)
+					}
+					if cm.CodeImage != nil {
+						defer cm.CodeImage.Close()
+					}
+					if work.LegacyBodies == 0 || work.Opcodes == 0 || work.Rejected != 0 || candidate && work.Vector.stores == 0 || work.IntegerControlInlineLeaves != 1 || work.IntegerControlInlineRecursive != 0 {
+						t.Fatalf("inactive composition: %+v", work)
+					}
+					st := stats.Funcs[0]
+					// Source has exactly one FC11 and internal br_table, and no separate
+					// call lowering is accepted. Two explicit indices use the chain path.
+					if st.Calls["inline"] != 1 || st.Calls["regabi"] != 0 || st.Calls["wrapper"] != 0 || st.Calls["mixed"] != 0 ||
+						st.Peephole["memfill-unroll"] != 1 || st.Peephole["br-table-jump"] != 0 || st.Peephole["br-table-compact"] != 0 {
+						t.Fatalf("wrong composition strategy: calls=%v peeps=%v", st.Calls, st.Peephole)
+					}
+					for _, row := range rows {
+						want := make([]byte, 65536)
+						for i := range want {
+							want[i] = byte(i*29 + 13)
+						}
+						for i := 32; i < 40; i++ {
+							want[i] = byte(row.args[1])
+						}
+						want[40] = 1
+						if combined {
+							want[40] = row.marker
+						} else if row.args[2] == 0 {
+							want[40] = 3
+						}
+						ownedBulkRun(t, cm, row.args, want)
+					}
+					meta := *cm
+					meta.Code, meta.CodeImage = nil, nil
+					encoded, err := json.Marshal(meta)
+					if err != nil {
+						t.Fatal(err)
+					}
+					if !candidate {
+						native = append([]byte(nil), cm.Code...)
+						metaOracle = encoded
+					} else if !bytes.Equal(native, cm.Code) || !bytes.Equal(metaOracle, encoded) {
+						t.Fatal("native or encoder metadata differs")
+					}
+					t.Logf("intr=%v forest=%v bytes=%d calls=%v peeps=%v work=%+v", intr, candidate, len(cm.Code), st.Calls, st.Peephole, work)
+				}
+			}
+		})
+	}
+}
