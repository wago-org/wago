+func layoutRepublishDirect(types []machineType, reuse bool) (*fn, *fixtureModuleWork, []*elem, int) {
+	w := &fixtureModuleWork{Forest: true, ReuseClosedElseRoots: reuse}
+	sc := newCompileScratch(32)
+	sc.fixtureWork = w
+	sc.ensureTargetStack()
+	f := &fn{s: sc.stack, sc: sc, globalCellReg: regNone, moduleGlobalRegionalLease: regNone}
+	var roots []*elem
+	slot := 0
+	for _, typ := range types {
+		e := f.pushValue(storage{kind: stSlot, typ: typ, slot: uint32(slot)})
+		// Inert union bits left over in an otherwise canonical scalar/vector
+		// slot. The fresh rebuild zeros them, so retention must too.
+		e.st.cval, e.st.idx, e.st.reg = 123, 77, R12
+		roots = append(roots, e)
+		slot += typ.stackSlots()
+	}
+	f.s.canonicalSlots = true
+	f.maxSpill = slot + 9
+	return f, w, roots, len(*f.s.activeChunk)
+}
