+func TestOwnedForestElseRepublishDirectOrdinary(t *testing.T) {
+	initial := []machineType{mtI32, mtV128, mtI64, mtV128}
+	expected := initial[:3]
+	// There is no optional merge scratch in these isolated fixtures (mergeIndex=0).
+	// Real opElse has already touched any allocated merge row before this helper.
+	fr := ctrlFrame{kind: cfIf, height: 3, resultN: 1}
+	t.Run("retag-retire-and-fresh-metadata", func(t *testing.T) {
+		old, oldW, oldRoots, oldN := layoutRepublishDirect(initial, false)
+		got, w, prior, before := layoutRepublishDirect(initial, true)
+		old.setDepthTypesWithGCRoots(expected, nil)
+		if !got.tryFixtureClosedElseRepublish(&fr, expected, nil, true) {
+			t.Fatalf("eligible direct path did not reuse: %+v", w.ElseRepublish)
+		}
+		for i := range expected {
+			if w.Vector.roots[i] != prior[i] || oldW.Vector.roots[i] == oldRoots[i] || *w.Vector.roots[i] != *oldW.Vector.roots[i] {
+				t.Fatalf("root%d identity or fully reset storage differs", i)
+			}
+		}
+		if prior[3].forestLive || prior[3].st.hasLogicalRoot() || w.Vector.roots[:cap(w.Vector.roots)][3] != nil || got.s.spillExtent != old.s.spillExtent || got.s.spillExtentValid != old.s.spillExtentValid || got.depth() != old.depth() || got.maxSpill != old.maxSpill || got.s.canonicalSlots != old.s.canonicalSlots || got.s.hasGCRoots != old.s.hasGCRoots || got.s.pendingPrefix != old.s.pendingPrefix || got.s.spilledPrefix != old.s.spilledPrefix || got.s.pendingEffects != old.s.pendingEffects || got.regUser != old.regUser || got.fregUser != old.fregUser || got.pinned != old.pinned || got.fpinned != old.fpinned {
+			t.Fatal("canonical depth/liveness/spills/reset facts differ")
+		}
+		if len(*got.s.activeChunk) != before || len(*old.s.activeChunk)-oldN != 3 || oldW.Vector.stores-w.Vector.stores != 6 {
+			t.Fatal("actual arena requests/root pointer store delta differs")
+		}
+		layoutEmit(t, "ELSE_DIRECT", map[string]any{"case": "retag-retire-and-fresh-metadata", "work": w.ElseRepublish, "oldNodeDelta": len(*old.s.activeChunk) - oldN, "newNodeDelta": len(*got.s.activeChunk) - before, "oldRootStores": oldW.Vector.stores, "newRootStores": w.Vector.stores})
+	})
+	t.Run("mismatch-is-read-only-then-old-rebuild", func(t *testing.T) {
+		got, w, roots, n := layoutRepublishDirect(initial, true)
+		want := []machineType{mtI32, mtV128, mtF64} // reports a same-width mismatch late in prefix verification
+		elems := make([]elem, len(roots))
+		for i, x := range roots {
+			elems[i] = *x
+		}
+		priorStack := *got.s
+		priorForest := w.Vector
+		if got.tryFixtureClosedElseRepublish(&fr, want, nil, true) || w.ElseRepublish.CheckedFallbacks != 1 || w.ElseRepublish.TypeChecks != 3 || w.ElseRepublish.RetaggedRoots != 0 || w.ElseRepublish.RetiredTail != 0 || w.ElseRepublish.RootPointerScrubs != 0 || w.ElseRepublish.AvoidedAllocRequests != 0 {
+			t.Fatalf("mismatch did not cleanly return to old path: %+v", w.ElseRepublish)
+		}
+		if !reflect.DeepEqual(*got.s, priorStack) || !reflect.DeepEqual(w.Vector, priorForest) || len(*got.s.activeChunk) != n {
+			t.Fatal("mismatch mutated stack before fallback")
+		}
+		for i, x := range roots {
+			if w.Vector.roots[i] != x || *x != elems[i] {
+				t.Fatalf("mismatch mutated root%d", i)
+			}
+		}
+		got.setDepthTypesWithGCRoots(want, nil)
+		if len(*got.s.activeChunk)-n != len(want) || !canonicalSlotLayout(w.Vector.roots) || w.Vector.roots[2].st.typ != mtF64 || w.Vector.roots[2] == roots[2] {
+			t.Fatal("old fallback did not rebuild fixture target image")
+		}
+		layoutEmit(t, "ELSE_DIRECT", map[string]any{"case": "mismatch-is-read-only-then-old-rebuild", "work": w.ElseRepublish, "oldNodeDelta": len(*got.s.activeChunk) - n})
+	})
+}
