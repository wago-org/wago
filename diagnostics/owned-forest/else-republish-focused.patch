+// Only these valid ordinary recipes are executed. Taken and not-taken
+// outcomes use separate pages and check observable branch-specific stores.
+func layoutRepublishModule(t *testing.T, vector bool) *wasm.Module {
+	t.Helper()
+	b := []byte{0, 0x20, 0} // retained scalar input
+	pc := func(i int) { b = append(b, 0x41); b = append(b, wasmtest.SLEB32(int32(i))...) }
+	vload := func(i int) { pc(i); b = append(b, 0xfd, 0, 4, 0) }
+	vstore := func() { b = append(b, 0xfd, 11, 4, 0) }
+	if vector {
+		pc(512)
+		vload(0)
+		pc(544) // main prefix: scalar, addr, vector, addr
+	} else {
+		pc(9)
+		pc(11) // independent scalar neighbors
+	}
+	b = append(b, 0x20, 1, 0x04)
+	if vector {
+		b = append(b, 0x7b)
+	} else {
+		b = append(b, 0x40)
+	}
+	for _, Cond := range []bool{true, false} {
+		if !Cond {
+			b = append(b, 0x05)
+		}
+		pc(128)
+		if Cond {
+			pc(17)
+		} else {
+			pc(29)
+		}
+		b = append(b, 0x36, 2, 0)
+		if vector {
+			if Cond {
+				vload(16)
+			} else {
+				vload(32)
+			}
+		}
+	}
+	b = append(b, 0x0b)
+	if vector {
+		vstore()
+		vstore()
+		pc(544)
+		b = append(b, 0x28, 2, 0, 0x73)
+	} else {
+		b = append(b, 0x6a, 0x6a)
+	}
+	pc(128)
+	b = append(b, 0x28, 2, 0, 0x73, 0x0b)
+	m := layoutProbeModMem(t, 1, []wasm.ValType{wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, b)
+	if e := wasm.ValidateModule(m); e != nil {
+		t.Fatal(e)
+	}
+	return m
+}
+
+func layoutRepublishRun(t *testing.T, cm *encoder.CompiledModule, vector bool, cond uint32, seed int) {
+	t.Helper()
+	eng, e := wr.NewEngine()
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer eng.Close()
+	j, e := wr.NewJobMemory(65536)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer j.Close()
+	a, e := wr.NewArena(4096)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer a.Close()
+	mapped, entry, e := wr.MapCode(cm.Code)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer wr.Unmap(mapped)
+	mem := j.CurrentBytes()
+	for i := range mem {
+		mem[i] = byte(i*17 + i/16*29 + seed)
+	}
+	want := append([]byte(nil), mem...)
+	var mark uint32 = 29
+	pick := 32
+	if cond != 0 {
+		mark, pick = 17, 16
+	}
+	binary.LittleEndian.PutUint32(want[128:], mark)
+	old := uint32(0xdeadbe00 + seed)
+	expect := (old + 20) ^ mark
+	if vector {
+		copy(want[512:], mem[:16])
+		copy(want[544:], mem[pick:pick+16])
+		expect = old ^ binary.LittleEndian.Uint32(want[544:]) ^ mark
+	}
+	in, out, tr := a.Alloc(256), a.Alloc(256), a.Alloc(wr.TrapBufferBytes)
+	binary.LittleEndian.PutUint64(in, uint64(old))
+	binary.LittleEndian.PutUint64(in[8:], uint64(cond))
+	e = eng.Call(entry+uintptr(cm.Entry[0]), in, j.LinearMemory(), tr, out)
+	if got := binary.LittleEndian.Uint32(out); e != nil || got != expect {
+		t.Fatalf("vector=%t cond=%d result=%x expected=%x err=%v", vector, cond, got, expect, e)
+	}
+	if !bytes.Equal(mem, want) {
+		for i := range mem {
+			if mem[i] != want[i] {
+				t.Fatalf("vector=%t cond=%d memory[%d]=%x want=%x", vector, cond, i, mem[i], want[i])
+			}
+		}
+	}
+}
