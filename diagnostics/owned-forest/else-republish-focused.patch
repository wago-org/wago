+// Only opElse owns this transition: the then-side image has been flushed
+// and its jump emitted, while the alternate image is an owned type snapshot.
+// No popped operand or arena chunk is recycled, and failed checks leave the
+// original rebuild entirely untouched.
+func (f *fn) tryFixtureClosedElseRepublish(fr *ctrlFrame, types []machineType, gcRoots []bool, thenReachable bool) bool {
+	if f.s.forest == nil || f.sc == nil || f.sc.fixtureWork == nil || !f.sc.fixtureWork.ReuseClosedElseRoots {
+		return false
+	}
+	w := &f.sc.fixtureWork.ElseRepublish
+	w.Attempts++
+	s, v := f.s, f.s.forest
+	if !thenReachable || fr.kind != cfIf || fr.has(ctrlRegMerge1) || fr.has(ctrlIfDeferredPrefix) ||
+		fr.has(ctrlInlineFallthrough) || fr.paramN != 0 || fr.resultN > 1 || len(types) == 0 ||
+		len(types) != fr.height || len(v.roots) != fr.height+fr.resultN || f.depth() != len(v.roots) ||
+		!s.canonicalSlots || s.hasGCRoots || f.moduleEH || f.gcFrameRoots != nil || len(f.customInstructions) != 0 ||
+		f.gcResolved.valid || f.storeFwd.valid || f.globalCellReg != regNone || f.inlineDepth != 0 || f.inlineForwardN != 0 ||
+		f.inlineTailConstants != nil || f.intervalActive != 0 || f.memSizeRegionalLease ||
+		f.moduleGlobalRegionalLease != regNone || f.pinned != 0 || f.fpinned != 0 ||
+		s.pendingPrefix != nil || s.spilledPrefix != nil || s.pendingEffects&(pendingLoad|pendingTrap) != 0 ||
+		profileEnabled || regallocCheckEnabled || ownedForestCensusEnabled {
+		w.InitialRejects++
+		return false
+	}
+	if merge := f.ctrlMerge(fr); merge != nil && merge.baseTypeTop != nil {
+		w.InitialRejects++
+		return false
+	}
+	for _, lease := range f.vectorRegion.locals {
+		w.LeaseChecks++
+		if lease != 0 {
+			w.CheckedFallbacks++
+			return false
+		}
+	}
+	for i, owner := range f.regUser {
+		w.RegisterChecks++
+		if owner != nil || f.fregUser[i] != nil {
+			w.CheckedFallbacks++
+			return false
+		}
+	}
+	slot, prefixEnd := 0, 0
+	for i, e := range v.roots {
+		w.RootChecks++
+		if e == nil || !e.forestLive || e.hasPhysicalLinks() || e.forestPending || !e.isValue() ||
+			!e.st.hasLogicalRoot() || e.arg0 != nil || e.arg1 != nil || e.st.cold != 0 ||
+			e.st.kind != stSlot || e.st.slotIndex() != slot || e.st.hasGCRoot() || e.st.hasEHRoot() ||
+			e.st.typ == mtCustom || e.st.typ == mtNone {
+			w.CheckedFallbacks++
+			return false
+		}
+		if i < len(types) {
+			w.TypeChecks++
+			if e.st.typ != types[i] || (i < len(gcRoots) && gcRoots[i]) {
+				w.CheckedFallbacks++
+				return false
+			}
+		}
+		slot += e.st.typ.stackSlots()
+		if i < len(types) {
+			prefixEnd = slot
+		}
+	}
+
+	for i := len(types); i < len(v.roots); i++ {
+		s.forestRetire(v.roots[i])
+		v.roots[i] = nil
+		v.stores++
+		w.RetiredTail++
+		w.RootPointerScrubs++
+	}
+	v.roots = v.roots[:len(types)]
+	slot = 0
+	for i, typ := range types {
+		st := storage{kind: stSlot, typ: typ, slot: uint32(slot)}
+		st.setLogicalRoot(true)
+		*v.roots[i] = elem{forestLive: true, st: st}
+		slot += typ.stackSlots()
+		w.RetaggedRoots++
+	}
+	s.pendingPrefix, s.spilledPrefix = nil, nil
+	s.spillExtent, s.spillExtentValid = uint32(prefixEnd), true
+	s.logicalDepth = uint32(len(types))
+	s.canonicalSlots, s.hasGCRoots = true, false
+	f.maxSpill = max(f.maxSpill, prefixEnd)
+	w.ReusedSites++
+	w.AvoidedAllocRequests += uint64(len(types))
+	w.AvoidedRootStores += uint64(len(types)) * 2
+	return true
+}
