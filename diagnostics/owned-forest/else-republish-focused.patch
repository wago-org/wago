+func TestOwnedForestElseRepublishOrdinary(t *testing.T) {
+	for _, vector := range []bool{false, true} {
+		t.Run(fmt.Sprintf("vector=%t", vector), func(t *testing.T) {
+			m := layoutRepublishModule(t, vector)
+			wantPrefix, wantTail := uint64(3), uint64(0)
+			if vector {
+				wantPrefix, wantTail = 4, 1
+			}
+			for _, intr := range []bool{false, true} {
+				var code, metadata []byte
+				var stores uint64
+				for _, reuse := range []bool{false, true} {
+					w := &fixtureModuleWork{Forest: true, RecordOperandLayout: true, ReuseClosedElseRoots: reuse, TemporaryV128SIMD: vector, TemporaryV128BlockResults: vector}
+					cm, e := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, fixtureWork: w})
+					if e != nil {
+						t.Fatal(e)
+					}
+					if cm.CodeImage != nil {
+						defer cm.CodeImage.Close()
+					}
+					p := w.ElseRepublish
+					if w.LegacyBodies != 1 || w.Rejected != 0 || w.Opcodes == 0 || len(w.OperandCapacities) != 1 || vector && (w.TemporaryV128Bodies != 1 || w.TemporaryV128BlockSlotMerges != 1) {
+						t.Fatalf("inactive ordinary source path: %+v", w)
+					}
+					if !reuse && p != (fixtureElseRepublishWork{}) {
+						t.Fatalf("unexpected disabled receipt: %+v", p)
+					}
+					if reuse && (p.Attempts != 1 || p.ReusedSites != 1 || p.InitialRejects != 0 || p.CheckedFallbacks != 0 || p.RetaggedRoots != wantPrefix || p.RetiredTail != wantTail || p.RootPointerScrubs != wantTail || p.AvoidedAllocRequests != wantPrefix || p.AvoidedRootStores != 2*wantPrefix || p.RootChecks != wantPrefix+wantTail || p.TypeChecks != wantPrefix || p.RegisterChecks == 0 || p.LeaseChecks == 0) {
+						t.Fatalf("actual checked republish and shape not reached: %+v", p)
+					}
+					z := *cm
+					z.Code, z.CodeImage = nil, nil
+					j, e := json.Marshal(z)
+					if e != nil {
+						t.Fatal(e)
+					}
+					if !reuse {
+						code, metadata, stores = append([]byte(nil), cm.Code...), j, w.Vector.stores
+					} else if !bytes.Equal(code, cm.Code) || !bytes.Equal(metadata, j) || w.Vector.stores > stores || stores-w.Vector.stores != p.AvoidedRootStores {
+						t.Fatalf("native, encoder or actual root-store delta differs: old=%d new=%d receipt=%+v", stores, w.Vector.stores, p)
+					}
+					for _, cond := range []uint32{0, 1} {
+						for _, seed := range []int{3, 29} {
+							layoutRepublishRun(t, cm, vector, cond, seed)
+						}
+					}
+					layoutEmit(t, "ELSE_ORDINARY", map[string]any{"vector": vector, "intr": intr, "reuse": reuse, "calls": 4, "native": fmt.Sprintf("%x", sha256.Sum256(cm.Code)), "encoder": fmt.Sprintf("%x", sha256.Sum256(j)), "rootStores": w.Vector.stores, "retires": w.Vector.retirements, "capacity": w.OperandCapacities[0], "work": p})
+				}
+			}
+		})
+	}
+}
