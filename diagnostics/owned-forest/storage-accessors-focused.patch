+func TestOwnedForestTypedStorageAccessorsOrdinary(t *testing.T) {
+	t.Run("variants-and-copy", func(t *testing.T) {
+		// Golden keyed literals deliberately use the unchanged physical layout;
+		// deriving the oracle through the accessor under test would be circular.
+		rows := []storage{
+			{kind: stInvalid},
+			{kind: stConst, typ: mtI64, cval: -0x7ffffffffffffffb},
+			{kind: stFuncRef, typ: mtI64, idx: 0xfffffff0},
+			{kind: stReg, typ: mtI32, reg: RAX, cval: 0x7fffffff, meta: uint8(storageCapturedBounds | factUpper32Zero)},
+			{kind: stSlot, typ: mtI32, slot: 0xabcdef01, idx: 0x87654321, cval: -0x112233445566778, meta: uint8(storageCapturedBounds | factUpper32Zero)},
+			{kind: stLocalRef, typ: mtI64, idx: 0xfedcba98, slot: 0x76543210},
+			{kind: stLocalReg, typ: mtI32, reg: RCX, idx: 17, slot: 0xfffffff1},
+			{kind: stGlobalRef, typ: mtI64, idx: 0xffffffff},
+			{kind: stGlobReg, typ: mtI64, reg: RDX, idx: 23},
+			{kind: stMemRef, typ: mtI64, reg: RAX, slot: 0x80000000, idx: 0x102, cval: 0x100000000},
+		}
+		for _, want := range rows {
+			got := want
+			got.setMachineType(mtI32)
+			got.setConstantBits(7)
+			got.setIndexBits(8)
+			if got.machineType() != mtI32 || got.constantBits() != 7 || got.indexBits() != 8 || got.kind != want.kind || got.reg != want.reg || got.slot != want.slot || got.meta != want.meta {
+				t.Fatalf("independent setter changed another raw field: %+v from %+v", got, want)
+			}
+			got.setMachineType(want.typ)
+			got.setConstantBits(want.cval)
+			got.setIndexBits(want.idx)
+			if got != want {
+				t.Fatalf("accessors did not restore raw variant: %+v want %+v", got, want)
+			}
+			donor := elem{st: want}
+			donor.setForestLive(true)
+			donor.setForestPending(true)
+			var fresh elem
+			fresh.setFreshStorage(donor.st)
+			if fresh.forestIsLive() || fresh.forestIsPending() || fresh.st != want {
+				t.Fatalf("fresh copy changed payload or copied owner state: %+v from %+v", fresh.st, want)
+			}
+			fresh.setForestLive(true)
+			fresh.setForestPending(true)
+			fresh.setStoragePreservingOwnership(want)
+			if !fresh.forestIsLive() || !fresh.forestIsPending() {
+				t.Fatal("destination pending owner did not survive replacement")
+			}
+			fresh.setForestPending(false)
+			fresh.setForestLive(false)
+			if fresh.st != want || !donor.forestIsLive() || !donor.forestIsPending() {
+				t.Fatal("preserving replacement changed payload or donor state")
+			}
+		}
+		layoutEmit(t, "STORAGE_ACCESSORS", map[string]any{"case": "variants-and-copy", "variants": len(rows), "compact": compactOperandNodes})
+	})
