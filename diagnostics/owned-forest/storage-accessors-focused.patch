+			if st.memDisp() != row.disp || st.memSize() != row.size || st.memSigned() != row.signed || st.memBorrow() != row.borrow || st.slot != row.slot || st.cval != row.encoded {
+				t.Fatalf("deferred memory payload mismatch: %+v -> %+v", row, st)
+			}
+			old := st
+			st.clearMemBorrow()
+			old.cval = 0
+			if st != old || st.memBorrow() != -1 {
+				t.Fatalf("clearing borrow changed unrelated memory payload: %+v want %+v", st, old)
+			}
+		}
+		fp := fmemRefStorage(RCX, -123, true, 7)
+		if fp.machineType() != mtF64 || fp.memDisp() != -123 || fp.memSize() != 8 || fp.memSigned() || fp.memBorrow() != 7 {
+			t.Fatalf("float memory reference payload=%+v", fp)
