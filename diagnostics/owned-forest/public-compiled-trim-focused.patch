+// NewOwnedForestPublicTrimFixture observes the real serial compile boundary
+// after the first function finalizes. It does not call GC or alter codegen.
+func NewOwnedForestPublicTrimFixture() *OwnedForestPublicFixture {
+	return &OwnedForestPublicFixture{
+		work:        fixtureModuleWork{Forest: true, RecordOperandLayout: true},
+		observeTrim: true,
+	}
+}
+
 func (f *OwnedForestPublicFixture) Configure(opts *CompileOptions) error {
 	if codegen.SourceChecks || opts.Workers != 1 || opts.Profile || opts.Stats != nil ||
 		opts.CollectInlineReport || len(opts.CustomInstructions) != 0 {
 		return fmt.Errorf("owned forest public fixture requires ordinary serial compilation")
 	}
+	if f.observeTrim {
+		if opts.MemoryPressure != nil || opts.MemoryPressureAt != 0 {
+			return fmt.Errorf("owned forest trim fixture cannot replace a memory pressure callback")
+		}
+		f.trim = OwnedForestPublicTrimObservation{}
+		opts.MemoryPressureAt = 1
+		opts.MemoryPressure = f.observeFinalizedTrim
+	}
 	opts.fixtureWork = &f.work
 	return nil
 }
@@ -40,3 +59,69 @@ func (f *OwnedForestPublicFixture) Configure(opts *CompileOptions) error {
 func (f *OwnedForestPublicFixture) DynamicImportSites() uint64 {
 	return f.work.DynamicIntegerHostImportSites
 }
+
+// OwnedForestPublicTrimObservation is a scalar snapshot taken in the existing
+// serial memory-pressure callback, before the next function is compiled.
+type OwnedForestPublicTrimObservation struct {
+	Callbacks, LegacyBodies                                           uint64
+	Attempts, Completed, Rejected                                     int
+	CapacityRows, Function, NodesAtSample                             int
+	ArenaMappedBytes, ArenaAppendedBytes                              int
+	NodeBytes                                                         uintptr
+	PretrimUsedBytes, PretrimReservedBytes, PosttrimRetainedNodeBytes uint64
+	RootLen, RootCap, NonNilRootPointers                              int
+	Sites, LiveRootsAtScrub, RootPointerScrubs, ControlHolderRejects  uint64
+}
+
+func (f *OwnedForestPublicFixture) observeFinalizedTrim() {
+	w := &f.work
+	row := OwnedForestPublicTrimObservation{
+		Callbacks: f.trim.Callbacks + 1, LegacyBodies: w.LegacyBodies,
+		Attempts: w.Attempts, Completed: w.Completed, Rejected: w.Rejected,
+		CapacityRows: len(w.OperandCapacities), Function: -1,
+		NodeBytes:                 w.OperandLayout.NodeBytes,
+		PosttrimRetainedNodeBytes: w.FinalizedTrim.LastRetainedNodeBytes,
+		RootLen:                   len(w.Vector.roots), RootCap: cap(w.Vector.roots),
+		Sites: w.FinalizedTrim.Sites, LiveRootsAtScrub: w.FinalizedTrim.LiveRootsAtScrub,
+		RootPointerScrubs:    w.FinalizedTrim.RootPointerScrubs,
+		ControlHolderRejects: w.FinalizedTrim.ControlHolderRejects,
+	}
+	if n := len(w.OperandCapacities); n != 0 {
+		pre := w.OperandCapacities[n-1]
+		row.Function, row.NodesAtSample = pre.Function, pre.NodesAtSample
+		row.PretrimUsedBytes, row.PretrimReservedBytes = pre.NodeUsedBytes, pre.NodeReservedBytes
+		row.ArenaMappedBytes, row.ArenaAppendedBytes = pre.ArenaMappedBytes, pre.ArenaAppendedBytes
+	}
+	for _, root := range w.Vector.roots[:cap(w.Vector.roots)] {
+		if root != nil {
+			row.NonNilRootPointers++
+		}
+	}
+	f.trim = row
+}
+
+func (f *OwnedForestPublicFixture) TrimObservation() OwnedForestPublicTrimObservation {
+	return f.trim
+}
+
+// OwnedForestPublicTrimCompletion contains scalar counters at module return,
+// separate from the first-function callback.
+type OwnedForestPublicTrimCompletion struct {
+	Sites, LegacyBodies           uint64
+	Attempts, Completed, Rejected int
+	CapacityRows, LastFunction    int
+	LastReservedBytes             uint64
+}
+
+func (f *OwnedForestPublicFixture) TrimCompletion() OwnedForestPublicTrimCompletion {
+	w := &f.work
+	row := OwnedForestPublicTrimCompletion{
+		Attempts: w.Attempts, Completed: w.Completed, Rejected: w.Rejected, Sites: w.FinalizedTrim.Sites, LegacyBodies: w.LegacyBodies,
+		CapacityRows: len(w.OperandCapacities), LastFunction: -1,
+	}
+	if n := len(w.OperandCapacities); n != 0 {
+		row.LastFunction = w.OperandCapacities[n-1].Function
+		row.LastReservedBytes = w.OperandCapacities[n-1].NodeReservedBytes
+	}
+	return row
+}
