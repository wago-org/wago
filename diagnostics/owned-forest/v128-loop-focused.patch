--- /dev/null
+++ b/src/core/compiler/backend/railshot/amd64/owned_forest_v128_loop_independent_test.go
@@ -0,0 +1,195 @@
+//go:build linux && amd64 && wago_owned_forest_fixture && wago_codegenstats
+
+package amd64
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"testing"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	encoder "github.com/wago-org/wago/src/core/encoder/amd64"
+	wr "github.com/wago-org/wago/src/core/runtime"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+)
+
+func ownedV128LoopModule(t *testing.T, scalarResult bool) *wasm.Module {
+	t.Helper()
+	// Param0 is an old scalar prefix, param1 a finite count (1..3).
+	b := []byte{1, 16, 0x7b, 0x20, 0}
+	pc := func(i int) { b = append(b, 0x41); b = append(b, wasmtest.SLEB32(int32(i))...) }
+	ld := func(i int) { pc(i); b = append(b, 0xfd, 0, 4, 0) }
+	st := func() { b = append(b, 0xfd, 11, 4, 0) }
+	// Keep all 16 distinct bytes beneath the loop control boundary.
+	pc(512)
+	ld(112)
+	bt := byte(0x40)
+	if scalarResult {
+		bt = 0x7f
+	}
+	b = append(b, 0x03, bt) // one direct valbyte, zero parameters
+	// Score these fixed-home locals at the same natural loop depth as
+	// the regional targets. No optimization settings are changed.
+	for i := byte(2); i < 10; i++ {
+		for range 3 {
+			b = append(b, 0x20, i, 0x22, i, 0x21, i)
+		}
+	}
+	pc(448)
+	b = append(b, 0x20, 1, 0x6a, 0x20, 1, 0x3a, 0, 0)
+	for i := range 5 {
+		// Static in-bounds source loads preserve prior live read leases;
+		// the separately observed loop marker proves dynamic iterations.
+		pc(256 + i*16)
+		ld(16 * i)
+		// The admitted tee keeps its borrowed value as an actual operand.
+		// This ordinary get feeds unchanged lookahead; drop consumes only it.
+		b = append(b, 0x22, byte(10+i), 0x20, byte(10+i), 0x1a)
+	}
+	// br_if drains the regional leases with five aliases still live.
+	// Taken backedges discard these iteration temporaries. Fallthrough
+	// overwrites one local while retaining its old alias, then stores them.
+	b = append(b, 0x20, 1, 0x41, 1, 0x6b, 0x22, 1, 0x0d, 0)
+	ld(96)
+	b = append(b, 0x21, 10)
+	for range 5 {
+		st()
+	}
+	pc(352)
+	b = append(b, 0x20, 10)
+	st()
+	pc(368)
+	b = append(b, 0x20, 17)
+	st()
+	if scalarResult {
+		pc(11)
+	}
+	b = append(b, 0x0b)
+	if scalarResult {
+		b = append(b, 0x21, 1)
+	}
+	st() // original distinct-half V128 prefix, retained through all iterations
+	ld(512)
+	b = append(b, 0xfd, 27, 0, 0x73)
+	if scalarResult {
+		b = append(b, 0x20, 1, 0x73)
+	}
+	b = append(b, 0x0b)
+	m := modMem(t, 1, []wasm.ValType{wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, b)
+	if err := wasm.ValidateModule(m); err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+
+func ownedV128LoopRun(t *testing.T, cm *encoder.CompiledModule, condition uint32, salt int, scalarResult bool) {
+	t.Helper()
+	eng, err := wr.NewEngine()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer eng.Close()
+	jm, err := wr.NewJobMemory(65536)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer jm.Close()
+	a, err := wr.NewArena(4096)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer a.Close()
+	mapped, entry, err := wr.MapCode(cm.Code)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer wr.Unmap(mapped)
+	mem := jm.CurrentBytes()
+	for i := range mem {
+		mem[i] = byte(i*31 + salt*7)
+	}
+	want := append([]byte(nil), mem...)
+	for i := range 5 {
+		copy(want[256+i*16:], mem[16*i:16*(i+1)])
+	}
+	copy(want[352:], mem[96:112])
+	clear(want[368:384])
+	for i := uint32(1); i <= condition; i++ {
+		want[448+i] = byte(i)
+	}
+	copy(want[512:], mem[112:128])
+	expectedLane := binary.LittleEndian.Uint32(mem[112:116])
+	if scalarResult {
+		expectedLane ^= 11
+	}
+	in, out, tr := a.Alloc(256), a.Alloc(256), a.Alloc(wr.TrapBufferBytes)
+	old := uint32(0x1234beef + salt)
+	binary.LittleEndian.PutUint64(in, uint64(old))
+	binary.LittleEndian.PutUint64(in[8:], uint64(condition))
+	err = eng.Call(entry+uintptr(cm.Entry[0]), in, jm.LinearMemory(), tr, out)
+	if got := binary.LittleEndian.Uint32(out); err != nil || got != old^expectedLane {
+		t.Fatalf("cond=%d got=%x want=%x err=%v", condition, got, old^expectedLane, err)
+	}
+	if !bytes.Equal(mem, want) {
+		for i := range mem {
+			if mem[i] != want[i] {
+				t.Fatalf("condition=%d byte[%d]=%x want=%x", condition, i, mem[i], want[i])
+			}
+		}
+	}
+}
+
+func TestOwnedForestV128LoopOrdinary(t *testing.T) {
+	for _, name := range []string{"empty", "scalar-result"} {
+		t.Run(name, func(t *testing.T) {
+			scalarResult := name == "scalar-result"
+			m := ownedV128LoopModule(t, scalarResult)
+			for _, intr := range []bool{false, true} {
+				var native, metaOracle []byte
+				for _, candidate := range []bool{false, true} {
+					work := &fixtureModuleWork{Forest: candidate, TemporaryV128SIMD: true, TemporaryV128Locals: true, TemporaryV128RegionalLocals: true, TemporaryV128Loops: true}
+					var stats ModuleStats
+					cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, Stats: &stats, fixtureWork: work})
+					if err != nil {
+						t.Fatal(err)
+					}
+					if cm.CodeImage != nil {
+						defer cm.CodeImage.Close()
+					}
+					if work.LegacyBodies != 1 || work.Rejected != 0 || work.Opcodes == 0 || candidate && work.Vector.stores == 0 || work.TemporaryV128Bodies != 1 {
+						t.Fatalf("inactive lane: %+v", work)
+					}
+					peep := stats.Funcs[0].Peephole
+					if peep["vector-region-admit"] < 5 || peep["vector-region-writeback"] < 5 {
+						t.Fatalf("actual regional selector inactive: %v", peep)
+					}
+					if work.TemporaryV128LoopHeaders != 1 || work.TemporaryV128LoopBackedges != 1 || work.TemporaryV128PreflightLoopStackPeak != 1 || work.TemporaryV128PreflightBytes == 0 || work.TemporaryV128PreflightOpcodes == 0 {
+						t.Fatalf("inactive loop header or preflight accounting: %+v", work)
+					}
+					if work.TemporaryV128RegionAdmissions < 5 || work.TemporaryV128RegionWritebacks < 5 || work.TemporaryV128RegionEvictions == 0 || work.TemporaryV128RegionBoundaryWritebacks < 4 || work.TemporaryV128RegionAliasRebases < 5 || candidate && work.TemporaryV128RegionRebaseVisits == 0 {
+						t.Fatalf("inactive eviction/boundary/live alias rebase: %+v", work)
+					}
+					for _, cond := range []uint32{1, 2, 3} {
+						for _, salt := range []int{3, 29} {
+							ownedV128LoopRun(t, cm, cond, salt, scalarResult)
+						}
+					}
+					meta := *cm
+					meta.Code, meta.CodeImage = nil, nil
+					encoded, err := json.Marshal(meta)
+					if err != nil {
+						t.Fatal(err)
+					}
+					if !candidate {
+						native = append([]byte(nil), cm.Code...)
+						metaOracle = encoded
+					} else if !bytes.Equal(native, cm.Code) || !bytes.Equal(metaOracle, encoded) {
+						t.Fatal("native or encoder metadata differs")
+					}
+					t.Logf("intr=%v forest=%v bytes=%d peeps=%v work=%+v", intr, candidate, len(cm.Code), peep, work)
+				}
+			}
+		})
+	}
+}
