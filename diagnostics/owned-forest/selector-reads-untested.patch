+func TestOwnedForestSelectorDivRem(t *testing.T) {
+	var oracle []byte
+	for _, candidate := range []bool{false, true} {
+		f := closureStart(candidate)
+		f.localSlot = []uint32{0, 1}
+		f.nLocalSlots = 2
+		f.localType = []machineType{mtI32, mtI32}
+		f.locals = []localDef{{state: lsMem, reg: regNone, typ: mtI32}, {state: lsMem, reg: regNone, typ: mtI32}}
+		f.a.MovImm32(RDI, 23)
+		f.a.Store32(RSP, f.localAddr(0), RDI)
+		f.a.MovImm32(RDI, 5)
+		f.a.Store32(RSP, f.localAddr(1), RDI)
+		f.pushValue(storage{kind: stLocalRef, typ: mtI32, idx: 0})
+		f.pushValue(storage{kind: stLocalRef, typ: mtI32, idx: 1})
+		bad := wasm.ReaderFrom([]byte{0x20, 1, 0x20, 0, 0x70})
+		if f.tryDivRemPair(&bad, 0x6e, opDivU, mtI32) || bad.Offset() != 0 {
+			t.Fatal("nonmatching probe mutated reader")
+		}
+		r := wasm.ReaderFrom([]byte{0x20, 0, 0x20, 1, 0x70})
+		if !f.tryDivRemPair(&r, 0x6e, opDivU, mtI32) || r.Offset() != 5 || f.s.logicalDepth != 2 {
+			t.Fatal("paired selector did not activate")
+		}
+		f.pushBinOp(opAdd, mtI32)
+		closureFinish(t, f, 7)
+		closureRun(t, f, 7)
+		if !candidate {
+			oracle = append([]byte(nil), f.a.B...)
+		} else if !bytes.Equal(oracle, f.a.B) {
+			t.Fatal("native differs")
+		}
+	}
+	for _, candidate := range []bool{false, true} {
+		f := independentForestFn(candidate)
+		f.pushValue(storage{kind: stLocalRef, typ: mtI32, idx: 0})
+		r := wasm.ReaderFrom([]byte{0x20, 0, 0x20, 0, 0x70})
+		if f.tryDivRemPair(&r, 0x6e, opDivU, mtI32) || r.Offset() != 0 {
+			t.Fatal("single-root probe crossed boundary")
+		}
+	}
+}
