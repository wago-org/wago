+func TestOwnedForestSelectorRepeatedModules(t *testing.T) {
+	for _, tc := range []struct {
+		opcode byte
+		value  uint64
+	}{{0x6a, 48}, {0x6b, 34}, {0x6c, 65}} {
+		body := []byte{0, 0x41, 20, 0x20, 2, 0x28, 2, 0, 0x20, 0, 0x20, 1, 0x73, 0x20, 1, tc.opcode, 0x6a, 0x6a, 0x0b}
+		m := modMem(t, 1, []wasm.ValType{wasm.I32, wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, body)
+		for _, intr := range []bool{false, true} {
+			var oracle []byte
+			for _, candidate := range []bool{false, true} {
+				w := &fixtureModuleWork{Forest: candidate}
+				cm, e := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, fixtureWork: w})
+				if e != nil {
+					t.Fatal(e)
+				}
+				if w.LegacyBodies != 1 || w.Opcodes == 0 {
+					t.Fatal("legacy path inactive")
+				}
+				got, e := ownedRunModule(t, cm, []uint64{3, 7, 0})
+				if e != nil || got != tc.value {
+					t.Fatalf("op=%x result=%d want=%d err=%v", tc.opcode, got, tc.value, e)
+				}
+				_, e = ownedRunModule(t, cm, []uint64{3, 7, 65535})
+				var tr *wr.TrapError
+				if !errors.As(e, &tr) || tr.Code != wr.TrapLinMemOutOfBounds || len(tr.Frames) != 1 || tr.Frames[0].ProgramCounter != 5 {
+					t.Fatalf("exact earlier load PC5: %v", e)
+				}
+				if !candidate {
+					oracle = append([]byte(nil), cm.Code...)
+				} else if !bytes.Equal(oracle, cm.Code) {
+					t.Fatal("native differs")
+				}
+				if cm.CodeImage != nil {
+					cm.CodeImage.Close()
+				}
+			}
+		}
+	}
+}
