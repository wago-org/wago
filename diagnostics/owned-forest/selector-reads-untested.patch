+func TestOwnedForestSelectorRepeatedLocal(t *testing.T) {
+	for _, tc := range []struct {
+		op   wOp
+		want uint64
+	}{{opAdd, 17}, {opSub, 3}, {opMul, 34}} {
+		t.Run(fmt.Sprint(tc.op), func(t *testing.T) {
+			var oracle []byte
+			for _, candidate := range []bool{false, true} {
+				f := closureStart(candidate)
+				f.a.MovImm32(RDI, 7)
+				f.a.Store32(RSP, f.localAddr(0), RDI)
+				local := func() { f.pushValue(storage{kind: stLocalRef, typ: mtI32, idx: 0}) }
+				con := func(v int64) { f.pushValue(storage{kind: stConst, typ: mtI32, cval: v}) }
+				local()
+				con(1)
+				f.pushBinOp(opXor, mtI32)
+				prior := f.s.back()
+				if !prior.isDeferred() {
+					t.Fatal("prior must remain deferred")
+				}
+				local()
+				con(3)
+				f.pushBinOp(opXor, mtI32)
+				local()
+				f.pushBinOp(tc.op, mtI32)
+				if !f.s.back().isValue() {
+					t.Fatal("repeated-local early materialization did not activate")
+				}
+				con(29)
+				r := wasm.ReaderFrom(nil)
+				f.setLocal(&r, 0, false)
+				f.pushBinOp(opAdd, mtI32)
+				closureFinish(t, f, tc.want)
+				closureRun(t, f, tc.want)
+				if !candidate {
+					oracle = append([]byte(nil), f.a.B...)
+				} else if !bytes.Equal(oracle, f.a.B) {
+					t.Fatal("native differs")
+				}
+			}
+		})
+	}
+}
