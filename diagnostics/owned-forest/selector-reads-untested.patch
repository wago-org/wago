+func TestOwnedForestSelectorNearbyBoundary(t *testing.T) {
+	for _, fill := range []int{0, 14, 15, 16, 17} {
+		for _, candidate := range []bool{false, true} {
+			f := independentForestFn(candidate)
+			f.pushValue(storage{kind: stLocalRef, typ: mtI32, idx: 0})
+			f.pushValue(storage{kind: stConst, typ: mtI32, cval: 3})
+			f.pushBinOp(opXor, mtI32)
+			for i := 0; i < fill; i++ {
+				f.pushValue(storage{kind: stConst, typ: mtI32, cval: int64(i)})
+			}
+			top := f.pushValue(storage{kind: stConst, typ: mtI32, cval: 99})
+			if got := f.hasNearbyDeferredRoot(top); got != (fill < 16) {
+				t.Fatalf("candidate=%v fill=%d got=%v", candidate, fill, got)
+			}
+		}
+	}
+}
