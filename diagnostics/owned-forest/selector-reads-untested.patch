+func TestOwnedForestSelectorDivisionModules(t *testing.T) {
+	for _, signed := range []bool{false, true} {
+		div, rem := byte(0x6e), byte(0x70)
+		if signed {
+			div, rem = 0x6d, 0x6f
+		}
+		// Fallthrough loop naturally retains the legacy driver without altering policy.
+		body := []byte{0, 0x03, 0x40, 0x01, 0x0b, 0x20, 0, 0x20, 1, div, 0x20, 0, 0x20, 1, rem, 0x6a, 0x0b}
+		m := mod1(t, []wasm.ValType{wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, body)
+		for _, intr := range []bool{false, true} {
+			var oracle []byte
+			for _, candidate := range []bool{false, true} {
+				w := &fixtureModuleWork{Forest: candidate}
+				cm, e := CompileModuleWith(m, CompileOptions{Workers: 1, Interruptible: intr, fixtureWork: w})
+				if e != nil {
+					t.Fatal(e)
+				}
+				if w.LegacyBodies != 1 || w.Opcodes == 0 {
+					t.Fatalf("inactive: %+v", w)
+				}
+				for _, args := range [][]uint64{{23, 5}, {23, 0}, {0x80000000, 0xffffffff}} {
+					got, e := ownedRunModule(t, cm, args)
+					trapExpected := args[1] == 0 || (signed && args[0] == 0x80000000)
+					if trapExpected {
+						var tr *wr.TrapError
+						code := wr.TrapDivZero
+						if args[1] != 0 {
+							code = wr.TrapDivOverflow
+						}
+						if !errors.As(e, &tr) || tr.Code != code || len(tr.Frames) != 1 || !tr.Frames[0].HasProgramCounter || tr.Frames[0].ProgramCounter != 9 {
+							t.Fatalf("signed=%v candidate=%v exact DIV PC9 expected: %v", signed, candidate, e)
+						}
+					} else {
+						want := uint64(uint32(args[0])/uint32(args[1]) + uint32(args[0])%uint32(args[1]))
+						if e != nil || got != want {
+							t.Fatalf("got=%d want=%d err=%v", got, want, e)
+						}
+					}
+				}
+				if !candidate {
+					oracle = append([]byte(nil), cm.Code...)
+				} else if !bytes.Equal(oracle, cm.Code) {
+					t.Fatal("module native differs")
+				}
+				if cm.CodeImage != nil {
+					cm.CodeImage.Close()
+				}
+			}
+		}
+	}
+}
