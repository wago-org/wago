+		{name: "retained-old-local-br-value", module: scalar(2, []byte{0, 0x02, 0x7f, 0x20, 0, 0x41, 9, 0x21, 0, 0x20, 1, 0x0d, 0, 0x41, 1, 0x6a, 0x0b, 0x20, 0, 0x6a, 0x0b}), args: []uint64{17, 1}, want: 26},
+		{name: "retained-old-local-fallthrough", module: scalar(2, []byte{0, 0x02, 0x7f, 0x20, 0, 0x41, 9, 0x21, 0, 0x20, 1, 0x0d, 0, 0x41, 1, 0x6a, 0x0b, 0x20, 0, 0x6a, 0x0b}), args: []uint64{17, 0}, want: 27},
