+func TestOwnedForestModulePeelPreservesLazyLocal(t *testing.T) {
+	f := independentForestFn(true)
+	leaf := f.pushValue(storage{kind: stLocalRef, typ: mtI32, idx: 0})
+	constant := f.pushValue(storage{kind: stConst, typ: mtI32, cval: 7})
+	child := testDeferredElem(opEq, mtI32, leaf, constant)
+	f.s.pushDeferred(child)
+	parent := testDeferredElem(opEqz, mtI32, child, nil)
+	f.s.pushDeferred(parent)
+	if f.s.logicalDepth != 1 || f.s.pendingEffects&pendingLocalRef == 0 {
+		t.Fatal("invalid precondition")
+	}
+	f.forestPeelTop(parent, child)
+	if f.s.pendingEffects&pendingLocalRef == 0 {
+		t.Fatal("sole-root peel lost lazy-local effect summary")
+	}
+	if f.s.logicalDepth != 1 || len(f.s.forest.roots) != 1 || f.s.forest.roots[0] != child || parent.forestLive || !child.forestLive || !leaf.forestLive || !constant.forestLive || !child.st.hasLogicalRoot() {
+		t.Fatal("ownership/depth changed")
+	}
+	c := f.s.fixtureScan(false)
+	for _, want := range []*elem{leaf, constant, child} {
+		if got := c.next(); got != want {
+			t.Fatal("postorder changed")
+		}
+	}
+	if c.next() != nil {
+		t.Fatal("extra node")
+	}
+	independentForestNilLinks(t, f, []*elem{parent, child, leaf, constant})
+}
