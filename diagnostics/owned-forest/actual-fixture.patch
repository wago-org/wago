+func TestOwnedForestModuleScalarDriver(t *testing.T) {
+	for _, tc := range ownedModuleCases(t) {
+		for _, intr := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/interruptible=%v", tc.name, intr), func(t *testing.T) {
+				var oracle []byte
+				for _, candidate := range []bool{false, true} {
+					work := &fixtureModuleWork{Forest: candidate}
+					opts := CompileOptions{Workers: 1, Interruptible: intr, fixtureWork: work}
+					cm, err := CompileModuleWith(tc.module, opts)
+					bypass := strings.HasPrefix(tc.name, "if-")
+					scopeControl := tc.name == "nonzero-call-reversed-args-live-prefix"
+					if err != nil {
+						if candidate && scopeControl && work.Rejected > 0 && work.InlineCallGaps > 0 {
+							t.Logf("COVERAGE_REJECTED_NOT_MIGRATED name=%s candidate=%v error=%v work=%+v", tc.name, candidate, err, work)
+							continue
+						}
+						t.Fatalf("candidate=%v explicit compile rejection: %v work=%+v", candidate, err, work)
+					}
+					if candidate && scopeControl {
+						t.Fatal("scope control unexpectedly migrated; inspect before changing denominator")
+					}
+					if cm.CodeImage != nil {
+						defer cm.CodeImage.Close()
+					}
+					if work.Attempts == 0 || work.Completed == 0 || work.Rejected != 0 || (!scopeControl && !bypass && (work.Opcodes == 0 || work.LegacyBodies == 0)) {
+						t.Fatalf("selector incomplete candidate=%v work=%+v", candidate, work)
+					}
+					if bypass {
+						if work.SharedScalarBodies == 0 || work.LegacyBodies != 0 || work.Opcodes != 0 || work.Vector.stores != 0 || work.RootCapacity != 0 {
+							t.Fatalf("invalid shared-scalar bypass: %+v", work)
+						}
+						t.Log("SHARED_SCALAR_BYPASS_NOT_FOREST_COVERAGE")
+					} else if candidate && work.Vector.stores == 0 {
+						t.Fatal("legacy candidate has no actual forest root work")
+					}
+					got, err := ownedRunModule(t, cm, tc.args)
+					if tc.trap {
+						var trap *wr.TrapError
+						if !errors.As(err, &trap) || trap.Code != wr.TrapLinMemOutOfBounds || len(trap.Frames) != 1 || trap.Frames[0].FunctionIndex != 0 || !trap.Frames[0].HasProgramCounter || trap.Frames[0].ProgramCounter != tc.trapPC {
+							t.Fatalf("candidate=%v expected exact OOB PC%d got %v", candidate, tc.trapPC, err)
+						}
+					} else if err != nil || got != tc.want {
+						t.Fatalf("candidate=%v result=%d want=%d err=%v", candidate, got, tc.want, err)
+					}
+					exact := true
+					if !candidate {
+						oracle = append([]byte(nil), cm.Code...)
+					} else {
+						exact = bytes.Equal(oracle, cm.Code)
+						if bypass && !exact {
+							t.Fatal("shared-scalar bypass native differs")
+						}
+					}
+					t.Logf("candidate=%v nativeBytes=%d nativeSHA=%x exactList=%v entries=%v internal=%v sharedScalar=%d streaming=%d legacy=%d inlineGaps=%d opcodes=%d attempts=%d completed=%d rejected=%d list=%+v vector=%+v rootCapacity=%d orderedSpills=%+v", candidate, len(cm.Code), sha256.Sum256(cm.Code), exact, cm.Entry, cm.InternalEntry, work.SharedScalarBodies, work.StreamingBodies, work.LegacyBodies, work.InlineCallGaps, work.Opcodes, work.Attempts, work.Completed, work.Rejected, work.List, work.Vector, work.RootCapacity, work.Spills)
+				}
+			})
+		}
+	}
+}
