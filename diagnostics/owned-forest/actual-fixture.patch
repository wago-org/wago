+	effectIf := []byte{0, 0x41, 13, 0x20, 0, 0x04, 0x7f, 0x41, 0, 0x41, 17, 0x36, 2, 0, 0x41, 0, 0x28, 2, 0, 0x05, 0x41, 0, 0x41, 23, 0x36, 2, 0, 0x41, 0, 0x28, 2, 0, 0x0b, 0x6a, 0x0b}
+	effectModule := modMem(t, 1, []wasm.ValType{wasm.I32}, []wasm.ValType{wasm.I32}, effectIf)
+	cases = append(cases, ownedModuleCase{name: "effectful-if-true", module: effectModule, args: []uint64{1}, want: 30}, ownedModuleCase{name: "effectful-if-false", module: effectModule, args: []uint64{0}, want: 36})
