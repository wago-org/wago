diff --git a/src/core/compiler/backend/railshot/amd64/owned_forest_closure_independent_test.go b/src/core/compiler/backend/railshot/amd64/owned_forest_closure_independent_test.go
new file mode 100644
index 00000000..3c0dbe52
--- /dev/null
+++ b/src/core/compiler/backend/railshot/amd64/owned_forest_closure_independent_test.go
@@ -0,0 +1,155 @@
+//go:build (linux || darwin || windows) && amd64 && wago_owned_forest_fixture
+
+package amd64
+
+import (
+	"bytes"
+	"encoding/binary"
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	encoder "github.com/wago-org/wago/src/core/encoder/amd64"
+	"testing"
+)
+
+func closureStart(candidate bool) *fn {
+	f := independentForestFn(candidate)
+	f.localType = []machineType{mtI32}
+	f.locals = []localDef{{state: lsMem, reg: regNone, typ: mtI32}}
+	if !candidate {
+		f.s.fixtureListWork = &fixtureListWork{}
+	}
+	f.a.Push(RBX)
+	f.a.Push(RCX)
+	f.a.SubRsp(1024)
+	return f
+}
+func closureFinish(t *testing.T, f *fn, want uint64) {
+	t.Helper()
+	r := f.materialize(f.s.back())
+	f.a.MovReg64(RAX, r)
+	f.a.AddRsp(1024)
+	f.a.Pop(RCX)
+	f.a.Pop(RBX)
+	f.a.Store64(RCX, 0, RAX)
+	f.a.Ret()
+}
+func closureRun(t *testing.T, f *fn, want uint64) {
+	t.Helper()
+	if got := runCompiledAmd64u(t, &encoder.CompiledModule{Code: f.a.B, Entry: []int{0}}); got != want {
+		t.Fatalf("got=%d want=%d", got, want)
+	}
+	if f.s.forest != nil {
+		t.Logf("forest: %+v rootCapacity=%d", *f.s.forest, cap(f.s.forest.roots))
+		independentForestNilLinks(t, f, f.rootsBottomToTop())
+	} else {
+		t.Logf("list reached operations: %+v", *f.s.fixtureListWork)
+	}
+}
+func TestOwnedForestClosureLocalSnapshot(t *testing.T) {
+	var oracle []byte
+	for _, candidate := range []bool{false, true} {
+		f := closureStart(candidate)
+		f.a.MovImm32(RDI, 11)
+		f.a.Store32(RSP, f.localAddr(0), RDI)
+		old := f.pushValue(storage{kind: stLocalRef, typ: mtI32, idx: 0})
+		f.pushValue(storage{kind: stConst, typ: mtI32, cval: 3})
+		f.pushBinOp(opAnd, mtI32)
+		f.pushUnOp(opEqz, mtI32)
+		f.pushValue(storage{kind: stConst, typ: mtI32, cval: 29})
+		r := wasm.ReaderFrom(nil)
+		f.setLocal(&r, 0, false)
+		f.pushValue(storage{kind: stLocalRef, typ: mtI32, idx: 0})
+		f.pushBinOp(opAdd, mtI32)
+		independentForestNilLinks(t, f, []*elem{old, f.s.back()})
+		closureFinish(t, f, 29)
+		closureRun(t, f, 29)
+		if !candidate {
+			oracle = append([]byte(nil), f.a.B...)
+		} else if !bytes.Equal(oracle, f.a.B) {
+			t.Fatal("local snapshot native mismatch")
+		}
+	}
+}
+func TestOwnedForestClosureEffectNestedAllocation(t *testing.T) {
+	var oracle []byte
+	for _, candidate := range []bool{false, true} {
+		f := closureStart(candidate)
+		f.a.MovImm32(RDI, 17)
+		f.a.Store32(RSP, f.localAddr(0), RDI)
+		f.a.MovReg64(RBX, RSP)
+		f.a.MovImm32(R12, 0)
+		load := f.pushValue(memRefStorage(R12, f.localAddr(0), 4, false, false, -1))
+		f.regUser[R12] = load
+		f.pushValue(storage{kind: stConst, typ: mtI32, cval: 3})
+		f.pushBinOp(opAdd, mtI32)
+		f.materializePendingLoads()
+		scratch := f.allocReg(0)
+		f.a.MovImm32(scratch, 99)
+		f.a.Store32(RSP, f.localAddr(0), scratch)
+		f.release(scratch)
+		f.pushValue(storage{kind: stLocalRef, typ: mtI32, idx: 0})
+		f.pushBinOp(opAdd, mtI32)
+		closureFinish(t, f, 119)
+		closureRun(t, f, 119)
+		if !candidate {
+			oracle = append([]byte(nil), f.a.B...)
+		} else if !bytes.Equal(oracle, f.a.B) {
+			t.Fatal("effect snapshot native mismatch")
+		}
+	}
+}
+func TestOwnedForestClosureActualCall(t *testing.T) {
+	var oracle []byte
+	for _, candidate := range []bool{false, true} {
+		f := closureStart(candidate)
+		f.m = modFuncs(t, funcDef{nil, []wasm.ValType{wasm.I32}, []byte{0, 0x41, 23, 0x0b}})
+		f.pushValue(storage{kind: stConst, typ: mtI32, cval: 19})
+		r := wasm.ReaderFrom([]byte{0})
+		if e := f.callOp(&r); e != nil {
+			t.Fatal(e)
+		}
+		if len(f.relocs) != 1 || !f.relocs[0].internal {
+			t.Fatal("actual internal call not emitted")
+		}
+		f.pushBinOp(opAdd, mtI32)
+		closureFinish(t, f, 42)
+		target := f.a.Len()
+		f.a.MovImm32(RAX, 23)
+		f.a.Ret()
+		at := f.relocs[0].at
+		binary.LittleEndian.PutUint32(f.a.B[at:], uint32(int32(target-int(at)-4)))
+		closureRun(t, f, 42)
+		if !candidate {
+			oracle = append([]byte(nil), f.a.B...)
+		} else if !bytes.Equal(oracle, f.a.B) {
+			t.Fatal("actual call native mismatch")
+		}
+	}
+}
+func TestOwnedForestClosureActualBlock(t *testing.T) {
+	var oracle []byte
+	for _, candidate := range []bool{false, true} {
+		f := closureStart(candidate)
+		f.regMerge = false // same slot-agreement profile in BOTH arms
+		f.pushValue(storage{kind: stConst, typ: mtI32, cval: 11})
+		r := wasm.ReaderFrom([]byte{0x7f, 0x41, 33, 0x0c, 0, 0x0b})
+		if e := f.opBlock(&r, 0x02); e != nil {
+			t.Fatal(e)
+		}
+		f.pushValue(storage{kind: stConst, typ: mtI32, cval: 33})
+		br := wasm.ReaderFrom([]byte{0})
+		if e := f.opBr(&br, false); e != nil {
+			t.Fatal(e)
+		}
+		if e := f.opEnd(); e != nil {
+			t.Fatal(e)
+		}
+		f.pushBinOp(opAdd, mtI32)
+		closureFinish(t, f, 44)
+		closureRun(t, f, 44)
+		if !candidate {
+			oracle = append([]byte(nil), f.a.B...)
+		} else if !bytes.Equal(oracle, f.a.B) {
+			t.Fatal("actual block native mismatch")
+		}
+	}
+}
diff --git a/src/core/compiler/backend/railshot/amd64/owned_forest_emitter_independent_test.go b/src/core/compiler/backend/railshot/amd64/owned_forest_emitter_independent_test.go
