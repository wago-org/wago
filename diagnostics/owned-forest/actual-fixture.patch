+//go:build (linux || darwin || windows) && amd64 && wago_owned_forest_fixture
+
+package amd64
+
+import (
+	"bytes"
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	encoder "github.com/wago-org/wago/src/core/encoder/amd64"
+	"reflect"
+	"testing"
+	"unsafe"
+)
+
+// Deliberately poison the legacy sentinel. A candidate that touches the list
+// cannot silently pass by rebuilding it behind the fixture's back.
+func independentForestFn(candidate bool) *fn {
+	f := &fn{a: &encoder.Asm{}, s: newStack(), sc: newScratch(), m: &wasm.Module{}, localSlot: []uint32{0}, nLocalSlots: 1, globalCellReg: regNone, memSizeReg: regNone, moduleGlobalRegionalLease: regNone, policy: currentCodegenPolicy()}
+	if candidate {
+		f.s.forest = &fixtureForest{}
+		f.s.head.prev = nil
+		f.s.head.next = nil
+	}
+	return f
+}
+func independentForestNilLinks(t *testing.T, f *fn, seen []*elem) {
+	t.Helper()
+	if f.s.forest == nil {
+		return
+	}
+	if f.s.head.prev != nil || f.s.head.next != nil {
+		t.Fatal("candidate rebuilt legacy sentinel")
+	}
+	for _, e := range seen {
+		if e.prev != nil || e.next != nil {
+			t.Fatal("candidate operand acquired legacy link")
+		}
+	}
+}
+func TestOwnedForestEmitterMaskedCompare(t *testing.T) {
+	var oracle []byte
+	for _, candidate := range []bool{false, true} {
+		f := independentForestFn(candidate)
+		f.a.Push(RCX)
+		f.a.SubRsp(256)
+		f.a.MovImm32(RDI, 4)
+		f.a.Store32(RSP, f.localAddr(0), RDI)
+		var nodes []*elem
+		nodes = append(nodes, f.pushValue(storage{kind: stConst, typ: mtI32, cval: 7}))
+		nodes = append(nodes, f.pushValue(storage{kind: stLocalRef, typ: mtI32, idx: 0}))
+		nodes = append(nodes, f.pushValue(storage{kind: stConst, typ: mtI32, cval: 3}))
+		f.pushBinOp(opAnd, mtI32)
+		nodes = append(nodes, f.s.back())
+		f.pushUnOp(opEqz, mtI32)
+		nodes = append(nodes, f.s.back())
+		f.pushBinOp(opAdd, mtI32)
+		nodes = append(nodes, f.s.back())
+		independentForestNilLinks(t, f, nodes)
+		reg := f.materialize(f.s.back())
+		f.a.MovReg64(RAX, reg)
+		independentForestNilLinks(t, f, nodes)
+		f.a.AddRsp(256)
+		f.a.Pop(RCX)
+		f.a.Store64(RCX, 0, RAX)
+		f.a.Ret()
+		if got := runCompiledAmd64u(t, &encoder.CompiledModule{Code: f.a.B, Entry: []int{0}}); got != 8 {
+			t.Fatalf("candidate=%v got=%d", candidate, got)
+		}
+		if !candidate {
+			oracle = append([]byte(nil), f.a.B...)
+		} else {
+			if !bytes.Equal(oracle, f.a.B) {
+				t.Fatal("same-emitter native mismatch")
+			}
+			if f.s.forest.flagsTransitions == 0 {
+				t.Fatal("masked flags transition not activated")
+			}
+			if f.s.forest.stores == 0 || f.s.forest.retirements == 0 {
+				t.Fatal("forest bookkeeping not selected")
+			}
+			t.Logf("root stores=%d growth=%d retired=%d peak=%d capacity=%d", f.s.forest.stores, f.s.forest.grows, f.s.forest.retirements, f.s.forest.peak, cap(f.s.forest.roots))
+		}
+	}
+}
+
+func TestOwnedForestEmitterPressureWrapper(t *testing.T) {
+	var oracle []byte
+	for _, candidate := range []bool{false, true} {
+		f := independentForestFn(candidate)
+		f.a.Push(RCX)
+		f.a.SubRsp(1024)
+		var nodes []*elem
+		for i, r := range gpAlloc {
+			f.a.MovImm32(r, int32(i+1))
+			nodes = append(nodes, f.pushReg(r, mtI32))
+		}
+		r := f.allocReg(0)
+		f.a.MovImm32(r, 99)
+		nodes = append(nodes, f.pushReg(r, mtI32))
+		if candidate && f.s.forest.spills == 0 {
+			t.Fatal("no actual GP pressure spill")
+		}
+		independentForestNilLinks(t, f, nodes)
+		f.flushWrapper()
+		independentForestNilLinks(t, f, nodes)
+		for _, r := range gpAlloc {
+			f.a.MovImm32(r, 0xdead)
+		} // call-like clobber after real wrapper prep
+		for i := 0; i < len(gpAlloc); i++ {
+			f.pushBinOp(opAdd, mtI32)
+		}
+		reg := f.materialize(f.s.back())
+		f.a.MovReg64(RAX, reg)
+		f.a.AddRsp(1024)
+		f.a.Pop(RCX)
+		f.a.Store64(RCX, 0, RAX)
+		f.a.Ret()
+		want := uint64(len(gpAlloc)*(len(gpAlloc)+1)/2 + 99)
+		if got := runCompiledAmd64u(t, &encoder.CompiledModule{Code: f.a.B, Entry: []int{0}}); got != want {
+			t.Fatalf("candidate=%v got=%d want=%d", candidate, got, want)
+		}
+		if !candidate {
+			oracle = append([]byte(nil), f.a.B...)
+		} else {
+			if !bytes.Equal(oracle, f.a.B) {
+				t.Fatal("wrapper/pressure native mismatch")
+			}
+			t.Logf("spills=%d visits=%d cursorWrites=%d capacity=%d", f.s.forest.spills, f.s.forest.visits, f.s.forest.cursorWrites, cap(f.s.forest.roots))
+		}
+	}
+}
+func TestOwnedForestEmitterControlAgreement(t *testing.T) {
+	var oracle []byte
+	for _, candidate := range []bool{false, true} {
+		f := independentForestFn(candidate)
+		f.a.Push(RCX)
+		f.a.SubRsp(256)
+		f.pushValue(storage{kind: stConst, typ: mtI32, cval: 11})
+		f.pushValue(storage{kind: stConst, typ: mtI32, cval: 22})
+		f.pushValue(storage{kind: stConst, typ: mtI32, cval: 33})
+		fr := &ctrlFrame{kind: cfBlock}
+		f.setFrameBaseTypePrefix(fr, 1)
+		f.flushWrapper()
+		f.moveBranchValues(fr, f.depth(), 1)
+		f.setDepthTypes([]machineType{mtI32, mtI32})
+		independentForestNilLinks(t, f, f.rootsBottomToTop())
+		f.pushBinOp(opAdd, mtI32)
+		r := f.materialize(f.s.back())
+		f.a.MovReg64(RAX, r)
+		f.a.AddRsp(256)
+		f.a.Pop(RCX)
+		f.a.Store64(RCX, 0, RAX)
+		f.a.Ret()
+		if got := runCompiledAmd64u(t, &encoder.CompiledModule{Code: f.a.B, Entry: []int{0}}); got != 44 {
+			t.Fatalf("candidate=%v agreement=%d", candidate, got)
+		}
+		if !candidate {
+			oracle = append([]byte(nil), f.a.B...)
+		} else if !bytes.Equal(oracle, f.a.B) {
+			t.Fatal("control agreement native mismatch")
+		}
+	}
+}
+func TestOwnedForestEmitterMemoryTrapEmission(t *testing.T) {
+	var oracle []byte
+	var sites [trapMax + 1][]trapSite
+	for _, candidate := range []bool{false, true} {
+		f := independentForestFn(candidate)
+		f.wasmPC = 37
+		f.traceFuncIdx = 3
+		address := f.pushValue(storage{kind: stLocalRef, typ: mtI32, idx: 0})
+		r := wasm.ReaderFrom([]byte{2, 0})
+		if err := f.memLoad(&r, 4, false, false); err != nil {
+			t.Fatal(err)
+		}
+		load := f.s.back()
+		f.pushValue(storage{kind: stConst, typ: mtI32, cval: 3})
+		f.pushBinOp(opEq, mtI32)
+		f.materialize(f.s.back())
+		independentForestNilLinks(t, f, []*elem{address, load, f.s.back()})
+		n := 0
+		for _, group := range f.sc.trapSites {
+			for _, site := range group {
+				n++
+				if site.pc != 37 || site.function != 3 {
+					t.Fatalf("trap provenance %+v", site)
+				}
+			}
+		}
+		if n == 0 {
+			t.Fatal("no actual bounds trap site")
+		}
+		if !candidate {
+			oracle = append([]byte(nil), f.a.B...)
+			for i, g := range f.sc.trapSites {
+				sites[i] = append([]trapSite(nil), g...)
+			}
+		} else {
+			if !bytes.Equal(oracle, f.a.B) || !reflect.DeepEqual(sites, f.sc.trapSites) {
+				t.Fatal("memory/trap native or PC mismatch")
+			}
+			if f.s.forest.flagsTransitions == 0 {
+				t.Fatal("folded comparison not activated")
+			}
+		}
+	}
+}
+
+func TestOwnedForestEmitterStorageReceipt(t *testing.T) {
+	t.Logf("actual bytes elem=%d stack=%d cursor=%d forest=%d cursorFrame=%d frameBound=%d; no node-layout shrink claimed", unsafe.Sizeof(elem{}), unsafe.Sizeof(stack{}), unsafe.Sizeof(fixtureCursor{}), unsafe.Sizeof(fixtureForest{}), unsafe.Sizeof(fixtureCursorFrame{}), len(fixtureCursor{}.frames))
+}
+
+func TestOwnedForestEmitterRejectsUnsupported(t *testing.T) {
+	cases := []struct {
+		name, want string
+		run        func(*fn)
+	}{
+		{"fp-allocation", "fixture forest: unported FP allocation", func(f *fn) { f.allocFReg(0) }},
+		{"interval-eviction", "fixture forest: unported interval local eviction", func(f *fn) { f.intervalReg = []Reg{R12}; f.evictIntervalLocal(0) }},
+		{"generic-nontop-erase", "fixture forest: unported non-top erase", func(f *fn) {
+			e := f.pushValue(storage{kind: stConst, typ: mtI32, cval: 1})
+			f.pushValue(storage{kind: stConst, typ: mtI32, cval: 2})
+			f.s.erase(e)
+		}},
+		{"flush-below", "fixture forest: unported flushBelow", func(f *fn) { f.flushBelow(nil) }},
+		{"missing-effect-limit", "fixture forest: partial effect limit not found", func(f *fn) { f.fixturePendingEffects(true, new(elem)) }},
+		{"missing-effect-pending", "fixture forest: partial effect limit not found", func(f *fn) { f.s.pendingEffects = pendingLoad; f.fixturePendingEffects(true, new(elem)) }},
+		{"pending-erase", "fixture forest: erase unresolved subtree or pending result", func(f *fn) {
+			e := f.pushValue(storage{kind: stConst, typ: mtI32})
+			e.forestPending = true
+			f.s.erase(e)
+		}},
+		{"deferred-erase", "fixture forest: erase unresolved subtree or pending result", func(f *fn) {
+			f.pushValue(storage{kind: stLocalRef, typ: mtI32})
+			f.pushValue(storage{kind: stConst, typ: mtI32, cval: 3})
+			f.pushBinOp(opAnd, mtI32)
+			f.s.erase(f.s.back())
+		}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			f := independentForestFn(true)
+			defer func() {
+				if got := recover(); got != tc.want {
+					t.Fatalf("panic=%v want=%s", got, tc.want)
+				}
+			}()
+			tc.run(f)
+			t.Fatal("unsupported path returned")
+		})
+	}
+}
diff --git a/src/core/compiler/backend/railshot/amd64/owned_forest_fixture.go b/src/core/compiler/backend/railshot/amd64/owned_forest_fixture.go
new file mode 100644
index 00000000..db838c62
--- /dev/null
+++ b/src/core/compiler/backend/railshot/amd64/owned_forest_fixture.go
@@ -0,0 +1,418 @@
+//go:build amd64
+
+package amd64
+
+// fixtureForest is a direct-emitter experiment, not a publicly admitted path.
+// Existing elem layout is retained for the independent legacy oracle.
+// Counts for the reached paired operations only; units are not interchangeable.
+type fixtureListWork struct {
+	linkWrites, cursorVisits, spillPrefixVisits, effectVisits uint64
+}
+
+type fixtureForest struct {
+	spills                                                          uint64
+	cursorWrites, visits, lostPrefixOpportunities, flagsTransitions uint64
+	peakCursor                                                      int
+	roots                                                           []*elem
+	stores, grows, retirements                                      uint64
+	peak                                                            int
+}
+
+func (s *stack) operandAttached(e *elem) bool {
+	if s.forest != nil {
+		return e.forestLive
+	}
+	return e.prev != nil && e.next != nil
+}
+
+func (s *stack) forestLast(n int) *elem {
+	i := len(s.forest.roots) - 1 - n
+	if i < 0 {
+		return nil
+	}
+	return s.forest.roots[i]
+}
+
+func (s *stack) forestAppend(e *elem) *elem {
+	if e.prev != nil || e.next != nil || e.forestLive || !e.st.hasLogicalRoot() {
+		panic("fixture forest: invalid root append")
+	}
+	e.forestLive = true
+	v := s.forest
+	if len(v.roots) == cap(v.roots) {
+		v.grows++
+		v.stores += uint64(len(v.roots))
+	}
+	v.roots = append(v.roots, e)
+	v.stores++
+	v.peak = max(v.peak, len(v.roots))
+	return e
+}
+
+func (s *stack) forestReplace(arity int, e *elem) *elem {
+	v := s.forest
+	i := len(v.roots) - arity
+	if i < 0 || v.roots[i] != e.arg0 || (arity == 2 && v.roots[i+1] != e.arg1) {
+		panic("fixture forest: wrong deferred suffix")
+	}
+	if e.forestLive || e.prev != nil || e.next != nil {
+		panic("fixture forest: attached replacement")
+	}
+	v.roots[i] = e
+	v.stores++
+	if arity == 2 {
+		v.roots[i+1] = nil
+		v.stores++
+	}
+	v.roots = v.roots[:i+1]
+	e.forestLive = true
+	return e
+}
+
+// Structural retirement only: existing lowering owns all register releases.
+func (s *stack) forestRetire(e *elem) {
+	if !e.forestLive || e.prev != nil || e.next != nil {
+		panic("fixture forest: retire invalid operand")
+	}
+	s.forgetSpill(e)
+	s.canonicalSlots = false
+	s.pendingPrefix = nil
+	if e.st.hasLogicalRoot() {
+		if s.logicalDepth == 0 {
+			panic("fixture forest: logical depth underflow")
+		}
+		s.logicalDepth--
+		e.st.setLogicalRoot(false)
+	}
+	e.forestLive = false
+	s.forest.retirements++
+	if len(s.forest.roots) == 0 {
+		s.pendingEffects &^= pendingLocalRef
+	}
+}
+
+func (f *fn) forestRetireSubtree(e *elem) {
+	if e == nil {
+		return
+	}
+	if e.isDeferred() {
+		f.forestRetireSubtree(e.arg1)
+		f.forestRetireSubtree(e.arg0)
+	}
+	if regallocCheckEnabled {
+		f.checkConsumeMemRef(e)
+	}
+	f.s.clearElemCold(e)
+	f.s.forestRetire(e)
+}
+
+func (f *fn) forestRetireChildren(node *elem) {
+	if !node.isDeferred() || node.arg0 == nil {
+		panic("fixture forest: invalid deferred owner")
+	}
+	f.forestRetireSubtree(node.arg1)
+	f.forestRetireSubtree(node.arg0)
+	node.arg0, node.arg1 = nil, nil
+}
+
+func (s *stack) forestResetRoots() {
+	v := s.forest
+	for i, e := range v.roots {
+		if e.isDeferred() || e.forestPending {
+			panic("fixture forest: cannot reset unresolved roots")
+		}
+		s.clearElemCold(e)
+		s.forestRetire(e)
+		v.roots[i] = nil
+		v.stores++
+	}
+	v.roots = v.roots[:0]
+}
+
+type fixtureCursorFrame struct {
+	node  *elem
+	phase uint8
+}
+
+// Independent cursor per allocator or barrier invocation. No retained pointer
+// vector other than the logical roots. Ancestor frames are bounded separately
+// from function size and roots, and returned nodes are already popped.
+type fixtureCursor struct {
+	s                *stack
+	legacy           *elem
+	root, endRoot, n int
+	frames           [maxDeferDepth + 4]fixtureCursorFrame
+}
+
+func (s *stack) fixtureScan(skipSpillPrefix bool) fixtureCursor {
+	c := fixtureCursor{s: s}
+	if s.forest != nil {
+		c.endRoot = len(s.forest.roots)
+	} else {
+		c.legacy = s.head.next
+		if skipSpillPrefix {
+			c.legacy = s.firstUnspilled()
+		}
+	}
+	return c
+}
+
+func (c *fixtureCursor) push(e *elem) {
+	if c.n >= len(c.frames) || !e.forestLive || e.prev != nil || e.next != nil {
+		panic("fixture forest: invalid cursor child")
+	}
+	c.frames[c.n] = fixtureCursorFrame{node: e}
+	c.n++
+	v := c.s.forest
+	v.cursorWrites++
+	v.peakCursor = max(v.peakCursor, c.n)
+}
+
+func (c *fixtureCursor) next() *elem {
+	if c.s.forest == nil {
+		e := c.legacy
+		if e == c.s.head {
+			return nil
+		}
+		c.legacy = e.next
+		if c.s.fixtureListWork != nil {
+			c.s.fixtureListWork.cursorVisits++
+		}
+		return e
+	}
+	v := c.s.forest
+	for {
+		if c.n == 0 {
+			if c.root == c.endRoot {
+				return nil
+			}
+			c.push(v.roots[c.root])
+			c.root++
+		}
+		top := &c.frames[c.n-1]
+		e := top.node
+		if e.isDeferred() && !e.forestPending {
+			switch top.phase {
+			case 0:
+				top.phase = 1
+				v.cursorWrites++
+				if e.arg0 == nil {
+					panic("fixture forest: deferred node missing arg0")
+				}
+				c.push(e.arg0)
+				continue
+			case 1:
+				top.phase = 2
+				v.cursorWrites++
+				if e.arg1 != nil {
+					c.push(e.arg1)
+					continue
+				}
+			}
+		}
+		c.n--
+		c.frames[c.n] = fixtureCursorFrame{}
+		v.cursorWrites++
+		v.visits++
+		return e
+	}
+}
+
+func (f *fn) fixturePendingEffects(loads bool, limit *elem) {
+	s := f.s
+	mask := pendingTrap
+	if loads {
+		mask |= pendingLoad
+	}
+	if limit == nil {
+		panic("fixture forest: nil effect limit")
+	}
+	if s.pendingEffects&mask == 0 {
+		if limit != s.head {
+			c := s.fixtureScan(false)
+			for e := c.next(); e != nil; e = c.next() {
+				if e == limit {
+					return
+				}
+			}
+			panic("fixture forest: partial effect limit not found")
+		}
+		return
+	}
+	if s.pendingPrefix != nil {
+		s.forest.lostPrefixOpportunities++
+	}
+	c := s.fixtureScan(false)
+	for {
+		e := c.next()
+		if e == limit {
+			break
+		}
+		if e == nil {
+			if limit != s.head {
+				panic("fixture forest: partial effect limit not found")
+			}
+			break
+		}
+		if e.forestPending {
+			panic("fixture forest: pending result observed at effect barrier")
+		}
+		if e.isDeferred() && isDivRem(e.deferredOp()) {
+			f.materialize(e)
+		} else if e.isValue() && e.st.kind == stMemRef && loads {
+			f.stats.addForcedLoad()
+			f.materializeByType(e)
+		}
+	}
+	if limit == s.head {
+		s.pendingEffects &^= mask
+		s.pendingPrefix = s.back() // observation only; no physical cursor.
+	}
+}
+
+// Test-only per-module receipt. Never installed in public or parallel compile.
+type fixtureModuleWork struct {
+	SharedScalarBodies, StreamingBodies, LegacyBodies, InlineCallGaps uint64
+	Opcodes                                                           uint64
+	Forest                                                            bool
+	Attempts, Completed, Rejected                                     int
+	List                                                              fixtureListWork
+	Vector                                                            fixtureForest
+	RootCapacity                                                      int
+	Spills                                                            []fixtureSpillTrace
+}
+
+type fixtureSpillTrace struct {
+	Function, PC uint32
+	Reg          Reg
+	Kind         storageKind
+	Type         machineType
+}
+
+func (w *fixtureModuleWork) releaseRoots() {
+	w.RootCapacity = cap(w.Vector.roots)
+	w.Vector.stores += uint64(len(w.Vector.roots))
+	clear(w.Vector.roots)
+	w.Vector.roots = nil
+}
+
+func (s *stack) selectorPrevious(node *elem, depth int) *elem {
+	if s.forest == nil {
+		return baseOfValentBlock(node).prev
+	}
+	if s.forestLast(depth-1) != node {
+		panic("fixture forest: invalid selector root position")
+	}
+	if e := s.forestLast(depth); e != nil {
+		return e
+	}
+	return s.head
+}
+
+func (f *fn) forestEraseAt(i int, e *elem) {
+	s := f.s
+	v := s.forest
+	if i < 0 || i >= len(v.roots) || v.roots[i] != e || e.forestPending ||
+		e.isDeferred() && (e.arg0 != nil || e.arg1 != nil) {
+		panic("fixture forest: indexed erase of wrong or unresolved root")
+	}
+	if regallocCheckEnabled {
+		f.checkConsumeMemRef(e)
+	}
+	s.clearElemCold(e)
+	v.stores += uint64(copy(v.roots[i:], v.roots[i+1:]))
+	v.roots[len(v.roots)-1] = nil
+	v.stores++
+	v.roots = v.roots[:len(v.roots)-1]
+	s.forestRetire(e)
+}
+
+func (f *fn) forestPeelTop(parent, child *elem) {
+	s := f.s
+	if s.back() != parent || parent.forestPending || !parent.isDeferred() ||
+		parent.arg0 != child || parent.arg1 != nil || !child.forestLive || child.st.hasLogicalRoot() {
+		panic("fixture forest: invalid unary root transfer")
+	}
+	i := len(s.forest.roots) - 1
+	parent.arg0 = nil
+	// Replace the owning slot in place. Even for the sole root the remaining
+	// child is live, so retirement must not clear pendingLocalRef as if the
+	// stack became empty. The child keeps all existing register ownership.
+	s.forest.roots[i] = child
+	s.forest.stores++
+	if regallocCheckEnabled {
+		f.checkConsumeMemRef(parent)
+	}
+	s.clearElemCold(parent)
+	s.forestRetire(parent)
+	child.st.setLogicalRoot(true)
+	s.logicalDepth++
+}
+
+func (s *stack) forestRotateToTop(i int, e *elem) {
+	v := s.forest
+	if i < 0 || i >= len(v.roots) || v.roots[i] != e || e.forestPending {
+		panic("fixture forest: invalid root rotation")
+	}
+	if i == len(v.roots)-1 {
+		return
+	}
+	v.stores += uint64(copy(v.roots[i:], v.roots[i+1:]))
+	v.roots[len(v.roots)-1] = e
+	v.stores++
+	s.canonicalSlots = false
+	s.spilledPrefix = nil
+	s.pendingPrefix, s.pendingPrefixLoads = nil, false
+}
+
+func fixtureScalarOpcode(op byte) bool {
+	switch {
+	case op <= 0x05, op >= 0x0b && op <= 0x0d, op == 0x0f, op == 0x10, op == 0x1a, op == 0x1b,
+		op >= 0x20 && op <= 0x24, op == 0x28, op == 0x29, op >= 0x2c && op <= 0x37, op >= 0x3a && op <= 0x3e,
+		op == 0x41, op == 0x42, op >= 0x45 && op <= 0x5a, op >= 0x67 && op <= 0x8a,
+		op == 0xa7, op == 0xac, op == 0xad, op >= 0xc0 && op <= 0xc4:
+		return true
+	default:
+		return false
+	}
+}
+
+// The existing IF prefix rematerializer owns one detached recipe. Retire its
+// two proven pure leaves without discarding the recipe's child identity.
+func (f *fn) forestDetachIfRecipe(i int, root *elem) {
+	if ifPrefixLocal(root) == nil {
+		panic("fixture forest: invalid IF prefix recipe")
+	}
+	a, b := root.arg0, root.arg1
+	if root.isDeferred() {
+		f.forestRetireChildren(root)
+	}
+	f.forestEraseAt(i, root)
+	root.arg0, root.arg1 = a, b
+}
+
+func (s *stack) forestRestoreIfRecipe(root *elem) {
+	if len(s.forest.roots) != 1 || root.forestLive || root.st.hasLogicalRoot() {
+		panic("fixture forest: invalid IF prefix restore")
+	}
+	if root.isDeferred() {
+		if root.arg0 == nil || root.arg1 == nil {
+			panic("fixture forest: missing recipe leaves")
+		}
+		for _, e := range []*elem{root.arg0, root.arg1} {
+			if !e.isValue() || e.forestLive || e.st.hasLogicalRoot() {
+				panic("fixture forest: invalid recipe leaf")
+			}
+			e.forestLive = true
+		}
+	}
+	result := s.forest.roots[0]
+	root.st.setLogicalRoot(true)
+	s.logicalDepth++
+	s.forestAppend(root)
+	s.forest.roots[0], s.forest.roots[1] = root, result
+	s.forest.stores += 2
+	s.canonicalSlots = false
+	s.spilledPrefix = nil
+	s.pendingPrefix, s.pendingPrefixLoads = nil, false
+}
