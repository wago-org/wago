+	call := modFuncs(t, funcDef{[]wasm.ValType{wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, []byte{0, 0x20, 0, 0x41, 3, 0x6a, 0x20, 1, 0x20, 0, 0x10, 1, 0x6a, 0x0b}}, funcDef{[]wasm.ValType{wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, []byte{0, 0x20, 0, 0x41, 10, 0x6c, 0x20, 1, 0x6a, 0x0b}})
+	cases = append(cases, ownedModuleCase{name: "nonzero-call-reversed-args-live-prefix", module: call, args: []uint64{7, 4}, want: 57})
