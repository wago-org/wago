+func TestOwnedForestFlushPlanReentrantOrdinary(t *testing.T) {
+	for _, lane := range []string{"gp-deferred-narrow", "gp-wrapper-budget-wide", "v128-wrapper-pressure-wide"} {
+		t.Run(lane, func(t *testing.T) {
+			var original []byte
+			for _, fused := range []bool{false, true} {
+				w := &fixtureModuleWork{Forest: true, RecordNoncanonicalFlushPlan: true, FuseNoncanonicalFlushPlan: fused}
+				sc := newCompileScratch(64)
+				sc.fixtureWork = w
+				sc.ensureTargetStack()
+				f := &fn{a: &encoder.Asm{}, s: sc.stack, sc: sc, m: &wasm.Module{}, localSlot: []uint32{0}, nLocalSlots: 1, globalCellReg: regNone, memSizeReg: regNone, moduleGlobalRegionalLease: regNone, policy: currentCodegenPolicy(), fixtureTemporarySIMD: lane == "v128-wrapper-pressure-wide"}
+				f.localType = []machineType{mtI32}
+				f.locals = []localDef{{state: lsMem, reg: regNone, typ: mtI32}}
+				f.a.Push(RBX)
+				f.a.Push(RCX)
+				f.a.SubRsp(1024)
+				width, want := 0, uint64(0)
+				if lane != "v128-wrapper-pressure-wide" {
+					f.a.MovReg64(RBX, RSP)
+					f.a.MovImm32(RDI, 17)
+					f.a.Store32(RSP, 768, RDI)
+					f.a.MovImm32(RDI, 23)
+					f.a.Store32(RSP, 772, RDI)
+					f.a.MovImm32(R12, 0)
+					f.locals[0] = localDef{state: lsReg, reg: R12, typ: mtI32}
+					f.pinnedLocalMask = f.pinnedLocalMask.add(R12)
+					f.pushValue(memRefStorage(R12, 768, 4, false, false, 0))
+					f.pushValue(memRefStorage(R12, 772, 4, false, false, 0))
+					f.pushBinOp(opAdd, mtI32)
+					if !f.s.back().isDeferred() {
+						t.Fatal("missing deepest deferred root")
+					}
+					want, width = 40, 1
+					for i, r := range gpAlloc {
+						if r == R12 {
+							continue
+						}
+						f.a.MovImm32(r, int32(i+1))
+						f.pushReg(r, mtI32)
+						want += uint64(i + 1)
+						width++
+					}
+				} else {
+					// Slot 40 is outside canonical destinations. Every XMM is
+					// occupied by live later roots when the first slot reloads.
+					f.a.MovImm32(RDI, 17)
+					f.a.Store64(RSP, f.spillOff(40), RDI)
+					f.a.MovImm32(RDI, 23)
+					f.a.Store64(RSP, f.spillOff(41), RDI)
+					f.pushValue(storage{kind: stSlot, typ: mtV128, slot: 40})
+					want, width = 40, 2
+					for j := 0; j < 16; j++ {
+						lo, hi := int32(101+3*j), int32(401+7*j)
+						f.a.MovImm32(RDI, lo)
+						f.a.Store64(RSP, 768, RDI)
+						f.a.MovImm32(RDI, hi)
+						f.a.Store64(RSP, 776, RDI)
+						f.mov128LoadDisp(Reg(j), RSP, 768)
+						f.pushVReg(Reg(j))
+						want += uint64(lo + hi)
+						width += 2
+					}
+				}
+				n := len(w.Vector.roots)
+				preGP, preV128 := w.Vector.spills, w.TemporaryV128Spills
+				if lane == "gp-deferred-narrow" {
+					f.flush()
+				} else {
+					f.flushWrapper()
+				}
+				gpSpills, v128Spills := w.Vector.spills-preGP, w.TemporaryV128Spills-preV128
+				r := w.NoncanonicalFlushPlan
+				wide, narrow := uint64(0), uint64(1)
+				if lane != "gp-deferred-narrow" {
+					wide, narrow = 1, 0
+				}
+				reads, fusedPlans := uint64(2*n), uint64(0)
+				if fused {
+					reads, fusedPlans = uint64(n), 1
+				}
+				requiredSpill := gpSpills > 0 && v128Spills == 0
+				if lane == "v128-wrapper-pressure-wide" {
+					requiredSpill = v128Spills > 0 && gpSpills == 0
+				}
+				if r.Plans != 1 || r.FusedPlans != fusedPlans || r.RootVisits != reads || r.RootTypeReads != reads || r.WideRoutes != wide || r.NarrowRoutes != narrow || !requiredSpill || !canonicalSlotLayout(w.Vector.roots) {
+					t.Fatalf("flush route/actual reentrant spill absent: receipt=%+v gpSpills=%d v128Spills=%d", r, gpSpills, v128Spills)
+				}
+				// Use every canonical slot, both V128 halves included, after
+				// actual materialization. The frame was reserved up front.
+				f.a.MovImm32(RAX, 0)
+				for i := 0; i < width; i++ {
+					f.a.Load64(RDX, RSP, f.spillOff(i))
