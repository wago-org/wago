+func TestOwnedForestFlushPlanTupleOrdinary(t *testing.T) {
+	val := func(k storageKind, typ machineType, slot uint32) *elem {
+		return &elem{st: storage{kind: k, typ: typ, slot: slot}}
+	}
+	def := func(a, b *elem) *elem {
+		return &elem{st: storage{kind: deferredStorageKind, typ: mtI32}, arg0: a, arg1: b}
+	}
+	gcRoot := val(stReg, mtI64, 0)
+	gcRoot.st.setGCRoot(true)
+	v := val(stSlot, mtV128, 0)
+	for _, c := range []struct {
+		name           string
+		roots          []*elem
+		total, gp, fp  int
+		low, canonical bool
+	}{
+		{"empty", nil, 0, 0, 0, false, true},
+		{"canonical-mixed", []*elem{v, val(stSlot, mtF64, 2), val(stSlot, mtI32, 3)}, 4, 1, 2, false, true},
+		{"low-nested-child-after-v128", []*elem{v, def(val(stReg, mtI32, 0), def(val(stSlot, mtI32, 1), nil))}, 3, 1, 1, true, false},
+		{"equal-threshold-child-and-gc", []*elem{v, def(val(stSlot, mtI32, 2), nil), gcRoot}, 4, 2, 1, false, false},
+		{"low-slot-root-after-v128", []*elem{v, val(stSlot, mtI32, 1)}, 3, 1, 1, true, false},
+		{"late-custom-plan-only", []*elem{v, val(stReg, mtCustom, 0)}, 3, 1, 1, false, false},
+	} {
+		t.Run(c.name, func(t *testing.T) {
+			f := &fn{}
+			wantTypes, wantGC, total, gp, fp, low := layoutOldFlushPlan(c.roots)
+			if total != c.total || gp != c.gp || fp != c.fp || low != c.low || canonicalSlotLayout(c.roots) != c.canonical {
+				t.Fatalf("old tuple mismatch total=%d gp=%d fp=%d low=%t", total, gp, fp, low)
+			}
+			got := f.planFusedNoncanonicalFlush(c.roots)
+			if !reflect.DeepEqual(got.types, wantTypes) || !reflect.DeepEqual(got.gcRoots, wantGC) || got.total != total || got.gpValues != gp || got.fpValues != fp || got.needsStage != low {
+				t.Fatalf("new tuple=%+v types=%v gc=%v", got, wantTypes, wantGC)
+			}
+		})
+	}
+}
