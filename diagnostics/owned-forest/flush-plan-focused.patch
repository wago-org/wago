+type fixtureNoncanonicalFlushPlan struct {
+	types                     []machineType
+	gcRoots                   []bool
+	total, gpValues, fpValues int
+	needsStage                bool
+}
+
+// Both old prepasses inspect the same stable root image. No materialization
+// occurs here. In each iteration the hazard uses the preceding widths, not
+// the width after this root's eventual canonical store.
+func (f *fn) planFusedNoncanonicalFlush(roots []*elem) fixtureNoncanonicalFlushPlan {
+	plan := fixtureNoncanonicalFlushPlan{types: f.tmpFlushTypes[:0], gcRoots: f.tmpGCRoots[:0]}
+	for _, root := range roots {
+		typ := rootMachineType(root)
+		plan.gcRoots = append(plan.gcRoots, root.isValue() && root.st.hasGCRoot())
+		plan.types = append(plan.types, typ)
+		if root.isValue() && root.st.kind == stSlot && root.st.slotIndex() < plan.total ||
+			root.isDeferred() && f.flushSpillBefore(root, plan.total) {
+			plan.needsStage = true
+		}
+		if typ.isFloat() || typ.isV128() {
+			plan.fpValues++
+		} else {
+			plan.gpValues++
+		}
+		plan.total += typ.stackSlots()
+	}
+	f.tmpGCRoots = plan.gcRoots
+	return plan
+}
