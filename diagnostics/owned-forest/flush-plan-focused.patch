+// This oracle reproduces the old independent prepasses. It is used on an
+// immutable explicit root image, without reading the candidate's plan.
+func layoutOldFlushPlan(roots []*elem) (types []machineType, gc []bool, total, gp, fp int, low bool) {
+	var canonicalEnd int
+	for _, x := range roots {
+		canonicalEnd += rootMachineType(x).stackSlots()
+		gc = append(gc, x.isValue() && x.st.hasGCRoot())
+	}
+	var hazard func(*elem, int) bool
+	hazard = func(x *elem, d int) bool {
+		if x == nil || d == 0 {
+			return false
+		}
+		if x.isValue() {
+			return x.st.kind == stSlot && x.st.slotIndex() < d
+		}
+		return hazard(x.arg0, d) || hazard(x.arg1, d)
+	}
+	for _, x := range roots {
+		typ := rootMachineType(x)
+		types = append(types, typ)
+		low = hazard(x, total) || low
+		if typ.isFloat() || typ.isV128() {
+			fp++
+		} else {
+			gp++
+		}
+		total += typ.stackSlots()
+	}
+	if canonicalEnd != total {
+		panic("old flush totals disagree")
+	}
+	return
+}
