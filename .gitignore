# Go build artifacts
*.test
*.out

# Reproducibly bootstrapped development tools and local validation captures.
.tools/
.validation/

# Built CLI binaries (`just build`, `just build release`, `just build tinygo`) + release assets
/wago
/wago-engine
wago-tinygo
wago-runtime-standard-normal
wago-runtime-minimal-normal
wago-runtime-standard-tiny
wago-runtime-minimal-tiny
/wago-*-*

# Editor / OS
.DS_Store

# Local performance lab notebooks, profiles, and raw benchmark captures.
.perf/

# Locally-generated benchmark charts (published to the wago-org/docs repo)
bench/charts/

# Local benchpub output (published to wago-org/docs via scripts/publish-bench.sh)
bench/bench-out/
bench/out/

# Cached suite run from `just bench` (git-hash stamped), reused by
# `just bench render` and `just bench publish`
bench/.bench-run.txt

# Staleness marker written by benchpub: commit the charted numbers reflect + when
bench/.bench-stamp

# Coverage report rendered by scripts/coverage.sh for the PR comment
coverage-report.md

# CI info card artifacts (assembled by scripts/pr-card.sh)
ci-card/
card.md

# Per-project Wago build, cache, and local credential state
.wago/

# Claude Code ephemeral git worktrees (per-session; never committed). Excluded
# from gofmt/lint walks too — see `just lint fmt`.
.claude/worktrees/

# Local agent knowledge graphs and repository worktrees.
/graphify-out/
/.worktrees/

# Local temporary analysis and cleanup notes
/.tmp/
