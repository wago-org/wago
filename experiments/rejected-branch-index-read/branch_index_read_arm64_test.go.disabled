//go:build (linux || darwin) && arm64

package arm64

import (
	"errors"
	"testing"

	"github.com/wago-org/wago/src/core/compiler/wasm"
	enc "github.com/wago-org/wago/src/core/encoder/arm64"
	rt "github.com/wago-org/wago/src/core/runtime"
	"github.com/wago-org/wago/tests/support/wasmtest"
)

func branchIndexReadModule(t *testing.T, mask uint32, lhs bool, shape string) *wasm.Module {
	body := []byte{0}
	for range 9 {
		body = append(body, 0x02, 0x40)
	}
	if shape == "older-trap" {
		body = append(body, 0x20, 0, 0x20, 1, 0x6e)
	}
	constant := append([]byte{0x41}, wasmtest.SLEB32(int32(mask))...)
	if lhs {
		body = append(body, constant...)
	}
	body = append(body, 0x20, 0)
	if shape == "owned" {
		body = append(body, 0x41, 1, 0x6a)
	}
	if !lhs {
		if shape == "variable" {
			body = append(body, 0x20, 2)
		} else {
			body = append(body, constant...)
		}
	}
	body = append(body, 0x71, 0x0e, 8)
	for i := byte(0); i < 8; i++ {
		if shape == "duplicate" {
			body = append(body, 0)
		} else {
			body = append(body, i)
		}
	}
	body = append(body, 8)
	for i := range 9 {
		body = append(body, 0x0b, 0x20, 0, 0x41)
		body = append(body, wasmtest.SLEB32(int32(1000+i))...)
		body = append(body, 0x6a, 0x0f)
	}
	body = append(body, 0x0b)
	return mod1(t, []wasm.ValType{wasm.I32, wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, body)
}

func TestBranchIndexReadNative(t *testing.T) {
	for _, shape := range []string{"direct", "older-trap", "owned", "variable", "duplicate", "vector-off", "compact", "sink-off"} {
		for _, mask := range []uint32{0, 3, 5, 7, 15, 0x80000007, 0xffffffff} {
			for _, lhs := range []bool{false, true} {
				if shape == "variable" && lhs {
					continue
				}
				m := branchIndexReadModule(t, mask, lhs, shape)
				for _, enabled := range []bool{false, true} {
					for _, guard := range []bool{false, true} {
						for _, x := range []uint64{0, 7, 8, 17, 0xffffffff, 0xfeedface00000011} {
							var stats ModuleStats
							opts := CompileOptions{ElideBoundsChecks: guard, CompactNative: shape == "compact", Optimizations: map[string]bool{"branch-index-read": enabled, "br-table-branch-vector": shape != "vector-off", "three-op-sink": shape != "sink-off"}}
							if diagnosticsEnabled {
								opts.Stats = &stats
							}
							index := uint32(x) & mask
							if shape == "owned" {
								index = (uint32(x) + 1) & mask
							}
							if index >= 8 {
								index = 8
							} else if shape == "duplicate" {
								index = 0
							}
							got, err := runArm64WrapperWithOptions(t, m, opts, x, 1, uint64(mask))
							want := uint32(x) + 1000 + index
							if err != nil || got != uint64(want) {
								t.Fatalf("shape=%s mask=%x lhs=%v on=%v bounds=%v x=%x got=%x want=%x err=%v", shape, mask, lhs, enabled, guard, x, got, want, err)
							}
							if diagnosticsEnabled {
								admitted := enabled && !nativeCompactionEnabled && (shape == "direct" || shape == "older-trap") && enc.LogicalImmediate32(mask)
								if (stats.Funcs[0].Peephole["branch-index-read"] != 0) != admitted {
									t.Fatalf("shape=%s mask=%x on=%v stats=%v", shape, mask, enabled, stats.Funcs[0].Peephole)
								}
							}
						}
					}
				}
			}
		}
	}
}

func TestBranchIndexReadOlderTrap(t *testing.T) {
	m := branchIndexReadModule(t, 7, false, "older-trap")
	for _, enabled := range []bool{false, true} {
		for _, guard := range []bool{false, true} {
			_, err := runArm64WrapperWithOptions(t, m, CompileOptions{ElideBoundsChecks: guard, Optimizations: map[string]bool{"branch-index-read": enabled}}, 8, 0, 7)
			var trap *rt.TrapError
			if !errors.As(err, &trap) || trap.Code != rt.TrapDivZero {
				t.Fatalf("on=%v bounds=%v older trap=%v", enabled, guard, err)
			}
		}
	}
}
