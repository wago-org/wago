+//go:build arm64
+
+package arm64
+
+import (
+	"os"
+
+	enc "github.com/wago-org/wago/src/core/encoder/arm64"
+)
+
+var branchIndexReadEnabled = os.Getenv("WAGO_ARM64_EXPERIMENT_BRANCH_INDEX_READ") == "1"
+
+// Only the executable-vector consumer gives a target hint to this direct
+// i32 mask. The borrowed home stays pinned until the instruction executes;
+// a fresh owned result then follows ordinary index pinning through flush.
+// No arithmetic, memory, comparison, or non-vector sink changes lowering.
+func (f *fn) readBranchVectorIndex(e *elem) Reg {
+	if !f.opt(optThreeOpSink) || !e.isDeferred() || e.deferredOp() != opAnd || e.st.typ != mtI32 {
+		return regNone
+	}
+	source, constant := f.s.arg0(e), f.s.arg1(e)
+	if source.elemKind() == ekValue && source.st.kind == stConst {
+		source, constant = constant, source
+	}
+	if source.elemKind() != ekValue || source.st.typ != mtI32 ||
+		(source.st.kind != stLocalReg && source.st.kind != stGlobReg) ||
+		constant.elemKind() != ekValue || constant.st.kind != stConst || constant.st.typ != mtI32 ||
+		!enc.LogicalImmediate32(uint32(constant.st.cval)) {
+		return regNone
+	}
+	saved := f.pinned
+	f.pinned = f.pinned.add(source.st.reg)
+	result := f.allocReg(maskOf(source.st.reg))
+	f.a.Nop()             // preserve the discarded copy's instruction position
+	f.condense(e, result) // existing three-operand local-sink and source mapping
+	f.pinned = saved
+	f.erase(e)
+	f.stats.peep("branch-index-read")
+	return result
+}
