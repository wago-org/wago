new file mode 100644
index 00000000..78b7fde0
--- /dev/null
+++ b/src/core/compiler/backend/railshot/arm64/sign_only_if.go
@@ -0,0 +1,120 @@
+//go:build arm64
+
+package arm64
+
+import "os"
+
+var signOnlyIfEnabled = os.Getenv("WAGO_ARM64_EXPERIMENT_SIGN_ONLY_IF") == "1"
+
+// Only a consumed signed comparison whose entire truth value is the sign bit
+// is eligible. Operands are evaluated by the ordinary flags path before the
+// branch. Deferred expressions and other comparison constants stay unchanged.
+func (f *fn) signOnlyIfCondition(node *elem) bool {
+	if node == nil || !node.isDeferred() || (node.st.typ != mtI32 && node.st.typ != mtI64) {
+		return false
+	}
+	left, right := f.s.arg0(node), f.s.arg1(node)
+	if left.elemKind() != ekValue || left.st.kind == stConst ||
+		right.elemKind() != ekValue || right.st.kind != stConst {
+		return false
+	}
+	switch node.deferredOp() {
+	case opLtS, opGeS:
+		return right.st.cval == 0
+	case opLeS, opGtS:
+		return right.st.cval == -1
+	}
+	return false
+}
+
+// Only empty branch edges can consume NZCV here. Nonempty/cold edges and a
+// local.tee/CSET consumer keep the ordinary flags branch lowering.
+func (f *fn) signOnlyBranchJump(fr *ctrlFrame, cc Cond) bool {
+	switch fr.kind {
+	case cfLoop:
+		site := f.a.Bcond(cc)
+		if !f.a.PatchBranch19(site, fr.controlSite) {
+			if profileEnabled && f.stats != nil && f.stats.RecordSources {
+				f.rewindProfileEmission(site)
+			}
+			f.a.B = f.a.B[:site]
+			return false
+		}
+		f.patchSignOnlyIf(-site-2, fr.controlSite)
+		return true
+	case cfBlock, cfIf:
+		site := f.a.Bcond(cc)
+		f.appendFrameEnd(fr, -site-2, true)
+		fr.set(ctrlEndReachable, true)
+		return true
+	}
+	return false
+}
+
+// A negative if controlSite packs its pending sign-branch site as -site-2;
+// -1 remains the already-patched sentinel. No extra control-frame state is
+// needed. Emit the ordinary pair first, then change it only when its resolved
+// target fits the smaller bit-branch range. This preserves all native offsets
+// and leaves the original CMP/CMN+B.cond pair as the exact long-range fallback.
+func (f *fn) patchSignOnlyIf(encodedSite, target int) {
+	site := -encodedSite - 2
+	if !f.a.PatchBranch19(site, target) {
+		f.setRepresentationLimit(functionRepresentationBranchRange)
+		return
+	}
+	delta := target - site
+	if delta&3 != 0 || delta < -32768 || delta >= 32768 {
+		f.stats.peep("sign-only-if-range-fallback")
+		return
+	}
+	// Adjacent guard comparisons have a retained CCMP/CCMN cover. Keep their
+	// flags branches available instead of separating the chain with a bit test.
+	// Forward peers may still have unpatched targets, so use the bounded native
+	// shape rather than depending on branch patch order or destination equality.
+	if f.opt(optCommonExitCompare) && f.signBranchHasCompareNeighbor(site) {
+		f.stats.peep("sign-only-if-guard-chain-decline")
+		return
+	}
+	compare, branch := rdWord(f.a.B, site-4), rdWord(f.a.B, site)
+	cc := Cond(branch & 15)
+	negative := false
+	switch compare & 0x7ffffc1f {
+	case 0x7100001f: // CMP W/Xn,#0
+		if cc != condL && cc != condGE {
+			return
+		}
+		negative = cc == condL
+	case 0x3100041f: // CMN W/Xn,#1 (signed comparison against -1)
+		if cc != condLE && cc != condG {
+			return
+		}
+		negative = cc == condLE
+	default:
+		return
+	}
+	reg := compare >> 5 & 31
+	if reg == 31 || branch&0xff000010 != 0x54000000 {
+		return
+	}
+	bit := uint32(31)
+	if compare>>31 != 0 {
+		bit = 63
+	}
+	word := uint32(0x36000000) // TBZ: false edge when sign is clear
+	if negative {
+		word = 0x37000000 // TBNZ: false edge when sign is set
+	}
+	word |= bit>>5<<31 | (bit&31)<<19 | (uint32(delta/4)&0x3fff)<<5 | reg
+	wrWord(f.a.B, site-4, 0xd503201f)
+	wrWord(f.a.B, site, word)
+	f.stats.peep("sign-only-if")
+}
+
+func (f *fn) signBranchHasCompareNeighbor(site int) bool {
+	if site >= 12 && pureCompareWord(rdWord(f.a.B, site-12)) &&
+		rdWord(f.a.B, site-8)&0xff000010 == 0x54000000 {
+		return true
+	}
+	return site+12 <= len(f.a.B) && pureCompareWord(rdWord(f.a.B, site+4)) &&
+		rdWord(f.a.B, site+8)&0xff000010 == 0x54000000
+}
