+func TestSignOnlyIfForwardAndBackwardBranchEdges(t *testing.T) {
+	before := sharedScalarEnabled
+	sharedScalarEnabled = false
+	t.Cleanup(func() { sharedScalarEnabled = before })
+	for _, backward := range []bool{false, true} {
+		body := []byte{0}
+		if backward {
+			// The loaded negative source becomes zero on the first iteration;
+			// the next sign test exits. A negative parameter crosses the backedge.
+			body = append(body, 0x03, 0x40, 0x20, 0, 0x41, 0, 0x48, 0x41, 0, 0x21, 0, 0x0d, 0, 0x0b, 0x41, 17, 0x0b)
+		} else {
+			body = append(body, 0x41, 3, 0x21, 1, 0x02, 0x40, 0x20, 0, 0x41, 0, 0x48, 0x0d, 0, 0x41, 17, 0x21, 1, 0x0b, 0x20, 1, 0x0b)
+		}
+		m := mod1(t, []wasm.ValType{wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, body)
+		for _, enabled := range []bool{false, true} {
+			for _, input := range []uint64{0, 1, 0x80000000, 0xffffffff, 0xabcde12300000003} {
+				var stats ModuleStats
+				opts := CompileOptions{Optimizations: map[string]bool{"sign-only-if": enabled}}
+				if diagnosticsEnabled {
+					opts.Stats = &stats
+				}
+				got, err := runArm64WrapperWithOptions(t, m, opts, input, 0)
+				want := uint64(17)
+				if !backward && int32(input) < 0 {
+					want = 3
+				}
+				if err != nil || got != want {
+					t.Fatalf("backward=%v enabled=%v input=%x got=%d want=%d err=%v", backward, enabled, input, got, want, err)
+				}
+				if diagnosticsEnabled && !backward && (stats.Funcs[0].Peephole["sign-only-if"] != 0) != enabled {
+					t.Fatalf("missing forward edge admission stats=%v", stats.Funcs[0].Peephole)
+				}
+			}
+		}
+	}
+}
