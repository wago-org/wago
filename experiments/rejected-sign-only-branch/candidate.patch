+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	rt "github.com/wago-org/wago/src/core/runtime"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+)
+
+func runSignOnlyIfFixture(t *testing.T, m *wasm.Module, opts CompileOptions, args ...uint64) (uint64, error) {
+	t.Helper()
+	cm, err := CompileModuleWith(m, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cm.CodeImage != nil {
+		defer cm.CodeImage.Close()
+	}
+	eng, err := rt.NewEngine()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer eng.Close()
+	var jm *rt.JobMemory
+	if opts.ElideBoundsChecks {
+		if err := rt.InstallGuardTrapHandler(); err != nil {
+			t.Fatal(err)
+		}
+		jm, err = rt.NewJobMemoryGuarded(65536, 65536)
+	} else {
+		jm, err = rt.NewJobMemory(65536)
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer jm.Close()
+	ar, err := rt.NewArena(4096)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ar.Close()
+	code, entry, err := rt.MapCode(cm.Code)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rt.Unmap(code)
+	serArgs, results, trap := ar.Alloc(256), ar.Alloc(256), ar.Alloc(rt.TrapBufferBytes)
+	for i, arg := range args {
+		binary.LittleEndian.PutUint64(serArgs[i*8:], arg)
+	}
+	if opts.ElideBoundsChecks {
+		err = eng.CallGuarded(entry+uintptr(cm.Entry[0]), serArgs, jm.LinMemBase(), trap, results, jm)
+	} else {
+		err = eng.Call(entry+uintptr(cm.Entry[0]), serArgs, jm.LinearMemory(), trap, results)
+	}
+	return binary.LittleEndian.Uint64(results), err
+}
+
+func TestSignOnlyIfTruthSourcePreservationAndWidths(t *testing.T) {
+	before := sharedScalarEnabled
+	sharedScalarEnabled = false
+	t.Cleanup(func() { sharedScalarEnabled = before })
+	for _, wide := range []bool{false, true} {
+		typ, constOp, lt, ge, le, gt := wasm.I32, byte(0x41), byte(0x48), byte(0x4e), byte(0x4c), byte(0x4a)
+		if wide {
+			typ, constOp, lt, ge, le, gt = wasm.I64, 0x42, 0x53, 0x59, 0x57, 0x55
+		}
+		for _, tc := range []struct {
+			op       byte
+			c        int64
+			negative bool
+		}{{lt, 0, true}, {ge, 0, false}, {le, -1, true}, {gt, -1, false}} {
+			body := []byte{0, 0x20, 0, constOp}
+			body = append(body, wasmtest.SLEB64(tc.c)...)
+			body = append(body, tc.op, 0x04, 0x7f, 0x41, 17, 0x05, 0x41, 3, 0x0b, 0x20, 0)
+			if wide {
+				body = append(body, 0xa7)
+			}
+			body = append(body, 0x73, 0x0b)
+			m := mod1(t, []wasm.ValType{typ}, []wasm.ValType{wasm.I32}, body)
+			for _, enabled := range []bool{false, true} {
+				for _, guard := range []bool{false, true} {
+					for _, input := range []uint64{0, 1, 0x7fffffff, 0x80000000, 0xffffffff, 0x7fffffffffffffff, 0x8000000000000000, 0xffffffffffffffff, 0xabcde12300000003, 0x12345678ffffffff} {
+						var stats ModuleStats
+						opts := CompileOptions{ElideBoundsChecks: guard, Optimizations: map[string]bool{"sign-only-if": enabled}}
+						if diagnosticsEnabled {
+							opts.Stats = &stats
+						}
+						got, err := runArm64WrapperWithOptions(t, m, opts, input)
+						negative := int32(input) < 0
+						if wide {
+							negative = int64(input) < 0
+						}
+						arm := uint32(3)
+						if negative == tc.negative {
+							arm = 17
+						}
+						want := uint64(arm ^ uint32(input))
+						if err != nil || got != want {
+							t.Fatalf("wide=%v op=%x enabled=%v guard=%v input=%x got=%x want=%x err=%v", wide, tc.op, enabled, guard, input, got, want, err)
+						}
+						if diagnosticsEnabled && (stats.Funcs[0].Peephole["sign-only-if"] != 0) != enabled {
+							t.Fatalf("missing admission wide=%v op=%x enabled=%v stats=%v", wide, tc.op, enabled, stats.Funcs[0].Peephole)
+						}
+					}
+				}
+			}
+		}
+	}
+}
