//go:build (linux || darwin) && arm64 && wago_guardpage

package arm64

import (
	"encoding/binary"
	"errors"
	"testing"

	"github.com/wago-org/wago/src/core/compiler/wasm"
	rt "github.com/wago-org/wago/src/core/runtime"
	"github.com/wago-org/wago/tests/support/wasmtest"
)

func runSignOnlyIfFixture(t *testing.T, m *wasm.Module, opts CompileOptions, args ...uint64) (uint64, error) {
	t.Helper()
	cm, err := CompileModuleWith(m, opts)
	if err != nil {
		t.Fatal(err)
	}
	if cm.CodeImage != nil {
		defer cm.CodeImage.Close()
	}
	eng, err := rt.NewEngine()
	if err != nil {
		t.Fatal(err)
	}
	defer eng.Close()
	var jm *rt.JobMemory
	if opts.ElideBoundsChecks {
		if err := rt.InstallGuardTrapHandler(); err != nil {
			t.Fatal(err)
		}
		jm, err = rt.NewJobMemoryGuarded(65536, 65536)
	} else {
		jm, err = rt.NewJobMemory(65536)
	}
	if err != nil {
		t.Fatal(err)
	}
	defer jm.Close()
	ar, err := rt.NewArena(4096)
	if err != nil {
		t.Fatal(err)
	}
	defer ar.Close()
	code, entry, err := rt.MapCode(cm.Code)
	if err != nil {
		t.Fatal(err)
	}
	defer rt.Unmap(code)
	serArgs, results, trap := ar.Alloc(256), ar.Alloc(256), ar.Alloc(rt.TrapBufferBytes)
	for i, arg := range args {
		binary.LittleEndian.PutUint64(serArgs[i*8:], arg)
	}
	if opts.ElideBoundsChecks {
		err = eng.CallGuarded(entry+uintptr(cm.Entry[0]), serArgs, jm.LinMemBase(), trap, results, jm)
	} else {
		err = eng.Call(entry+uintptr(cm.Entry[0]), serArgs, jm.LinearMemory(), trap, results)
	}
	return binary.LittleEndian.Uint64(results), err
}

func TestSignOnlyIfTruthSourcePreservationAndWidths(t *testing.T) {
	before := sharedScalarEnabled
	sharedScalarEnabled = false
	t.Cleanup(func() { sharedScalarEnabled = before })
	for _, wide := range []bool{false, true} {
		typ, constOp, lt, ge, le, gt := wasm.I32, byte(0x41), byte(0x48), byte(0x4e), byte(0x4c), byte(0x4a)
		if wide {
			typ, constOp, lt, ge, le, gt = wasm.I64, 0x42, 0x53, 0x59, 0x57, 0x55
		}
		for _, tc := range []struct {
			op       byte
			c        int64
			negative bool
		}{{lt, 0, true}, {ge, 0, false}, {le, -1, true}, {gt, -1, false}} {
			body := []byte{0, 0x20, 0, constOp}
			body = append(body, wasmtest.SLEB64(tc.c)...)
			body = append(body, tc.op, 0x04, 0x7f, 0x41, 17, 0x05, 0x41, 3, 0x0b, 0x20, 0)
			if wide {
				body = append(body, 0xa7)
			}
			body = append(body, 0x73, 0x0b)
			m := mod1(t, []wasm.ValType{typ}, []wasm.ValType{wasm.I32}, body)
			for _, enabled := range []bool{false, true} {
				for _, guard := range []bool{false, true} {
					for _, input := range []uint64{0, 1, 0x7fffffff, 0x80000000, 0xffffffff, 0x7fffffffffffffff, 0x8000000000000000, 0xffffffffffffffff, 0xabcde12300000003, 0x12345678ffffffff} {
						var stats ModuleStats
						opts := CompileOptions{ElideBoundsChecks: guard, Optimizations: map[string]bool{"sign-only-if": enabled}}
						if diagnosticsEnabled {
							opts.Stats = &stats
						}
						got, err := runArm64WrapperWithOptions(t, m, opts, input)
						negative := int32(input) < 0
						if wide {
							negative = int64(input) < 0
						}
						arm := uint32(3)
						if negative == tc.negative {
							arm = 17
						}
						want := uint64(arm ^ uint32(input))
						if err != nil || got != want {
							t.Fatalf("wide=%v op=%x enabled=%v guard=%v input=%x got=%x want=%x err=%v", wide, tc.op, enabled, guard, input, got, want, err)
						}
						if diagnosticsEnabled && (stats.Funcs[0].Peephole["sign-only-if"] != 0) != enabled {
							t.Fatalf("missing admission wide=%v op=%x enabled=%v stats=%v", wide, tc.op, enabled, stats.Funcs[0].Peephole)
						}
					}
				}
			}
		}
	}
}

func TestSignOnlyIfTrappingOperandsStayOrdered(t *testing.T) {
	for _, olderDiv := range []bool{false, true} {
		body := []byte{0}
		if olderDiv {
			body = append(body, 0x20, 1, 0x41, 0, 0x6e)
		}
		body = append(body, 0x20, 0, 0x28, 2, 0, 0x41, 0, 0x4e, 0x04, 0x7f, 0x41, 17, 0x05, 0x41, 3, 0x0b)
		if olderDiv {
			body = append(body, 0x6a)
		}
		body = append(body, 0x0b)
		m := modMem(t, 1, []wasm.ValType{wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, body)
		for _, enabled := range []bool{false, true} {
			for _, guard := range []bool{false, true} {
				for _, address := range []uint64{0, 3, 65532, 65533, 0x80000000, 0xffffffff} {
					got, err := runSignOnlyIfFixture(t, m, CompileOptions{ElideBoundsChecks: guard, Optimizations: map[string]bool{"sign-only-if": enabled}}, address, 17)
					expected := rt.TrapCode(0)
					if olderDiv {
						expected = rt.TrapDivZero
					} else if address > 65532 {
						expected = rt.TrapLinMemOutOfBounds
					}
					if expected != 0 {
						var trap *rt.TrapError
						if !errors.As(err, &trap) || trap.Code != expected {
							t.Fatalf("older=%v enabled=%v guard=%v address=%x trap=%v want=%v", olderDiv, enabled, guard, address, err, expected)
						}
					} else if err != nil || got != 17 {
						t.Fatalf("enabled=%v guard=%v address=%x got=%d err=%v", enabled, guard, address, got, err)
					}
				}
			}
		}
	}
}

func TestSignOnlyIfForwardAndBackwardBranchEdges(t *testing.T) {
	before := sharedScalarEnabled
	sharedScalarEnabled = false
	t.Cleanup(func() { sharedScalarEnabled = before })
	for _, backward := range []bool{false, true} {
		body := []byte{0}
		if backward {
			// The loaded negative source becomes zero on the first iteration;
			// the next sign test exits. A negative parameter crosses the backedge.
			body = append(body, 0x03, 0x40, 0x20, 0, 0x41, 0, 0x48, 0x41, 0, 0x21, 0, 0x0d, 0, 0x0b, 0x41, 17, 0x0b)
		} else {
			body = append(body, 0x41, 3, 0x21, 1, 0x02, 0x40, 0x20, 0, 0x41, 0, 0x48, 0x0d, 0, 0x41, 17, 0x21, 1, 0x0b, 0x20, 1, 0x0b)
		}
		m := mod1(t, []wasm.ValType{wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, body)
		for _, enabled := range []bool{false, true} {
			for _, input := range []uint64{0, 1, 0x80000000, 0xffffffff, 0xabcde12300000003} {
				var stats ModuleStats
				opts := CompileOptions{Optimizations: map[string]bool{"sign-only-if": enabled}}
				if diagnosticsEnabled {
					opts.Stats = &stats
				}
				got, err := runArm64WrapperWithOptions(t, m, opts, input, 0)
				want := uint64(17)
				if !backward && int32(input) < 0 {
					want = 3
				}
				if err != nil || got != want {
					t.Fatalf("backward=%v enabled=%v input=%x got=%d want=%d err=%v", backward, enabled, input, got, want, err)
				}
				if diagnosticsEnabled && !backward && (stats.Funcs[0].Peephole["sign-only-if"] != 0) != enabled {
					t.Fatalf("missing forward edge admission stats=%v", stats.Funcs[0].Peephole)
				}
			}
		}
	}
}
