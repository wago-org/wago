+//go:build !tinygo
+
+package collectors
+
+import (
+	"github.com/wasmbench/wasmbench/protocol"
+	"runtime"
+)
+
+func extraGoMemoryObservations(before, after runtime.MemStats, phase, denominator string) []protocol.Observation {
+	return []protocol.Observation{
+		{Metric: "host.gc.forced_cycles", DefinitionVersion: 1, Unit: "count", Scope: "adapter_process_go_heap", Phase: phase, Collector: "runtime.ReadMemStats", CollectorVersion: runtime.Version(), Quality: "engine_reported", Profile: "memory", Denominator: denominator, Status: "available", Value: protocol.Value(float64(after.NumForcedGC - before.NumForcedGC))},
+		{Metric: "host.gc.pause_time", DefinitionVersion: 1, Unit: "ns", Scope: "adapter_process_go_heap", Phase: phase, Collector: "runtime.ReadMemStats", CollectorVersion: runtime.Version(), Quality: "engine_reported", Profile: "memory", Denominator: denominator, Status: "available", Value: protocol.Value(float64(after.PauseTotalNs - before.PauseTotalNs))},
+	}
+}
