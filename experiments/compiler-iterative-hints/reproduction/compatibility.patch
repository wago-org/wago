+//go:build tinygo
+
+package corpus
+
+import (
+	"encoding/json"
+	"github.com/wasmbench/wasmbench/protocol"
+)
+
+// Reject rather than weaken os.OpenRoot fixture confinement.
+func importWagoCommand(base, id string, raw json.RawMessage, w *protocol.Workload) error {
+	w.UnsupportedReason = "command fixture import unavailable under TinyGo: confined filesystem API unsupported"
+	return nil
+}
