+//go:build amd64
+
+package amd64
+
+import "testing"
+
+func TestDirectStructWordInitialized(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		fields []nativeGCStructAllocField
+		offset uint32
+		want   bool
+	}{
+		{"empty", nil, 0, false},
+		{"wide", []nativeGCStructAllocField{{offset: 0, size: 8}}, 0, true},
+		{"two narrow", []nativeGCStructAllocField{{offset: 0, size: 4}, {offset: 4, size: 4}}, 0, true},
+		{"low half widened", []nativeGCStructAllocField{{offset: 0, size: 4}}, 0, true},
+		{"high half", []nativeGCStructAllocField{{offset: 4, size: 4}}, 0, false},
+		{"alignment padding widened", []nativeGCStructAllocField{{offset: 0, size: 4}, {offset: 8, size: 8}}, 0, true},
+		{"after hole", []nativeGCStructAllocField{{offset: 0, size: 4}, {offset: 8, size: 8}}, 8, true},
+		{"tail", []nativeGCStructAllocField{{offset: 0, size: 8}}, 8, false},
+		{"reference pair", []nativeGCStructAllocField{{offset: 0, size: 4, ref: true}, {offset: 4, size: 4}}, 0, true},
+		{"reference padding widened", []nativeGCStructAllocField{{offset: 0, size: 4, ref: true}}, 0, true},
+		{"reference", []nativeGCStructAllocField{{offset: 0, size: 8, ref: true}}, 0, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := directStructWordInitialized(tc.fields, tc.offset); got != tc.want {
+				t.Fatalf("got%v want%v", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestDirectStructInitializerStoreSize(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		fields []nativeGCStructAllocField
+		index  int
+		want   uint32
+	}{
+		{"single", []nativeGCStructAllocField{{offset: 0, size: 4}}, 0, 8},
+		{"high neighbor", []nativeGCStructAllocField{{offset: 0, size: 4}, {offset: 4, size: 4}}, 0, 4},
+		{"high reference", []nativeGCStructAllocField{{offset: 0, size: 4}, {offset: 4, size: 4, ref: true}}, 0, 4},
+		{"high half", []nativeGCStructAllocField{{offset: 4, size: 4}}, 0, 4},
+		{"next word", []nativeGCStructAllocField{{offset: 0, size: 4}, {offset: 8, size: 8}}, 0, 8},
+		{"wide", []nativeGCStructAllocField{{offset: 0, size: 8}}, 0, 8},
+		{"reference padding", []nativeGCStructAllocField{{offset: 0, size: 4, ref: true}}, 0, 8},
+		{"reference neighbor", []nativeGCStructAllocField{{offset: 0, size: 4, ref: true}, {offset: 4, size: 4}}, 0, 4},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := directStructInitializerStoreSize(tc.fields, tc.index); got != tc.want {
+				t.Fatalf("got%d want%d", got, tc.want)
+			}
+		})
+	}
+}
