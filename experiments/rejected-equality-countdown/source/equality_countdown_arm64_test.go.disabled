//go:build (linux || darwin) && arm64

package arm64

import (
	"errors"
	"testing"

	"github.com/wago-org/wago/src/core/compiler/wasm"
	rt "github.com/wago-org/wago/src/core/runtime"
	"github.com/wago-org/wago/tests/support/wasmtest"
)

func equalityCountdownFixture(t testing.TB, step int32, counterUsed, boundUsed, escape, nested, trap bool) *wasm.Module {
	body := []byte{1, 1, 0x7f, 0x03, 0x40} // accumulator 2, loop
	if escape {
		body = append(body, 0x20, 0, 0x0d, 0)
	}
	if nested {
		body = append(body, 0x02, 0x40, 0x20, 2, 0x41, 1, 0x71, 0x0d, 0, 0x01, 0x0b)
	}
	body = append(body, 0x20, 2)
	if counterUsed {
		body = append(body, 0x20, 0)
	} else {
		body = append(body, 0x41, 7)
	}
	body = append(body, 0x6a)
	if boundUsed {
		body = append(body, 0x20, 1, 0x6a)
	}
	body = append(body, 0x21, 2)
	if trap {
		body = append(body, 0x41, 1, 0x41, 0, 0x6d, 0x1a)
	}
	body = append(body, 0x20, 1, 0x20, 0, 0x41)
	body = append(body, wasmtest.SLEB32(step)...)
	body = append(body, 0x6a, 0x22, 0, 0x47, 0x0d, 0, 0x0b)
	// Observe both original Wasm locals after the transformed loop.
	body = append(body, 0x20, 2, 0x41)
	body = append(body, wasmtest.SLEB32(65537)...)
	body = append(body, 0x6c, 0x20, 0, 0x41, 17, 0x6c, 0x73, 0x20, 1, 0x73, 0x0b)
	return mod1(t, []wasm.ValType{wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, body)
}

func TestEqualityCountdownWrapAndRestoration(t *testing.T) {
	for _, used := range []bool{false, true} {
		for _, nested := range []bool{false, true} {
			for _, guard := range []bool{false, true} {
				for _, compact := range []bool{false, true} {
					for _, tc := range []struct{ start, step, trips uint32 }{{0, 1, 7}, {0xfffffffe, 1, 4}, {0x7ffffffe, 1, 3}, {0xfffffffc, 2, 4}, {37, 4095, 3}} {
						bound, acc, counter := tc.start+tc.step*tc.trips, uint32(0), tc.start
						for range tc.trips {
							if used {
								acc += counter
							} else {
								acc += 7 + bound
							}
							counter += tc.step
						}
						want := uint64(acc*65537 ^ counter*17 ^ bound)
						for _, enabled := range []bool{false, true} {
							var stats ModuleStats
							opts := CompileOptions{CompactNative: compact, ElideBoundsChecks: guard, Optimizations: map[string]bool{"equality-countdown": enabled}}
							if diagnosticsEnabled {
								opts.Stats = &stats
							}
							got, err := runArm64WrapperWithOptions(t, equalityCountdownFixture(t, int32(tc.step), used, !used, false, nested, false), opts, uint64(tc.start), uint64(bound))
							if err != nil || got != want {
								t.Fatalf("used=%v nested=%v guard=%v compact=%v enabled=%v case=%+v got=%x want=%x err=%v", used, nested, guard, compact, enabled, tc, got, want, err)
							}
							wantAdmission := enabled && !used
							if diagnosticsEnabled && (stats.Funcs[0].Peephole["equality-countdown"] != 0) != wantAdmission {
								t.Fatalf("missing admission %+v", stats.Funcs[0].Peephole)
							}
						}
					}
				}
			}
		}
	}
}

func TestEqualityCountdownDoWhileTrapAndRejects(t *testing.T) {
	for _, used := range []bool{false, true} {
		for _, enabled := range []bool{false, true} {
			_, err := runArm64WrapperWithOptions(t, equalityCountdownFixture(t, 1, used, false, false, false, true), CompileOptions{Optimizations: map[string]bool{"equality-countdown": enabled}}, uint64(0xffffffff), uint64(0xffffffff))
			var trap *rt.TrapError
			if !errors.As(err, &trap) || trap.Code != rt.TrapDivZero {
				t.Fatalf("used=%v enabled=%v err=%v", used, enabled, err)
			}
		}
	}
	if !diagnosticsEnabled {
		return
	}
	for _, tc := range []struct {
		name                               string
		step                               int32
		used, bound, escape, interruptible bool
	}{
		{"counter observed", 1, true, false, false, false},
		{"both homes observed", 1, true, true, false, false},
		{"extra backedge", 1, true, false, true, false},
		{"zero step", 0, false, false, false, false},
		{"interruptible", 1, false, false, false, true},
	} {
		t.Run(tc.name, func(t *testing.T) {
			var stats ModuleStats
			cm, err := CompileModuleWith(equalityCountdownFixture(t, tc.step, tc.used, tc.bound, tc.escape, false, false), CompileOptions{Stats: &stats, Interruptible: tc.interruptible, Optimizations: map[string]bool{"equality-countdown": true}})
			if err != nil {
				t.Fatal(err)
			}
			if cm.CodeImage != nil {
				cm.CodeImage.Close()
			}
			if stats.Funcs[0].Peephole["equality-countdown"] != 0 {
				t.Fatalf("unsafe admission %v", stats.Funcs[0].Peephole)
			}
		})
	}
}

func TestEqualityCountdownOlderOperandDeclines(t *testing.T) {
	body := []byte{1, 1, 0x7f, 0x41, 0xfb, 0, 0x03, 0x40, 0x20, 2, 0x41, 7, 0x6a, 0x21, 2,
		0x20, 1, 0x20, 0, 0x41, 1, 0x6a, 0x22, 0, 0x47, 0x0d, 0, 0x0b,
		0x20, 2, 0x20, 0, 0x73, 0x20, 1, 0x73, 0x6a, 0x0b}
	for _, enabled := range []bool{false, true} {
		var stats ModuleStats
		opts := CompileOptions{Optimizations: map[string]bool{"equality-countdown": enabled}}
		if diagnosticsEnabled {
			opts.Stats = &stats
		}
		got, err := runArm64WrapperWithOptions(t, mod1(t, []wasm.ValType{wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, body), opts, 0, 7)
		if err != nil || got != 172 {
			t.Fatalf("enabled=%v got=%d err=%v", enabled, got, err)
		}
		if diagnosticsEnabled && stats.Funcs[0].Peephole["equality-countdown"] != 0 {
			t.Fatal("older operand was admitted")
		}
	}
}
