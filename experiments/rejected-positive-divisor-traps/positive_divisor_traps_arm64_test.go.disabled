//go:build (linux || darwin) && arm64

package arm64

import (
	"errors"
	"github.com/wago-org/wago/src/core/compiler/wasm"
	rt "github.com/wago-org/wago/src/core/runtime"
	"testing"
)

func positiveDivisorLoopFixture(t testing.TB, wide bool, badBackedge bool) *wasm.Module {
	return positiveDivisorLoopFixtureWithInit(t, wide, badBackedge, 16)
}

func positiveDivisorLoopFixtureWithInit(t testing.TB, wide, badBackedge bool, initial int) *wasm.Module {
	return positiveDivisorLoopFixtureWithResult(t, wide, badBackedge, initial, false)
}

func positiveDivisorLoopFixtureWithResult(t testing.TB, wide, badBackedge bool, initial int, extend bool) *wasm.Module {
	typ, con, add, div, gt := wasm.I32, byte(0x41), byte(0x6a), byte(0x6d), byte(0x4a)
	if wide {
		typ, con, add, div, gt = wasm.I64, 0x42, 0x7c, 0x7f, 0x55
	}
	localCode := byte(0x7f)
	if wide {
		localCode = 0x7e
	}
	body := []byte{2, 2, localCode, 1, 0x7f, con, 16, 0x21, 2, // divisor initialized positive
		0x02, 0x40, 0x20, 1, 0x45, 0x0d, 0, 0x03, 0x40,
		0x20, 0, 0x20, 2, div, 0x21, 3,
		0x20, 2, con, 0x7f, add, 0x22, 2, con, 1, 0x20, 2, con, 1, gt, 0x1b, 0x21, 2}
	if initial == 128 {
		body[5], body[6] = 0x20, 0
	} else {
		body[6] = byte(initial) & 0x7f
	}
	if badBackedge {
		body = append(body, con, 0, 0x21, 2)
	}
	body = append(body, 0x20, 4, 0x41, 1, 0x6a, 0x22, 4, 0x20, 1, 0x49, 0x0d, 0, 0x0b, 0x0b, 0x20, 3)
	result := typ
	if extend {
		body = append(body, 0xad)
		result = wasm.I64
	}
	body = append(body, 0x0b)
	return modMem(t, 1, []wasm.ValType{typ, wasm.I32}, []wasm.ValType{result}, body)
}

func TestPositiveDivisorLoopNative(t *testing.T) {
	for _, wide := range []bool{false, true} {
		for _, bad := range []bool{false, true} {
			m := positiveDivisorLoopFixture(t, wide, bad)
			for _, enabled := range []bool{false, true} {
				for _, borrowed := range []bool{false, true} {
					for _, guard := range []bool{false, true} {
						for _, trips := range []uint64{0, 1, 2, 16, 32} {
							for _, x := range []uint64{0, 1, 37, 0xffffffff, 0x80000000, 0x8000000000000000, ^uint64(0)} {
								opts := CompileOptions{ElideBoundsChecks: guard, Optimizations: map[string]bool{"positive-divisor-traps": enabled, "borrowed-div-rem": borrowed}}
								var stats ModuleStats
								if diagnosticsEnabled && x == 37 && trips == 32 {
									opts.Stats = &stats
								}
								got, err := runArm64WrapperWithOptions(t, m, opts, x, trips)
								if bad && trips > 1 {
									var te *rt.TrapError
									if !errors.As(err, &te) || te.Code != rt.TrapDivZero {
										t.Fatalf("zero trap removed wide=%v enabled=%v borrowed=%v guard=%v err=%v", wide, enabled, borrowed, guard, err)
									}
									continue
								}
								dividend := int64(x)
								if !wide {
									dividend = int64(int32(x))
								}
								divisor := int64(16) - int64(trips) + 1
								if divisor < 1 {
									divisor = 1
								}
								want := int64(0)
								if trips != 0 {
									want = dividend / divisor
								}
								if !wide {
									got = uint64(uint32(got))
									want = int64(uint32(want))
								}
								if err != nil || got != uint64(want) {
									t.Fatalf("wide=%v bad=%v enabled=%v borrowed=%v guard=%v x=%x trips=%d got=%x want=%x err=%v", wide, bad, enabled, borrowed, guard, x, trips, got, uint64(want), err)
								}
								if opts.Stats != nil {
									wantHit := enabled && !bad
									for _, key := range []string{"positive-divisor-zero", "positive-divisor-overflow"} {
										if (stats.Funcs[0].Peephole[key] != 0) != wantHit {
											t.Fatalf("wide=%v bad=%v enabled=%v borrowed=%v guard=%v key=%s peeps=%v", wide, bad, enabled, borrowed, guard, key, stats.Funcs[0].Peephole)
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

func TestPositiveDivisorWidthTransfer(t *testing.T) {
	// Independent machine-word goldens: MOVZ W9,#1, MOVZ X9,#1,
	// MOVZ X9,#1,LSL #32, MOVZ W9,#0x8000,LSL #16, MOV W10,W9,
	// MOV X10,X9 and MOVK W9,#0. W and X signs must never be conflated.
	for _, tc := range []struct {
		word     uint32
		in, want uint64
	}{
		{0x52800029, 0, positiveWritten(9, false)},
		{0xd2800029, 0, positiveWritten(9, false)},
		{0xd2c00029, 0, positiveBit(9, true)},
		{0x52b00009, 0, 0},
		{0x2a0903ea, positiveBit(9, false), positiveBit(9, false) | positiveWritten(10, false)},
		{0xaa0903ea, positiveBit(9, true), positiveBit(9, true) | positiveBit(10, true)},
		{0xaa0903ea, positiveBit(9, false), positiveBit(9, false) | positiveBit(10, false)},
		{0x72800009, positiveWritten(9, false), 0},
		{0xffffffff, positiveWritten(9, false), 0},
	} {
		if got := positiveTransfer(tc.word, tc.in, 0); got != tc.want {
			t.Fatalf("word=%08x in=%x got=%x want=%x", tc.word, tc.in, got, tc.want)
		}
	}
}

func TestPositiveDivisorClampsAndUnknownEntries(t *testing.T) {
	for _, wide := range []bool{false, true} {
		for _, cond := range []uint32{12, 13} {
			for _, k := range []uint32{0, 1, 17, 4095} {
				bits := uint32(0)
				if wide {
					bits = 1 << 31
				}
				mov := uint32(0xd2800009) | k<<5
				cmp := bits | 0x7100001f | 19<<5 | k<<10
				a, c := uint32(9), uint32(19)
				if cond == 12 {
					a, c = c, a
				}
				csel := bits | 0x1a800000 | c<<16 | cond<<12 | a<<5 | 19
				b := make([]byte, 12)
				wrWord(b, 0, mov)
				wrWord(b, 4, cmp)
				wrWord(b, 8, csel)
				for _, entry := range []int{-1, 0, 4, 8} {
					entries := []int{}
					if entry >= 0 {
						entries = append(entries, entry)
					}
					got := positiveClamp(b, 8, []uint64{0}, entries)
					want := uint64(0)
					if k != 0 && (entry < 4) {
						want = positiveWritten(19, wide)
					}
					if got != want {
						t.Fatalf("wide=%v cond=%d k=%d entry=%d got=%x want=%x", wide, cond, k, entry, got, want)
					}
				}
				for _, target := range []int{4, 8} {
					if got := positiveClamp(b, 8, []uint64{1 << uint(target/4)}, nil); got != 0 {
						t.Fatal("clamp accepts incoming edge into constant/flags region")
					}
				}
			}
		}
	}
}

func TestPositiveDivisorUnknownInitialization(t *testing.T) {
	for _, wide := range []bool{false, true} {
		for _, initial := range []int{0, -1, 128} {
			m := positiveDivisorLoopFixtureWithInit(t, wide, false, initial)
			for _, guard := range []bool{false, true} {
				for _, enabled := range []bool{false, true} {
					for _, trips := range []uint64{0, 1, 2, 32} {
						for _, x := range []uint64{0, 37, 0xffffffff, 0x80000000, 0x8000000000000000, ^uint64(0)} {
							opts := CompileOptions{ElideBoundsChecks: guard, Optimizations: map[string]bool{"positive-divisor-traps": enabled}}
							var stats ModuleStats
							if diagnosticsEnabled {
								opts.Stats = &stats
							}
							got, err := runArm64WrapperWithOptions(t, m, opts, x, trips)
							n := int64(x)
							if !wide {
								n = int64(int32(x))
							}
							d := int64(initial)
							if initial == 128 {
								d = n
							}
							want := int64(0)
							trap := rt.TrapCode(0)
							for i := uint64(0); i < trips; i++ {
								if d == 0 {
									trap = rt.TrapDivZero
									break
								}
								if d == -1 && (wide && n == -1<<63 || !wide && n == -1<<31) {
									trap = rt.TrapDivOverflow
									break
								}
								want = n / d
								d--
								if !wide {
									d = int64(int32(d))
								}
								if d < 1 {
									d = 1
								}
							}
							if trap != 0 {
								var te *rt.TrapError
								if !errors.As(err, &te) || te.Code != trap {
									t.Fatalf("wide=%v init=%d x=%x trips=%d enabled=%v err=%v wanttrap=%d", wide, initial, x, trips, enabled, err, trap)
								}
							} else {
								if !wide {
									want = int64(uint32(want))
									got = uint64(uint32(got))
								}
								if err != nil || got != uint64(want) {
									t.Fatalf("wide=%v init=%d x=%x trips=%d enabled=%v got=%x want=%x err=%v", wide, initial, x, trips, enabled, got, uint64(want), err)
								}
							}
							if opts.Stats != nil && (stats.Funcs[0].Peephole["positive-divisor-zero"] != 0 || stats.Funcs[0].Peephole["positive-divisor-overflow"] != 0) {
								t.Fatalf("unknown/negative initializer admitted facts: %v", stats.Funcs[0].Peephole)
							}
						}
					}
				}
			}
		}
	}
}

func TestPositiveDivisorOneResultCanonicalizesI32(t *testing.T) {
	m := positiveDivisorLoopFixtureWithResult(t, false, false, 16, true)
	for _, guard := range []bool{false, true} {
		for _, borrowed := range []bool{false, true} {
			for _, enabled := range []bool{false, true} {
				for _, x := range []uint64{0, 1, 0x1234567800000001, 0x1234567880000000, ^uint64(0)} {
					var stats ModuleStats
					opts := CompileOptions{ElideBoundsChecks: guard, Optimizations: map[string]bool{"positive-divisor-traps": enabled, "borrowed-div-rem": borrowed}}
					if diagnosticsEnabled {
						opts.Stats = &stats
					}
					got, err := runArm64WrapperWithOptions(t, m, opts, x, 32)
					if err != nil || got != uint64(uint32(x)) {
						t.Fatalf("guard=%v borrowed=%v enabled=%v x=%x got=%x want=%x err=%v", guard, borrowed, enabled, x, got, uint64(uint32(x)), err)
					}
					if diagnosticsEnabled && positiveDivisorOneEnabled && (stats.Funcs[0].Peephole["positive-divisor-one"] != 0) != enabled {
						t.Fatalf("identity case fixture not admitted: %v", stats.Funcs[0].Peephole)
					}
				}
			}
		}
	}
}

func TestPositiveDivisorExplicitCompaction(t *testing.T) {
	for _, wide := range []bool{false, true} {
		for _, guard := range []bool{false, true} {
			for _, borrowed := range []bool{false, true} {
				for _, x := range []uint64{37, ^uint64(0)} {
					m := positiveDivisorLoopFixture(t, wide, false)
					var stats ModuleStats
					opts := CompileOptions{CompactNative: true, ElideBoundsChecks: guard, Optimizations: map[string]bool{"positive-divisor-traps": true, "borrowed-div-rem": borrowed}}
					if diagnosticsEnabled {
						opts.Stats = &stats
					}
					got, err := runArm64WrapperWithOptions(t, m, opts, x, 32)
					want := x
					if !wide {
						want = uint64(uint32(want))
						got = uint64(uint32(got))
					}
					if err != nil || got != want {
						t.Fatalf("wide=%v guard=%v borrowed=%v x=%x got=%x want=%x err=%v", wide, guard, borrowed, x, got, want, err)
					}
					if opts.Stats != nil && stats.Funcs[0].Peephole["positive-divisor-zero"] == 0 {
						t.Fatalf("explicit compact fixture does not exercise proof: %v", stats.Funcs[0].Peephole)
					}
				}
			}
		}
	}
}
