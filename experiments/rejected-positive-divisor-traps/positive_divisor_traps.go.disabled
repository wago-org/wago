//go:build arm64

package arm64

import (
	"github.com/wago-org/wago/src/core/compiler/backend/railshot/shared"
	"os"
)

var positiveDivisorOneEnabled = os.Getenv("WAGO_ARM64_POSITIVE_DIVISOR_ONE") == "1"

var positiveDivisorShrinkEnabled = os.Getenv("WAGO_ARM64_POSITIVE_DIVISOR_SHRINK") == "1"

var positiveDivisorTrapsEnabled = os.Getenv("WAGO_ARM64_EXPERIMENT_POSITIVE_DIVISOR_TRAPS") == "1"

// A fact bit means the signed W/X value is strictly positive on every incoming
// path. The high half holds X facts; a proved-positive W write proves both.
func positiveBit(reg uint32, wide bool) uint64 {
	if reg == 31 {
		return 0
	}
	if wide {
		reg += 32
	}
	return uint64(1) << reg
}

func positiveWritten(reg uint32, wide bool) uint64 {
	bit := positiveBit(reg, wide)
	if !wide {
		bit |= positiveBit(reg, true)
	}
	return bit
}

func positiveMovZ(w uint32) (uint32, uint64, bool) {
	if w&0x7f800000 != 0x52800000 {
		return 0, 0, false
	}
	rd := w & 31
	v := uint64(w>>5&0xffff) << (16 * (w >> 21 & 3))
	wide := w>>31 != 0
	if v == 0 || (!wide && (v >= 1<<31 || w&(1<<22) != 0)) || wide && v >= 1<<63 {
		return rd, 0, true
	}
	bits := positiveWritten(rd, wide)
	if wide && v < 1<<31 {
		bits |= positiveBit(rd, false)
	}
	return rd, bits, true
}

// The adjacent MOVZ; CMP #k; CSEL clamp is an instruction-level proof of
// max_signed(value,k), k>0. Excluding entries after MOVZ proves both the constant
// and NZCV reach CSEL unchanged. Other CSEL forms only intersect source facts.
func positiveClamp(b []byte, pc int, targets []uint64, entries []int) uint64 {
	if pc < 8 || branchTargeted(targets, pc) || branchTargeted(targets, pc-4) {
		return 0
	}
	for _, e := range entries {
		if e == pc || e == pc-4 {
			return 0
		}
	}
	w, cmp, mov := rdWord(b, pc), rdWord(b, pc-4), rdWord(b, pc-8)
	if w&0x7fe00c00 != 0x1a800000 || cmp&0x7f00001f != 0x7100001f || cmp&(1<<22) != 0 {
		return 0
	}
	k := cmp >> 10 & 0xfff
	if k == 0 {
		return 0
	}
	constant, _, ok := positiveMovZ(mov)
	if !ok || mov&(3<<21) != 0 || mov>>5&0xffff != k {
		return 0
	}
	wide := w>>31 != 0
	if (w^cmp)&0x80000000 != 0 || wide && mov>>31 == 0 {
		return 0
	}
	x, a, c, cond := cmp>>5&31, w>>5&31, w>>16&31, w>>12&15
	if x == 31 || (cond != 13 || a != constant || c != x) && (cond != 12 || a != x || c != constant) {
		return 0
	}
	return positiveWritten(w&31, wide)
}

// Unknown instructions erase all facts. The recognized families either write
// exactly Rd or no GPR; stores with writeback and load pairs deliberately decline.
func positiveTransfer(w uint32, incoming, clamp uint64) uint64 {
	if w == nopWord || w&0xff000010 == 0x54000000 || w&0xfc000000 == 0x14000000 ||
		w&0x7e000000 == 0x34000000 || w&0x7e000000 == 0x36000000 || w&0x1fe00000 == 0x1a400000 {
		return incoming
	}
	wide, rd := w>>31 != 0, w&31
	kill := positiveBit(rd, false) | positiveBit(rd, true)
	if _, facts, ok := positiveMovZ(w); ok {
		return incoming&^kill | facts
	}
	// ORR Rd,ZR,Rm,LSL #0 is MOV; W writes canonicalize the X value.
	if w&0x7fe0ffe0 == 0x2a0003e0 {
		src := w >> 16 & 31
		facts := uint64(0)
		if incoming&positiveBit(src, wide) != 0 {
			facts |= positiveWritten(rd, wide)
		}
		if wide && incoming&positiveBit(src, false) != 0 {
			facts |= positiveBit(rd, false)
		}
		return incoming&^kill | facts
	}
	if w&0x7fe00c00 == 0x1a800000 {
		facts := clamp
		if incoming&positiveBit(w>>5&31, wide) != 0 && incoming&positiveBit(w>>16&31, wide) != 0 {
			facts |= positiveWritten(rd, wide)
		}
		return incoming&^kill | facts
	}
	if w&0x1f000000 == 0x11000000 || w&0x1f000000 == 0x0b000000 || w&0x1f000000 == 0x0a000000 ||
		w&0x1f800000 == 0x12000000 || w&0x1f800000 == 0x12800000 || w&0x1f800000 == 0x13000000 ||
		w&0x1f000000 == 0x1b000000 || w&0x1fe00000 == 0x1ac00000 || w&0x5fe00000 == 0x5ac00000 {
		return incoming &^ kill
	}
	if w&0x3b000000 == 0x39000000 || w&0x3b20fc00 == 0x38206800 {
		if w&(1<<26) != 0 {
			return incoming
		} // FP/SIMD memory instruction has no GPR destination.
		if w>>22&3 == 0 {
			return incoming
		} // plain scalar store, no writeback
		return incoming &^ kill
	}
	return 0
}

// Greatest-fixed-point must analysis is bounded to 1K native words, 128
// basic blocks and 64 scans. Entry facts start unknown; every other block starts
// at top and descends. No rewrite occurs until every CFG edge is stable.
func (f *fn) foldPositiveDivisorTraps(b []byte, n int, targets []uint64, entries ...int) {
	sc := f.scratchState()
	if n > 4096 || n < 8 || f.makesCalls || f.usesCalls || f.moduleEH || f.opaqueFragments || len(f.customInstructions) != 0 || len(sc.trapSites[trapDivZero]) == 0 {
		return
	}
	// The first RET after every advertised entry ends the ordinary body only
	// if no normal edge leaves that region. Registered trap exits are terminal
	// and cannot contribute an incoming value to a later Wasm instruction.
	bodyStart := 0
	for _, entry := range entries {
		if entry < 0 || entry >= n || entry&3 != 0 {
			return
		}
		bodyStart = max(bodyStart, entry)
	}
	bodyEnd := n
	for pc := bodyStart; pc < n; pc += 4 {
		if rdWord(b, pc)&0xfffffc1f == 0xd65f0000 {
			bodyEnd = pc + 4
			break
		}
	}
	isTrapExit := func(pc int) bool {
		for _, sites := range sc.trapSites {
			for _, site := range sites {
				if int(site.branch&^1) == pc {
					return true
				}
			}
		}
		return false
	}
	for pc := 0; pc < bodyEnd; pc += 4 {
		w := rdWord(b, pc)
		if to, ok := branchTarget(pc, w); ok && w&0xfc000000 != 0x94000000 && (to < 0 || to >= bodyEnd) && !isTrapExit(pc) {
			return
		}
	}
	n = bodyEnd
	// A positive clamp is the profitable source of a recurrent divisor proof.
	// Constant-only bodies retain their existing strength reduction.
	seed := uint64(0)
	for pc := 8; pc < n; pc += 4 {
		if rdWord(b, pc)&0x7fe00c00 == 0x1a800000 && positiveClamp(b, pc, targets, entries) != 0 {
			clamp := rdWord(b, pc)
			seed = positiveBit(clamp&31, clamp>>31 != 0)
			break
		}
	}
	if seed == 0 {
		return
	}
	const top = uint8(1)
	type block struct{ begin, end, target, next uint16 }
	var blocks [128]block
	var blockAt [1024]uint8
	var state [128]uint8
	var transfer [128]uint8
	count := 0
	for pc := 0; pc < n; pc += 4 {
		start := pc == 0 || branchTargeted(targets, pc)
		for _, entry := range entries {
			if entry < 0 || entry >= n || entry&3 != 0 {
				return
			}
			start = start || entry == pc
		}
		if pc > 0 {
			prev := rdWord(b, pc-4)
			_, branch := branchTarget(pc-4, prev)
			start = start || branch || prev&0xfffffc1f == 0xd65f0000 || prev&0xfffffc1f == 0xd61f0000
		}
		if start {
			if count == len(blocks) {
				return
			}
			if count > 0 {
				blocks[count-1].end = uint16(pc)
			}
			blocks[count].begin = uint16(pc)
			state[count] = top
			count++
		}
		blockAt[pc/4] = uint8(count - 1)
	}
	blocks[count-1].end = uint16(n)
	state[0] = 0
	for _, pc := range entries {
		state[blockAt[pc/4]] = 0
	}
	for i := 0; i < count; i++ {
		bl := &blocks[i]
		bl.target = uint16(count)
		bl.next = uint16(count)
		pc := int(bl.end) - 4
		w := rdWord(b, pc)
		if to, ok := branchTarget(pc, w); ok && w&0xfc000000 != 0x94000000 {
			if to < 0 || to&3 != 0 {
				return
			}
			if to < n {
				bl.target = uint16(blockAt[to/4])
			} else if !isTrapExit(pc) {
				return
			}
		}
		terminal := w&0xfc000000 == 0x14000000 || w&0xfffffc1f == 0xd65f0000 || w&0xfffffc1f == 0xd61f0000
		if !terminal && i+1 < count {
			bl.next = uint16(i + 1)
		}
	}
	// Only the clamp destination is recurrently tracked. Every block is
	// summarized as preserve / kill / generate, so fixed-point rounds never
	// decode instructions. Copies within a guard's block are proved afterward.
	for i := 0; i < count; i++ {
		transfer[i] = 2
		for pc := int(blocks[i].begin); pc < int(blocks[i].end); pc += 4 {
			w := rdWord(b, pc)
			clamp := uint64(0)
			if w&0x7fe00c00 == 0x1a800000 {
				clamp = positiveClamp(b, pc, targets, entries)
			}
			if clamp&seed != 0 {
				transfer[i] = 1
				continue
			}
			if _, facts, ok := positiveMovZ(w); ok && facts&seed != 0 {
				transfer[i] = 1
				continue
			}
			if positiveTransfer(w, seed, 0)&seed == 0 {
				transfer[i] = 0
			}
		}
	}
	stable := false
	for round := 0; round < 64; round++ {
		changed := false
		for i := 0; i < count; i++ {
			bl := blocks[i]
			out := state[i]
			if transfer[i] != 2 {
				out = transfer[i]
			}
			for _, to := range [2]uint16{bl.target, bl.next} {
				if int(to) < count {
					next := state[to] & out
					if next != state[to] {
						state[to] = next
						changed = true
					}
				}
			}
		}
		if !changed {
			stable = true
			break
		}
	}
	if !stable {
		return
	}
	for _, site := range sc.trapSites[trapDivZero] {
		pc := int(site.branch)
		if site.function != f.traceFuncIdx || pc < 4 || pc+4 > n || site.branch&3 != 0 || branchTargeted(targets, pc) {
			continue
		}
		cmp, br := rdWord(b, pc-4), rdWord(b, pc)
		if cmp&0x7ffffc1f != 0x7100001f || br&0xff00001f != 0x54000000 {
			continue
		}
		for _, e := range entries {
			if e == pc {
				br = 0
			}
		}
		if br == 0 {
			continue
		}
		wide, divisor := cmp>>31 != 0, cmp>>5&31
		if positiveBefore(b, int(blocks[blockAt[(pc-4)/4]].begin), pc-4, uint64(state[blockAt[(pc-4)/4]])*seed, targets, entries)&positiveBit(divisor, wide) == 0 {
			continue
		}
		// Leave CMP unchanged: output NZCV is exactly the original successful path.
		wrWord(b, pc, nopWord)
		f.recordPositiveDivisorHole(pc)
		f.stats.peep("positive-divisor-zero")
		start := pc + 4
		if start+8 > n {
			continue
		}
		cmn, skip := rdWord(b, start), rdWord(b, start+4)
		if cmn != (cmp^0x40000000)|0x400 || skip&0xff00001f != 0x54000001 {
			continue
		}
		to, ok := branchTarget(start+4, skip)
		if !ok || to <= start+8 || to > start+32 || to+4 > n {
			continue
		}
		div := rdWord(b, to)
		if div&0x7fe0fc00 != 0x1ac00c00 || div>>16&31 != divisor || (div^cmp)&0x80000000 != 0 || !deadFlagsPath(b, to+4, n) {
			continue
		}
		overflow := false
		for _, s := range sc.trapSites[trapDivOverflow] {
			if s.branch == uint32(to-4) && s.function == site.function {
				overflow = true
			}
		}
		if !overflow {
			continue
		}
		valid := true
		for q := start; q < to; q += 4 {
			if branchTargeted(targets, q) {
				valid = false
			}
			for _, e := range entries {
				if e == q {
					valid = false
				}
			}
			if q > start+4 && q < to-4 {
				w := rdWord(b, q)
				if !pureCompareWord(w) && (w&0x1f800000 != 0x12800000 || w&31 != 16) {
					valid = false
				}
			}
		}
		if !valid {
			continue
		}

		if positiveDivisorOneEnabled && to-pc >= 12 {
			// A proved positive divisor has one common identity case: n/1=n.
			// Both this copy path and ordinary SDIV preserve all operand GPRs.
			wrWord(b, pc-4, cmp|1<<10)
			wrWord(b, pc, 0x54000001|(uint32((to-pc)/4)&0x7ffff)<<5)
			wrWord(b, pc+4, (div&0x80000000)|0x2a0003e0|(div>>5&31)<<16|div&31)
			wrWord(b, pc+8, 0x14000000|(uint32((to+4-(pc+8))/4)&0x3ffffff))
			branchTargetAdd(targets, to+4, n)
			// The earlier zero branch is now the non-one test, so it cannot
			// remain in the hole inventory.
			holes := sc.deadHoleSites[:sc.deadHoleN]
			kept := 0
			for _, off := range holes {
				if off < pc-4 || off >= to {
					sc.deadHoleSites[kept] = off
					kept++
				}
			}
			sc.deadHoleN = uint8(kept)
			for q := pc + 12; q < to; q += 4 {
				wrWord(b, q, nopWord)
				f.recordPositiveDivisorHole(q)
			}
			f.stats.peep("positive-divisor-overflow")
			f.stats.peep("positive-divisor-one")
			continue
		}
		for q := start; q < to; q += 4 {
			wrWord(b, q, nopWord)
			f.recordPositiveDivisorHole(q)
		}
		// Once the whole overflow guard is dead, its incoming zero-test flags
		// are dead too. Do not remove a separately reachable CMP.
		if !branchTargeted(targets, pc-4) {
			entry := false
			for _, e := range entries {
				entry = entry || e == pc-4
			}
			if !entry {
				wrWord(b, pc-4, nopWord)
				f.recordPositiveDivisorHole(pc - 4)
			}
		}
		f.stats.peep("positive-divisor-overflow")
	}
}

func positiveBefore(b []byte, start, end int, facts uint64, targets []uint64, entries []int) uint64 {
	for pc := start; pc < end; pc += 4 {
		w := rdWord(b, pc)
		clamp := uint64(0)
		if w&0x7fe00c00 == 0x1a800000 {
			clamp = positiveClamp(b, pc, targets, entries)
		}
		facts = positiveTransfer(w, facts, clamp)
	}
	return facts
}

func (f *fn) recordPositiveDivisorHole(pc int) {
	if !positiveDivisorShrinkEnabled || !nativeFinalizerEnabled || nativeCompactionDisabled {
		return
	}
	if f.compactNative() {
		f.recordDeadHole(pc)
		return
	}
	sc := f.scratchState()
	if int(sc.deadHoleN) == len(sc.deadHoleSites) {
		sc.deadHoleOverflow = true
		return
	}
	sc.deadHoleSites[sc.deadHoleN] = pc
	sc.deadHoleN++
	f.positiveDivisorShrink = true
	if nativeFinalizerValidate {
		f.recordFinalizerMarker(pc, markerDeadHole)
	}
}

// Only the proven trap holes shrink. Existing frame reservations and all native
// entry/loop alignments remain untouched; the common offset mapper repatches
// branches, source ranges and other registered metadata.
func (f *fn) buildPositiveDivisorPlan(deletions []shared.DeletedRange) ([]shared.DeletedRange, int, bool) {
	sc := f.scratchState()
	if sc.deadHoleOverflow || int(sc.deadHoleN) > cap(deletions) {
		return f.rejectCompaction("positive-divisor-hole-budget")
	}
	for _, pc := range sc.deadHoleSites[:sc.deadHoleN] {
		if rdWord(f.a.B, pc) != nopWord {
			return f.rejectCompaction("positive-divisor-hole-word")
		}
		deletions = append(deletions, shared.DeletedRange{Off: uint32(pc), Len: 4})
	}
	for i := 1; i < len(deletions); i++ {
		v := deletions[i]
		j := i
		for j > 0 && deletions[j-1].Off > v.Off {
			deletions[j] = deletions[j-1]
			j--
		}
		deletions[j] = v
	}
	for i := 1; i < len(deletions); i++ {
		if deletions[i].Off == deletions[i-1].Off {
			return f.rejectCompaction("positive-divisor-hole-duplicate")
		}
	}
	for pc := 0; pc < len(f.a.B); pc += 4 {
		to, ok := branchTarget(pc, rdWord(f.a.B, pc))
		if !ok || to > pc || to < 0 {
			continue
		}
		shift := 0
		for _, d := range deletions {
			if int(d.Off) < to {
				shift += int(d.Len)
			}
		}
		align := f.policy.LoopAlignLog2
		if align == 0 {
			align = 4
		}
		if shift&((1<<align)-1) != 0 {
			return f.rejectCompaction("positive-divisor-loop-alignment")
		}
	}
	return deletions, 0, true
}
