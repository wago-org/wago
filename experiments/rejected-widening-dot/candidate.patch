+func TestWideningDotNativeAndExclusions(t *testing.T) {
+	requireCompilerDiagnostics(t)
+	m := wideningDotModule(t, true, nil)
+	for _, guard := range []bool{false, true} {
+		for _, compact := range []bool{false, true} {
+			var stats ModuleStats
+			cm, err := CompileModuleWith(m, CompileOptions{ElideBoundsChecks: guard, CompactNative: compact, Stats: &stats, Optimizations: map[string]bool{"widening-dot-vector": true, "inline": false}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if cm.CodeImage != nil {
+				defer cm.CodeImage.Close()
+			}
+			if stats.Funcs[0].Peephole["widening-dot-vector"] != 1 {
+				t.Fatalf("missing cover: %v", stats.Funcs[0].Peephole)
+			}
+			seenLow, seenHigh, seenReverse, seenExt := false, false, false, false
+			for pc := 0; pc+4 <= len(cm.Code); pc += 4 {
+				w := binary.LittleEndian.Uint32(cm.Code[pc:])
+				seenLow = seenLow || w&0xffe0fc00 == 0x2ea0c000
+				seenHigh = seenHigh || w&0xffe0fc00 == 0x6ea0c000
+				seenReverse = seenReverse || w&0xfffffc00 == 0x4ea00800
+				seenExt = seenExt || w&0xffe0fc00 == 0x6e004000
+			}
+			if !seenLow || !seenHigh || !seenReverse || !seenExt {
+				t.Fatalf("missing vector proof: low%v high%v rev%v ext%v", seenLow, seenHigh, seenReverse, seenExt)
+			}
+		}
+	}
+	for _, tc := range []struct {
+		name              string
+		prefix            []byte
+		shared, interrupt bool
+	}{
+		{"store", []byte{0x41, 0, 0x41, 1, 0x36, 2, 0}, false, false},
+		{"shared", nil, true, false}, {"interruptible", nil, false, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			m := wideningDotModule(t, false, nil)
+			if tc.prefix != nil {
+				old := m.Code[0].BodyBytes
+				at := bytes.Index(old, []byte{0x03, 0x40})
+				m.Code[0].BodyBytes = append(append(append([]byte{}, old[:at+2]...), tc.prefix...), old[at+2:]...)
+			}
+			if tc.shared {
+				m.Memories[0].Shared = true
+				m.Memories[0].Limits.HasMax = true
+				m.Memories[0].Limits.Max = 1
+			}
+			var stats ModuleStats
+			cm, err := CompileModuleWith(m, CompileOptions{Stats: &stats, Interruptible: tc.interrupt, Optimizations: map[string]bool{"widening-dot-vector": true}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if cm.CodeImage != nil {
+				defer cm.CodeImage.Close()
+			}
+			if stats.Funcs[0].Peephole["widening-dot-vector"] != 0 {
+				t.Fatal("unsupported kernel admitted")
+			}
+		})
+	}
+}
