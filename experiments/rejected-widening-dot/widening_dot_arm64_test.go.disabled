//go:build (linux || darwin) && arm64

package arm64

import (
	"bytes"
	"encoding/binary"
	"errors"
	"fmt"
	"testing"

	"github.com/wago-org/wago/src/core/compiler/wasm"
	rt "github.com/wago-org/wago/src/core/runtime"
	"github.com/wago-org/wago/tests/support/wasmtest"
)

func wideningDotModule(t testing.TB, calling bool, prefix []byte) *wasm.Module {
	params := []wasm.ValType{wasm.I32, wasm.I32, wasm.I32, wasm.I32, wasm.I64}
	results := []wasm.ValType{wasm.I64, wasm.I32, wasm.I32, wasm.I32}
	body := []byte{0}
	if calling {
		body = append(body, 0x20, 4, 0x10, 1, 0x1a)
	}
	body = append(body, prefix...)
	body = append(body, 0x03, 0x40,
		0x20, 1, 0x41, 4, 0x6a, 0x35, 2, 0,
		0x20, 0, 0x35, 2, 0, 0x7e, 0x20, 4, 0x7c,
		0x20, 1, 0x35, 2, 0,
		0x20, 0, 0x41, 4, 0x6a, 0x35, 2, 0, 0x7e, 0x7c, 0x21, 4,
		0x20, 0, 0x41, 8, 0x6a, 0x21, 0,
		0x20, 1, 0x41, 8, 0x6b, 0x21, 1,
		0x20, 3, 0x20, 2, 0x41, 2, 0x6b, 0x22, 2, 0x47, 0x0d, 0, 0x0b)
	if calling {
		body = append(body, 0x20, 4, 0x10, 1, 0x1a)
	}
	body = append(body, 0x20, 4, 0x20, 0, 0x20, 1, 0x20, 2, 0x0b)
	if !calling {
		return modMem(t, 1, params, results, body)
	}
	helper := []byte{1, 5, 0x7e}
	for i := byte(1); i <= 5; i++ {
		helper = append(helper, 0x20, 0, 0x42, i, 0x7c, 0x21, i)
	}
	helper = append(helper, 0x20, 1)
	for i := byte(2); i <= 5; i++ {
		helper = append(helper, 0x20, i, 0x85)
	}
	helper = append(helper, 0x0b)
	raw := wasmtest.Module(
		wasmtest.Section(1, wasmtest.Vec(wasmtest.FuncType(params, results), wasmtest.FuncType([]wasm.ValType{wasm.I64}, []wasm.ValType{wasm.I64}))),
		wasmtest.Section(3, wasmtest.Vec(wasmtest.ULEB(0), wasmtest.ULEB(1))),
		wasmtest.Section(5, wasmtest.Vec([]byte{0, 1})),
		wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("f", 0, 0))),
		wasmtest.Section(10, wasmtest.Vec(append(wasmtest.ULEB(uint32(len(body))), body...), append(wasmtest.ULEB(uint32(len(helper))), helper...))),
	)
	m, err := wasm.DecodeModule(raw)
	if err != nil {
		t.Fatal(err)
	}
	return m
}

func runWideningDot(t *testing.T, m *wasm.Module, opts CompileOptions, args ...uint64) ([4]uint64, error) {
	t.Helper()
	cm, err := CompileModuleWith(m, opts)
	if err != nil {
		t.Fatal(err)
	}
	if cm.CodeImage != nil {
		defer cm.CodeImage.Close()
	}
	eng, err := rt.NewEngine()
	if err != nil {
		t.Fatal(err)
	}
	defer eng.Close()
	var jm *rt.JobMemory
	if opts.ElideBoundsChecks {
		if err := rt.InstallGuardTrapHandler(); err != nil {
			t.Fatal(err)
		}
		jm, err = rt.NewJobMemoryGuarded(65536, 65536)
	} else {
		jm, err = rt.NewJobMemory(65536)
	}
	if err != nil {
		t.Fatal(err)
	}
	defer jm.Close()
	for i := 0; i < len(jm.CurrentBytes())/4; i++ {
		binary.LittleEndian.PutUint32(jm.CurrentBytes()[i*4:], uint32(i)*0x9e3779b9+0x80000001)
	}
	ar, err := rt.NewArena(4096)
	if err != nil {
		t.Fatal(err)
	}
	defer ar.Close()
	code, entry, err := rt.MapCode(cm.Code)
	if err != nil {
		t.Fatal(err)
	}
	defer rt.Unmap(code)
	serArgs, result, trap := ar.Alloc(256), ar.Alloc(256), ar.Alloc(rt.TrapBufferBytes)
	for i, x := range args {
		binary.LittleEndian.PutUint64(serArgs[i*8:], x)
	}
	if opts.ElideBoundsChecks {
		err = eng.CallGuarded(entry+uintptr(cm.Entry[0]), serArgs, jm.LinMemBase(), trap, result, jm)
	} else {
		err = eng.Call(entry+uintptr(cm.Entry[0]), serArgs, jm.LinearMemory(), trap, result)
	}
	var got [4]uint64
	for i := range got {
		got[i] = binary.LittleEndian.Uint64(result[i*8:])
	}
	return got, err
}

func TestWideningDotExactExecution(t *testing.T) {
	mem := make([]byte, 65536)
	for i := 0; i < len(mem)/4; i++ {
		binary.LittleEndian.PutUint32(mem[i*4:], uint32(i)*0x9e3779b9+0x80000001)
	}
	for _, calling := range []bool{false, true} {
		m := wideningDotModule(t, calling, nil)
		for _, tc := range []struct{ a, b, c, l uint32 }{
			{0, 8, 0, 0xfffffffc}, // final B wraps to -8 with every load valid.
			{0, 16, 0, 0xfffffffa}, {1, 25, 7, 1}, {4, 64, 0, 0xfffffff0},
			{64, 64, 0xfffffffe, 0xfffffff6}, {65520, 8, 0, 0xfffffffc},
			{0, 8, 0, 0xfffffffe}, // short one-iteration scalar fallback.
			{65528, 8, 0, 0xfffffffc}, {0, 0, 0, 0xfffffffc}, {0, 16, 0, 0},
			{0, 16, 0, 1}, {0xfffffff8, 8, 0, 0xfffffffc},
		} {
			a, b, c, acc, trapped := tc.a, tc.b, tc.c, uint64(0xffffffffffffffed), false
			for iterations := 0; ; iterations++ {
				if iterations == 100 {
					t.Fatal("fixture did not terminate/trap")
				}
				load := func(addr uint32) uint64 {
					if uint64(addr)+4 > uint64(len(mem)) {
						trapped = true
						return 0
					}
					return uint64(binary.LittleEndian.Uint32(mem[addr:]))
				}
				b1, a0, b0, a1 := load(b+4), load(a), load(b), load(a+4)
				if trapped {
					break
				}
				acc += b1*a0 + b0*a1
				a += 8
				b -= 8
				c -= 2
				if c == tc.l {
					break
				}
			}
			want := [4]uint64{acc, uint64(a), uint64(b), uint64(c)}
			for _, enabled := range []bool{false, true} {
				for _, guard := range []bool{false, true} {
					t.Run(fmt.Sprintf("call%v/%x,%x,%x,%x/on%v/guard%v", calling, tc.a, tc.b, tc.c, tc.l, enabled, guard), func(t *testing.T) {
						opts := CompileOptions{ElideBoundsChecks: guard, Optimizations: map[string]bool{"widening-dot-vector": enabled, "inline": false}}
						var stats ModuleStats
						if diagnosticsEnabled {
							opts.Stats = &stats
						}
						got, err := runWideningDot(t, m, opts, uint64(tc.a)|0xcafebabe00000000, uint64(tc.b)|0xdeadbeef00000000, uint64(tc.c)|0x1234567800000000, uint64(tc.l)|0xabcdef0100000000, 0xffffffffffffffed)
						if diagnosticsEnabled && enabled && stats.Funcs[0].Peephole["widening-dot-vector"] != 1 {
							t.Fatalf("not admitted: %v", stats.Funcs[0].Peephole)
						}
						if trapped {
							var trap *rt.TrapError
							if !errors.As(err, &trap) || trap.Code != rt.TrapLinMemOutOfBounds {
								t.Fatalf("expected OOB, got %v", err)
							}
							return
						}
						if err != nil || got != want {
							t.Fatalf("got %x,%v want %x", got, err, want)
						}
					})
				}
			}
		}
	}
}

func TestWideningDotNativeAndExclusions(t *testing.T) {
	requireCompilerDiagnostics(t)
	m := wideningDotModule(t, true, nil)
	for _, guard := range []bool{false, true} {
		for _, compact := range []bool{false, true} {
			var stats ModuleStats
			cm, err := CompileModuleWith(m, CompileOptions{ElideBoundsChecks: guard, CompactNative: compact, Stats: &stats, Optimizations: map[string]bool{"widening-dot-vector": true, "inline": false}})
			if err != nil {
				t.Fatal(err)
			}
			if cm.CodeImage != nil {
				defer cm.CodeImage.Close()
			}
			if stats.Funcs[0].Peephole["widening-dot-vector"] != 1 {
				t.Fatalf("missing cover: %v", stats.Funcs[0].Peephole)
			}
			seenLow, seenHigh, seenReverse, seenExt := false, false, false, false
			for pc := 0; pc+4 <= len(cm.Code); pc += 4 {
				w := binary.LittleEndian.Uint32(cm.Code[pc:])
				seenLow = seenLow || w&0xffe0fc00 == 0x2ea0c000
				seenHigh = seenHigh || w&0xffe0fc00 == 0x6ea0c000
				seenReverse = seenReverse || w&0xfffffc00 == 0x4ea00800
				seenExt = seenExt || w&0xffe0fc00 == 0x6e004000
			}
			if !seenLow || !seenHigh || !seenReverse || !seenExt {
				t.Fatalf("missing vector proof: low%v high%v rev%v ext%v", seenLow, seenHigh, seenReverse, seenExt)
			}
		}
	}
	for _, tc := range []struct {
		name              string
		prefix            []byte
		shared, interrupt bool
	}{
		{"store", []byte{0x41, 0, 0x41, 1, 0x36, 2, 0}, false, false},
		{"shared", nil, true, false}, {"interruptible", nil, false, true},
	} {
		t.Run(tc.name, func(t *testing.T) {
			m := wideningDotModule(t, false, nil)
			if tc.prefix != nil {
				old := m.Code[0].BodyBytes
				at := bytes.Index(old, []byte{0x03, 0x40})
				m.Code[0].BodyBytes = append(append(append([]byte{}, old[:at+2]...), tc.prefix...), old[at+2:]...)
			}
			if tc.shared {
				m.Memories[0].Shared = true
				m.Memories[0].Limits.HasMax = true
				m.Memories[0].Limits.Max = 1
			}
			var stats ModuleStats
			cm, err := CompileModuleWith(m, CompileOptions{Stats: &stats, Interruptible: tc.interrupt, Optimizations: map[string]bool{"widening-dot-vector": true}})
			if err != nil {
				t.Fatal(err)
			}
			if cm.CodeImage != nil {
				defer cm.CodeImage.Close()
			}
			if stats.Funcs[0].Peephole["widening-dot-vector"] != 0 {
				t.Fatal("unsupported kernel admitted")
			}
		})
	}
}

func TestWideningDotPendingTrapAndCompactResidual(t *testing.T) {
	for _, enabled := range []bool{false, true} {
		for _, guard := range []bool{false, true} {
			m := wideningDotModule(t, true, []byte{0x41, 7, 0x41, 0, 0x6e, 0x1a})
			_, err := runWideningDot(t, m, CompileOptions{ElideBoundsChecks: guard, Optimizations: map[string]bool{"widening-dot-vector": enabled, "inline": false}}, 65535, 0, 0, 0xfffffffc, 9)
			var trap *rt.TrapError
			if !errors.As(err, &trap) || trap.Code != rt.TrapDivZero {
				t.Fatalf("pending divide trap lost: on%v guard%v err%v", enabled, guard, err)
			}
			m = wideningDotModule(t, true, nil)
			got, err := runWideningDot(t, m, CompileOptions{ElideBoundsChecks: guard, CompactNative: true, Optimizations: map[string]bool{"widening-dot-vector": enabled, "inline": false}}, 1, 25, 7, 1, 0xffffffffffffffed)
			if err != nil {
				t.Fatal(err)
			}
			want, err := runWideningDot(t, m, CompileOptions{ElideBoundsChecks: guard, Optimizations: map[string]bool{"widening-dot-vector": false, "inline": false}}, 1, 25, 7, 1, 0xffffffffffffffed)
			if err != nil || got != want {
				t.Fatalf("compact residual %x vs %x (%v)", got, want, err)
			}
		}
	}
}
