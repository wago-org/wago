//go:build arm64

package arm64

import (
	"os"

	"github.com/wago-org/wago/src/core/compiler/wasm"
)

var wideningDotEnabled = os.Getenv("WAGO_ARM64_EXPERIMENT_WIDENING_DOT") == "1"

type wideningDotNode struct {
	op   byte
	a, b int
	v    uint32
	typ  machineType
}

type wideningDotPlan struct{ a, b, counter, limit, acc int }
type wideningDotJoin struct {
	depth, site int
	written     uint32
}

// A complete bounded scan proves exactly two full-width unsigned products,
// crossed forward/backward streams, and a modular equality countdown.
func (f *fn) inspectWideningDot(r *wasm.Reader) (p wideningDotPlan, ok bool) {
	if f.nLocals > 32 {
		return
	}
	wide := false
	for _, typ := range f.localType {
		if typ != mtI32 && typ != mtI64 {
			return p, false
		}
		wide = wide || typ == mtI64
	}
	if !wide {
		return p, false
	}
	var nodes [128]wideningDotNode
	var values [32]int
	var stack [24]int
	n, depth, written, loads := f.nLocals, 0, uint32(0), 0
	for i, typ := range f.localType {
		nodes[i] = wideningDotNode{op: 0x20, a: i, typ: typ}
		values[i] = i
	}
	push := func(x int) bool {
		if depth == len(stack) {
			return false
		}
		stack[depth] = x
		depth++
		return true
	}
	node := func(x wideningDotNode) int {
		if n == len(nodes) {
			return -1
		}
		nodes[n] = x
		n++
		return n - 1
	}
	scan := *r
	start := scan.Offset()
	for scan.Offset()-start < 256 {
		op, err := scan.Byte()
		if err != nil {
			return p, false
		}
		switch op {
		case 0x20, 0x21, 0x22:
			x, err := scan.U32()
			if err != nil || x >= uint32(f.nLocals) {
				return p, false
			}
			if op == 0x20 {
				if !push(values[x]) {
					return p, false
				}
				continue
			}
			if depth == 0 || nodes[stack[depth-1]].typ != f.localType[x] {
				return p, false
			}
			values[x] = stack[depth-1]
			written |= 1 << x
			if op == 0x21 {
				depth--
			}
		case 0x41:
			v, err := scan.I32()
			if err != nil {
				return p, false
			}
			x := node(wideningDotNode{op: op, v: uint32(v), typ: mtI32})
			if x < 0 || !push(x) {
				return p, false
			}
		case 0x6a, 0x6b, 0x47, 0x7c, 0x7e:
			if depth < 2 {
				return p, false
			}
			typ := mtI32
			if op == 0x7c || op == 0x7e {
				typ = mtI64
			}
			depth -= 2
			a, b := stack[depth], stack[depth+1]
			if nodes[a].typ != typ || nodes[b].typ != typ {
				return p, false
			}
			x := node(wideningDotNode{op: op, a: a, b: b, typ: typ})
			if x < 0 || !push(x) {
				return p, false
			}
		case 0x35: // i64.load32_u; no signed or shortened product assumptions.
			mem, off, err := f.readMemArg(&scan)
			if err != nil || mem != 0 || off != 0 || depth == 0 || nodes[stack[depth-1]].typ != mtI32 {
				return p, false
			}
			loads++
			if loads > 4 {
				return p, false
			}
			x := node(wideningDotNode{op: op, a: stack[depth-1], typ: mtI64})
			if x < 0 {
				return p, false
			}
			stack[depth-1] = x
		case 0x0d:
			label, err := scan.U32()
			if err != nil || label != 0 || depth != 1 || loads != 4 {
				return p, false
			}
			end, err := scan.Byte()
			if err != nil || end != 0x0b {
				return p, false
			}
			condition := nodes[stack[0]]
			if condition.op != 0x47 {
				return p, false
			}
			inc, limit := condition.a, condition.b
			if nodes[inc].op != 0x6b {
				inc, limit = limit, inc
			}
			v := nodes[inc]
			if v.op != 0x6b || nodes[v.a].op != 0x20 || nodes[v.b].op != 0x41 || nodes[v.b].v != 2 || nodes[limit].op != 0x20 {
				return p, false
			}
			p.counter, p.limit = nodes[v.a].a, nodes[limit].a
			if p.counter == p.limit || values[p.counter] != inc || written&(1<<p.limit) != 0 {
				return p, false
			}
			p.a, p.b, p.acc = -1, -1, -1
			for local := 0; local < f.nLocals; local++ {
				if written&(1<<local) == 0 || local == p.counter {
					continue
				}
				v := nodes[values[local]]
				if f.localType[local] == mtI64 {
					if p.acc >= 0 {
						return p, false
					}
					p.acc = local
					continue
				}
				if v.op == 0x6a && nodes[v.a].op == 0x41 {
					v.a, v.b = v.b, v.a
				}
				if nodes[v.a].op != 0x20 || nodes[v.a].a != local || nodes[v.b].op != 0x41 || nodes[v.b].v != 8 {
					return p, false
				}
				if v.op == 0x6a && p.a < 0 {
					p.a = local
				} else if v.op == 0x6b && p.b < 0 {
					p.b = local
				} else {
					return p, false
				}
			}
			if p.a < 0 || p.b < 0 || p.acc < 0 || written != (1<<p.a|1<<p.b|1<<p.counter|1<<p.acc) {
				return p, false
			}
			var terms [3]int
			nTerms, visits := 0, 0
			var sum func(int) bool
			sum = func(x int) bool {
				visits++
				if visits > 128 {
					return false
				}
				v := nodes[x]
				if v.op == 0x7c {
					return sum(v.a) && sum(v.b)
				}
				if nTerms == 3 {
					return false
				}
				terms[nTerms] = x
				nTerms++
				return true
			}
			if !sum(values[p.acc]) || nTerms != 3 {
				return p, false
			}
			load := func(x int) (int, uint32, bool) {
				v := nodes[x]
				if v.op != 0x35 {
					return 0, 0, false
				}
				v = nodes[v.a]
				off := uint32(0)
				if v.op == 0x6a {
					if nodes[v.a].op == 0x41 {
						v.a, v.b = v.b, v.a
					}
					if nodes[v.b].op != 0x41 || nodes[v.b].v != 4 {
						return 0, 0, false
					}
					off = 4
					v = nodes[v.a]
				}
				if v.op != 0x20 {
					return 0, 0, false
				}
				return v.a, off, true
			}
			seenAcc, products := false, uint8(0)
			for _, x := range terms {
				v := nodes[x]
				if v.op == 0x20 && v.a == p.acc {
					if seenAcc {
						return p, false
					}
					seenAcc = true
					continue
				}
				if v.op != 0x7e {
					return p, false
				}
				a, ao, aok := load(v.a)
				b, bo, bok := load(v.b)
				if a == p.b {
					a, b, ao, bo, aok, bok = b, a, bo, ao, bok, aok
				}
				if !aok || !bok || a != p.a || b != p.b || ao+bo != 4 {
					return p, false
				}
				bit := uint8(1)
				if ao == 4 {
					bit = 2
				}
				if products&bit != 0 {
					return p, false
				}
				products |= bit
			}
			return p, seenAcc && products == 3
		default:
			return p, false
		}
	}
	return p, false
}

// Only a call-free kernel may bypass scalar lowering in a calling function.
// Its established entry/region path keeps every dedicated local pin live and
// dirty, with unpinned locals in private canonical slots on all paths.
func (f *fn) emitWideningDot(r *wasm.Reader, fr *ctrlFrame) {
	if !f.opt(optWideningDot) || f.wideningDot != nil || f.dotLoop != nil || f.pureReduce != nil || f.interruptible || f.moduleEH || f.preserveCallerPins || f.localBase != 0 || len(f.customInstructions) != 0 || len(f.intervalLast) != 0 || f.depth() != 0 || f.memoryAddr64(0) || f.threadedMemory0 ||
		f.usesCalls && (!fr.has(ctrlLoopCallFree) || !callFreeLoopEntryEnabled || !callFreeLoopRegionEnabled) {
		return
	}
	p, ok := f.inspectWideningDot(r)
	if !ok {
		return
	}
	var gp, vr [4]Reg
	ng, nv := 0, 0
	blocked := f.pinned.union(f.pinnedLocalMask).union(f.reserved)
	for _, x := range gpAlloc {
		if ng < len(gp) && !blocked.has(x) && f.regUser[x] == nil {
			gp[ng] = x
			ng++
			blocked = blocked.add(x)
		}
	}
	blocked = f.blockedFRegs(0)
	for _, x := range fpAllocRegs {
		if nv < len(vr) && !blocked.has(x) && f.fregUser[x] == nil {
			vr[nv] = x
			nv++
			blocked = blocked.add(x)
		}
	}
	if ng != len(gp) || nv != len(vr) {
		return
	}
	a, b, count, acc := gp[0], gp[1], gp[2], gp[3]
	va, vb, product, sum := vr[0], vr[1], vr[2], vr[3]
	oldPinned, oldFPinned := f.pinned, f.fpinned
	for _, x := range gp {
		f.pinned = f.pinned.add(x)
	}
	for _, x := range vr {
		f.fpinned = f.fpinned.add(x)
	}
	read := func(local int, dst Reg) {
		if x, _, pin := f.pinReg(local); pin {
			f.recoverLocal(local)
			if f.localType[local] == mtI64 {
				f.a.MovReg64(dst, x)
			} else {
				f.a.MovReg32(dst, x)
			}
		} else if f.locals[local].state == lsConstZero {
			f.a.MovImm64(dst, 0)
		} else if f.localType[local] == mtI64 {
			f.ld64(dst, SP, f.localOff(local))
		} else {
			f.ld32(dst, SP, f.localOff(local))
		}
	}
	write := func(local int, src Reg) {
		if x, _, pin := f.pinReg(local); pin {
			if f.localType[local] == mtI64 {
				f.a.MovReg64(x, src)
			} else {
				f.a.MovReg32(x, src)
			}
		} else {
			if f.localType[local] == mtI32 {
				f.a.MovReg32(src, src)
			}
			f.st64(SP, f.localOff(local), src)
		}
	}
	read(p.a, a)
	read(p.b, b)
	read(p.counter, count)
	read(p.acc, acc)
	read(p.limit, X16)
	f.a.Sub32(count, count, X16)
	var fallback [9]int
	nFallback := 0
	guard := func(cc Cond) { fallback[nFallback] = f.a.Bcond(cc); nFallback++ }
	f.a.TstImm32(count, 1)
	guard(condNE)
	f.a.LsrImm32(count, count, 1)
	f.a.CmpImm32(count, 2)
	guard(condB) // Includes modular zero-distance do-while.
	f.a.LslImm64(X16, count, 3)
	f.a.Add64(X16, a, X16)
	mb := f.memSizeReg
	if mb == regNone {
		mb = X17
		f.ld64(mb, linMemReg, -int32(bdCurBytes))
	}
	f.cmpRR(X16, mb, true)
	guard(condA)
	f.a.MovImm64(X17, 1<<32)
	f.cmpRR(X16, X17, true)
	guard(condA)
	f.a.AddImm64(X16, b, 8)
	if mb == X17 {
		f.ld64(mb, linMemReg, -int32(bdCurBytes))
	}
	f.cmpRR(X16, mb, true)
	guard(condA)
	f.a.MovImm64(X17, 1<<32)
	f.cmpRR(X16, X17, true)
	guard(condA)
	f.a.LslImm64(X17, count, 3)
	f.cmpRR(X16, X17, true)
	guard(condB)
	f.a.Add64(a, a, linMemReg)
	f.a.Add64(b, b, linMemReg)
	f.a.SubImm64(b, b, 8)
	f.a.NeonEor16b(sum, sum, sum)
	loop := f.a.Len()
	f.a.LdrQ(va, a, 0)
	f.a.LdrQ(vb, b, 0)
	f.a.NeonRev64S(vb, vb)
	f.a.NeonExt16b(vb, vb, vb, 8)
	f.a.NeonUmullDfromS(product, va, vb)
	f.a.NeonAddD(sum, sum, product)
	f.a.NeonUmull2DfromS(product, va, vb)
	f.a.NeonAddD(sum, sum, product)
	f.a.AddImm64(a, a, 16)
	f.a.SubImm64(b, b, 16)
	f.a.SubImm32(count, count, 2)
	f.a.CmpImm32(count, 2)
	f.patchBranch19(f.a.Bcond(condAE), loop)
	f.a.NeonUmovD(X16, sum, 0)
	f.a.NeonUmovD(X17, sum, 1)
	f.a.Add64(X16, X16, X17)
	f.a.Add64(acc, acc, X16)
	write(p.acc, acc)
	f.a.Sub64(X16, a, linMemReg)
	write(p.a, X16)
	f.a.Sub64(X16, b, linMemReg)
	f.a.AddImm32(X16, X16, 8)
	write(p.b, X16)
	read(p.limit, X16)
	f.a.LslImm(X17, count, 1, true)
	f.a.Add32(X16, X16, X17)
	write(p.counter, X16)
	finished := f.a.Cbz32(count)
	for i := 0; i < nFallback; i++ {
		f.patchBranch19(fallback[i], f.a.Len())
	}
	f.pinned, f.fpinned = oldPinned, oldFPinned
	for _, x := range gp {
		f.release(x)
	}
	for _, x := range vr {
		f.releaseF(x)
	}
	written := uint32(1<<p.a | 1<<p.b | 1<<p.counter | 1<<p.acc)
	for local := 0; local < f.nLocals; local++ {
		if written&(1<<local) != 0 {
			f.setFactsForLocal(local, 0)
			if _, _, pin := f.pinReg(local); pin {
				f.locals[local].state = lsReg
			} else {
				f.locals[local].state = lsMem
			}
		}
	}
	f.wideningDot = &wideningDotJoin{depth: len(f.ctrl) + 1, site: finished, written: written}
	f.invalidateBoundsCert()
	f.invalidateStoreForward()
	f.stats.peep("widening-dot-vector")
}

func (f *fn) finishWideningDot(depth int) {
	state := f.wideningDot
	if state == nil || state.depth != depth {
		return
	}
	f.patchBranch19(state.site, f.a.Len())
	for local := 0; local < f.nLocals; local++ {
		if state.written&(1<<local) != 0 {
			f.setFactsForLocal(local, 0)
		}
	}
	f.invalidateBoundsCert()
	f.invalidateStoreForward()
	f.wideningDot = nil
}
