//go:build arm64

package arm64

import "os"

var branchlessSignedRemEnabled = os.Getenv("WAGO_ARM64_EXPERIMENT_BRANCHLESS_SIGNED_REM") == "1"

// The caller has already emitted the zero-divisor trap. AArch64 SDIV truncates
// signed overflow to INT_MIN, so MSUB also yields zero for INT_MIN % -1.
func (f *fn) emitBranchlessSignedRem(result, dividend, divisor Reg, wide bool) {
	// Both callers have already chosen a result distinct from the dividend
	// and divisor. The quotient can occupy that result directly; MSUB reads
	// it before replacing it, avoiding a second temporary under pressure.
	f.sdiv(result, dividend, divisor, wide)
	f.msub(result, result, divisor, dividend, wide)
	f.stats.peep("branchless-signed-rem")
}
