index 00000000..334c8179
--- /dev/null
+++ b/src/core/compiler/backend/railshot/arm64/widened_multiply_arm64_test.go
@@ -0,0 +1,156 @@
+//go:build arm64
+
+package arm64
+
+import (
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+	"testing"
+)
+
+func TestWidenedMultiplyNative(t *testing.T) {
+	requireCompilerDiagnostics(t)
+	for _, signed := range []bool{true, false} {
+		ext := byte(0xad)
+		if signed {
+			ext = 0xac
+		}
+		for _, operation := range []byte{0, 0x7c, 0x7d} {
+			// Put the accumulator before the multiplication for the subtract shape.
+			body := []byte{0}
+			if operation != 0 {
+				body = append(body, 0x20, 2)
+			}
+			body = append(body, 0x20, 0, ext, 0x20, 1, ext, 0x7e)
+			if operation != 0 {
+				body = append(body, operation)
+			}
+			body = append(body, 0x0b)
+			m := modMem(t, 1, []wasm.ValType{wasm.I32, wasm.I32, wasm.I64}, []wasm.ValType{wasm.I64}, body)
+			for _, on := range []bool{false, true} {
+				for _, guard := range []bool{false, true} {
+					var stats ModuleStats
+					cm, err := CompileModuleWith(m, CompileOptions{ElideBoundsChecks: guard, DeferCodeMapping: true, Stats: &stats, Optimizations: map[string]bool{"widened-multiply": on}})
+					if err != nil {
+						t.Fatal(err)
+					}
+					if cm.CodeImage != nil {
+						cm.CodeImage.Close()
+					}
+					hits := stats.Funcs[0].Peephole["widened-multiply"]
+					if on && hits != 1 || !on && hits != 0 {
+						t.Fatalf("signed=%v op=%x on=%v hits=%d", signed, operation, on, hits)
+					}
+					for _, v := range [][3]uint64{{0, 0, 0}, {1, 2, 7}, {0xffffffff, 0x80000000, 0xfffffffffffffff1}, {0x7fffffff, 0x7fffffff, 0x7fffffffffffffff}, {0xdeadbeef80000001, 0x76543210ffffffff, 0x8000000000000000}} {
+						product := uint64(uint32(v[0])) * uint64(uint32(v[1]))
+						if signed {
+							product = uint64(int64(int32(v[0])) * int64(int32(v[1])))
+						}
+						want := product
+						if operation == 0x7c {
+							want = v[2] + product
+						}
+						if operation == 0x7d {
+							want = v[2] - product
+						}
+						got, err := runArm64WrapperWithOptions(t, m, CompileOptions{ElideBoundsChecks: guard, CompactNative: false, Optimizations: map[string]bool{"widened-multiply": on}}, v[:]...)
+						if err != nil || got != want {
+							t.Fatalf("signed=%v op=%x on=%v guard=%v args=%x got=%x want=%x err=%v", signed, operation, on, guard, v, got, want, err)
+						}
+					}
+				}
+			}
+		}
+	}
+}
+
+func TestWidenedMultiplyLocalControlProof(t *testing.T) {
+	requireCompilerDiagnostics(t)
+	for _, ambiguous := range []bool{false, true} {
+		// Params a,b,unknown64,condition. Both declared i64 locals begin at zero.
+		body := []byte{1, 2, 0x7e, 0x20, 0, 0xac, 0x21, 4, 0x20, 1, 0xac, 0x21, 5, 0x20, 3, 0x04, 0x40}
+		if ambiguous {
+			body = append(body, 0x20, 2)
+		} else {
+			body = append(body, 0x20, 0, 0xac)
+		}
+		body = append(body, 0x21, 4, 0x0b, 0x20, 4, 0x20, 5, 0x7e, 0x0b)
+		m := modMem(t, 1, []wasm.ValType{wasm.I32, wasm.I32, wasm.I64, wasm.I32}, []wasm.ValType{wasm.I64}, body)
+		for _, on := range []bool{false, true} {
+			var stats ModuleStats
+			cm, err := CompileModuleWith(m, CompileOptions{DeferCodeMapping: true, Stats: &stats, Optimizations: map[string]bool{"widened-multiply": on}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if cm.CodeImage != nil {
+				cm.CodeImage.Close()
+			}
+			hits := stats.Funcs[0].Peephole["widened-multiply"]
+			if on && !ambiguous && hits != 1 || (!on || ambiguous) && hits != 0 {
+				t.Fatalf("ambiguous=%v on=%v hits=%d", ambiguous, on, hits)
+			}
+			for _, cond := range []uint64{0, 1} {
+				a, b, c := uint64(0xfffffff1), uint64(0x80000001), uint64(1<<45)+1
+				product := uint64(int64(int32(a)) * int64(int32(b)))
+				if ambiguous && cond != 0 {
+					product = c * uint64(int64(int32(b)))
+				}
+				got, err := runArm64WrapperWithOptions(t, m, CompileOptions{Optimizations: map[string]bool{"widened-multiply": on}}, a, b, c, cond)
+				if err != nil || got != product {
+					t.Fatalf("ambiguous=%v on=%v cond=%d got=%x want=%x err=%v", ambiguous, on, cond, got, product, err)
+				}
+			}
+		}
+	}
