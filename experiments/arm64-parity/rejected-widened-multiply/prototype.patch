+func TestWidenedMultiplyAccumulateEncoding(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		emit func(*Asm)
+		want uint32
+	}{
+		{"smaddl", func(a *Asm) { a.Smaddl(X0, X1, X2, X3) }, 0x9b220c20},
+		{"smsubl", func(a *Asm) { a.Smsubl(X0, X1, X2, X3) }, 0x9b228c20},
+		{"umaddl", func(a *Asm) { a.Umaddl(X0, X1, X2, X3) }, 0x9ba20c20},
+		{"umsubl", func(a *Asm) { a.Umsubl(X0, X1, X2, X3) }, 0x9ba28c20},
+	} {
+		var a Asm
+		tc.emit(&a)
+		if len(a.B) != 4 || binary.LittleEndian.Uint32(a.B) != tc.want {
+			t.Fatalf("%s got=%x want=%08x", tc.name, a.B, tc.want)
+		}
+	}
+}
