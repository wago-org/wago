diff --git a/src/core/compiler/backend/railshot/arm64/widened_multiply.go b/src/core/compiler/backend/railshot/arm64/widened_multiply.go
new file mode 100644
index 00000000..1a1231dd
--- /dev/null
+++ b/src/core/compiler/backend/railshot/arm64/widened_multiply.go
@@ -0,0 +1,218 @@
+//go:build arm64
+
+package arm64
+
+import (
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	"os"
+)
+
+var widenedMultiplyEnabled = os.Getenv("WAGO_ARM64_EXPERIMENT_WIDENED_MULTIPLY") == "1"
+
+// A declared i64 local starts at zero. If every assignment is immediately
+// produced by a signed narrow load/extension or an in-range constant, the local
+// remains a signed i32 in every control path. Parameters and ambiguous writes
+// decline. This source-level proof does not rely on assignment order or joins.
+func (f *fn) proveSigned32Locals(body []byte) [2]uint64 {
+	var mask [2]uint64
+	if len(body) == 0 || len(body) > 16<<10 || f.nLocals > 128 || len(f.localType) > 128 || len(f.customInstructions) != 0 {
+		return mask
+	}
+	for x, typ := range f.localType {
+		if typ == mtI64 && x >= f.nParams {
+			mask[x>>6] |= uint64(1) << uint(x&63)
+		}
+	}
+	if mask[0]|mask[1] == 0 {
+		return mask
+	}
+	r := wasm.ReaderFrom(body)
+	var imm wasm.InstructionImmediate
+	signed := false
+	for r.HasNext() {
+		op, err := r.Byte()
+		if err != nil {
+			return [2]uint64{}
+		}
+		if op == 0x42 {
+			v, err := r.I64()
+			if err != nil {
+				return [2]uint64{}
+			}
+			signed = v == int64(int32(v))
+			continue
+		}
+		if op == 0x21 || op == 0x22 {
+			x, err := r.U32()
+			if err != nil || int(x) >= len(f.localType) {
+				return [2]uint64{}
+			}
+			if !signed {
+				mask[x>>6] &^= uint64(1) << uint(x&63)
+			}
+			signed = signed && op == 0x22 && f.localType[x] == mtI64
+			continue
+		}
+		if err = f.classifier.ClassifyInto(&r, op, &imm); err != nil {
+			return [2]uint64{}
+		}
+		signed = op == 0xac || op == 0xc2 || op == 0xc3 || op == 0xc4 || op >= 0x30 && op <= 0x34
+	}
+	return mask
+}
+
+// Return the low-word source of a proven signed/unsigned widening operand.
+// Narrow conversions are discarded only when their input is already a concrete
+// scalar value; bounded arithmetic is left to ordinary lowering.
+func (f *fn) widenedMultiplyOperand(e *elem, signed bool) *elem {
+	if e == nil || e.st.typ != mtI64 {
+		return nil
+	}
+	if e.isDeferred() {
+		want := opZExt32
+		if signed {
+			want = opSExt32
+		}
+		if e.deferredOp() != want {
+			return nil
+		}
+		child := f.s.arg0(e)
+		if child != nil && child.elemKind() == ekValue && (child.st.typ == mtI32 || child.st.typ == mtI64) {
+			return child
+		}
+		return nil
+	}
+	if e.elemKind() != ekValue {
+		return nil
+	}
+	if e.st.kind == stConst {
+		if signed && e.st.cval == int64(int32(e.st.cval)) || !signed && uint64(e.st.cval) <= 0xffffffff {
+			return e
+		}
+		return nil
+	}
+	want := factUpper32Zero
+	if signed {
+		want = factSigned32
+	}
+	if e.st.valueFacts().has(want) {
+		return e
+	}
+	return nil
+}
+
+// A bounded arithmetic accumulator is safe to realize before multiplicands only
+// when every leaf is a nontrapping private read. Memory/global reads and divisions
+// retain their established realization order and ordinary lowering.
+func pureWidenedAccumulator(s *stack, e *elem, budget int) bool {
+	if e == nil || budget <= 0 {
+		return false
+	}
+	if e.elemKind() == ekValue {
+		return (e.st.typ == mtI32 || e.st.typ == mtI64) && e.st.kind != stMemRef && e.st.kind != stGlobalRef && e.st.kind != stFuncRef
+	}
+	if !e.isDeferred() {
+		return false
+	}
+	switch e.deferredOp() {
+	case opSExt32, opZExt32:
+		return pureWidenedAccumulator(s, s.arg0(e), budget-1)
+	case opAdd, opSub, opMul:
+		return pureWidenedAccumulator(s, s.arg0(e), budget-1) && pureWidenedAccumulator(s, s.arg1(e), budget-1)
+	}
+	return false
+}
+
+func (f *fn) tryWidenedMultiply(node *elem, dest Reg) Reg {
+	if node.st.typ != mtI64 || !f.opt(optWidenedMultiply) {
+		return regNone
+	}
+	root := node
+	var acc *elem
+	subtract := false
+	if node.deferredOp() == opAdd || node.deferredOp() == opSub {
+		a, b := f.s.arg0(node), f.s.arg1(node)
+		if b.isDeferred() && b.deferredOp() == opMul {
+			root, acc = b, a
+		} else if node.deferredOp() == opAdd && a.isDeferred() && a.deferredOp() == opMul {
+			root, acc = a, b
+		} else {
+			return regNone
+		}
+		// Loads may trap and mutable global reads may observe effects. New fused
+		// covers only reorder nontrapping local/constant/register accumulator reads.
+		if acc.st.typ != mtI64 || !pureWidenedAccumulator(f.s, acc, 4) {
+			return regNone
+		}
+		subtract = node.deferredOp() == opSub
+	} else if node.deferredOp() != opMul {
+		return regNone
+	}
+	a, b := f.s.arg0(root), f.s.arg1(root)
+	if acc == nil {
+		// Preserve the existing one-instruction multiply strength reductions.
+		for _, operand := range [2]*elem{a, b} {
+			if operand.elemKind() == ekValue && operand.st.kind == stConst && (operand.st.cval == 3 || operand.st.cval == 5 || operand.st.cval == 9) {
+				return regNone
+			}
+		}
+	}
+	signed := true
+	n, m := f.widenedMultiplyOperand(a, true), f.widenedMultiplyOperand(b, true)
+	if n == nil || m == nil {
+		signed = false
+		n, m = f.widenedMultiplyOperand(a, false), f.widenedMultiplyOperand(b, false)
+		if n == nil || m == nil {
+			return regNone
+		}
+	}
+	saved := f.pinned
+	// Match ordinary right-before-left realization for multiply; the fused
+	// accumulator is a concrete nontrapping read and can be captured first.
+	ra, ownA := regNone, false
+	if acc != nil {
+		ra, ownA = f.materializeRead(acc)
+		f.pinned = f.pinned.add(ra)
+	}
+	rm, ownM := f.materializeRead(m)
+	f.pinned = f.pinned.add(rm)
+	rn, ownN := f.materializeRead(n)
+	f.pinned = f.pinned.add(rn)
+	d := dest
+	if d == regNone {
+		d = f.allocReg(0)
+	}
+	if acc == nil {
+		if signed {
+			f.a.Smull(d, rn, rm)
+		} else {
+			f.a.Umull(d, rn, rm)
+		}
+	} else if signed {
+		if subtract {
+			f.a.Smsubl(d, rn, rm, ra)
+		} else {
+			f.a.Smaddl(d, rn, rm, ra)
+		}
+	} else {
+		if subtract {
+			f.a.Umsubl(d, rn, rm, ra)
+		} else {
+			f.a.Umaddl(d, rn, rm, ra)
+		}
+	}
+	f.pinned = saved
+	if ownN {
+		f.release(rn)
+	}
+	if ownM && rm != rn {
+		f.release(rm)
+	}
+	if ownA && ra != rn && ra != rm {
+		f.release(ra)
+	}
+	f.consumeBlockBelow(node)
+	f.occupy(node, d)
+	f.stats.peep("widened-multiply")
+	return d
+}
