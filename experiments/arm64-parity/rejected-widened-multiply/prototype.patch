+			for _, v := range [][2]uint64{{3, 5}, {0xffffffff, 0x80000000}, {0x7fffffff, 0x7fffffff}} {
+				want := uint64(int64(int32(v[0])) + int64(int32(v[0]))*int64(int32(v[1])))
+				got, err := runArm64WrapperWithOptions(t, m, CompileOptions{ElideBoundsChecks: guard, Optimizations: map[string]bool{"widened-multiply": on}}, v[:]...)
+				if err != nil || got != want {
