+func TestWidenedMultiplyLoadsAndConstants(t *testing.T) {
+	requireCompilerDiagnostics(t)
+	for _, coefficient := range []int64{-2147483648, -3, 3, 5, 9, 13, 2147483647, 2147483648, 1 << 40} {
+		body := []byte{0, 0x41, 16, 0x20, 0, 0x36, 2, 0, 0x41, 16, 0x34, 2, 0, 0x42}
+		body = append(body, wasmtest.SLEB64(coefficient)...)
+		body = append(body, 0x7e, 0x0b)
+		m := modMem(t, 1, []wasm.ValType{wasm.I32}, []wasm.ValType{wasm.I64}, body)
+		for _, on := range []bool{false, true} {
+			for _, guard := range []bool{false, true} {
+				var stats ModuleStats
+				cm, err := CompileModuleWith(m, CompileOptions{ElideBoundsChecks: guard, DeferCodeMapping: true, Stats: &stats, Optimizations: map[string]bool{"widened-multiply": on}})
+				if err != nil {
+					t.Fatal(err)
+				}
+				if cm.CodeImage != nil {
+					cm.CodeImage.Close()
+				}
+				hits := stats.Funcs[0].Peephole["widened-multiply"]
+				wantHit := on && coefficient == int64(int32(coefficient)) && coefficient != 3 && coefficient != 5 && coefficient != 9
+				if wantHit && hits != 1 || !wantHit && hits != 0 {
+					t.Fatalf("coefficient=%d on=%v hits=%d", coefficient, on, hits)
+				}
+				for _, a := range []uint64{1, 0xffffffff, 0x80000001, 0xdeadbeef7fffffff} {
+					want := uint64(int64(int32(a)) * coefficient)
+					got, err := runArm64WrapperWithOptions(t, m, CompileOptions{ElideBoundsChecks: guard, Optimizations: map[string]bool{"widened-multiply": on}}, a)
+					if err != nil || got != want {
+						t.Fatalf("coefficient=%d on=%v guard=%v a=%x got=%x want=%x err=%v", coefficient, on, guard, a, got, want, err)
+					}
+				}
+			}
+		}
+	}
