+// materializeMulAddRead borrows immutable cached integer constants for fused
+// multiply-accumulate sources. Cache misses retain ordinary read-only lowering.
+func (f *fn) materializeMulAddRead(e *elem) (Reg, bool) {
+	if f.opt(optMulAddConstRead) && e.elemKind() == ekValue && e.st.kind == stConst && (e.st.typ == mtI32 || e.st.typ == mtI64) {
+		if reg, okay := f.cachedIntConst(e.st); okay {
+			if regallocCheckEnabled {
+				f.checkUse(e)
+			}
+			f.stats.peep("mul-add-const-read")
+			return reg, false
+		}
+	}
+	return f.materializeRead(e)
+}
