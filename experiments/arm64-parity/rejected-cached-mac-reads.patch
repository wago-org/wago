+func TestReadOnlyLoopConstantMADDArm64(t *testing.T) {
+	saved := mulAddConstReadEnabled
+	defer func() { mulAddConstReadEnabled = saved }()
+	for _, wide := range []bool{false, true} {
+		typ, constOp, mulOp, addOp := wasm.I32, byte(0x41), byte(0x6c), byte(0x6a)
+		if wide {
+			typ, constOp, mulOp, addOp = wasm.I64, 0x42, 0x7e, 0x7c
+		}
+		constants := []uint64{0x1234567, 0x2345671, 0x3456712, 0x4567123}
+		if wide {
+			for i := range constants {
+				constants[i] |= uint64(i+1) << 40
+			}
+		}
+		body := []byte{1, 1, 0x7f, 0x3f, 0, 0x1a, 0x20, 2, 0x21, 3, 0x02, 0x40, 0x20, 3, 0x45, 0x0d, 0, 0x03, 0x40}
+		for _, c := range constants {
+			for range 2 {
+				body = append(body, 0x20, 0, 0x20, 1, constOp)
+				if wide {
+					body = append(body, wasmtest.SLEB64(int64(c))...)
+				} else {
+					body = append(body, wasmtest.SLEB32(int32(c))...)
+				}
+				body = append(body, mulOp, addOp, 0x21, 0)
+			}
+		}
+		body = append(body, 0x20, 3, 0x41, 1, 0x6b, 0x22, 3, 0x0d, 0, 0x0b, 0x0b, 0x20, 0, 0x0b)
+		m := mod1(t, []wasm.ValType{typ, typ, wasm.I32}, []wasm.ValType{typ}, body)
+		m.Memories = []wasm.MemType{{Limits: wasm.Limits{Min: 1}}}
+		for _, enabled := range []bool{false, true} {
+			mulAddConstReadEnabled = enabled
+			if diagnosticsEnabled {
+				stats := &ModuleStats{}
+				cm, err := CompileModuleWith(m, CompileOptions{Stats: stats})
+				if err != nil {
+					t.Fatal(err)
+				}
+				if cm.CodeImage != nil {
+					cm.CodeImage.Close()
+				}
+				if (stats.Funcs[0].Peephole["mul-add-const-read"] != 0) != enabled {
+					t.Fatalf("wide=%v enabled=%v stats=%v", wide, enabled, stats.Funcs[0].Peephole)
+				}
+			}
+			for _, n := range []uint64{0, 1, 3, 17} {
+				accumulator, input := uint64(0x34567812), uint64(0x12345679)
+				want := accumulator
+				for range n {
+					for _, c := range constants {
+						want += input * c
+						want += input * c
+					}
+				}
+				if !wide {
+					want = uint64(uint32(want))
+				}
+				got, err := runArm64WrapperWithOptions(t, m, CompileOptions{}, accumulator, input, n)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if got != want {
+					t.Fatalf("wide=%v enabled=%v n=%d got=%x want=%x", wide, enabled, n, got, want)
+				}
+			}
+		}
+	}
+}
