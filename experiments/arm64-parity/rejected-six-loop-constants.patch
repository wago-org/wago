+func TestSixLoopIntConstantsMixedTypeMetadataArm64(t *testing.T) {
+	saved := loopIntConstCapacity
+	loopIntConstCapacity = 6
+	defer func() { loopIntConstCapacity = saved }()
+	h := funcHintView{loopIntConstCount: 6, loopIntConstTypes: 0x999, loopIntConst: [6]int64{0x1234567, 0x123456789abcdef, 0x2345678, 0x23456789abcdef1, 0x3456789, 0x3456789abcdef12}}
+	f := fn{a: &a64.Asm{}, policy: currentCodegenPolicy()}
+	f.preloadLoopIntConsts(&h)
+	if f.iconstN != 6 {
+		t.Fatalf("cached=%d", f.iconstN)
+	}
+	for i, c := range f.iconsts {
+		want := mtI32
+		if i%2 != 0 {
+			want = mtI64
+		}
+		if c.typ != want || c.bits != h.loopIntConst[i] {
+			t.Fatalf("entry=%d got=%+v want type=%v bits=%x", i, c, want, h.loopIntConst[i])
+		}
 	}
 }
 
