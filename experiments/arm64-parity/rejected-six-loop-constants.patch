+func TestSixLoopIntConstantsPreserveWideTypesArm64(t *testing.T) {
+	saved := loopIntConstCapacity
+	defer func() { loopIntConstCapacity = saved }()
+	constants := []uint64{0x123456789abcdef1, 0x23456789abcdef13, 0x3456789abcdef135, 0x456789abcdef1357, 0x56789abcdef13579, 0x6789abcdef135791}
+	body := []byte{1, 1, 0x7f, 0x3f, 0, 0x1a, 0x20, 1, 0x21, 2, 0x02, 0x40, 0x20, 2, 0x45, 0x0d, 0, 0x03, 0x40}
+	for _, c := range constants {
+		for range 2 {
+			body = append(body, 0x20, 0, 0x42)
+			body = append(body, wasmtest.SLEB64(int64(c))...)
+			body = append(body, 0x7e, 0x21, 0)
+		}
+	}
+	body = append(body, 0x20, 2, 0x41, 1, 0x6b, 0x22, 2, 0x0d, 0, 0x0b, 0x0b, 0x20, 0, 0x0b)
+	m := mod1(t, []wasm.ValType{wasm.I64, wasm.I32}, []wasm.ValType{wasm.I64}, body)
+	m.Memories = []wasm.MemType{{Limits: wasm.Limits{Min: 1}}}
+	for _, capacity := range []int{4, 6} {
+		loopIntConstCapacity = capacity
+		if diagnosticsEnabled {
+			stats := &ModuleStats{}
+			cm, err := CompileModuleWith(m, CompileOptions{Stats: stats})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if cm.CodeImage != nil {
+				cm.CodeImage.Close()
+			}
+			if got := stats.Funcs[0].Peephole["loop-int-const"]; got != capacity && !(capacity == 6 && got == 5) {
+				t.Fatalf("capacity=%d cached=%d", capacity, got)
+			}
+		}
+		for _, n := range []uint64{0, 1, 3, 17} {
+			input := uint64(0xfedcba9876543210)
+			want := input
+			for range n {
+				for _, c := range constants {
+					want *= c
+					want *= c
+				}
+			}
+			got, err := runArm64WrapperWithOptions(t, m, CompileOptions{}, input, n)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got != want {
+				t.Fatalf("capacity=%d n=%d got=%x want=%x", capacity, n, got, want)
+			}
+		}
+	}
+}
