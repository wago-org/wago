+	for _, on := range []bool{false, true} {
+		for _, borrow := range []bool{false, true} {
+			for _, guard := range []bool{false, true} {
+				for _, c := range []uint64{0, 1, 2, 1 << 32} {
+					x, y := uint64(0xfeedface12345678), uint64(0xdeadbeef98765432)
+					want := y
+					if uint32(c) != 0 {
