+//go:build arm64
+
+package arm64
+
+import (
+	a64 "github.com/wago-org/wago/src/core/encoder/arm64"
+	"math/bits"
+	"os"
+)
+
+var scaledConstMulEnabled = os.Getenv("WAGO_ARM64_EXPERIMENT_SCALED_CONST_MUL") == "1"
+
+// scaledAddMultiplier represents (1 + 2^small) * 2^shift. Both steps preserve
+// modular integer multiplication, including unsigned i32 representatives.
+func scaledAddMultiplier(value int64, wide bool) (small, shift uint8, okay bool) {
+	var v uint64
+	if wide {
+		if value <= 0 {
+			return 0, 0, false
+		}
+		v = uint64(value)
+	} else {
+		v = uint64(uint32(value))
+	}
+	if v == 0 {
+		return 0, 0, false
+	}
+	k := bits.TrailingZeros64(v)
+	odd := v >> k
+	if k == 0 || (odd != 3 && odd != 5 && odd != 9) {
+		return 0, 0, false
+	}
+	return uint8(bits.TrailingZeros64(odd - 1)), uint8(k), true
+}
+
+func (f *fn) tryScaledConstMulAdd(node, mul, addend *elem, dest Reg, wide bool) Reg {
+	if !scaledConstMulEnabled {
+		return regNone
+	}
+	n, c := f.s.arg0(mul), f.s.arg1(mul)
+	if n.elemKind() == ekValue && n.st.kind == stConst {
+		n, c = c, n
+	}
+	if c.elemKind() != ekValue || c.st.kind != stConst {
+		return regNone
+	}
+	small, shift, okay := scaledAddMultiplier(c.st.cval, wide)
+	if !okay {
+		return regNone
+	}
+	saved := f.pinned
+	var ra Reg
+	var ownRa bool
+	if addend.elemKind() == ekValue && addend.st.kind == stConst {
+		ra, ownRa = f.intConstReadReg(addend.st, 0)
+	} else {
+		ra, ownRa = f.materializeRead(addend)
+	}
+	f.pinned = f.pinned.add(ra)
+	rn, ownN := f.materializeRead(n)
+	f.pinned = f.pinned.add(rn)
+	d := dest
+	if d == regNone {
+		d = f.allocReg(0)
+	}
+	product := d
+	if d == ra {
+		product = f.allocReg(0)
+	}
+	f.a.AddShifted(product, rn, rn, small, !wide)
+	if node.deferredOp() == opAdd {
+		f.a.AddShifted(d, ra, product, shift, !wide)
+	} else {
+		f.a.SubShiftedReg(d, ra, product, a64.RegShiftLSL, shift, !wide)
+	}
+	if product != d {
+		f.release(product)
+	}
+	f.pinned = saved
+	if ownN {
+		f.release(rn)
+	}
+	if ownRa && ra != rn {
+		f.release(ra)
+	}
+	f.stats.peep("scaled-const-mul-add")
+	f.consumeBlockBelow(node)
+	f.occupy(node, d)
+	return d
+}
