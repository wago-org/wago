+//go:build (linux || darwin) && arm64
+
+package arm64
+
+import (
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+	"testing"
+)
+
+func TestScaledConstMulAddAliasesAndWrapping(t *testing.T) {
+	saved := scaledConstMulEnabled
+	defer func() { scaledConstMulEnabled = saved }()
+	for _, wide := range []bool{false, true} {
+		typ, constOp, mulOp, addOp := wasm.I32, byte(0x41), byte(0x6c), byte(0x6a)
+		localType := byte(0x7f)
+		if wide {
+			typ, constOp, mulOp, addOp = wasm.I64, 0x42, 0x7e, 0x7c
+			localType = 0x7e
+		}
+		constants := []int64{6, 10, 24, 72, 3 << 29}
+		if wide {
+			constants = append(constants, 3<<61)
+		}
+		for _, coefficient := range constants {
+			for _, subtract := range []bool{false, true} {
+				for _, destination := range []int{-1, 0, 1, 2} {
+					body := []byte{1, 1, localType, 0x3f, 0, 0x1a, 0x20, 0, 0x20, 1, constOp}
+					if wide {
+						body = append(body, wasmtest.SLEB64(coefficient)...)
+					} else {
+						body = append(body, wasmtest.SLEB32(int32(coefficient))...)
+					}
+					operation := addOp
+					if subtract {
+						operation++
+					}
+					body = append(body, mulOp, operation)
+					if destination >= 0 {
+						body = append(body, 0x21, byte(destination), 0x20, byte(destination))
+					}
+					body = append(body, 0x0b)
+					m := mod1(t, []wasm.ValType{typ, typ}, []wasm.ValType{typ}, body)
+					m.Memories = []wasm.MemType{{Limits: wasm.Limits{Min: 1}}}
+					for _, enabled := range []bool{false, true} {
+						scaledConstMulEnabled = enabled
+						if diagnosticsEnabled && coefficient == 24 && destination == 2 {
+							stats := &ModuleStats{}
+							cm, err := CompileModuleWith(m, CompileOptions{Stats: stats})
+							if err != nil {
+								t.Fatal(err)
+							}
+							if cm.CodeImage != nil {
+								cm.CodeImage.Close()
+							}
+							if (stats.Funcs[0].Peephole["scaled-const-mul-add"] != 0) != enabled {
+								t.Fatalf("enabled=%v stats=%v", enabled, stats.Funcs[0].Peephole)
+							}
+						}
+
+						for _, input := range []uint64{0, 1, 0xffffffff, 0xfedcba9876543210} {
+							accumulator := uint64(0x123456789abcdef0)
+							want := accumulator + input*uint64(coefficient)
+							if subtract {
+								want = accumulator - input*uint64(coefficient)
+							}
+							if !wide {
+								want = uint64(uint32(want))
+							}
+							got, err := runArm64WrapperWithOptions(t, m, CompileOptions{}, accumulator, input)
+							if err != nil {
+								t.Fatal(err)
+							}
+							if got != want {
+								t.Fatalf("wide=%v coefficient=%d subtract=%v destination=%d enabled=%v input=%x got=%x want=%x", wide, coefficient, subtract, destination, enabled, input, got, want)
+							}
+						}
+					}
+				}
+			}
+		}
+	}
+}
+
+func TestScaledConstStandaloneMultiply(t *testing.T) {
+	saved := scaledConstMulEnabled
+	defer func() { scaledConstMulEnabled = saved }()
+	for _, wide := range []bool{false, true} {
+		typ, constOp, mulOp, localType := wasm.I32, byte(0x41), byte(0x6c), byte(0x7f)
+		if wide {
+			typ, constOp, mulOp, localType = wasm.I64, 0x42, 0x7e, 0x7e
+		}
+		for _, coefficient := range []int64{6, 10, 24, 72, 3 << 29} {
+			for _, sink := range []bool{false, true} {
+				body := []byte{1, 1, localType, 0x3f, 0, 0x1a, 0x20, 0, constOp}
+				if wide {
+					body = append(body, wasmtest.SLEB64(coefficient)...)
+				} else {
+					body = append(body, wasmtest.SLEB32(int32(coefficient))...)
+				}
+				body = append(body, mulOp)
+				if sink {
+					body = append(body, 0x21, 0, 0x20, 0)
+				}
+				body = append(body, 0x0b)
+				m := mod1(t, []wasm.ValType{typ}, []wasm.ValType{typ}, body)
+				m.Memories = []wasm.MemType{{Limits: wasm.Limits{Min: 1}}}
+				for _, enabled := range []bool{false, true} {
+					scaledConstMulEnabled = enabled
+					for _, input := range []uint64{0, 1, 0xffffffff, 0xfedcba9876543210} {
+						want := input * uint64(coefficient)
+						if !wide {
+							want = uint64(uint32(want))
+						}
+						got, err := runArm64WrapperWithOptions(t, m, CompileOptions{}, input)
+						if err != nil {
+							t.Fatal(err)
+						}
+						if got != want {
+							t.Fatalf("wide=%v coefficient=%d sink=%v enabled=%v input=%x got=%x want=%x", wide, coefficient, sink, enabled, input, got, want)
+						}
+					}
+				}
+			}
+		}
+	}
+}
