@@ -0,0 +1,17 @@
+//go:build arm64
+
+package arm64
+
+import "os"
+
+var branchlessSignedRemEnabled = os.Getenv("WAGO_ARM64_EXPERIMENT_BRANCHLESS_SIGNED_REM") == "1"
+
+// The caller has already emitted the zero-divisor trap. AArch64 SDIV truncates
+// signed overflow to INT_MIN, so MSUB also yields zero for INT_MIN % -1.
+func (f *fn) emitBranchlessSignedRem(result, dividend, divisor Reg, wide bool) {
+ q := f.allocReg(maskOf(divisor, dividend, result))
+ f.sdiv(q, dividend, divisor, wide)
+ f.msub(result, q, divisor, dividend, wide)
+ f.release(q)
+ f.stats.peep("branchless-signed-rem")
+}
--- a/src/core/compiler/backend/railshot/arm64/branchless_signed_rem_arm64_test.go
+++ b/src/core/compiler/backend/railshot/arm64/branchless_signed_rem_arm64_test.go
@@ -0,0 +1,87 @@
+//go:build (linux || darwin) && arm64
+
+package arm64
+
+import (
+	"errors"
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	rt "github.com/wago-org/wago/src/core/runtime"
+	"testing"
+)
+
+func TestBranchlessSignedRemSourcesAliasesAndTraps(t *testing.T) {
+	for _, borrowed := range []bool{false, true} {
+	for _, wide := range []bool{false, true} {
+		typ, xor := wasm.I32, byte(0x73)
+		min, minusOne := uint64(0x80000000), uint64(0xffffffff)
+		if wide {
+			typ, xor = wasm.I64, 0x85
+			min, minusOne = 1<<63, ^uint64(0)
+		}
+		for _, op := range divOps(wide) {
+			for _, same := range []bool{false, true} {
+				divisorLocal := byte(1)
+				if same {
+					divisorLocal = 0
+				}
+				body := []byte{0, 0x20, 0, 0x20, divisorLocal, op.opcode}
+				params := make([]wasm.ValType, 16)
+				for i := range params {
+					params[i] = typ
+					body = append(body, 0x20, byte(i), xor)
+				}
+				body = append(body, 0x0b)
+				m := mod1(t, params, []wasm.ValType{typ}, body)
+				for _, enabled := range []bool{false, true} {
+					for _, guard := range []bool{false, true} {
+						for _, pair := range [][2]uint64{{17, 5}, {0, 3}, {1, 1}, {min, minusOne}, {minusOne, 2}, {min, 3}, {minusOne, minusOne}, {7, 0}, {min, min}} {
+							args := make([]uint64, 16)
+							for i := range args {
+								args[i] = uint64(i*13 + 7)
+							}
+							args[0], args[1] = pair[0], pair[1]
+							n, d := args[0], args[divisorLocal]
+							if !wide {
+								n, d = uint64(uint32(n)), uint64(uint32(d))
+							}
+							opts := CompileOptions{ElideBoundsChecks: guard, Optimizations: map[string]bool{"borrowed-div-rem": borrowed, "branchless-signed-rem": enabled}}
+							var stats ModuleStats
+							admission := diagnosticsEnabled && !same && pair == [2]uint64{17, 5} && op.signed && op.rem
+							if admission {
+								opts.Stats = &stats
+							}
+							got, err := runArm64WrapperWithOptions(t, m, opts, args...)
+							if admission && (stats.Funcs[0].Peephole["branchless-signed-rem"] != 0) != enabled {
+								t.Fatalf("missing admission %s enabled=%v stats=%v", op.name, enabled, stats.Funcs[0].Peephole)
+							}
+							trap := rt.TrapCode(0)
+							if d == 0 {
+								trap = rt.TrapDivZero
+							} else if op.signed && !op.rem && n == min && d == minusOne {
+								trap = rt.TrapDivOverflow
+							}
+							if trap != 0 {
+								var te *rt.TrapError
+								if !errors.As(err, &te) || te.Code != trap {
+									t.Fatalf("%s n=%x d=%x trap=%v want=%v", op.name, n, d, err, trap)
+								}
+								continue
+							}
+							want := refDivRem(op, wide, n, d)
+							for _, x := range args {
+								want ^= x
+							}
+							if !wide {
+								want, got = uint64(uint32(want)), uint64(uint32(got))
+							}
+							if err != nil || got != want {
+								t.Fatalf("%s same=%v enabled=%v guard=%v n=%x d=%x got=%x want=%x err=%v", op.name, same, enabled, guard, n, d, got, want, err)
+							}
+						}
+					}
+				}
+			}
+		}
+	}
+}
