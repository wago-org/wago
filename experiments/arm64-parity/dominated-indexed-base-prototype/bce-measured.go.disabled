package arm64

import "encoding/binary"

// FoldDominatedIndexedBases propagates exact address seeds over finalized
// direct branches without changing code size. Callers must supply every
// additional native entry and exclude exception/custom entry points.
// Backward entries start unknown; forward joins intersect identical seeds.
func (a *Asm) FoldDominatedIndexedBases(entryOffsets ...int) int {
	n := len(a.B) &^ 3
	if n > 4096 {
		return 0
	}
	b := a.B[:n:n]
	// One seed id and three control flags per instruction. No heap backing.
	const target, backward, seen uint16 = 1 << 15, 1 << 14, 1 << 13
	const seedMask uint16 = 0x7ff
	var entries [1024]uint16
	branches := 0
	for pc := 0; pc+4 <= len(b); pc += 4 {
		w := binary.LittleEndian.Uint32(b[pc : pc+4])
		if w == 0xD503201F || w&0x1C000000 != 0x14000000 {
			continue
		}
		if w&0xFFFFFC1F == 0xD61F0000 {
			return 0
		}
		if to, ok := dominatedDirectBranchTarget(pc, w); ok {
			branches++
			if branches > 128 {
				return 0
			}
			if to >= 0 && to < n {
				entries[to/4] |= target
				if pc >= to {
					entries[to/4] |= backward
				}
			}
		}
	}
	// Wrapper/internal entries have an unknown incoming address state.
	for _, pc := range entryOffsets {
		if pc < 0 || pc >= n || pc&3 != 0 {
			return 0
		}
		entries[pc/4] |= target | backward
	}
	fact := uint16(0)
	reachable := true
	hits := 0
	for pc := 0; pc+4 <= len(b); pc += 4 {
		entry := entries[pc/4]
		if entry&target != 0 {
			switch {
			case entry&backward != 0:
				// Later predecessors are not yet proved; never reuse through this entry.
				fact = 0
				reachable = true
			case entry&seen != 0:
				incoming := entry & seedMask
				if !reachable {
					fact = incoming
					reachable = true
				} else if fact != incoming {
					fact = 0
				}
			}
		}
		word := binary.LittleEndian.Uint32(b[pc : pc+4])
		if word == 0xD503201F {
			continue
		}
		if to, ok := dominatedDirectBranchTarget(pc, word); ok {
			incoming := fact
			call := word&0xFC000000 == 0x94000000
			if call {
				incoming = 0
				fact = 0
			}
			if reachable && to >= 0 && to < n {
				slot := &entries[to/4]
				if *slot&seen == 0 {
					*slot = (*slot &^ seedMask) | seen | incoming
				} else if *slot&seedMask != incoming {
					*slot &^= seedMask
				}
			}
			if word&0xFC000000 == 0x14000000 {
				fact = 0
				reachable = false
			}
			continue
		}
		if !reachable {
			continue
		}
		if word&0xFFE0FC1F == 0x8B000010 {
			base, index := Reg(word>>5&31), Reg(word>>16&31)
			if base == X16 || index == X16 || base == ZR || index == ZR {
				fact = 0
				continue
			}
			if fact != 0 {
				seed := int(fact-1) * 4
				if pc >= 8 && pc-seed <= 256 && binary.LittleEndian.Uint32(b[seed:seed+4]) == word {
					binary.LittleEndian.PutUint32(b[pc:pc+4], 0xD503201F)
					hits++
					continue
				}
			}
			fact = uint16(pc/4 + 1)
			continue
		}
		if fact != 0 {
			seed := int(fact-1) * 4
			seedWord := binary.LittleEndian.Uint32(b[seed : seed+4])
			base, index := Reg(seedWord>>5&31), Reg(seedWord>>16&31)
			if !preservesDominatedIndexedBase(word, base, index) {
				fact = 0
			}
		}
	}
	return hits
}

func preservesDominatedIndexedBase(word uint32, base, index Reg) bool {
	if word == 0xD503201F {
		return true
	}
	// Direct non-call control transfers write no GPR. Edges are checked above.
	if word&0xFC000000 == 0x14000000 || word&0xFF000010 == 0x54000000 ||
		word&0x7E000000 == 0x34000000 || word&0x7E000000 == 0x36000000 {
		return true
	}
	// Conditional compares affect only NZCV, not the cached pointer inputs.
	if word&0x1FE00000 == 0x1A400000 {
		return true
	}
	// Recognized integer families each write only Rd. Calls, indirect control,
	// writeback memory, system instructions and unknown encodings are rejected.
	writesRd := word&0x1F000000 == 0x0A000000 ||
		word&0x1F800000 == 0x12000000 || word&0x1F800000 == 0x12800000 ||
		word&0x1F800000 == 0x13000000 || word&0x1F000000 == 0x1B000000 ||
		word&0x1FE00000 == 0x1AC00000 || word&0x5FE00000 == 0x5AC00000 ||
		word&0x1FE00000 == 0x1A800000
	if writesRd {
		dst := Reg(word & 31)
		return dst != X16 && dst != base && dst != index
	}
	return preservesIndexedBase(word, base, index)
}

func dominatedDirectBranchTarget(pc int, w uint32) (int, bool) {
	if w&0x1C000000 != 0x14000000 {
		return 0, false
	}
	switch {
	case w&0x7C000000 == 0x14000000:
		return pc + int(int32(w<<6)>>6)*4, true
	case w&0xFF000010 == 0x54000000 || w&0x7E000000 == 0x34000000:
		return pc + int(int32(w<<8)>>13)*4, true
	case w&0x7E000000 == 0x36000000:
		return pc + int(int32(w<<13)>>18)*4, true
	}
	return 0, false
}
