+// EnabledResolvedOptionRef performs the same resolved bit query without copying
+// the selection. Compilation backends keep an immutable, addressable selection
+// and query it repeatedly during instruction lowering.
+func (s *Selection) EnabledResolvedOptionRef(option Option) bool {
+	return s.bits[option.word]&option.mask != 0
+}
+
 // Valid reports whether the selection was resolved by a Bindings owner.
 func (s Selection) Valid() bool { return s.bindings != nil }
 
