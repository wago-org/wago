//go:build arm64

package arm64

import (
	"github.com/wago-org/wago/src/core/compiler/wasm"
	"github.com/wago-org/wago/tests/support/wasmtest"
	"testing"
)

func storeMapFixture(step, stride int32, paired, recurrence bool) []byte {
	var code []byte
	writes := 1
	if paired {
		writes = 2
	}
	for i := 0; i < writes; i++ {
		code = append(code, 0x20, 1)
		if i != 0 {
			code = append(code, 0x41, 4, 0x6a)
		}
		if recurrence {
			code = append(code, 0x20, 3, 0x41, 1, 0x73, 0x22, 3)
		} else {
			code = append(code, 0x20, 0, 0x41, 37, 0x6c, 0x41, 3, 0x76, 0x41, 7, 0x71, 0x45)
		}
		code = append(code, 0x36, 2, 0)
	}
	code = append(code, 0x20, 1, 0x41)
	code = append(code, wasmtest.SLEB32(stride)...)
	code = append(code, 0x6a, 0x21, 1)
	code = append(code, 0x20, 0, 0x41)
	code = append(code, wasmtest.SLEB32(step)...)
	code = append(code, 0x6a, 0x22, 0, 0x20, 2, 0x47, 0x0d, 0, 0x0b)
	return code
}

func TestStoreMapPreflight(t *testing.T) {
	f := fn{nLocals: 4, localType: []machineType{mtI32, mtI32, mtI32, mtI32}}
	for _, paired := range []bool{false, true} {
		stride, step := int32(4), int32(1)
		if paired {
			stride, step = 8, 2
		}
		body := storeMapFixture(step, stride, paired, false)
		r := wasm.ReaderFrom(body)
		p, ok := f.inspectStoreMap(&r)
		if !ok {
			t.Fatalf("paired=%v not admitted", paired)
		}
		if r.Offset() != 0 {
			t.Fatal("preflight consumed caller reader")
		}
		if p.counter != 0 || p.steps[0] != uint32(step) || p.steps[1] != uint32(stride) || p.end != len(body) {
			t.Fatalf("bad induction proof: %+v", p)
		}
		for i := 0; i < p.nWrites; i++ {
			if p.writes[i].stride != uint64(stride) {
				t.Fatal("wrong store stride")
			}
		}
	}
	for _, tc := range []struct {
		name string
		body []byte
	}{
		{"cross-iteration-recurrence", storeMapFixture(1, 4, false, true)},
		{"nonpositive-step", storeMapFixture(0, 4, false, false)},
		{"overlapping-iteration-store", storeMapFixture(1, 2, false, false)},
		{"load", append([]byte{0x20, 1, 0x28, 2, 0}, storeMapFixture(1, 4, false, false)...)},
		{"call", []byte{0x10, 0}},
		{"grow", []byte{0x40, 0}},
		{"nested-control", []byte{0x02, 0x40, 0x0b}},
		{"truncated", []byte{0x41, 0x80}},
	} {
		t.Run(tc.name, func(t *testing.T) {
			r := wasm.ReaderFrom(tc.body)
			if _, ok := f.inspectStoreMap(&r); ok {
				t.Fatal("unsafe loop admitted")
			}
			if r.Offset() != 0 {
				t.Fatal("failed preflight consumed reader")
			}
		})
	}
}

func TestStoreMapRangeAndDisjointnessProof(t *testing.T) {
	f := fn{nLocals: 4, localType: []machineType{mtI32, mtI32, mtI32, mtI32}}
	r := wasm.ReaderFrom(storeMapFixture(2, 8, true, false))
	p, ok := f.inspectStoreMap(&r)
	if !ok {
		t.Fatal("fixture declined")
	}
	for _, tc := range []struct {
		name                  string
		start, address, limit uint32
		bytes                 uint64
		want                  bool
	}{
		{"interleaved", 0, 0, 16, 64, true},
		{"unaligned", 0, 1, 16, 65, true},
		{"exact-end", 0, 4096, 16, 4160, true},
		{"cross-end", 0, 4096, 16, 4159, false},
		{"nonintegral-trip", 0, 0, 15, 64, false},
		{"wraparound-trip", 16, 0, 0, 64, false},
		{"address-wrap", 0, 0xfffffff8, 16, 1 << 33, false},
	} {
		t.Run(tc.name, func(t *testing.T) {
			_, _, ok := p.storeMapRanges([]uint32{tc.start, tc.address, tc.limit, 0}, tc.bytes)
			if ok != tc.want {
				t.Fatalf("safe=%v want=%v", ok, tc.want)
			}
		})
	}
	alias := p
	alias.writes[1].address = alias.writes[0].address
	if _, _, ok := alias.storeMapRanges([]uint32{0, 0, 16, 0}, 64); ok {
		t.Fatal("overlapping output streams admitted")
	}
	shifted := p
	shifted.writes[1].offset = 4
	if _, _, ok := shifted.storeMapRanges([]uint32{0, 0, 16, 0}, 128); ok {
		t.Fatal("cross-iteration output alias admitted")
	}
}

func TestStoreMapAcceptedRangesMatchScalarAddresses(t *testing.T) {
	f := fn{nLocals: 4, localType: []machineType{mtI32, mtI32, mtI32, mtI32}}
	for _, stride := range []int32{4, 8, 12, 16} {
		r := wasm.ReaderFrom(storeMapFixture(1, stride, true, false))
		p, ok := f.inspectStoreMap(&r)
		if !ok {
			t.Fatal("affine fixture declined")
		}
		for trips := uint32(1); trips <= 8; trips++ {
			for address := uint32(0); address < 4; address++ {
				for offset := uint64(0); offset < 24; offset++ {
					q := p
					q.writes[1].offset = offset
					got, _, safe := q.storeMapRanges([]uint32{0, address, trips, 0}, 128)
					if !safe {
						continue
					}
					if got != trips {
						t.Fatal("wrong trip count")
					}
					occupied := map[uint64]bool{}
					for iteration := uint32(0); iteration < trips; iteration++ {
						for store := 0; store < 2; store++ {
							base := uint64(address + iteration*uint32(stride))
							if store == 1 {
								base += 4 + offset
							}
							for byteIndex := uint64(0); byteIndex < 4; byteIndex++ {
								at := base + byteIndex
								if at >= 128 || occupied[at] {
									t.Fatalf("accepted unsafe scalar range stride=%d trips=%d address=%d offset=%d at=%d", stride, trips, address, offset, at)
								}
								occupied[at] = true
							}
						}
					}
				}
			}
		}
	}
}

func TestStoreMapRejectsMemoryAndLocalTypes(t *testing.T) {
	for _, mt := range []wasm.MemType{{Shared: true}, {Limits: wasm.Limits{Addr64: true}}} {
		f := fn{m: &wasm.Module{Memories: []wasm.MemType{mt}}, nLocals: 4, localType: []machineType{mtI32, mtI32, mtI32, mtI32}}
		r := wasm.ReaderFrom(storeMapFixture(1, 4, false, false))
		if _, ok := f.inspectStoreMap(&r); ok {
			t.Fatal("unsupported memory admitted")
		}
	}
	f := fn{nLocals: 4, localType: []machineType{mtI32, mtI32, mtI64, mtI32}}
	r := wasm.ReaderFrom(storeMapFixture(1, 4, false, false))
	if _, ok := f.inspectStoreMap(&r); ok {
		t.Fatal("non-i32 local admitted")
	}
}
