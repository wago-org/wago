//go:build arm64

package arm64

import (
	"bytes"
	"encoding/binary"
	"github.com/wago-org/wago/src/core/compiler/wasm"
	coreruntime "github.com/wago-org/wago/src/core/runtime"
	"testing"
)

func storeMapLoopModule(t testing.TB, paired bool) *wasm.Module {
	// Params: trip count, address, seed. Locals: index, last value, checksum,
	// checksum index, original address. Both loops have ordinary scalar tails.
	body := []byte{1, 5, 0x7f, 0x20, 1, 0x21, 7, 0x02, 0x40, 0x20, 0, 0x45, 0x0d, 0, 0x03, 0x40}
	streams := 1
	stride := byte(4)
	if paired {
		streams = 2
		stride = 8
	}
	for stream := 0; stream < streams; stream++ {
		body = append(body, 0x20, 1)
		if stream != 0 {
			body = append(body, 0x41, 4, 0x6a)
		}
		body = append(body, 0x20, 3, 0x20, 2, 0x6a, 0x41, byte(37+stream), 0x6c, 0x41, 3, 0x76, 0x41, 7, 0x71, 0x45, 0x22, 4, 0x36, 0, 0)
	}
	body = append(body, 0x20, 1, 0x41, stride, 0x6a, 0x21, 1, 0x20, 3, 0x41, 1, 0x6a, 0x22, 3, 0x20, 0, 0x47, 0x0d, 0, 0x0b, 0x03, 0x40)
	for stream := 0; stream < streams; stream++ {
		body = append(body, 0x20, 5, 0x20, 7, 0x28, 0, byte(stream*4), 0x6a, 0x21, 5)
	}
	body = append(body, 0x20, 7, 0x41, stride, 0x6a, 0x21, 7, 0x20, 6, 0x41, 1, 0x6a, 0x22, 6, 0x20, 0, 0x47, 0x0d, 0, 0x0b, 0x0b, 0x20, 5, 0x20, 3, 0x6a, 0x20, 1, 0x6a, 0x20, 4, 0x6a, 0x0b)
	return modMem(t, 1, []wasm.ValType{wasm.I32, wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, body)
}

func TestStoreMapLoopExecution(t *testing.T) {
	old := storeMapEnabled
	defer func() { storeMapEnabled = old }()
	for _, paired := range []bool{false, true} {
		m := storeMapLoopModule(t, paired)
		streams, stride := uint32(1), uint32(4)
		if paired {
			streams, stride = 2, 8
		}
		for _, enabled := range []bool{false, true} {
			storeMapEnabled = enabled
			for _, guard := range []bool{false, true} {
				for _, count := range []uint32{0, 1, 3, 4, 5, 7, 8, 9, 17} {
					for _, seed := range []uint32{0, 0xfffffff0} {
						for _, address := range []uint32{0, 1, 123} {
							var sum, last uint32
							for index := uint32(0); index < count; index++ {
								for stream := uint32(0); stream < streams; stream++ {
									last = 0
									if ((index+seed)*(37+stream)>>3)&7 == 0 {
										last = 1
									}
									sum += last
								}
							}
							want := sum + count + address + count*stride + last
							got, err := runArm64WrapperWithOptions(t, m, CompileOptions{ElideBoundsChecks: guard, CompactNative: false}, uint64(count), uint64(address), uint64(seed))
							if err != nil || uint32(got) != want {
								t.Fatalf("pair=%v enabled=%v guard=%v count=%d address=%d seed=%x got=%x want=%x err=%v", paired, enabled, guard, count, address, seed, got, want, err)
							}
						}
					}
				}
			}
		}
	}
}
func TestStoreMapLoopAdmission(t *testing.T) {
	requireCompilerDiagnostics(t)
	old := storeMapEnabled
	defer func() { storeMapEnabled = old }()
	for _, paired := range []bool{false, true} {
		for _, enabled := range []bool{false, true} {
			storeMapEnabled = enabled
			stats := compileWithStats(t, storeMapLoopModule(t, paired), false).Funcs[0]
			hits := stats.Peephole["store-map-vector"]
			if enabled && hits != 1 || !enabled && hits != 0 {
				t.Fatalf("pair=%v enabled=%v hits=%d", paired, enabled, hits)
			}
		}
	}
}

func runStoreMapMemory(t *testing.T, m *wasm.Module, guard bool, args ...uint64) ([]byte, error) {
	t.Helper()
	cm, err := CompileModuleWith(m, CompileOptions{ElideBoundsChecks: guard, CompactNative: false})
	if err != nil {
		t.Fatal(err)
	}
	if cm.CodeImage != nil {
		defer cm.CodeImage.Close()
	}
	engine, err := coreruntime.NewEngine()
	if err != nil {
		t.Fatal(err)
	}
	defer engine.Close()
	memory, err := newStoreMapTestMemory(guard)
	if err != nil {
		t.Fatal(err)
	}
	defer memory.Close()
	for i := range memory.CurrentBytes() {
		memory.CurrentBytes()[i] = 0xa5
	}
	arena, err := coreruntime.NewArena(4096)
	if err != nil {
		t.Fatal(err)
	}
	defer arena.Close()
	code, entry, err := coreruntime.MapCode(cm.Code)
	if err != nil {
		t.Fatal(err)
	}
	defer coreruntime.Unmap(code)
	serialized, result, trap := arena.Alloc(64), arena.Alloc(16), arena.Alloc(coreruntime.TrapBufferBytes)
	for i, arg := range args {
		binary.LittleEndian.PutUint64(serialized[i*8:], arg)
	}
	err = callStoreMapTest(engine, entry+uintptr(cm.Entry[0]), serialized, trap, result, memory, guard)
	return append([]byte(nil), memory.CurrentBytes()...), err
}
func TestStoreMapLoopAliasesAndTraps(t *testing.T) {
	old := storeMapEnabled
	defer func() { storeMapEnabled = old }()
	body := []byte{1, 1, 0x7f, 0x02, 0x40, 0x20, 0, 0x45, 0x0d, 0, 0x03, 0x40}
	for stream := byte(0); stream < 2; stream++ {
		body = append(body, 0x20, 1+stream, 0x20, 3, 0x41, 3+stream*4, 0x6a, 0x36, 0, 0)
	}
	for stream := byte(0); stream < 2; stream++ {
		body = append(body, 0x20, 1+stream, 0x41, 4, 0x6a, 0x21, 1+stream)
	}
	body = append(body, 0x20, 3, 0x41, 1, 0x6a, 0x22, 3, 0x20, 0, 0x47, 0x0d, 0, 0x0b, 0x0b, 0x20, 3, 0x0b)
	m := modMem(t, 1, []wasm.ValType{wasm.I32, wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, body)
	for _, guard := range []bool{false, true} {
		for _, tc := range []struct {
			a, b uint64
			trap bool
		}{{128, 128, false}, {128, 132, false}, {128, 144, false}, {128, 256, false}, {65520, 65536, true}, {65520, 65520, true}} {
			if guard && tc.trap && !storeMapGuardPageTests {
				continue
			}
			storeMapEnabled = false
			want, referenceErr := runStoreMapMemory(t, m, guard, 8, tc.a, tc.b)
			storeMapEnabled = true
			got, err := runStoreMapMemory(t, m, guard, 8, tc.a, tc.b)
			if (err != nil) != tc.trap || (referenceErr != nil) != tc.trap {
				t.Fatalf("guard=%v a=%d b=%d wrong trap: %v / %v", guard, tc.a, tc.b, err, referenceErr)
			}
			if !bytes.Equal(got, want) {
				t.Fatalf("guard=%v a=%d b=%d changed alias or pre-trap memory effects", guard, tc.a, tc.b)
			}
		}
	}
}
