+func TestOrdinaryShiftedImmediateEdgesArm64(t *testing.T) {
+	saved := shiftedAddSubOrdinaryEnabled
+	defer func() { shiftedAddSubOrdinaryEnabled = saved }()
+	for _, wide := range []bool{false, true} {
+		typ, constantOp := wasm.I32, byte(0x41)
+		if wide {
+			typ, constantOp = wasm.I64, 0x42
+		}
+		for _, subtract := range []bool{false, true} {
+			operation := byte(0x6a)
+			if subtract {
+				operation = 0x6b
+			}
+			if wide {
+				operation += 0x12
+			}
+			for _, constant := range []int64{4096, -4096, 65536, -65536, 0xfff000, -0xfff000, 0x1000000, 0xfff001} {
+				body := []byte{0, 0x20, 0, constantOp}
+				if wide {
+					body = append(body, wasmtest.SLEB64(constant)...)
+				} else {
+					body = append(body, wasmtest.SLEB32(int32(constant))...)
+				}
+				body = append(body, operation, 0x0b)
+				m := mod1(t, []wasm.ValType{typ}, []wasm.ValType{typ}, body)
+				for _, enabled := range []bool{false, true} {
+					shiftedAddSubOrdinaryEnabled = enabled
+					for _, input := range []uint64{7, 0xfedcba98fedcba98} {
+						want := input + uint64(constant)
+						if subtract {
+							want = input - uint64(constant)
+						}
+						if !wide {
+							want = uint64(uint32(want))
+						}
+						got, err := runArm64WrapperWithOptions(t, m, CompileOptions{}, input)
+						if err != nil {
+							t.Fatal(err)
+						}
+						if got != want {
+							t.Fatalf("wide=%v subtract=%v constant=%d enabled=%v input=%x got=%x want=%x", wide, subtract, constant, enabled, input, got, want)
+						}
+					}
+				}
+			}
+		}
+	}
+}
