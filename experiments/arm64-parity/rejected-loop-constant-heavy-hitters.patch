+func TestLoopIntConstKeepsLaterFrequentCandidatesArm64(t *testing.T) {
+	saved := loopConstHeavyHittersEnabled
+	defer func() { loopConstHeavyHittersEnabled = saved }()
+	for _, enabled := range []bool{false, true} {
+		loopConstHeavyHittersEnabled = enabled
+		scanner := byteBodyScanner{}
+		for i := 0; i < maxLoopIntConstCandidates; i++ {
+			scanner.noteLoopIntConst(int64(0x123456701+i), 2, 1, 1)
+		}
+		late := int64(0x23456789abcdef1)
+		for range 16 {
+			scanner.noteLoopIntConst(late, 2, 1, 1)
+		}
+		scanner.noteLoopIntConst(0x3456789abcdef12, 2, 1, 1)
+		scanner.finishLoopIntConsts()
+		found := false
+		for i := 0; i < int(scanner.h.loopIntConstCount); i++ {
+			if scanner.h.loopIntConst[i] == late {
+				found = true
+				if scanner.h.loopIntConstTypes>>(2*i)&3 != 2 {
+					t.Fatal("late i64 constant lost width")
+				}
+			}
+		}
+		if found != enabled {
+			t.Fatalf("enabled=%v selected=%v", enabled, scanner.h.loopIntConst[:scanner.h.loopIntConstCount])
+		}
+	}
+}
