diff --git a/src/core/compiler/backend/railshot/arm64/select_lazy.go b/src/core/compiler/backend/railshot/arm64/select_lazy.go
new file mode 100644
index 00000000..b670bf2c
--- /dev/null
+++ b/src/core/compiler/backend/railshot/arm64/select_lazy.go
@@ -0,0 +1,117 @@
+//go:build arm64
+
+package arm64
+
+import "os"
+
+var lazyIntegerSelectEnabled = os.Getenv("WAGO_ARM64_NO_LAZY_INTEGER_SELECT") != "1"
+
+// selectArmCost admits only a bounded, nontrapping integer accumulator tree.
+// Leaves are constants or already homed values; loads, division, references,
+// and any operation with an observable effect retain eager Wasm evaluation.
+func (f *fn) selectArmCost(e *elem, budget int) (int, bool) {
+	if budget == 0 || e == nil || (e.st.typ != mtI32 && e.st.typ != mtI64) {
+		return 0, false
+	}
+	if !e.isDeferred() {
+		switch e.st.kind {
+		case stConst, stLocalReg, stSlot:
+			return 0, true
+		}
+		return 0, false
+	}
+	op := e.deferredOp()
+	if !isBinALU(op) && !isShift(op) {
+		return 0, false
+	}
+	right := f.s.arg1(e)
+	if right.isDeferred() {
+		return 0, false
+	}
+	if _, ok := f.selectArmCost(right, 1); !ok {
+		return 0, false
+	}
+	cost, ok := f.selectArmCost(f.s.arg0(e), budget-1)
+	if !ok {
+		return 0, false
+	}
+	if op == opMul {
+		cost += 3
+	} else {
+		cost++
+	}
+	return cost, true
+}
+
+// Branch around an expensive pure arm instead of executing it unconditionally
+// before CSEL. All surviving register owners are frozen across the branch, so
+// conditional lowering cannot introduce spills that the skipped edge misses.
+func (f *fn) tryLazyIntegerSelect() bool {
+	if !f.opt(optLazyIntegerSelect) {
+		return false
+	}
+	cond := f.s.back()
+	if cond == nil {
+		return false
+	}
+	b := f.s.prev(f.s.baseOfValentBlock(cond))
+	if b == f.s.head {
+		return false
+	}
+	a := f.s.prev(f.s.baseOfValentBlock(b))
+	if a == f.s.head {
+		return false
+	}
+	if _, ok := f.selectArmCost(b, 1); !ok {
+		return false
+	}
+	cost, ok := f.selectArmCost(a, 16)
+	if !ok || cost < 12 {
+		return false
+	}
+	// Leave enough registers for the predicate, result and bounded accumulator
+	// lowering without evicting any persistent register or regional-local cache.
+	frozen := f.pinned
+	for _, r := range gpAlloc {
+		if f.regUser[r] != nil {
+			frozen = frozen.add(r)
+		}
+	}
+	blocked := frozen.union(f.pinnedLocalMask).union(f.reserved)
+	free := 0
+	for _, r := range gpAlloc {
+		if !blocked.has(r) {
+			free++
+		}
+	}
+	if free < 7 {
+		return false
+	}
+	c := f.popValue()
+	cr := f.materialize(c)
+	f.pinned = f.pinned.add(cr)
+	bv := f.popValue()
+	br := f.materialize(bv)
+	if a.st.typ == mtI32 {
+		// Serialized i32 parameters and slots can have noncanonical high bits.
+		f.a.MovReg32(br, br)
+	}
+	// Predicate/result preparation is unconditional. Snapshot the resulting
+	// owner set, including any registers allocated while realizing the predicate.
+	saved := f.pinned
+	for _, r := range gpAlloc {
+		if f.regUser[r] != nil {
+			f.pinned = f.pinned.add(r)
+		}
+	}
+	f.pinned = f.pinned.add(br)
+	skip := f.a.Cbz32(cr)
+	f.condenseInto(a, br)
+	f.erase(a)
+	f.patchBranch19(skip, f.a.Len())
+	f.pinned = saved.remove(cr)
+	f.release(cr)
+	f.pushReg(br, a.st.typ)
+	f.stats.peep("lazy-integer-select")
+	return true
+}
diff --git a/src/core/compiler/backend/railshot/arm64/select_lazy_arm64_test.go b/src/core/compiler/backend/railshot/arm64/select_lazy_arm64_test.go
new file mode 100644
index 00000000..c1ae5e52
--- /dev/null
+++ b/src/core/compiler/backend/railshot/arm64/select_lazy_arm64_test.go
@@ -0,0 +1,94 @@
+//go:build (linux || darwin || windows) && arm64
+
+package arm64
+
+import (
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	"testing"
+)
+
+func lazySelectModule(t testing.TB, wide bool, trap bool, tee bool) *wasm.Module {
+	typ := wasm.I32
+	cn, mul, xor := byte(0x41), byte(0x6c), byte(0x73)
+	if wide {
+		typ = wasm.I64
+		cn, mul, xor = 0x42, 0x7e, 0x85
+	}
+	body := []byte{0, 0x20, 0}
+	// Two independent multiply stages separated by XOR, rather than a foldable
+	// constant multiplier chain. Both inputs and the fallback remain live.
+	body = append(body, cn, 17, mul, cn, 31, xor, cn, 23, mul)
+	if trap {
+		body = append(body, cn, 0)
+		if wide {
+			body = append(body, 0x80)
+		} else {
+			body = append(body, 0x6e)
+		}
+	}
+	body = append(body, 0x20, 1, 0x20, 2, 0x1b)
+	if tee {
+		body = append(body, 0x22, 0, 0x20, 0, xor)
+	}
+	body = append(body, 0x0b)
+	return mod1(t, []wasm.ValType{typ, typ, wasm.I32}, []wasm.ValType{typ}, body)
+}
+
+func TestLazyIntegerSelectValuesAndTrapOrder(t *testing.T) {
+	for _, wide := range []bool{false, true} {
+		for _, tee := range []bool{false, true} {
+			for _, enabled := range []bool{false, true} {
+				opts := CompileOptions{Optimizations: map[string]bool{"lazy-integer-select": enabled}}
+				for _, v := range []uint64{0, 1, 0x89abcdef, 0xffffffffffffffff} {
+					for _, cond := range []uint64{0, 1, 0x80000000} {
+						got, err := runArm64WrapperWithOptions(t, lazySelectModule(t, wide, false, tee), opts, v, 97, cond)
+						if err != nil {
+							t.Fatal(err)
+						}
+						want := uint64(97)
+						if cond != 0 {
+							want = ((v * 17) ^ 31) * 23
+						}
+						if !wide {
+							want = uint64(uint32(want))
+						}
+						if tee {
+							want = 0
+						}
+						if got != want {
+							t.Fatalf("wide=%v tee=%v enabled=%v v=%x cond=%x: got %x want %x", wide, tee, enabled, v, cond, got, want)
+						}
+					}
+				}
+				// Wasm select evaluates both arms. A zero divisor must still trap even
+				// when the result from that arm would not have been selected.
+				_, err := runArm64WrapperWithOptions(t, lazySelectModule(t, wide, true, false), opts, 7, 97, 0)
+				if err == nil {
+					t.Fatal("unselected trapping arm did not trap")
+				}
+			}
+		}
+	}
+}
+
+func TestLazyIntegerSelectAdmission(t *testing.T) {
+	requireCompilerDiagnostics(t)
+	for _, wide := range []bool{false, true} {
+		for _, trap := range []bool{false, true} {
+			for _, enabled := range []bool{false, true} {
+				stats := &ModuleStats{}
+				_, err := CompileModuleWith(lazySelectModule(t, wide, trap, false), CompileOptions{Stats: stats, Optimizations: map[string]bool{"lazy-integer-select": enabled}})
+				if err != nil {
+					t.Fatal(err)
+				}
+				var count int
+				for _, f := range stats.Funcs {
+					count += f.Peephole["lazy-integer-select"]
+				}
+				if (count != 0) != (enabled && !trap) {
+					t.Fatalf("wide=%v trap=%v enabled=%v: lazy select count %d", wide, trap, enabled, count)
+				}
+			}
+		}
+	}
+}
