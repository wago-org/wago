+// This experiment widens the already admitted group across its preceding select.
+// Both arms are still evaluated eagerly before the guard, including traps.
+func (f *fn) selectGroupEntryPlan(reader *wasm.Reader, destination int, yes, no, condition *elem) (selectGroupPlan, bool) {
+	if !selectGroupEntryEnabled || !f.opt(optSelectGroupGuard) || f.selectGroupEnd != 0 || f.usesCalls || f.localBase != 0 || len(f.customInstructions) != 0 || len(f.intervalLast) != 0 || !f.canonicalI32Local(destination) {
+		return selectGroupPlan{}, false
+	}
+	if !f.selectGroupPureArm(yes) {
+		return selectGroupPlan{}, false
+	}
+	if no.elemKind() != ekValue || no.st.kind != stLocalReg || no.st.index() != destination || no.st.typ != mtI32 || condition == nil || !condition.isDeferred() || condition.deferredOp() != opAnd || condition.st.typ != mtI32 {
+		return selectGroupPlan{}, false
+	}
+	left, right := f.s.arg0(condition), f.s.arg1(condition)
+	if left.elemKind() == ekValue && left.st.kind == stConst {
+		left, right = right, left
+	}
+	if left.elemKind() != ekValue || (left.st.kind != stLocalReg && left.st.kind != stReg) || right.elemKind() != ekValue || right.st.kind != stConst {
+		return selectGroupPlan{}, false
+	}
+	plan, okay := f.scanSelectGroup(reader, destination)
+	if !okay {
+		return selectGroupPlan{}, false
+	}
+	maskReg, floating, pinned := f.pinReg(plan.maskLocal)
+	if !pinned || floating {
+		return selectGroupPlan{}, false
+	}
+	if left.st.kind == stLocalReg {
+		if left.st.index() != plan.maskLocal {
+			return selectGroupPlan{}, false
+		}
+	} else if left.st.reg != maskReg {
+		return selectGroupPlan{}, false
+	}
+	plan.mask |= uint32(right.st.cval)
+	return plan, true
+}
+
+func (f *fn) selectGroupPureArm(root *elem) bool {
+	for e := f.s.baseOfValentBlock(root); ; e = f.s.next(e) {
+		if e.isDeferred() {
+			if e.st.typ != mtI32 {
+				return false
+			}
+			switch e.deferredOp() {
+			case opAdd, opSub, opMul, opAnd, opOr, opXor, opShl, opShrS, opShrU, opRotl, opRotr:
+			default:
+				return false
+			}
+		} else if e.elemKind() != ekValue {
+			return false
+		} else {
+			switch e.st.kind {
+			case stConst, stReg, stLocalReg, stLocalRef, stSlot:
+			default:
+				return false
+			}
+		}
+		if e == root {
+			return true
+		}
+	}
+}
