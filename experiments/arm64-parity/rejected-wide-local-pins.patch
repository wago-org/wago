+// Prefer permanent pins for reads that regional leases must recover after an
+// edge. This is a placement score, not a semantic liveness proof.
+func (f *fn) crossRegionPinScore(local int, score uint32) uint32 {
+	if !f.intervalControl || local >= len(f.intervalHead)-1 || len(f.intervalEvents) == 0 {
+		return 0
+	}
+	boundary := f.intervalHead[f.nLocals]
+	region, previous, first := 0, -1, -1
+	reads, crossings := uint64(0), uint64(0)
+	firstRead := false
+	for i := f.intervalHead[local]; i != noIntervalEvent; i = f.intervalEvents[i].next {
+		event := f.intervalEvents[i]
+		pos := event.pos & ^intervalEventKill
+		for boundary != noIntervalEvent && f.intervalEvents[boundary].pos < pos {
+			region++
+			boundary = f.intervalEvents[boundary].next
+		}
+		read := event.pos&intervalEventKill == 0
+		if first == -1 {
+			first = region
+			firstRead = read
+		}
+		if read {
+			reads++
+			if previous >= 0 && previous != region {
+				crossings++
+			}
+		}
+		previous = region
+	}
+	if f.hasLoop && firstRead && first != previous {
+		crossings++
+	}
+	if reads == 0 {
+		return 0
+	}
+	return uint32(uint64(score) * crossings / reads)
+}
