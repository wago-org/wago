+func TestWideStaticPinsControlEdges(t *testing.T) {
+	saved := wideStaticPins
+	defer func() { wideStaticPins = saved }()
+	for _, pins := range []int{2, 4, 6} {
+		wideStaticPins = pins
+		if diagnosticsEnabled {
+			stats := &ModuleStats{}
+			cm, err := CompileModuleWith(intervalControlModule(t), CompileOptions{Stats: stats, Optimizations: map[string]bool{"interval-region-pins": true}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if cm.CodeImage != nil {
+				cm.CodeImage.Close()
+			}
+			if stats.Funcs[0].PinnedLocals < pins {
+				t.Fatalf("pins=%d assigned=%d", pins, stats.Funcs[0].PinnedLocals)
+			}
+		}
+		t.Run(string(rune('0'+pins))+"/diamonds", TestIntervalControlBackedgesAndDiamonds)
+		t.Run(string(rune('0'+pins))+"/detached-select", TestIntervalDetachedSelectSurvivesEviction)
+		t.Run(string(rune('0'+pins))+"/fused-exit", TestIntervalControlFusedExitCanonicalizesLocals)
+		t.Run(string(rune('0'+pins))+"/counted-loop", TestIntervalCountedLoopCanonicalizesBackedge)
+	}
+}
