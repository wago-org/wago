diff --git a/src/core/compiler/backend/railshot/arm64/entry_dead_zeros.go b/src/core/compiler/backend/railshot/arm64/entry_dead_zeros.go
new file mode 100644
index 00000000..5b37738c
--- /dev/null
+++ b/src/core/compiler/backend/railshot/arm64/entry_dead_zeros.go
@@ -0,0 +1,89 @@
+//go:build arm64
+
+package arm64
+
+import "os"
+
+var entryDeadZerosEnabled = os.Getenv("WAGO_ARM64_EXPERIMENT_ENTRY_DEAD_ZEROS") == "1"
+
+// Restrict the analysis to call-making integer functions with enough eager
+// initial homes to repay a structured scan. Call-free functions already retain
+// locals cheaply; references and EH need independent root/handler proofs.
+func (f *fn) tryZeroDeadIntegerLocals(localScores []uint32) bool {
+	if !f.makesCalls || f.lazyZero || f.m == nil || f.ft == nil || f.inlineDepth != 0 || f.localBase != 0 ||
+		len(f.inlineBase) != 0 || len(f.localType) != f.nLocals || f.moduleEH || len(f.gcTypeLayouts) != 0 ||
+		f.gcFrameRoots != nil || len(f.customInstructions) != 0 {
+		return false
+	}
+	idx := int(f.traceFuncIdx) - f.m.ImportedFuncCount()
+	if idx < 0 || idx >= len(f.m.Code) {
+		return false
+	}
+	body := f.m.Code[idx].BodyBytes
+	if f.nLocals > 64 || f.nLocals-f.nParams < 8 || len(body) == 0 || len(body) > maxLocalInitializationBody ||
+		!sigIsIntOnly(f.ft) {
+		return false
+	}
+	for _, typ := range f.localType {
+		if typ != mtI32 && typ != mtI64 {
+			return false
+		}
+	}
+	var candidates uint64
+	for x := f.nParams; x < f.nLocals; x++ {
+		if f.opt(optEntryInitElision) && x < len(localScores) && localScores[x]&localScoreEntryInitialized != 0 {
+			continue // the existing prefix proof already eliminates this zero
+		}
+		candidates |= uint64(1) << uint(x)
+	}
+	if candidates == 0 {
+		return false
+	}
+	needed, ok := scanInitialLocalReads(body, f.classifier)
+	if !ok {
+		return false
+	}
+	if mask := candidates &^ needed; mask != 0 {
+		f.stats.peep("entry-dead-zeros-analysis")
+		f.zeroDeadIntegerLocals(localScores, mask)
+		return true
+	}
+	return false
+}
+
+// Eligible functions have only integer locals and no EH/GC lane initialization.
+// Select this cold path once; the ordinary OFF/unaffected eager-zero loop retains
+// its original work per local. Scores remain immutable, and prefix and new-proof
+// counters retain their independent policy meaning.
+func (f *fn) zeroDeadIntegerLocals(localScores []uint32, dead uint64) {
+	pairZeros := f.opt(optEntryZeroPairs)
+	prefixProof := f.opt(optEntryInitElision)
+	pendingZero := int32(-1)
+	for x := f.nParams; x < f.nLocals; x++ {
+		prefix := prefixProof && x < len(localScores) && localScores[x]&localScoreEntryInitialized != 0
+		if prefix || dead&(uint64(1)<<uint(x)) != 0 {
+			if pairZeros {
+				pendingZero = f.flushDeclaredZeroSlot(pendingZero)
+			}
+			if prefix {
+				f.stats.peep("entry-init-elide")
+			} else {
+				f.stats.peep("entry-dead-zero-elide")
+			}
+			continue
+		}
+		if reg, _, ok := f.pinReg(x); ok {
+			if pairZeros {
+				pendingZero = f.flushDeclaredZeroSlot(pendingZero)
+			}
+			f.a.MovImm64(reg, 0)
+		} else if pairZeros {
+			pendingZero = f.queueDeclaredZeroSlot(pendingZero, f.localOff(x))
+		} else {
+			f.st64(SP, f.localOff(x), ZR)
+		}
+	}
+	if pairZeros {
+		f.flushDeclaredZeroSlot(pendingZero)
+	}
+}
diff --git a/src/core/compiler/backend/railshot/arm64/structured_local_initialization.go b/src/core/compiler/backend/railshot/arm64/structured_local_initialization.go
new file mode 100644
index 00000000..09a1597d
--- /dev/null
+++ b/src/core/compiler/backend/railshot/arm64/structured_local_initialization.go
@@ -0,0 +1,158 @@
+//go:build arm64
+
+package arm64
+
+import "github.com/wago-org/wago/src/core/compiler/wasm"
+
+const maxLocalInitializationBody = 4 << 10
+
+type localInitializationFrame struct {
+	entry, end                            uint64
+	kind                                  byte
+	entryReachable, endReachable, hasElse bool
+}
+
+func (fr *localInitializationFrame) merge(written uint64, reachable bool) {
+	if !reachable {
+		return
+	}
+	if fr.endReachable {
+		fr.end &= written
+	} else {
+		fr.end = written
+		fr.endReachable = true
+	}
+}
+
+// scanInitialLocalReads proves which incoming scalar-local values may be read
+// before any definition. Written bits only increase along an execution path.
+// Forward target and if joins intersect every reachable predecessor. A loop's
+// initial-entry mask remains a lower bound on every backedge: assignments cannot
+// make a local unwritten. One traversal therefore suffices, without a CFG,
+// fixed-point passes, heap allocation, or a retained per-module sidecar.
+func scanInitialLocalReads(body []byte, classifier wasm.ModuleInstructionClassifier) (needed uint64, ok bool) {
+	if len(body) == 0 || len(body) > maxLocalInitializationBody {
+		return 0, false
+	}
+	var frames [64]localInitializationFrame
+	frames[0] = localInitializationFrame{entryReachable: true}
+	depth := 1
+	written, reachable := uint64(0), true
+	r := wasm.ReaderFrom(body)
+	branch := func(label uint32) bool {
+		if uint64(label) >= uint64(depth) {
+			return false
+		}
+		fr := &frames[depth-1-int(label)]
+		if fr.kind != 0 && fr.kind != 0x03 {
+			fr.merge(written, reachable)
+		}
+		return true
+	}
+	for r.HasNext() && depth != 0 {
+		op, err := r.Byte()
+		if err != nil {
+			return 0, false
+		}
+		switch op {
+		case 0x00, 0x0f:
+			reachable = false
+		case 0x12, 0x13, 0x15:
+			var imm wasm.InstructionImmediate
+			if err := classifier.ClassifyInto(&r, op, &imm); err != nil {
+				return 0, false
+			}
+			reachable = false
+		case 0x02, 0x03, 0x04:
+			if depth == len(frames) {
+				return 0, false
+			}
+			if err := wasm.SkipInstructionImmediate(&r, op); err != nil {
+				return 0, false
+			}
+			frames[depth] = localInitializationFrame{kind: op, entry: written, entryReachable: reachable}
+			depth++
+		case 0x05:
+			fr := &frames[depth-1]
+			if fr.kind != 0x04 || fr.hasElse {
+				return 0, false
+			}
+			fr.merge(written, reachable)
+			written, reachable = fr.entry, fr.entryReachable
+			fr.hasElse = true
+		case 0x0b:
+			fr := &frames[depth-1]
+			if fr.kind == 0x04 && !fr.hasElse {
+				fr.merge(fr.entry, fr.entryReachable)
+			}
+			fr.merge(written, reachable)
+			written, reachable = fr.end, fr.endReachable
+			depth--
+		case 0x0c, 0x0d:
+			label, err := r.U32()
+			if err != nil || !branch(label) {
+				return 0, false
+			}
+			if op == 0x0c {
+				reachable = false
+			}
+		case 0x0e:
+			n, err := r.U32()
+			if err != nil || uint64(n)+1 > uint64(r.BytesLeft()) {
+				return 0, false
+			}
+			for j := uint32(0); j <= n; j++ {
+				label, err := r.U32()
+				if err != nil || !branch(label) {
+					return 0, false
+				}
+			}
+			reachable = false
+		case 0x20, 0x21, 0x22:
+			x, err := r.U32()
+			if err != nil || x >= 64 {
+				return 0, false
+			}
+			if reachable {
+				bit := uint64(1) << x
+				if op == 0x20 {
+					needed |= bit &^ written
+				} else {
+					written |= bit
+				}
+			}
+		case 0x06, 0x07, 0x08, 0x09, 0x0a, 0x18, 0x19, 0x1f:
+			return 0, false // EH has additional handler edges
+		default:
+			if op >= 0xd0 && op != 0xfc {
+				return 0, false
+			}
+			if _, ok := wasm.ImmediateFreeInstructionKind(op); ok {
+				continue
+			}
+			var err error
+			switch op {
+			case 0x41:
+				_, err = r.I32()
+			case 0x42:
+				_, err = r.I64()
+			case 0x43:
+				_, err = r.Bytes(4)
+			case 0x44:
+				_, err = r.Bytes(8)
+			case 0x10, 0x14, 0x23, 0x24, 0x25, 0x26, 0x3f, 0x40:
+				_, err = r.U32()
+			default:
+				var imm wasm.InstructionImmediate
+				err = classifier.ClassifyInto(&r, op, &imm)
+			}
+			if err != nil {
+				return 0, false
+			}
+		}
+	}
+	if depth != 0 || r.HasNext() {
+		return 0, false
+	}
+	return needed, true
+}
diff --git a/src/core/compiler/backend/railshot/arm64/entry_dead_zeros_arm64_test.go b/src/core/compiler/backend/railshot/arm64/entry_dead_zeros_arm64_test.go
