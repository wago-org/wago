//go:build (linux || darwin) && arm64 && wago_guardpage

package arm64

import (
	"encoding/binary"
	"errors"
	"testing"

	"github.com/wago-org/wago/src/core/compiler/wasm"
	rt "github.com/wago-org/wago/src/core/runtime"
)

func runSelectFactsFixture(t *testing.T, m *wasm.Module, opts CompileOptions, args ...uint64) (uint64, error) {
	t.Helper()
	cm, err := CompileModuleWith(m, opts)
	if err != nil {
		t.Fatal(err)
	}
	if cm.CodeImage != nil {
		defer cm.CodeImage.Close()
	}
	eng, err := rt.NewEngine()
	if err != nil {
		t.Fatal(err)
	}
	defer eng.Close()
	var jm *rt.JobMemory
	if opts.ElideBoundsChecks {
		if err := rt.InstallGuardTrapHandler(); err != nil {
			t.Fatal(err)
		}
		jm, err = rt.NewJobMemoryGuarded(65536, 65536)
	} else {
		jm, err = rt.NewJobMemory(65536)
	}
	if err != nil {
		t.Fatal(err)
	}
	defer jm.Close()
	for i := range jm.LinearMemory() {
		jm.LinearMemory()[i] = byte(i*37 + 11)
	}
	ar, err := rt.NewArena(4096)
	if err != nil {
		t.Fatal(err)
	}
	defer ar.Close()
	code, entry, err := rt.MapCode(cm.Code)
	if err != nil {
		t.Fatal(err)
	}
	defer rt.Unmap(code)
	serArgs, results, trap := ar.Alloc(256), ar.Alloc(256), ar.Alloc(rt.TrapBufferBytes)
	for i, arg := range args {
		binary.LittleEndian.PutUint64(serArgs[i*8:], arg)
	}
	if opts.ElideBoundsChecks {
		err = eng.CallGuarded(entry+uintptr(cm.Entry[0]), serArgs, jm.LinMemBase(), trap, results, jm)
	} else {
		err = eng.Call(entry+uintptr(cm.Entry[0]), serArgs, jm.LinearMemory(), trap, results)
	}
	return binary.LittleEndian.Uint64(results), err
}

func TestSelectResultFactsCanonicalCarriersBoundsAndAliases(t *testing.T) {
	for _, fused := range []bool{false, true} {
		for _, tee := range []bool{false, true} {
			body := []byte{1, 1, 0x7f, 0x20, 0, 0x20, 1, 0x20, 2}
			if fused {
				body = append(body, 0x45)
			}
			body = append(body, 0x1b)
			if tee {
				body = append(body, 0x22, 3)
			}
			body = append(body, 0x28, 2, 0, 0x20, 0, 0x6a, 0x20, 1, 0x6a, 0x0b)
			m := modMem(t, 1, []wasm.ValType{wasm.I32, wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, body)
			for _, enabled := range []bool{false, true} {
				for _, guard := range []bool{false, true} {
					for _, pair := range [][2]uint64{{0, 3}, {3, 65532}, {65533, 0}, {0xabcde12300000003, 0xfedc12340000fffc}, {0x80000000, 0}, {0xffffffff, 65532}} {
						for _, cond := range []uint64{0, 1, 7} {
							chosen := pair[1]
							selectA := cond != 0
							if fused {
								selectA = !selectA
							}
							if selectA {
								chosen = pair[0]
							}
							address := uint32(chosen)
							var stats ModuleStats
							opts := CompileOptions{ElideBoundsChecks: guard, Optimizations: map[string]bool{"select-result-facts": enabled}}
							if diagnosticsEnabled {
								opts.Stats = &stats
							}
							got, err := runSelectFactsFixture(t, m, opts, pair[0], pair[1], cond)
							if diagnosticsEnabled && (stats.Funcs[0].Peephole["select-result-facts"] != 0) != enabled {
								t.Fatalf("missing producer proof fused=%v tee=%v enabled=%v stats=%v", fused, tee, enabled, stats.Funcs[0].Peephole)
							}
							if address > 65532 {
								var trap *rt.TrapError
								if !errors.As(err, &trap) || trap.Code != rt.TrapLinMemOutOfBounds {
									t.Fatalf("fused=%v tee=%v guard=%v enabled=%v address=%x trap=%v", fused, tee, guard, enabled, address, err)
								}
								continue
							}
							var word uint32
							for i := uint32(0); i < 4; i++ {
								word |= uint32(byte((address+i)*37+11)) << (i * 8)
							}
							want := uint64(word + uint32(pair[0]) + uint32(pair[1]))
							if err != nil || got != want {
								t.Fatalf("fused=%v tee=%v enabled=%v guard=%v args=%x cond=%d got=%x want=%x err=%v", fused, tee, enabled, guard, pair, cond, got, want, err)
							}
						}
					}
				}
			}
		}
	}
}

func TestSelectResultFactsKeepI64AndLoadRenames(t *testing.T) {
	requireCompilerDiagnostics(t)
	cases := []struct {
		name string
		m    *wasm.Module
	}{
		{"i64", mod1(t, []wasm.ValType{wasm.I64, wasm.I64, wasm.I32}, []wasm.ValType{wasm.I64}, []byte{0, 0x20, 0, 0x20, 1, 0x20, 2, 0x1b, 0x0b})},
		// The result of this select tees a self-load-defined local. Its intentional
		// W-register dependent-address rename remains even with the producer fact.
		{"load-rename", modMem(t, 1, []wasm.ValType{wasm.I32, wasm.I32, wasm.I32}, []wasm.ValType{wasm.I32}, []byte{0, 0x20, 0, 0x28, 2, 0, 0x21, 0, 0x20, 0, 0x20, 1, 0x20, 2, 0x1b, 0x22, 0, 0x28, 2, 0, 0x0b})},
	}
	for _, tc := range cases {
		var off []byte
		for _, enabled := range []bool{false, true} {
			var stats ModuleStats
			cm, err := CompileModuleWith(tc.m, CompileOptions{Stats: &stats, Optimizations: map[string]bool{"select-result-facts": enabled}})
			if err != nil {
				t.Fatal(err)
			}
			if enabled && string(off) != string(cm.Code) {
				t.Fatalf("%s native changed", tc.name)
			}
			off = append([]byte(nil), cm.Code...)
			if tc.name == "i64" && stats.Funcs[0].Peephole["select-result-facts"] != 0 {
				t.Fatal("i64 select incorrectly canonicalized")
			}
			if tc.name == "load-rename" && enabled && stats.Funcs[0].Peephole["memory-address-load-rename"] == 0 {
				t.Fatal("dependent load rename disappeared")
			}
			if cm.CodeImage != nil {
				cm.CodeImage.Close()
			}
		}
	}
}
