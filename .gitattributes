* text=auto eol=lf

# Pinned upstream fixtures are byte-identical, including source whitespace and
# line endings. Do not let Git's Windows checkout policy rewrite their bytes.
tests/corpus/regressions/** -text -whitespace
tests/fuzz/engine/starshine-ffi.wasm -text -whitespace
corpus/workloads/**/*.wasm -diff -text -whitespace
corpus/workloads/applications/**/inputs/** -diff -text -whitespace
