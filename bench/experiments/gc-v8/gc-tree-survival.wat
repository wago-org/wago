(module
 (type $node (struct (field (mut (ref null $node))) (field (mut (ref null $node))) (field i32)))
 (global $root (mut (ref null $node)) (ref.null $node))
 (func $build (param $depth i32) (result (ref $node))
  (if (result (ref $node)) (i32.eqz (local.get $depth))
   (then (struct.new $node (ref.null $node) (ref.null $node) (i32.const 1)))
   (else (struct.new $node
     (call $build (i32.sub (local.get $depth) (i32.const 1)))
     (call $build (i32.sub (local.get $depth) (i32.const 1))) (i32.const 1)))))
 (func $sum (param $p (ref null $node)) (result i32)
  (if (result i32) (ref.is_null (local.get $p)) (then (i32.const 0))
   (else (i32.add (struct.get $node 2 (local.get $p))
      (i32.add (call $sum (struct.get $node 0 (local.get $p)))
               (call $sum (struct.get $node 1 (local.get $p))))))))
 (func (export "performance") (param $n i32) (result i32)
  (local $i i32) (local $sum i32) (local $tmp (ref null $node))
  (global.set $root (call $build (i32.const 10)))
  (block $done (loop $again (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
   (local.set $tmp (call $build (i32.const 10)))
   (local.set $sum (i32.add (local.get $sum) (call $sum (local.get $tmp))))
   (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $again)))
  (i32.add (local.get $sum) (call $sum (global.get $root)))))
