+//go:build linux && amd64 && wago_gc_direct_arena_cache && wago_gc_direct_trusted_alloc
+
+package wago
+
+import (
+	"fmt"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+	"testing"
+)
+
+func directArenaPressureModule() []byte {
+	ft := []byte{0x60, 12}
+	for i := 0; i < 12; i++ {
+		ft = append(ft, 0x7f)
+	}
+	ft = append(ft, 1, 0x7f)
+	body := []byte{}
+	// Eleven scalar operands survive every constructor/helper below. The retained
+	// global is moved repeatedly while those operands force register/spill pressure.
+	for i := 1; i < 12; i++ {
+		body = append(body, 0x20, byte(i))
+	}
+	body = append(body, 0x20, 0, 0xfb, 0, 0, 0x24, 0)
+	for i := 0; i < 16; i++ {
+		body = append(body, 0x41, 0, 0xfb, 0, 0, 0x1a)
+	}
+	body = append(body, 0x23, 0, 0xfb, 2, 0, 0)
+	for i := 0; i < 11; i++ {
+		body = append(body, 0x6a)
+	}
+	body = append(body, 0x0b)
+	caller := []byte{}
+	for i := 0; i < 12; i++ {
+		caller = append(caller, 0x20, byte(i))
+	}
+	caller = append(caller, 0x10, 0, 0x0b)
+	return wasmtest.Module(wasmtest.Section(1, wasmtest.Vec([]byte{0x5f, 1, 0x7f, 0}, ft)), wasmtest.Section(3, wasmtest.Vec([]byte{1}, []byte{1})), wasmtest.Section(6, wasmtest.Vec([]byte{0x63, 0, 1, 0xd0, 0, 0x0b})), wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("run", 0, 1))), wasmtest.Section(10, wasmtest.Vec(wasmtest.Code(body), wasmtest.Code(caller))))
+}
+func TestDirectGCArenaCachePressureMovingRootsAndInstances(t *testing.T) {
+	assertArenaCacheActive(t, directArenaPressureModule())
+	c, err := Compile(NewRuntimeConfig().WithOptimization("gc-direct-arena-cache", true).WithCoreFeatures(CoreFeaturesV3).WithOptimization("dead-gc-new", false).WithOptimization("inline", false), directArenaPressureModule())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	instances := make([]*Instance, 2)
+	for i := range instances {
+		rt := NewRuntime()
+		defer rt.Close()
+		in, e := Instantiate(c, InstantiateOptions{store: rt.refStore, GC: GCConfig{ExperimentalDirectOffsets: true, NurseryBytes: 128, ThroughputHeapBytes: 64 << 10, ForceMajorEveryMinor: true}})
+		if e != nil {
+			t.Fatal(e)
+		}
+		defer in.Close()
+		instances[i] = in
+	}
+	for n := 0; n < 24; n++ {
+		for index, in := range instances {
+			args := make([]uint64, 12)
+			var want uint32
+			for i := range args {
+				args[i] = uint64(uint32(0x80000000 + uint32(n*37+index*997+i)))
+				want += uint32(args[i])
+			}
+			got, e := in.Invoke("run", args...)
+			if e != nil || len(got) != 1 || uint32(got[0]) != want {
+				t.Fatal(n, index, got, want, e)
+			}
+		}
+	}
+	for _, in := range instances {
+		if s := in.gc.Stats(); s.FullCollections == 0 || s.Allocations != 24*17 {
+			t.Fatalf("collection/allocation proof %+v", s)
+		}
+	}
+}
+
+func TestDirectGCArenaCacheZeroTripAndNullTrap(t *testing.T) {
+	// An admitted function must not allocate or trap merely by entering it.
+	body := []byte{0x20, 0, 0x45, 0x04, 0x7f, 0x41, 7, 0x05, 0x41, 19, 0xfb, 0, 0, 0x1a, 0xd0, 0, 0xfb, 2, 0, 0, 0x0b, 0x0b}
+	data := wasmtest.Module(wasmtest.Section(1, wasmtest.Vec([]byte{0x5f, 1, 0x7f, 0}, []byte{0x60, 1, 0x7f, 1, 0x7f})), wasmtest.Section(3, wasmtest.Vec([]byte{1})), wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("run", 0, 0))), wasmtest.Section(10, wasmtest.Vec(wasmtest.Code(body))))
+	assertArenaCacheActive(t, data)
+	c, err := Compile(NewRuntimeConfig().WithOptimization("gc-direct-arena-cache", true).WithCoreFeatures(CoreFeaturesV3).WithOptimization("dead-gc-new", false).WithOptimization("inline", false), data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	rt := NewRuntime()
+	defer rt.Close()
+	in, err := Instantiate(c, InstantiateOptions{store: rt.refStore, GC: GCConfig{ExperimentalDirectOffsets: true, NurseryBytes: 128, ThroughputHeapBytes: 64 << 10}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer in.Close()
+	for i := 0; i < 2; i++ {
+		got, err := in.Invoke("run", 0)
+		if err != nil || len(got) != 1 || got[0] != 7 {
+			t.Fatal(got, err)
+		}
+		if in.gc.Stats().Allocations != uint64(i) {
+			t.Fatal(in.gc.Stats())
+		}
+		_, err = in.Invoke("run", 1)
+		if err == nil {
+			t.Fatal("null struct.get did not trap")
+		}
+	}
+}
+
+func TestDirectGCArenaCacheAllocationFailureRecovery(t *testing.T) {
+	// A scalar object remains on the operand stack while an oversized array
+	// requests collection and fails. The next invocation must reinitialize RBP.
+	body := []byte{0x41, 19, 0xfb, 0, 0, 0x41, 0, 0x20, 0, 0xfb, 6, 1, 0x1a, 0xfb, 2, 0, 0, 0x0b}
+	data := wasmtest.Module(wasmtest.Section(1, wasmtest.Vec([]byte{0x5f, 1, 0x7f, 0}, []byte{0x5e, 0x7f, 1}, []byte{0x60, 1, 0x7f, 1, 0x7f})), wasmtest.Section(3, wasmtest.Vec([]byte{2})), wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("run", 0, 0))), wasmtest.Section(10, wasmtest.Vec(wasmtest.Code(body))))
+	assertArenaCacheActive(t, data)
+	c, err := Compile(NewRuntimeConfig().WithOptimization("gc-direct-arena-cache", true).WithCoreFeatures(CoreFeaturesV3).WithOptimization("dead-gc-new", false).WithOptimization("inline", false), data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	rt := NewRuntime()
+	defer rt.Close()
+	in, err := Instantiate(c, InstantiateOptions{store: rt.refStore, GC: GCConfig{ExperimentalDirectOffsets: true, NurseryBytes: 128, ThroughputHeapBytes: 256, ForceMajorEveryMinor: true}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer in.Close()
+	for i := 0; i < 4; i++ {
+		if _, err := in.Invoke("run", 1<<20); err == nil {
+			t.Fatal("oversized array succeeded")
+		}
+		got, err := in.Invoke("run", 0)
+		if err != nil || len(got) != 1 || got[0] != 19 {
+			t.Fatal(got, err)
+		}
+	}
+}
+
+func TestDirectGCArenaCacheConfigIsolation(t *testing.T) {
+	base := NewRuntimeConfig().WithCoreFeatures(CoreFeaturesV3).WithOptimization("dead-gc-new", false).WithOptimization("inline", false)
+	selected := func(cfg *RuntimeConfig) bool {
+		for _, info := range cfg.OptimizationInfos() {
+			if info.Name == "gc-direct-arena-cache" {
+				return info.On
+			}
+		}
+		t.Fatal("missing opt-in cache option")
+		return false
+	}
+	initial := selected(base)
+	for index, enabled := range []bool{false, true, false, true} {
+		cfg := base.WithOptimization("gc-direct-arena-cache", enabled)
+		if selected(cfg) != enabled || selected(base) != initial {
+			t.Fatal("configuration selection leaked")
+		}
+		t.Run(fmt.Sprintf("%d-%v", index, enabled), func(t *testing.T) {
+			t.Parallel()
+			c, err := Compile(cfg, directArenaPressureModule())
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer c.Close()
+			rt := NewRuntime()
+			defer rt.Close()
+			in, err := Instantiate(c, InstantiateOptions{store: rt.refStore, GC: GCConfig{ExperimentalDirectOffsets: true, NurseryBytes: 128, ThroughputHeapBytes: 64 << 10, ForceMajorEveryMinor: true}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer in.Close()
+			for n := 0; n < 8; n++ {
+				args := make([]uint64, 12)
+				for i := range args {
+					args[i] = uint64(index + 1)
+				}
+				got, err := in.Invoke("run", args...)
+				if err != nil || len(got) != 1 || got[0] != uint64(12*(index+1)) {
+					t.Fatal(got, err)
+				}
+			}
+			if in.gc.Stats().Allocations != 8*17 {
+				t.Fatal("allocation accounting changed")
+			}
+			if selected(cfg) != enabled || selected(base) != initial {
+				t.Fatal("compilation changed config")
+			}
+		})
+	}
+}
