+//go:build linux && amd64 && wago_gc_direct_arena_cache && wago_gc_direct_trusted_alloc && wago_codegenstats
+
+package wago
+
+import (
+	"bytes"
+	"crypto/sha256"
+	backend "github.com/wago-org/wago/src/core/compiler/backend/railshot/amd64"
+	"github.com/wago-org/wago/src/core/compiler/codegen"
+	"github.com/wago-org/wago/src/core/compiler/frontend"
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	wruntime "github.com/wago-org/wago/src/core/runtime"
+	"os"
+	"testing"
+)
+
+func arenaCacheReceipt(t *testing.T, data []byte, interruptible bool) (admit, loads, uses int) {
+	enabled := true
+	admit, loads, uses, _ = arenaCacheCompilation(t, data, interruptible, &enabled, true)
+	return
+}
+func arenaCacheCompilation(t *testing.T, data []byte, interruptible bool, enabled *bool, disableInline bool) (admit, loads, uses int, code []byte) {
+	t.Helper()
+	m, e := wasm.DecodeModule(data)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if e = wasm.ValidateModule(m); e != nil {
+		t.Fatal(e)
+	}
+	meta, e := frontend.BuildGCTypeMetadata(m)
+	if e != nil {
+		t.Fatal(e)
+	}
+	var diagnostic string
+	plan := newGCFrameRootPlan(m, true, true, &diagnostic, nil)
+	if diagnostic != "" {
+		t.Fatal(diagnostic)
+	}
+	opts := map[string]bool{"dead-gc-new": false}
+	if disableInline {
+		opts["inline"] = false
+	}
+	if enabled != nil {
+		opts["gc-direct-arena-cache"] = *enabled
+	}
+	var stats backend.ModuleStats
+	cm, e := backend.CompileModuleWith(m, backend.CompileOptions{Stats: &stats, GCStructHelpers: true, GCArrayHelpers: true, GCFrameRoots: plan, Interruptible: interruptible, Optimizations: opts, Codegen: codegen.Options{Module: codegen.ModuleInfo{GCTypeDescs: meta.Descs, GCTypeLayouts: meta.Layouts}}})
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer cm.CodeImage.Close()
+	code = append([]byte(nil), cm.Code...)
+	for _, s := range stats.Funcs {
+		admit += s.Peephole["gc-direct-arena-cache-admit"]
+		loads += s.Peephole["gc-direct-arena-cache-load"]
+		uses += s.Peephole["gc-direct-arena-cache-use"]
+		if s.Peephole["gc-direct-arena-cache-admit"] != 0 {
+			t.Logf("cache allocation-uses=%d slow-reloads=%d", s.Peephole["gc-direct-arena-cache-allocation-use"], s.Peephole["gc-direct-arena-cache-slow-reload"])
+			if s.Peephole["gc-direct-arena-cache-slow-reload"] == 0 {
+				t.Fatal("admitted constructor has no cold reload receipt")
+			}
+		}
+	}
+	return
+}
+func TestDirectGCArenaCacheArtifactReceipts(t *testing.T) {
+	for _, name := range []string{"struct-allocation-access", "array-allocation-access", "array-fill", "array-copy-checksum", "array-loop-copy-checksum", "tree-survival"} {
+		data, e := os.ReadFile("../../bench/experiments/gc-v8/gc-" + name + ".wasm")
+		if e != nil {
+			t.Fatal(e)
+		}
+		a, l, u := arenaCacheReceipt(t, data, !wruntime.HostInterruptSupported())
+		t.Logf("%s admitted=%d loads=%d uses=%d host_interrupt=%v", name, a, l, u, wruntime.HostInterruptSupported())
+		if name == "struct-allocation-access" && wruntime.HostInterruptSupported() && (a == 0 || l == 0 || u == 0) {
+			t.Fatal("target struct artifact did not activate cache")
+		}
+		if name != "struct-allocation-access" && a != 0 {
+			t.Fatalf("unexpected admission for %s: %d", name, a)
+		}
+	}
+	a, _, u := arenaCacheReceipt(t, directArenaPressureModule(), false)
+	if a != 1 || u == 0 {
+		t.Fatal("pressure fixture cache inactive")
+	}
+	a, _, _ = arenaCacheReceipt(t, directArenaPressureModule(), true)
+	if a != 0 {
+		t.Fatal("interruptible fixture admitted")
+	}
+}
+
+func TestDirectGCArenaCacheSameBinaryReceipts(t *testing.T) {
+	for _, name := range []string{"struct-allocation-access", "array-allocation-access", "array-fill", "array-copy-checksum", "array-loop-copy-checksum", "tree-survival"} {
+		data, err := os.ReadFile("../../bench/experiments/gc-v8/gc-" + name + ".wasm")
+		if err != nil {
+			t.Fatal(err)
+		}
+		var off []byte
+		for _, enabled := range []bool{false, true, false} {
+			a, _, u, code := arenaCacheCompilation(t, data, !wruntime.HostInterruptSupported(), &enabled, false)
+			t.Logf("%s enabled=%v admitted=%d read-uses=%d code=%d sha256=%x", name, enabled, a, u, len(code), sha256.Sum256(code))
+			want := 0
+			if enabled && name == "struct-allocation-access" && wruntime.HostInterruptSupported() {
+				want = 1
+			}
+			if a != want {
+				t.Fatalf("cache receipt %d want %d", a, want)
+			}
+			if off == nil {
+				off = code
+			} else if want == 0 && !bytes.Equal(off, code) {
+				t.Fatal("non-admitted generated code changed")
+			}
+			if want == 1 && bytes.Equal(off, code) {
+				t.Fatal("admitted struct code unchanged")
+			}
+		}
+	}
+}
+
+func assertArenaCacheActive(t *testing.T, data []byte) {
+	t.Helper()
+	enabled := true
+	a, _, uses, _ := arenaCacheCompilation(t, data, !wruntime.HostInterruptSupported(), &enabled, true)
+	if wruntime.HostInterruptSupported() && (a != 1 || uses == 0) {
+		t.Fatalf("runtime fixture cache inactive: admitted=%d uses=%d", a, uses)
+	}
+}
