--- /dev/null
+++ b/src/core/compiler/backend/railshot/amd64/gc_direct_arena_cache_test.go
@@ -0,0 +1,34 @@
+//go:build amd64
+
+package amd64
+
+import "testing"
+
+func TestDirectArenaBodyAdmission(t *testing.T) {
+	body := []byte{0x20, 0, 0xfb, 0, 0, 0xfb, 2, 0, 0, 0x0b}
+	if !directArenaBodyAdmitted(body) {
+		t.Fatal("simple constructor/read rejected")
+	}
+	for _, prefix := range [][]byte{{0x10, 0}, {0x11, 0, 0}, {0x12, 0}, {0x14, 0}, {0xfe, 0}, {0xfd, 0}, {0xfc, 0}, {0x3f, 0}, {0x06, 0x40}, {0x02, 0}} {
+		input := append(append([]byte(nil), prefix...), body...)
+		if directArenaBodyAdmitted(input) {
+			t.Fatalf("unsupported prefix%x admitted", prefix)
+		}
+	}
+	if directArenaBodyAdmitted([]byte{0xfb, 0}) || directArenaBodyAdmitted([]byte{0xfb, 2, 0, 0, 0x0b}) {
+		t.Fatal("truncated/no-allocation body admitted")
+	}
+	many := make([]byte, 1025)
+	copy(many, body)
+	if directArenaBodyAdmitted(many) {
+		t.Fatal("unbounded body")
+	}
+	many = make([]byte, 257)
+	for i := range many {
+		many[i] = 1
+	}
+	many = append(many, body...)
+	if directArenaBodyAdmitted(many) {
+		t.Fatal("unbounded instruction count")
+	}
+}
