+//go:build amd64 && wago_gc_direct_arena_cache
+
+package amd64
+
+import "github.com/wago-org/wago/src/core/compiler/optimization"
+
+const directArenaCacheEnabled = true
+
+// The ordinary immutable per-compilation policy owns the selection. The probe
+// never mutates process defaults or the backend's global knobs.
+var directArenaCacheDefault bool
+var optDirectArenaCache = optimizationBindings.Option("gc-direct-arena-cache")
+
+func withArenaCacheBinding(bindings []optimization.BindingSpec) []optimization.BindingSpec {
+	return append(bindings, optimization.Bind("gc-direct-arena-cache", &directArenaCacheDefault))
+}
+func (f *fn) arenaCacheSelected() bool { return f.opt(optDirectArenaCache) }
