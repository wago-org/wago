diff --git a/src/core/compiler/backend/railshot/amd64/gc_direct_arena_cache.go b/src/core/compiler/backend/railshot/amd64/gc_direct_arena_cache.go
new file mode 100644
index 00000000..8fc5d335
--- /dev/null
+++ b/src/core/compiler/backend/railshot/amd64/gc_direct_arena_cache.go
@@ -0,0 +1,109 @@
+//go:build amd64
+
+package amd64
+
+import (
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	"github.com/wago-org/wago/src/core/runtime/abi"
+	gc "github.com/wago-org/wago/src/core/runtime/gc/native"
+)
+
+// Decode a bounded subset rather than treating hintHasCall as guest calls: that
+// hint also includes the GC helper transitions that this experiment must allow.
+// The ordinary validator has already established operand and type correctness.
+func directArenaBodyAdmitted(body []byte) bool {
+	if len(body) == 0 || len(body) > 1024 {
+		return false
+	}
+	r := wasm.ReaderFrom(body)
+	allocation, read := false, false
+	for ops := 0; r.BytesLeft() > 0; ops++ {
+		if ops >= 256 {
+			return false
+		}
+		op, err := r.Byte()
+		if err != nil {
+			return false
+		}
+		immediates := 0
+		switch op {
+		case 0x00, 0x01, 0x05, 0x0b, 0x0f, 0x1a, 0x1b, 0xd1:
+		case 0x02, 0x03, 0x04:
+			block, e := r.I64()
+			if e != nil || (block != -64 && block != -1 && block != -2) {
+				return false
+			}
+		case 0x0c, 0x0d, 0x20, 0x21, 0x22, 0x23, 0x24:
+			immediates = 1
+		case 0x41:
+			if _, e := r.I32(); e != nil {
+				return false
+			}
+		case 0x42, 0xd0:
+			if _, e := r.I64(); e != nil {
+				return false
+			}
+		case 0x45, 0x46, 0x47, 0x48, 0x49, 0x4a, 0x4b, 0x4c, 0x4d, 0x4e, 0x4f,
+			0x50, 0x51, 0x52, 0x53, 0x54, 0x55, 0x56, 0x57, 0x58, 0x59, 0x5a,
+			0x67, 0x68, 0x69, 0x6a, 0x6b, 0x6c, 0x6d, 0x6e, 0x6f, 0x70, 0x71, 0x72, 0x73, 0x74, 0x75, 0x76, 0x77, 0x78,
+			0x79, 0x7a, 0x7b, 0x7c, 0x7d, 0x7e, 0x7f, 0x80, 0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87, 0x88, 0x89, 0x8a,
+			0xa7, 0xac, 0xad:
+		case 0xfb:
+			sub, e := r.U32()
+			if e != nil {
+				return false
+			}
+			switch sub {
+			case 0, 1:
+				allocation = true
+				immediates = 1
+			case 2, 3, 4:
+				read = true
+				immediates = 2
+			case 5:
+				immediates = 2
+			case 6, 7, 11, 12, 13, 14:
+				immediates = 1
+			case 15, 28, 29, 30:
+			default:
+				return false
+			}
+		default:
+			return false // Includes ALL guest/tail/ref calls, memory, EH and SIMD.
+		}
+		for i := 0; i < immediates; i++ {
+			if _, e := r.U32(); e != nil {
+				return false
+			}
+		}
+	}
+	return allocation && read
+}
+
+func (f *fn) loadDirectArenaCache() {
+	f.reloadDirectArenaBase()
+	f.certifyDirectArenaCache()
+}
+
+func (f *fn) reloadDirectArenaBase() {
+	if !f.directArenaCache {
+		return
+	}
+	// Only arena backing is cached. Bumps, occupied ranges, headers, type maps and
+	// object addresses retain their existing per-operation lifetime contracts.
+	f.a.Load64(RBP, RBX, -int32(abi.GCNativeViewPtrOffset))
+	f.a.Load64(RBP, RBP, gc.DirectInstanceCollectorOffset)
+	f.a.Load64(RBP, RBP, gc.DirectViewArenaOffset)
+	f.stats.peep("gc-direct-arena-cache-load")
+}
+
+func (f *fn) certifyDirectArenaCache() {
+	if f.directArenaCache && regallocCheckEnabled {
+		f.checkImmutable(RBP, false, 8)
+	}
+}
+func (f *fn) suspendDirectArenaCache() {
+	if f.directArenaCache && regallocCheckEnabled {
+		f.checkReleaseImmutable(RBP, false)
+	}
+}
