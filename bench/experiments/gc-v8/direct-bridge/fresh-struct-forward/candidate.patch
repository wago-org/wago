+		t.Fatal(err)
+	}
+	forwarded, code := freshStructReceipt(t, data, nil)
+	t.Logf("fresh-struct-forward=%d generated-bytes=%d", forwarded, len(code))
+	if forwarded != 1 {
+		t.Fatalf("exact retained struct artifact forwarding=%d, want1", forwarded)
+	}
+}
+
+func freshStructReceipt(t *testing.T, data []byte, enabled *bool) (forwarded int, code []byte) {
+	t.Helper()
+	m, err := wasm.DecodeModule(data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = wasm.ValidateModule(m); err != nil {
+		t.Fatal(err)
+	}
+	metadata, err := frontend.BuildGCTypeMetadata(m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var diagnostic string
+	plan := newGCFrameRootPlan(m, true, true, &diagnostic, nil)
+	if diagnostic != "" {
+		t.Fatal(diagnostic)
+	}
+	opts := map[string]bool{"dead-gc-new": false}
+	if freshStructProbeAvailable() {
+		opts["gc-fresh-struct-forward"] = true
+	}
+	if enabled != nil {
+		opts["gc-fresh-struct-forward"] = *enabled
+	}
+	var stats backend.ModuleStats
+	compiled, err := backend.CompileModuleWith(m, backend.CompileOptions{Stats: &stats, GCStructHelpers: true, GCArrayHelpers: true, GCFrameRoots: plan, Interruptible: !wruntime.HostInterruptSupported(), Optimizations: opts, Codegen: codegen.Options{Module: codegen.ModuleInfo{GCTypeDescs: metadata.Descs, GCTypeLayouts: metadata.Layouts}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer compiled.CodeImage.Close()
+	for _, fn := range stats.Funcs {
+		forwarded += fn.Peephole["gc-fresh-struct-get-forward"]
+	}
+	return forwarded, append([]byte(nil), compiled.Code...)
+}
+
+func assertFreshStructReceipt(t *testing.T, data []byte, want int) {
+	t.Helper()
+	n, _ := freshStructReceipt(t, data, nil)
+	if n != want {
+		t.Fatalf("fresh scalar fixture receipt=%d want%d", n, want)
+	}
+}
diff --git a/src/wago/gc_fresh_struct_samebinary_amd64_test.go b/src/wago/gc_fresh_struct_samebinary_amd64_test.go
new file mode 100644
index 00000000..70de7412
--- /dev/null
+++ b/src/wago/gc_fresh_struct_samebinary_amd64_test.go
@@ -0,0 +1,39 @@
+//go:build linux && amd64 && wago_codegenstats && wago_gc_fresh_struct_probe
+
+package wago
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"os"
+	"testing"
+)
+
+func TestGCFreshStructSameBinaryReceipts(t *testing.T) {
+	for _, name := range []string{"struct-allocation-access", "array-allocation-access", "array-fill", "array-copy-checksum", "array-loop-copy-checksum", "tree-survival"} {
+		data, err := os.ReadFile("../../bench/experiments/gc-v8/gc-" + name + ".wasm")
+		if err != nil {
+			t.Fatal(err)
+		}
+		var off []byte
+		for _, enabled := range []bool{false, true, false} {
+			n, code := freshStructReceipt(t, data, &enabled)
+			want := 0
+			if enabled && name == "struct-allocation-access" {
+				want = 1
+			}
+			t.Logf("%s enabled=%v forwarded=%d code=%d sha256=%x", name, enabled, n, len(code), sha256.Sum256(code))
+			if n != want {
+				t.Fatalf("forwarded=%d want%d", n, want)
+			}
+			if off == nil {
+				off = code
+			} else if want == 0 && !bytes.Equal(off, code) {
+				t.Fatal("non-forwarded code differs")
+			}
+			if want == 1 && bytes.Equal(off, code) {
+				t.Fatal("forwarded struct code unchanged")
+			}
+		}
+	}
+}
