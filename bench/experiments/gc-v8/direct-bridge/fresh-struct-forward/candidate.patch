+//go:build linux && amd64
+
+package wago
+
+func freshStructProbeAvailable() bool {
+	for _, info := range NewRuntimeConfig().OptimizationInfos() {
+		if info.Name == "gc-fresh-struct-forward" {
+			return true
+		}
+	}
+	return false
+}
+func freshStructTestConfig() *RuntimeConfig {
+	cfg := NewRuntimeConfig().WithCoreFeatures(CoreFeaturesV3).WithOptimization("dead-gc-new", false)
+	if freshStructProbeAvailable() {
+		cfg = cfg.WithOptimization("gc-fresh-struct-forward", true)
+	}
+	return cfg
+}
