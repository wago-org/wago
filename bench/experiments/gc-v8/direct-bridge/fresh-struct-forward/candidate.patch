diff --git a/src/wago/gc_fresh_struct_direct_amd64_test.go b/src/wago/gc_fresh_struct_direct_amd64_test.go
new file mode 100644
index 00000000..8ba4a36b
--- /dev/null
+++ b/src/wago/gc_fresh_struct_direct_amd64_test.go
@@ -0,0 +1,141 @@
+//go:build linux && amd64 && !tinygo && !wago_guardpage && wago_gc_direct_trusted_alloc
+
+package wago
+
+import (
+	"github.com/wago-org/wago/tests/support/wasmtest"
+	"testing"
+)
+
+// These cases retain allocation and root-array publication, unlike scalar
+// replacement. Overwriting the initializer or mutating its field kills the fact.
+func TestDirectGCFreshStructForwardEffects(t *testing.T) {
+	for _, tc := range []struct {
+		name                    string
+		overwrite, mutate, trap bool
+	}{
+		{name: "forward"}, {name: "source overwritten", overwrite: true},
+		{name: "field mutated", mutate: true}, {name: "root store trap", trap: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			length := byte(1)
+			if tc.trap {
+				length = 0
+			}
+			data := gcFreshStructLocalForwardBytes(tc.overwrite, tc.mutate, length)
+			wantForward := 1
+			if tc.overwrite || tc.mutate {
+				wantForward = 0
+			}
+			assertFreshStructReceipt(t, data, wantForward)
+			c, err := Compile(freshStructTestConfig(), data)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer c.Close()
+			for _, forced := range []bool{false, true} {
+				rt := NewRuntime()
+				defer rt.Close()
+				in, err := Instantiate(c, InstantiateOptions{store: rt.refStore, GC: GCConfig{ExperimentalDirectOffsets: true, NurseryBytes: 128, ThroughputHeapBytes: 64 << 10, CollectEveryAlloc: forced, ForceMajorEveryMinor: true}})
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer in.Close()
+				for i := 0; i < 24; i++ {
+					input := uint64(uint32(i*17 - 33))
+					want := input
+					if tc.mutate {
+						want = 7
+					}
+					got, err := in.Invoke("run", input)
+					if tc.trap {
+						if err == nil {
+							t.Fatal("root-array bounds trap disappeared", got)
+						}
+					} else if err != nil || len(got) != 1 || got[0] != want {
+						t.Fatal(i, forced, got, want, err)
+					}
+				}
+				if s := in.gc.Stats(); s.Allocations != 48 || s.FullCollections == 0 {
+					t.Fatalf("allocation/collection effects %+v", s)
+				}
+			}
+		})
+	}
+}
+
+func freshStructScalarBitsModule(kind byte, nullObject bool) []byte {
+	result := kind
+	if kind == 0x7d {
+		result = 0x7f
+	}
+	if kind == 0x7c {
+		result = 0x7e
+	}
+	body := []byte{2, 1, 0x63, 1, 1, 0x63, 0,
+		0x41, 1, 0xfb, 7, 1, 0x21, 1,
+		0x20, 0, 0xfb, 0, 0, 0x21, 2,
+		0x20, 1, 0x41, 0, 0x20, 2, 0xfb, 14, 1}
+	if nullObject {
+		body = append(body, 0xd0, 0, 0x21, 2)
+	}
+	body = append(body, 0x20, 2, 0xfb, 2, 0, 0)
+	if kind == 0x7d {
+		body = append(body, 0xbc)
+	}
+	if kind == 0x7c {
+		body = append(body, 0xbd)
+	}
+	body = append(body, 0x0b)
+	return wasmtest.Module(wasmtest.Section(1, wasmtest.Vec([]byte{0x5f, 1, kind, 0}, []byte{0x5e, 0x63, 0, 1}, []byte{0x60, 1, kind, 1, result})), wasmtest.Section(3, wasmtest.Vec([]byte{2})), wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("run", 0, 0))), wasmtest.Section(10, wasmtest.Vec(append(wasmtest.ULEB(uint32(len(body))), body...))))
+}
+
+func TestDirectGCFreshStructScalarBitsAndNullOverwrite(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		kind byte
+		bits []uint64
+	}{
+		{"i64", 0x7e, []uint64{0, 1, 0xffffffffffffffff, 0x8123456789abcdef}},
+		{"f32", 0x7d, []uint64{0, 0x80000000, 0x7fc12345, 0xff800000}},
+		{"f64", 0x7c, []uint64{0, 0x8000000000000000, 0x7ff8123456789abc, 0xfff0000000000000}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			for _, nullObject := range []bool{false, true} {
+				data := freshStructScalarBitsModule(tc.kind, nullObject)
+				wantForward := 1
+				if nullObject {
+					wantForward = 0
+				}
+				assertFreshStructReceipt(t, data, wantForward)
+				c, err := Compile(freshStructTestConfig(), data)
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer c.Close()
+				rt := NewRuntime()
+				defer rt.Close()
+				in, err := Instantiate(c, InstantiateOptions{store: rt.refStore, GC: GCConfig{ExperimentalDirectOffsets: true, NurseryBytes: 128, ThroughputHeapBytes: 64 << 10, CollectEveryAlloc: true, ForceMajorEveryMinor: true}})
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer in.Close()
+				for round := 0; round < 8; round++ {
+					for _, bits := range tc.bits {
+						got, err := in.Invoke("run", bits)
+						if nullObject {
+							if err == nil {
+								t.Fatal("overwritten null receiver forwarded", got)
+							}
+						} else if err != nil || len(got) != 1 || got[0] != bits {
+							t.Fatal(got, bits, err)
+						}
+					}
+				}
+				if got := in.gc.Stats().Allocations; got != 64 {
+					t.Fatal("allocation count", got)
+				}
+			}
+		})
+	}
+}
