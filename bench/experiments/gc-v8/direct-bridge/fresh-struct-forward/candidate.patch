new file mode 100644
index 00000000..dca2b632
--- /dev/null
+++ b/src/wago/gc_fresh_struct_policy_amd64_test.go
@@ -0,0 +1,74 @@
+//go:build linux && amd64 && !tinygo && !wago_guardpage && wago_gc_direct_trusted_alloc && wago_gc_fresh_struct_probe
+
+package wago
+
+import (
+	"fmt"
+	"os"
+	"sync"
+	"testing"
+)
+
+func TestDirectGCFreshStructPolicyIsolation(t *testing.T) {
+	data, err := os.ReadFile("../../bench/experiments/gc-v8/gc-struct-allocation-access.wasm")
+	if err != nil {
+		t.Fatal(err)
+	}
+	base := NewRuntimeConfig().WithCoreFeatures(CoreFeaturesV3).WithOptimization("dead-gc-new", false)
+	selected := func(cfg *RuntimeConfig) bool {
+		for _, info := range cfg.OptimizationInfos() {
+			if info.Name == "gc-fresh-struct-forward" {
+				return info.On
+			}
+		}
+		t.Fatal("missing probe option")
+		return false
+	}
+	if selected(base) {
+		t.Fatal("probe default must remain off")
+	}
+	var mu sync.Mutex
+	sizes := map[bool]int{}
+	t.Cleanup(func() {
+		mu.Lock()
+		defer mu.Unlock()
+		if len(sizes) != 2 || sizes[false] == sizes[true] {
+			t.Errorf("actual per-config generated sizes did not differ: %v", sizes)
+		}
+	})
+	for index, enabled := range []bool{false, true, false, true} {
+		cfg := base.WithOptimization("gc-fresh-struct-forward", enabled)
+		t.Run(fmt.Sprintf("%d-%v", index, enabled), func(t *testing.T) {
+			t.Parallel()
+			c, err := Compile(cfg, data)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer c.Close()
+			mu.Lock()
+			old, seen := sizes[enabled]
+			sizes[enabled] = c.CodeSize()
+			mu.Unlock()
+			if seen && old != c.CodeSize() {
+				t.Fatal("same policy produced different code size")
+			}
+			rt := NewRuntime()
+			defer rt.Close()
+			in, err := Instantiate(c, InstantiateOptions{store: rt.refStore, GC: GCConfig{ExperimentalDirectOffsets: true, NurseryBytes: 256, ThroughputHeapBytes: 64 << 10, ForceMajorEveryMinor: true}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer in.Close()
+			got, err := in.Invoke("performance", 16)
+			if err != nil || len(got) != 1 || got[0] != 7680 {
+				t.Fatal(got, err)
+			}
+			if s := in.gc.Stats(); s.Allocations != 1088 || s.FullCollections == 0 {
+				t.Fatal("effects", s)
+			}
+			if selected(cfg) != enabled || selected(base) {
+				t.Fatal("config isolation lost")
+			}
+		})
+	}
+}
