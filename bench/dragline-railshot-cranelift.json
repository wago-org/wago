{
  "version": 2,
  "engines": [
    {
      "name": "dragline-native",
      "builtin": "dragline",
      "target": "native",
      "workers": 1,
      "required": true
    },
    {
      "name": "railshot-native",
      "builtin": "railshot",
      "target": "native",
      "workers": 1,
      "required": true
    },
    {
      "name": "wazero",
      "builtin": "wazero",
      "required": true
    },
    {
      "name": "cranelift",
      "command": "wasmtime",
      "args": ["compile", "-O", "opt-level=2,regalloc-algorithm=backtracking", "-o", "{artifact}", "{wasm}"],
      "version_args": ["--version"],
      "required": true
    },
    {
      "name": "v8",
      "command": "v8",
      "args": ["bench/tools/v8-compile-worker.js", "--", "{wasm}", "{artifact}"],
      "version_args": ["--version"],
      "artifact": "opaque",
      "required": true
    },
    {
      "name": "wavm",
      "command": "wavm",
      "args": ["compile", "{wasm}", "{artifact}"],
      "version_args": ["version"],
      "artifact": "opaque",
      "required": true
    }
  ]
}
