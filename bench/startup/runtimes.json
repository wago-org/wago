{
  "_comment": "Cross-runtime end-to-end latency sweep config. Every listed runtime is required. Override a binary with its named environment variable (for example, WAGO_BIN=/path/to/wago).",
  "order": [
    "wago",
    "wazy",
    "wazero",
    "wasmtime",
    "v8",
    "wasm3",
    "wasmi",
    "wavm"
  ],
  "runtimes": {
    "wago": {
      "tag": "single-pass",
      "bin": "wago",
      "env": "WAGO_BIN",
      "versionLine": 2,
      "args": [
        "run",
        "{wasm}"
      ]
    },
    "wazy": {
      "tag": "compiler",
      "bin": "wazy",
      "env": "WAZY_BIN",
      "versionArgs": [
        "version"
      ],
      "args": [
        "run",
        "{wasm}"
      ]
    },
    "wazero": {
      "tag": "compiler",
      "bin": "wazero",
      "env": "WAZERO_BIN",
      "versionArgs": [
        "version"
      ],
      "args": [
        "run",
        "{wasm}"
      ]
    },
    "wasmtime": {
      "tag": "cranelift",
      "bin": "wasmtime",
      "env": "WASMTIME_BIN",
      "args": [
        "run",
        "-C",
        "cache=n",
        "{wasm}"
      ]
    },
    "v8": {
      "tag": "turboshaft",
      "bin": "v8",
      "env": "V8_BIN",
      "args": [
        "{repo}/bench/startup/v8-runner.js",
        "--",
        "{wasm}"
      ]
    },
    "wasm3": {
      "tag": "interpreter",
      "bin": "wasm3",
      "env": "WASM3_BIN",
      "args": [
        "{wasm}"
      ]
    },
    "wasmi": {
      "tag": "interpreter",
      "bin": "wasmi_cli",
      "env": "WASMI_BIN",
      "args": [
        "{wasm}"
      ]
    },
    "wavm": {
      "tag": "llvm",
      "bin": "wavm",
      "env": "WAVM_BIN",
      "versionArgs": [
        "version"
      ],
      "args": [
        "run",
        "--abi=bare",
        "--function=_start",
        "{wasm}"
      ]
    }
  },
  "workloads": [
    {
      "id": "nbody",
      "label": "nbody",
      "twin": "nbody.wasm",
      "desc": "Benchmarks-Game N-body leapfrog integrator (f64)",
      "wasmfyi": "wago/nbody/step"
    },
    {
      "id": "fib",
      "label": "fib",
      "twin": "fib.wasm",
      "desc": "recursive Fibonacci (call/return)",
      "wasmfyi": "wago/fib_rec/fib"
    },
    {
      "id": "sha256",
      "label": "sha256",
      "twin": "sha256.wasm",
      "desc": "SHA-256 of an 8 KiB buffer (i32 rotate/xor)",
      "wasmfyi": "wago/sha256/hashN"
    },
    {
      "id": "raytrace",
      "label": "raytrace",
      "twin": "raytrace.wasm",
      "desc": "recursive Whitted ray tracer, 48\u00d748 frame (f64)",
      "wasmfyi": "wago/raytrace/render"
    },
    {
      "id": "coremark",
      "label": "coremark",
      "twin": "coremark.wasm",
      "desc": "CoreMark 2K performance run",
      "wasmfyi": "wago/coremark/2k-performance"
    },
    {
      "id": "fannkuch",
      "label": "fannkuch",
      "twin": "fannkuch.wasm",
      "desc": "Benchmarks-Game fannkuch-redux (permute + flip)",
      "wasmfyi": "wago/fannkuch/run"
    }
  ]
}
