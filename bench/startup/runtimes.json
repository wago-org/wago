{
  "_comment": "Cross-runtime end-to-end latency sweep config. Every listed runtime is required. Override a binary with its named environment variable (for example, WAGO_BIN=/path/to/wago).",
  "order": [
    "wago",
    "wazero",
    "wasmtime",
    "v8",
    "wasm3",
    "wasmi",
    "wavm"
  ],
  "runtimes": {
    "wago": {
      "tag": "single-pass",
      "bin": "wago",
      "env": "WAGO_BIN",
      "args": [
        "run",
        "{wasm}"
      ]
    },
    "wazero": {
      "tag": "compiler",
      "bin": "wazero",
      "env": "WAZERO_BIN",
      "args": [
        "run",
        "{wasm}"
      ]
    },
    "wasmtime": {
      "tag": "cranelift",
      "bin": "wasmtime",
      "env": "WASMTIME_BIN",
      "args": [
        "run",
        "-C",
        "cache=n",
        "{wasm}"
      ]
    },
    "v8": {
      "tag": "turboshaft",
      "bin": "v8",
      "env": "V8_BIN",
      "args": [
        "{repo}/bench/startup/v8-runner.js",
        "--",
        "{wasm}"
      ]
    },
    "wasm3": {
      "tag": "interpreter",
      "bin": "wasm3",
      "env": "WASM3_BIN",
      "args": [
        "{wasm}"
      ]
    },
    "wasmi": {
      "tag": "interpreter",
      "bin": "wasmi_cli",
      "env": "WASMI_BIN",
      "args": [
        "{wasm}"
      ]
    },
    "wavm": {
      "tag": "llvm",
      "bin": "wavm",
      "env": "WAVM_BIN",
      "versionArgs": [
        "version"
      ],
      "args": [
        "run",
        "--abi=bare",
        "--function=_start",
        "{wasm}"
      ]
    }
  },
  "workloads": [
    {
      "id": "nbody",
      "label": "nbody",
      "twin": "nbody.wasm",
      "desc": "Benchmarks-Game N-body leapfrog integrator (f64)"
    },
    {
      "id": "fib",
      "label": "fib",
      "twin": "fib.wasm",
      "desc": "recursive Fibonacci"
    },
    {
      "id": "spectralnorm",
      "label": "spectralnorm",
      "twin": "spectralnorm.wasm",
      "desc": "Benchmarks-Game power iteration (f64)"
    },
    {
      "id": "quicksort",
      "label": "quicksort",
      "twin": "quicksort.wasm",
      "desc": "recursive in-place int sort"
    },
    {
      "id": "raytrace",
      "label": "raytrace",
      "twin": "raytrace.wasm",
      "desc": "recursive Whitted ray tracer (f64)"
    },
    {
      "id": "sha256",
      "label": "sha256",
      "twin": "sha256.wasm",
      "desc": "64-round SHA-256, integer rotate/xor"
    }
  ]
}
