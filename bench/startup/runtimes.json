{
  "_comment": "Cross-runtime end-to-end latency sweep config. Every listed runtime is required. Override a binary with its named environment variable (for example, WAGO_BIN=/path/to/wago).",
  "order": [
    "wago",
    "wazy",
    "wazero",
    "wasmtime",
    "v8",
    "wasmer",
    "wasmer-singlepass"
  ],
  "runtimes": {
    "wago": {
      "tag": "single-pass",
      "bin": "wago",
      "env": "WAGO_BIN",
      "versionLine": 2,
      "args": [
        "run",
        "{wasm}"
      ]
    },
    "wazy": {
      "tag": "compiler",
      "bin": "wazy",
      "env": "WAZY_BIN",
      "versionArgs": [
        "version"
      ],
      "args": [
        "run",
        "{wasm}"
      ]
    },
    "wazero": {
      "tag": "compiler",
      "bin": "wazero",
      "env": "WAZERO_BIN",
      "versionArgs": [
        "version"
      ],
      "args": [
        "run",
        "{wasm}"
      ]
    },
    "wasmtime": {
      "tag": "cranelift",
      "bin": "wasmtime",
      "env": "WASMTIME_BIN",
      "args": [
        "run",
        "-C",
        "cache=n",
        "{wasm}"
      ]
    },
    "v8": {
      "tag": "turboshaft",
      "bin": "v8",
      "env": "V8_BIN",
      "args": [
        "{repo}/bench/startup/v8-runner.js",
        "--",
        "{wasm}"
      ]
    },
    "wasmer": {
      "tag": "cranelift",
      "bin": "wasmer",
      "env": "WASMER_BIN",
      "args": [
        "run",
        "--cranelift",
        "--disable-cache",
        "{wasm}"
      ]
    },
    "wasmer-singlepass": {
      "label": "wasmer",
      "tag": "singlepass",
      "bin": "wasmer",
      "env": "WASMER_BIN",
      "args": [
        "run",
        "--singlepass",
        "--disable-cache",
        "{wasm}"
      ]
    }
  },
  "workloads": [
    {
      "id": "pcre2",
      "label": "pcre2",
      "twin": "pcre2.wasm",
      "desc": "PCRE2: compile regular expressions and match them over text (303 KB module)",
      "wasmfyi": "wago/pcre2/compile-match"
    },
    {
      "id": "yyjson",
      "label": "yyjson",
      "twin": "yyjson.wasm",
      "desc": "yyjson: parse, edit and re-serialize JSON documents",
      "wasmfyi": "wago/yyjson/parse-edit-write"
    },
    {
      "id": "utf8proc",
      "label": "utf8proc",
      "twin": "utf8proc.wasm",
      "desc": "utf8proc: Unicode normalization and case folding (324 KB module)",
      "wasmfyi": "wago/utf8proc/normalize-casefold"
    },
    {
      "id": "nanosvg",
      "label": "nanosvg",
      "twin": "nanosvg.wasm",
      "desc": "NanoSVG: parse SVG documents into shapes and paths",
      "wasmfyi": "wago/nanosvg/parse-structure"
    },
    {
      "id": "libtommath",
      "label": "libtommath",
      "twin": "libtommath.wasm",
      "desc": "LibTomMath: big-integer modular arithmetic",
      "wasmfyi": "wago/libtommath/modular-arithmetic"
    },
    {
      "id": "coremark",
      "label": "coremark",
      "twin": "coremark.wasm",
      "desc": "CoreMark 2K performance run",
      "wasmfyi": "wago/coremark/2k-performance"
    }
  ]
}
