+package wago
+
+import (
+	"strings"
+	"sync"
+	"testing"
+)
+
+func failedSnapshotImports(kind string) (*Imports, *ImportFuncBuilder) {
+	im := NewImports()
+	if kind == "nil" {
+		return im, im.I32Event("env", "event", nil)
+	}
+	return im, im.HostFunc("env", "event", func(v int32) int32 { return v }).Params(ValI64)
+}
+
+func TestImportSnapshotFailureStable(t *testing.T) {
+	for _, kind := range []string{"nil", "signature"} {
+		t.Run(kind, func(t *testing.T) {
+			im, _ := failedSnapshotImports(kind)
+			bindings, first := im.snapshot()
+			if first == nil || bindings != nil {
+				t.Fatal("invalid declaration accepted")
+			}
+			for i := 0; i < 1024; i++ {
+				bindings, err := im.snapshot()
+				if err != first || bindings != nil {
+					t.Fatalf("snapshot %d changed the retained error", i)
+				}
+			}
+			if n := testing.AllocsPerRun(100, func() { _, _ = im.snapshot() }); n != 0 {
+				t.Fatalf("repeated failure allocated %v", n)
+			}
+		})
+	}
+}
+
+func TestImportSnapshotSealedMutation(t *testing.T) {
+	for _, kind := range []string{"valid", "nil", "signature"} {
+		t.Run(kind, func(t *testing.T) {
+			im, builder := failedSnapshotImports("signature")
+			if kind == "valid" {
+				builder.Params(ValI32)
+			} else if kind == "nil" {
+				im, builder = failedSnapshotImports(kind)
+			}
+			_, first := im.snapshot()
+			if (first == nil) != (kind == "valid") {
+				t.Fatal("wrong initial validation")
+			}
+			original := append([]ValType(nil), builder.imp.params...)
+			builder.Params(ValF64).Results(ValF64).Docs("rejected").Capability("rejected")
+			im.Function("env", "late", func() {})
+			bindings, next := im.snapshot()
+			if next == nil || next == first || bindings != nil || !strings.Contains(next.Error(), "sealed") {
+				t.Fatal("rejected mutation not reported")
+			}
+			if len(original) != len(builder.imp.params) || original[0] != builder.imp.params[0] {
+				t.Fatal("sealed declaration changed")
+			}
+			if builder.imp.docs != "" || builder.imp.hasCap {
+				t.Fatal("sealed metadata changed")
+			}
+			for i := 0; i < 32; i++ {
+				if _, err := im.snapshot(); err != next {
+					t.Fatal("rejected mutation error grew on read")
+				}
+			}
+		})
+	}
+}
+
+func TestImportSnapshotConcurrentStable(t *testing.T) {
+	for _, kind := range []string{"valid", "nil", "signature"} {
+		t.Run(kind, func(t *testing.T) {
+			im, builder := failedSnapshotImports("signature")
+			if kind == "valid" {
+				builder.Params(ValI32)
+			} else if kind == "nil" {
+				im, builder = failedSnapshotImports(kind)
+			}
+			_, first := im.snapshot()
+			var wg sync.WaitGroup
+			for i := 0; i < 16; i++ {
+				wg.Add(1)
+				go func() {
+					defer wg.Done()
+					for j := 0; j < 64; j++ {
+						bindings, err := im.snapshot()
+						if err != first {
+							t.Error("error identity changed")
+							return
+						}
+						if first == nil {
+							fn, ok := bindings[importBindingMapKey("env", "event")].(func(int32) int32)
+							if !ok || fn(17) != 17 {
+								t.Error("binding changed")
+								return
+							}
+						} else if bindings != nil {
+							t.Error("invalid bindings returned")
+							return
+						}
+					}
+				}()
+			}
+			wg.Wait()
+		})
+	}
+}
+
+func TestImportSnapshotFirstValidationComplete(t *testing.T) {
+	im, _ := failedSnapshotImports("nil")
+	im.HostFunc("env", "wrong", func(v int32) {}).Params(ValI64)
+	_, err := im.snapshot()
+	if err == nil || !strings.Contains(err.Error(), "callback is nil") || !strings.Contains(err.Error(), "does not match") {
+		t.Fatalf("incomplete first validation: %v", err)
+	}
+}
+
+func BenchmarkFailedSnapshotBatch(b *testing.B) {
+	for _, kind := range []string{"nil", "signature"} {
+		b.Run(kind, func(b *testing.B) {
+			b.ReportAllocs()
+			for i := 0; i < b.N; i++ {
+				im, _ := failedSnapshotImports(kind)
+				for n := 0; n < 256; n++ {
+					if _, err := im.snapshot(); err == nil {
+						b.Fatal("accepted invalid import")
+					}
+				}
+			}
+		})
+	}
+}
