diff --git a/src/core/compiler/backend/railshot/amd64/plugin_gc_callsite_test.go b/src/core/compiler/backend/railshot/amd64/plugin_gc_callsite_test.go
new file mode 100644
index 000000000..d86a089bb
--- /dev/null
+++ b/src/core/compiler/backend/railshot/amd64/plugin_gc_callsite_test.go
@@ -0,0 +1,58 @@
+//go:build amd64
+
+package amd64
+
+import (
+	"testing"
+
+	plugincodegen "github.com/wago-org/wago/codegen/amd64"
+	railcore "github.com/wago-org/wago/src/core/compiler/backend/railshot"
+	"github.com/wago-org/wago/src/core/compiler/backend/railshot/shared"
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	"github.com/wago-org/wago/tests/support/wasmtest"
+)
+
+func TestCustomInstructionConsumesGCFrameCallsite(t *testing.T) {
+	// A lowered import followed by a real call must consume two source masks,
+	// while only the real call contributes a native return address. The callee
+	// contains a loop so native inlining cannot eliminate that second call.
+	b := wasmtest.Module(
+		wasmtest.Section(1, wasmtest.Vec(wasmtest.FuncType(nil, nil))),
+		wasmtest.Section(2, wasmtest.Vec(append(append(wasmtest.Name("env"), wasmtest.Name("inline")...), 0, 0))),
+		wasmtest.Section(3, wasmtest.Vec([]byte{0}, []byte{0})),
+		wasmtest.Section(10, wasmtest.Vec(wasmtest.Code([]byte{0x10, 0, 0x10, 2, 0x0b}), wasmtest.Code([]byte{0x03, 0x40, 0x0b, 0x0b}))),
+	)
+	m, err := wasm.DecodeModule(b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	plans := shared.NewGCModuleFrameRootPlan(2)
+	if !plans.MarkFunction(0) || !plans.ReserveFunctions(1) {
+		t.Fatal("prepare plans")
+	}
+	plan, ok := plans.BeginFunction(0)
+	if !ok {
+		t.Fatal("begin plan")
+	}
+	plan.Candidate, plan.Exact = true, true
+	if !plan.SetLiveMasks([]uint64{0, 0}, 0, 2) {
+		t.Fatal("set masks")
+	}
+	lowering := &plugincodegen.Lowering{
+		Compatibility: plugincodegen.CompatibilityManaged,
+		Managed:       func(plugincodegen.ManagedContext) error { return nil },
+	}
+	cm, err := CompileModuleWith(m, CompileOptions{Workers: 1, GCFrameRoots: plans, CustomInstructions: map[uint32]railcore.CustomInstruction{0: {Codegen: lowering}}})
+	if cm != nil && cm.CodeImage != nil {
+		defer cm.CodeImage.Close()
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !plan.Exact {
+		t.Fatal("custom instruction left a source call mask unconsumed; exact GC roots were lost")
+	}
+	if plan.CallsiteCount() != 1 {
+		t.Fatalf("native callsites = %d, want 1", plan.CallsiteCount())
+	}
+}
diff --git a/src/core/compiler/backend/railshot/amd64/recipe_result_ownership_test.go b/src/core/compiler/backend/railshot/amd64/recipe_result_ownership_test.go
new file mode 100644
index 000000000..bec110266
--- /dev/null
+++ b/src/core/compiler/backend/railshot/amd64/recipe_result_ownership_test.go
@@ -0,0 +1,54 @@
+//go:build (linux || darwin || windows) && amd64
+
+package amd64
+
+import (
+	"testing"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	encoder "github.com/wago-org/wago/src/core/encoder/amd64"
+)
+
+func TestRecipeResultSurvivesFixedRegisterShift(t *testing.T) {
+	f := &fn{a: &encoder.Asm{}, s: newStack(), sc: newScratch(), localSlot: []uint32{0}, nLocalSlots: 1, globalCellReg: regNone, memSizeReg: regNone, policy: currentCodegenPolicy()}
+	f.a.Push(RCX)
+	f.a.SubRsp(256)
+	f.a.MovImm32(RDI, 2)
+	f.a.Store32(RSP, f.localAddr(0), RDI)
+	// Reuse input zero, requiring the non-stack-compatible recipe path.
+	recipe := CustomInstruction{Nodes: []CustomInstructionNode{
+		{Op: CustomInstructionInput, Input: 0, Width: 32},
+		{Op: CustomInstructionAdd, A: 0, B: 0, Width: 32},
+	}, Output: 1, ResultWidth: 32}
+	f.pushValue(storage{kind: stConst, typ: mtI32, cval: 6})
+	// Force the recipe result into the subsequent shift's fixed count register.
+	for _, r := range gpAlloc {
+		if r != RCX {
+			f.reserved = f.reserved.union(maskOf(r))
+		}
+	}
+	if err := f.emitCustomInstruction(recipe, &wasm.CompType{Params: []wasm.ValType{wasm.I32}, Results: []wasm.ValType{wasm.I32}}); err != nil {
+		t.Fatal(err)
+	}
+	f.reserved = 0
+	if result := f.s.back(); result.st.kind != stReg || result.st.reg != RCX {
+		t.Fatalf("recipe result storage = %+v, want RCX", result.st)
+	}
+	f.pushValue(storage{kind: stConst, typ: mtI32, cval: 10})
+	f.pushValue(storage{kind: stLocalRef, typ: mtI32, idx: 0})
+	f.pushBinOp(opShl, mtI32)
+	f.materialize(f.s.back())
+	f.pushBinOp(opAdd, mtI32)
+	r := f.materialize(f.s.back())
+	f.a.MovReg64(RAX, r)
+	if f.maxSpill*8+f.nLocalSlots*8 > 256 {
+		t.Fatal("test frame too small")
+	}
+	f.a.AddRsp(256)
+	f.a.Pop(RCX)
+	f.a.Store64(RCX, 0, RAX)
+	f.a.Ret()
+	if got := runCompiledAmd64u(t, &encoder.CompiledModule{Code: f.a.B, Entry: []int{0}}); got != 52 {
+		t.Fatalf("got %d, want 52", got)
+	}
+}
