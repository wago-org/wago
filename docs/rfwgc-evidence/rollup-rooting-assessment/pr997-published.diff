+		} else if err != nil || len(got) != 1 || got[0] != 91 {
+			t.Fatalf("outer:%v,%v; want91", got, err)
+		}
+		if count := in.publicGCState().hostActivationCount; count != 0 {
+			t.Fatalf("retained %d parked activations", count)
+		}
+		assertHostReentryDepthsEmpty(t)
+	}
+}
