//go:build darwin && arm64 && tinygo && scheduler.threads

package wago

import (
	"context"
	"errors"
	"github.com/wago-org/wago/tests/support/wasmtest"
	grt "runtime"
	"testing"
	"time"
)

func TestDarwinTinyGoCancellationAndGC(t *testing.T) {
	// (import "env" "entered" (func)); exported spin calls it then loops forever.
	// Binary fixture avoids TinyGo's unavailable external WAT helper/early return.
	module := wasmtest.Module(
		wasmtest.Section(1, wasmtest.Vec(wasmtest.FuncType(nil, nil))),
		wasmtest.Section(2, []byte{1, 3, 'e', 'n', 'v', 7, 'e', 'n', 't', 'e', 'r', 'e', 'd', 0, 0}),
		wasmtest.Section(3, []byte{1, 0}),
		wasmtest.Section(7, wasmtest.Vec(wasmtest.ExportEntry("spin", 0, 1))),
		wasmtest.Section(10, []byte{1, 9, 0, 0x10, 0, 0x03, 0x40, 0x0c, 0, 0x0b, 0x0b}),
	)
	compiled, err := Compile(NewRuntimeConfig(), module)
	if err != nil {
		t.Fatal(err)
	}
	defer compiled.Close()
	for _, name := range []string{"cancel", "close"} {
		t.Run(name, func(t *testing.T) {
			closeInstead := name == "close"
			entered := make(chan struct{})
			in, err := Instantiate(compiled, InstantiateOptions{Imports: testImports("env.entered", slotHostFunc(func(_ HostModule, _, _ []uint64) { close(entered) }))})
			if err != nil {
				t.Fatal(err)
			}
			defer in.Close()
			ctx, cancel := context.WithCancel(context.Background())
			defer cancel()
			done := make(chan error, 1)
			go func() { _, e := in.InvokeContext(ctx, "spin"); done <- e }()
			select {
			case <-entered:
			case <-time.After(5 * time.Second):
				panic("cancel guest did not enter")
			}
			for i := 0; i < 8; i++ {
				grt.GC()
			}
			if closeInstead {
				if err := in.Close(); err != nil {
					t.Fatal(err)
				}
			} else {
				cancel()
			}
			select {
			case e := <-done:
				if closeInstead {
					requireInterruptedTrap(t, e)
				} else if !errors.Is(e, context.Canceled) {
					t.Fatalf("InvokeContext error = %v, want context.Canceled", e)
				}
			case <-time.After(5 * time.Second):
				panic("TinyGo cancellation did not unwind")
			}
			cancel()
			grt.GC()
			if err := in.Close(); err != nil {
				t.Fatal(err)
			}
			grt.GC()
		})
	}
}
