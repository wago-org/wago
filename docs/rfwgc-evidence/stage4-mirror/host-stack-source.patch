+#!/usr/bin/env python3
+"""MoonBit legacy ABI, Facet GC buffers, and disabled worker regressions."""
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+
+def imp(name, params='', results='', module='__moonbit_fs_unstable', alias=None):
+    return f'(import "{module}" "{name}" (func ${alias or name} '+(
+        f'(param {params})' if params else '')+(f'(result {results})' if results else '')+'))'
+
+
+STRINGS = ''.join(imp(n, p, r) for n,p,r in [
+    ('begin_create_string','','externref'),('string_append_char','externref i32',''),
+    ('finish_create_string','externref','externref'),('begin_read_string','externref','externref'),
+    ('string_read_char','externref','i32')])
+
+
+def text(value):
+    units = value.encode('utf-16-le',errors='surrogatepass')
+    return '(local.set $s (call $begin_create_string))'+''.join(
+        f'(call $string_append_char (local.get $s) (i32.const {int.from_bytes(units[i:i+2],"little")}))'
+        for i in range(0,len(units),2))+'(call $finish_create_string (local.get $s))'
+
+
+def cases():
+    yield 'args-utf16', STRINGS+imp('args_get','','externref')+imp('begin_read_string_array','externref','externref')+imp('string_array_read_string','externref','externref')+'''
+      (func (export "f") (result i32 i32 i32) (local $s externref)
+       (local.set $s (call $begin_read_string (call $string_array_read_string (call $begin_read_string_array (call $args_get)))))
+       (call $string_read_char (local.get $s)) (call $string_read_char (local.get $s)) (call $string_read_char (local.get $s))))''', ['--guest-arg=😀'], '55357\n56832\n-1\n'
+    yield 'file-read', STRINGS+imp('read_file_to_bytes_new','externref','i32')+imp('get_file_content','','externref')+imp('begin_read_byte_array','externref','externref')+imp('byte_array_read_byte','externref','i32')+'''
+      (func (export "f") (result i32 i32 i32 i32) (local $s externref)
+      '''+text('input')+'''(call $read_file_to_bytes_new)
+      (local.set $s (call $begin_read_byte_array (call $get_file_content)))
+      (call $byte_array_read_byte (local.get $s)) (call $byte_array_read_byte (local.get $s)) (call $byte_array_read_byte (local.get $s))))''', ['--dir=.={root}'], '0\n65\n255\n-1\n'
+    for path in ('../outside', 'escape', '/etc/passwd'):
+        yield 'deny-'+path.replace('/','_'), STRINGS+imp('read_file_to_bytes_new','externref','i32')+'''
+         (func (export "f") (result i32) (local $s externref)'''+text(path)+'''(call $read_file_to_bytes_new)))''', ['--dir=.={root}'], '-1\n'
+    yield 'env-isolated', STRINGS+imp('get_env_var','externref','externref')+imp('set_env_var','externref externref')+'''
+      (func (export "f") (result i32) (local $s externref) (local $k externref)
+      '''+text('KEY')+'''(local.set $k) (local.get $k)'''+text('é')+'''(call $set_env_var)
+      (call $string_read_char (call $begin_read_string (call $get_env_var (local.get $k))))))''', [], '233\n'
+    yield 'worker-eqref', imp('run_batch','eqref eqref','i32','dewdrop.transform.workers')+imp('capacity','','i32','dewdrop.transform.workers')+'(export "f" (func $capacity)))', [], '0\n'
+    yield 'worker-disabled', imp('capacity','','i32','dewdrop.transform.workers')+'(export "f" (func $capacity)))', [], '0\n'
+    yield 'facet-allocate-concrete', '''(type $a (array (mut i16)))'''+imp('args_read_array_i16','i32 i32','(ref null $a) i32','facet')+'''
+      (func (export "f") (result i32 i32 i32) (local $a (ref null $a)) (local $e i32)
+        (call $args_read_array_i16 (i32.const 0) (i32.const 0)) (local.set $e) (local.set $a)
+        (local.get $e) (array.len (local.get $a)) (array.get_u $a (local.get $a) (i32.const 1))))''', ['--guest-arg=😀'], '0\n2\n56832\n'
+    yield 'facet-copy-partial', '''(type $a (array (mut i32)))'''+imp('args_read_into_array_i32','i32 i32 (ref array) i32 i32','i64 i32','facet')+'''
+      (func (export "f") (result i64 i32 i32 i32) (local $a (ref $a))
+        (local.set $a (array.new $a (i32.const 77) (i32.const 3)))
+        (call $args_read_into_array_i32 (i32.const 0) (i32.const 0) (local.get $a) (i32.const 1) (i32.const 1))
