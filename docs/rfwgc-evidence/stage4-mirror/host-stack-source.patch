+import .host_paths;
+
+// Instance-owned externrefs. These records share the existing resource table,
+// but carry bit 63 so they cannot be confused with GC references or Facet fds.
+// kind: 3 UTF-16 string, 4 bytes, 5 string list, 6/7 builder, 8/9/10 reader.
+// record: kind, backing, length(bytes), capacity, source token, position, reserved.
+let MB_LIMIT: u64 = 268435456;
+fn mb_new(rt: Runtime&, kind: u64) -> u64 {
+    let slot = ss_load64(rt.host + 8);
+    if slot >= 65536 { rt.trap = 11; return 0; }
+    ss_store64(rt.host + 8, slot + 1);
+    ss_store64(ss_load64(rt.host) + slot * 64, kind);
+    return GC_INTERNAL_EXTERN | (ss_load64(rt.host + 16) << 16) | slot;
+}
+fn mb_object(rt: Runtime&, token: u64, kind: u64) -> u64 {
+    if token & GC_REFERENCE_TAGS != GC_INTERNAL_EXTERN { rt.trap = 11; return 0; }
+    let resource = host_resource(rt, token & 4294967295);
+    if resource == 0 { rt.trap = 11; return 0; }
+    if ss_load64(resource) != kind { rt.trap = 11; return 0; }
+    return resource;
+}
+fn mb_reserve(rt: Runtime&, record: u64, required: u64) -> bool {
+    if required > MB_LIMIT { rt.trap = 11; return false; }
+    let old = ss_load64(record + 24); if required <= old { return true; }
+    let capacity = min(MB_LIMIT, max(required, max(4096, old * 2)));
+    let total = ss_load64(rt.host + 136);
+    if capacity - old > MB_LIMIT - total { rt.trap = 11; return false; }
+    let base = ss_jit_alloc(capacity); if base == 0 { rt.trap = 11; return false; }
+    if old != 0 {
+        ss_move_bytes(base, ss_load64(record + 8), ss_load64(record + 16));
+        ss_jit_free(ss_load64(record + 8), old);
+    }
+    ss_store64(record + 8, base); ss_store64(record + 24, capacity); ss_store64(rt.host + 136, total + capacity - old); return true;
+}
+fn mb_dispose(rt: Runtime&, record: u64) {
+    let capacity = ss_load64(record + 24);
+    if capacity != 0 { ss_jit_free(ss_load64(record + 8), capacity); ss_store64(rt.host + 136, ss_load64(rt.host + 136) - capacity); }
+    ss_fill_bytes(record, 0, 64);
+}
+fn mb_append(rt: Runtime&, record: u64, value: u64, width: u64) {
+    let used = ss_load64(record + 16);
+    if !mb_reserve(rt, record, used + width) { return; }
+    host_text_unit(ss_load64(record + 8) + used, value, width);
+    ss_store64(record + 16, used + width);
