index 000000000..6979d8af3
--- /dev/null
+++ b/tools/moonbit_host_verify.py
@@ -0,0 +1,74 @@
+#!/usr/bin/env python3
+"""Qualify exact real-program loads; reject process-success/link-failure records."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+from wasm_binary import name, uleb
+
+
+def loaded(record):
+    lines = record['stdout'].splitlines()
+    return (record['returncode'] == 0 and not record['stderr']
+            and lines.count('loaded 1') == 1
+            and not any(line.startswith(('link ', 'trap ')) for line in lines))
+
+
+def run(runner, action, options):
+    command = [str(runner), *options, str(action)]
+    p = subprocess.run(command, capture_output=True, text=True, timeout=180)
+    return dict(command=command, returncode=p.returncode, stdout=p.stdout, stderr=p.stderr)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--runner', type=Path, required=True)
+    parser.add_argument('--inventory', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    runner = args.runner.resolve(); args.output.mkdir(parents=True, exist_ok=True)
+    inventory = json.loads(args.inventory.read_text())
+    entries = inventory['workloads'] if isinstance(inventory,dict) else inventory
+    with tempfile.TemporaryDirectory(prefix='moonbit-load-') as temporary:
+        root = Path(temporary)
+        empty = root/'empty.wasm'; empty.write_bytes(b'\0asm\1\0\0\0')
+        wat = root/'missing.wat'; wat.write_text('(module (import "absent" "required" (func)))')
+        missing = wat.with_suffix('.wasm')
+        subprocess.run(['wasm-tools','parse',str(wat),'-o',str(missing)],check=True)
+        controls = []
+        for module in (empty,missing):
+            action = root/'control.actions'; action.write_bytes(b'\x02'+uleb(1)+name(str(module)))
+            controls.append(run(runner,action,[]))
+        good,bad = controls
+        assert loaded(good), good
+        assert bad['returncode'] == 0 and 'link 128' in bad['stdout'] and not loaded(bad), bad
+        for mutation in (dict(good,stdout=good['stdout']+'link 128\n'),
+                         dict(good,stdout=good['stdout']+'loaded 1\n'),
+                         dict(good,stdout=''),dict(good,stderr='failure'),dict(good,returncode=1)):
+            assert not loaded(mutation)
+        (args.output/'producer-controls.json').write_text(json.dumps(dict(records=controls,corruptions_rejected=5),indent=2)+'\n')
+        records = []
+        for entry in entries:
+            module = Path(entry['module']['origin'])
+            digest = hashlib.file_digest(module.open('rb'),'sha256').hexdigest()
+            assert digest == entry['module']['sha256'], (module,digest)
+            action = root/'load.actions'
+            arguments = [str(module), '--help']
+            action.write_bytes(b'\x05'+uleb(len(arguments))+b''.join(name(a) for a in arguments)
+                               +uleb(0)+uleb(1)+name(str(root))+name('/')+uleb(16711807)
+                               +b'\x02'+uleb(1)+name(str(module)))
+            for mode in ('default','off'):
+                record = run(runner,action,[] if mode == 'default' else ['--region-scalar=off'])
+                record.update(workload=entry['workload'],module_sha256=digest,mode=mode)
+                records.append(record)
+                (args.output/'loads.json').write_text(json.dumps(records,indent=2)+'\n')
+                print(entry['workload'],mode,'PASS' if loaded(record) else 'FAIL',flush=True)
+                assert loaded(record), record
+        assert len(records) == 24
+
+
+if __name__ == '__main__':
+    main()
