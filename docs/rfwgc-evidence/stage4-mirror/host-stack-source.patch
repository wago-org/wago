+    yield 'opaque-is-not-fd', STRINGS+imp('args_get','','externref')+imp('handle_close','i32','i32','facet')+imp('begin_read_string_array','externref','externref')+imp('string_array_read_string','externref','externref')+'''
+      (func (export "f") (result i32 i32) (local $s externref)
+      (local.set $s (call $args_get)) (call $handle_close (i32.const 65537))
+      (call $string_read_char (call $begin_read_string (call $string_array_read_string (call $begin_read_string_array (local.get $s)))))))''', ['--guest-arg=X'], '4\n88\n'
+    yield 'bulk-args', imp('request','i32 i32 i32','i32','__starshine_cli_v1')+imp('response','i32 i32','i32','__starshine_cli_v1')+'''
+      (memory 1) (func (export "f") (result i32 i32 i32 i32)
+      (call $request (i32.const 1) (i32.const 0) (i32.const 0))
+      (call $response (i32.const 0) (i32.const 6))
+      (i32.load8_u (i32.const 0)) (i32.load8_u (i32.const 3))))''', ['--guest-arg=x'], '6\n6\n0\n120\n'
+    yield 'bulk-file', imp('request','i32 i32 i32','i32','__starshine_cli_v1')+imp('response','i32 i32','i32','__starshine_cli_v1')+'''
+      (memory 1) (data (i32.const 100) "input") (func (export "f") (result i32 i32 i32 i32)
+      (call $request (i32.const 4) (i32.const 100) (i32.const 5))
+      (call $response (i32.const 0) (i32.const 3))
+      (i32.load8_u (i32.const 1)) (i32.load8_u (i32.const 2))))''', ['--dir=.={root}'], '3\n3\n65\n255\n'
+    yield 'bulk-candidates', imp('request','i32 i32 i32','i32','__starshine_cli_v1')+imp('response','i32 i32','i32','__starshine_cli_v1')+'''
+      (memory 1) (func (export "f") (result i32 i32 i32 i32)
+      (call $request (i32.const 6) (i32.const 0) (i32.const 0))
+      (call $response (i32.const 0) (i32.const 100))
+      (i32.load8_u (i32.const 0)) (i32.load8_u (i32.const 1))))''', ['--dir=.={root}'], '10\n10\n0\n91\n'
+    yield 'facet-immutable', '''(type $a (array i16))'''+imp('args_read_into_array_i16','i32 i32 (ref array) i32 i32','i64 i32','facet')+'''
+      (func (export "f") (result i64 i32)
+        (call $args_read_into_array_i16 (i32.const 0) (i32.const 0) (array.new_default $a (i32.const 1)) (i32.const 0) (i32.const 1))))''', ['--guest-arg=Z'], '0\n25\n'
+    yield 'facet-immutable-allocation', '''(type $a (array i8))'''+imp('args_read_array_i8','i32 i32','(ref null $a) i32','facet')+'''
+      (func (export "f") (result i32 i32) (local $a (ref null $a)) (local $e i32)
+        (call $args_read_array_i8 (i32.const 0) (i32.const 0)) (local.set $e) (local.set $a)
+        (local.get $e) (array.get_u $a (local.get $a) (i32.const 0))))''', ['--guest-arg=Z'], '0\n90\n'
+    yield 'network-no-authority', imp('socket_open','i32 i32 i32 i32','i32 i32','facet')+'''
+      (func (export "f") (result i32 i32)
+      (call $socket_open (i32.const 1) (i32.const 1) (i32.const 0) (i32.const 0))))''', [], '0\n37\n'
+
+
+def main():
+    runners = [str(Path(p).resolve()) for p in sys.argv[1:]]
+    assert runners
+    with tempfile.TemporaryDirectory(prefix='slipstream-moonbit-') as temporary:
+        root = Path(temporary); cap = root/'cap'; cap.mkdir()
+        (cap/'input').write_bytes(b'A\xff'); (root/'outside').write_bytes(b'secret')
+        (cap/'escape').symlink_to('../outside')
+        fixtures = []
+        for label, body, options, expected in cases():
+            wat = root/(label+'.wat'); wasm = wat.with_suffix('.wasm')
+            wat.write_text('(module '+body)
+            subprocess.run(['wasm-tools','parse',str(wat),'-o',str(wasm)],check=True,capture_output=True)
+            fixtures.append((label,wasm,[p.format(root=cap) for p in options],expected))
+        for runner in runners:
+            for label, wasm, options, expected in fixtures:
+                for mode in ([],['--region-scalar=off']):
+                    result = subprocess.run([runner,str(wasm),'--invoke=f',*mode,*options],capture_output=True,text=True,timeout=45)
+                    assert result.returncode == 0 and result.stdout == expected, (label,mode,result.returncode,result.stdout,result.stderr)
+            print(f'PASS {Path(runner).name}: {len(fixtures)} MoonBit/Facet cases in both native modes')
+
+
+if __name__ == '__main__':
+    main()
