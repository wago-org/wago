--- /dev/null
+++ b/src/worker_imports.goose
@@ -0,0 +1,25 @@
+import .facet_imports;
+
+// Dewdrop tools/wago-transform-host/workers.go: disabled pools advertise zero
+// capacity. 0x6d below accepts the primary host eqref ABI or a concrete non-null packed-byte array, checked
+// structurally at registration rather than accepting an arbitrary reference.
+let worker_imports: FacetImport[5] = [
+    FacetImport { "capacity", "", "\x7f", true },
+    FacetImport { "run_batch", "\x6d\x6d", "\x7f", true },
+    FacetImport { "input_size", "", "\x7f", true },
+    FacetImport { "input", "\x6d", "", true },
+    FacetImport { "output", "\x6d", "", true },
+];
+
+fn host_byte_array_type(m: Module&, t: u32) -> bool {
+    // Dewdrop optimizer output widens these imports to nullable eqref.
+    // The primary worker host validates the dynamic byte array on channel use.
+    // Disabled channels trap before touching their arguments.
+    if t == ref_type(HEAP_EQ, true) { return true; }
+    if !is_ref_type(t) || ref_nullable(t) || !heap_defined(ref_heap(t)) { return false; }
+    let index = heap_type_index(ref_heap(t));
+    if index >= m.types.len { return false; }
+    let array = m.types[index as i64];
+    return array.kind == 2 && array.fields.len == 1 &&
+        m.field_types[array.fields.pos] == 0x78 && m.field_mut[array.fields.pos] != 0;
+}
