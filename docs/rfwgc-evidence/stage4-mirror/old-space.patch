+fn expanded_old_space() {
+    let h = ng_open(6400, 32768, 4); assert(h != 0);
+    assert(N_DIRTY_TOP + NG_DIRTY_GROUPS * 8 <= NG_META_BYTES);
+    assert(NG_WINDOW < NG_FORWARD && NG_WINDOW - NG_LOS == 134217728);
+    assert(ng_register(h, 1, 8192, 0, 0, [(1 as u64) << 32 | 8, (1 as u64) << 32 | 16]));
+    assert(ng_register(h, 2, 16, 0, 0, []));
+    let root = ss_ng_map(4096, 3); assert(root as! i64 >= 0);
+    assert(ng_root(h, root, 1, 8, 5, 0));
+    // Exercise the real old-space admission/destination machinery. A rooted
+    // 256 MiB chain exceeds both the former old partition and reserved heap.
+    let count: u64 = 32768; let bytes = count * 8192;
+    assert(ng_admit(h, bytes, 1, 8192));
+    let heap = ng_get(h, N_HEAP); var previous: u64 = 0; var first: u64 = 0;
+    for i in count {
+        let word = ng_old_destination(h, 0, 8192); assert(word != 0);
+        ss_ng_store32(heap + word, 1 | (2 << 24));
+        ss_ng_store32(heap + word + 8, previous);
+        ss_ng_store32(heap + word + 24, i);
+        ng_set(h, N_STARTS, word); ng_lines(h, word, 8192);
+        if i == 0 { first = word; } previous = word;
+    }
+    assert(previous > 268435456 && previous < NG_LOS);
+    ss_ng_store64(root, previous);
+    let young = ng_allocate(h, 2, 0); assert(young != 0);
+    ss_ng_store64(heap + young + 8, 42);
+    ss_ng_store32(heap + previous + 16, young); ng_barrier(h, heap + previous + 16);
+    // This card is in a top-summary group beyond the former eight groups.
+    assert(ng_collect(h, false));
+    let moved = ss_ng_load32(heap + previous + 16); assert(moved != young);
+    assert(ss_ng_load64(heap + moved + 8) == 42);
+    assert(ng_collect(h, true));
+    var cursor = ss_ng_load64(root); var remaining = count;
+    while cursor != 0 {
+        assert(ng_valid(h, cursor) && remaining != 0);
+        remaining -= 1; assert(ss_ng_load32(heap + cursor + 24) == remaining);
+        cursor = ss_ng_load32(heap + cursor + 8);
+    }
+    assert(remaining == 0);
+    ss_ng_store64(root, 0); assert(ng_collect(h, true));
+    assert(!ng_valid(h, first) && !ng_valid(h, previous));
+    assert(ng_close(h)); ss_ng_unmap(root, 4096);
+    print("PASS native ABI2 expanded old space, high remembered cards and full reclamation");
+}
