[
  {
    "label": "compiler",
    "command": [
      "tinygo",
      "version"
    ],
    "exit": 0
  },
  {
    "label": "bootstrap",
    "command": [
      "bash",
      "scripts/patch-tinygo-042.sh"
    ],
    "exit": 0
  },
  {
    "label": "go-ordinary",
    "command": [
      "go",
      "test",
      "-count=1",
      "-timeout=25m",
      "-run",
      "Evacuation",
      "./src/core/runtime/gc/native"
    ],
    "exit": 0
  },
  {
    "label": "tinygo-ordinary",
    "command": [
      "tinygo",
      "test",
      "-scheduler=threads",
      "-gc=conservative",
      "-v",
      "-run",
      "Evacuation",
      "./src/core/runtime/gc/native"
    ],
    "exit": 0
  },
  {
    "label": "go-wagodebug",
    "command": [
      "go",
      "test",
      "-count=1",
      "-timeout=25m",
      "-tags=wagodebug",
      "-run",
      "Evacuation",
      "./src/core/runtime/gc/native"
    ],
    "exit": 0
  },
  {
    "label": "tinygo-wagodebug",
    "command": [
      "tinygo",
      "test",
      "-scheduler=threads",
      "-gc=conservative",
      "-tags=wagodebug",
      "-v",
      "-run",
      "Evacuation",
      "./src/core/runtime/gc/native"
    ],
    "exit": 0
  },
  {
    "label": "go-wago_regalloccheck",
    "command": [
      "go",
      "test",
      "-count=1",
      "-timeout=25m",
      "-tags=wago_regalloccheck",
      "-run",
      "Evacuation",
      "./src/core/runtime/gc/native"
    ],
    "exit": 0
  },
  {
    "label": "tinygo-wago_regalloccheck",
    "command": [
      "tinygo",
      "test",
      "-scheduler=threads",
      "-gc=conservative",
      "-tags=wago_regalloccheck",
      "-v",
      "-run",
      "Evacuation",
      "./src/core/runtime/gc/native"
    ],
    "exit": 0
  }
