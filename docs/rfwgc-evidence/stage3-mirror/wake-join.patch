+// A helper first seals all phase-data/statistic writes by claiming its epoch.
+// Normal completion and contained-failure repair race on the same CAS. The
+// winner is unique; either side may then publish the idempotent completion bit.
+fn ng_ack_phase(h: u64, worker: u64, ticket: u64) -> bool {
+    let at = h + 1024 + worker * 8; var seen = ss_ng_load64(at);
+    loop {
+        if seen == ticket { return true; }
+        if seen > ticket { ng_fail_closed(h, 13); return false; }
+        let old = ss_ng_cas(at, seen, ticket);
+        if old == seen { return true; }
+        seen = old;
+    }
+}
+// N_DONE is (ticket << 8) | completed_helpers. The completion CAS is the last
+// shared phase operation. A following futex wake is notification only: an old
+// delayed wake is harmless because the owner always rereads the full word.
+fn ng_complete(h: u64, worker: u64, ticket: u64, workers: u64) -> bool {
+    if !ng_ack_phase(h, worker, ticket) { ss_ng_wake(h + N_DONE); return false; }
+    let bit = (1 as u64) << worker; let target = ng_done_target(workers);
+    loop {
+        let done = ng_get(h, N_DONE);
+        if done >> 8 != ticket { ng_fail_closed(h, 13); ss_ng_wake(h + N_DONE); return false; }
+        if done & bit != 0 { return true; }
+        let next = done | bit; let seen = ss_ng_cas(h + N_DONE, done, next);
+        if seen != done { continue; }
+        if next & 255 == target { ss_ng_wake(h + N_DONE); }
